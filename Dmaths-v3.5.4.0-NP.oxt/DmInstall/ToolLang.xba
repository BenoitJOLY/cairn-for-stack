Public Trad(5,5) as String


Sub ChargementDuVocabulaire
	Trad(0,0) = &quot; LibreOffice / AOOo / Neo va être redémarré. &quot;
	Trad(0,1) = &quot; Votre compte ne dispose pas de droits d&apos;écriture suffisants. &quot;
	Trad(0,2) = &quot; Etes vous sûr de vouloir désinstaller Dmaths ? &quot;
	Trad(0,3) = &quot; Vos options sont opérationnelles. &quot;
	Trad(0,4) = &quot; Dmaths est maintenant désinstallé. &quot;
	Trad(0,5) = &quot; Quittez et relancez OpenOffice ! &quot;	

	
	Trad(1,0) = &quot; LibreOffice / AOOo  / Neo will start again. &quot;
	Trad(1,1) = &quot; You must have administrator rights. &quot;	
	Trad(1,2) = &quot; Do you want to uninstall Dmaths ?	&quot;
	Trad(1,3) = &quot; Your options are activated &quot;
	Trad(1,4) = &quot; Dmaths has now been uninstalled	&quot;
	Trad(1,5) = &quot; Quit and restart OpenOffice! &quot;	
	
	Trad(2,0) = &quot; Schließe LibreOffice / AOOo/ Neo bzw. den Schnellstarter. &quot;
	Trad(2,1) = &quot; Sie müssen dafür Administrator-Rechte haben. &quot;
	Trad(2,2) = &quot; Möchten Sie Dmaths wirklich entfernen? &quot;
	Trad(2,3) = &quot; Die Optionen sind aktiviert &quot;
	Trad(2,4) = &quot; Dmaths erfolgreich deinstalliert. &quot;
	Trad(2,5) = &quot; Beenden und starten Sie OpenOffice neu! &quot;
	
	Trad(3,0) = &quot; LibreOffice / AOOo  / Neo will start again. &quot;
	Trad(3,1) = &quot; You must have administrator rights. &quot;	
	Trad(3,2) = &quot; Do you want to uninstall Dmaths ?	&quot;
	Trad(3,3) = &quot; Your options are activated &quot;
	Trad(3,4) = &quot; Dmaths has now been uninstalled	&quot;
	Trad(3,5) = &quot; Quit and restart OpenOffice! &quot;	
	
	Trad(4,0) = &quot; LibreOffice / AOOo  / Neo vai ser reiniciado.    &quot;
	Trad(4,1) = &quot; Você tem que ter direitos administrativos. &quot;	
	Trad(4,2) = &quot; Pretende desinstalar Dmaths?	      &quot;
	Trad(4,3) = &quot; As suas opções estão ativas &quot;
	Trad(4,4) = &quot; Dmaths está agora desinstalado	&quot;
	Trad(4,5) = &quot; Fechar e reiniciar LibreOffice/OpenOffice! &quot;	

	Trad(5,0) = &quot; LibreOffice / AOOo  / Neo will start again. &quot;
	Trad(5,1) = &quot; You must have administrator rights. &quot;	
	Trad(5,2) = &quot; Do you want to uninstall Dmaths ?	&quot;
	Trad(5,3) = &quot; Your options are activated &quot;
	Trad(5,4) = &quot; Dmaths has now been uninstalled	&quot;
	Trad(5,5) = &quot; Quit and restart OpenOffice! &quot;	
	
End Sub
