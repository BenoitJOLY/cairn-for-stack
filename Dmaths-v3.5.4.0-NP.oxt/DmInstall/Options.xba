Sub ModifieCheckBoxTailleFormule
	If oDmOptions.GetControl(&quot;CheckBox12&quot;).State=1 Then
	oDmOptions.GetControl(&quot;TextField1&quot;).Enable = False
	Else
	oDmOptions.GetControl(&quot;TextField1&quot;).Enable = True
	End If
End Sub


