   	If oTextCursor.IsCollapsed() then
		sFormule=SelectionnerFormuleEnPassantPrimes(oTextCursor,1)
		&apos;sFormule=SelectionnerFormule(oTextCursor,1)
	else
		sFormule=SelectionnerFormule(oTextCursor,0)
	end if
	sFormule=&quot;bar(&quot;+sFormule+&quot;)&quot;
	Arbre=cmath2arbre(sFormule)
	sFormuleOOo=arbre2OOo(Arbre)
	LitParametresFormules
	&apos;if iGras = com.sun.star.awt.FontWeight.BOLD then
