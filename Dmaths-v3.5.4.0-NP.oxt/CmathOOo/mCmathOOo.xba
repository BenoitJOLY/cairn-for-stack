sub Script
	dim oViewCursor as object, oTextCursor as object
	dim sPolice as string, iTaille as integer, sFormule as string
	if not PoliceScriptTrouvee(&quot;Cmathscr&quot;) then
		msgbox(&quot;La police Cmath Script n&apos;est pas installée&quot;)
		exit sub
	end if
    oViewCursor = ThisComponent.getCurrentController().getViewCursor()
	oTextCursor=oViewCursor.Text.createTextCursorByRange(oViewCursor)
    sPolice=oViewCursor.CharFontName
    iTaille=oViewCursor.Charheight
    If oTextCursor.IsCollapsed() then
		sFormule=SelectionnerFormule(oTextCursor,1)
	end if
&apos;	InsereFormule(oViewCursor, oTextCursor, sPolice, iTaille, &quot;{font serif nitalic{&quot;+sFormule+&quot;}}&quot;,true)
	if IsMacOS then
		oTextCursor.CharFontName=&quot;Cmath Script&quot;
	else
		oTextCursor.CharFontName=&quot;Cmathscr&quot;
	end if
 	oTextCursor.goRight(1,False)
    oTextCursor.CharFontName=sPolice
end sub

