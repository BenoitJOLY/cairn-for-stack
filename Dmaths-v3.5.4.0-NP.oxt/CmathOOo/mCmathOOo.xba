&apos;Option Explicit

&apos;public bModeTexte as boolean &apos;IsTextMode 
global sSearch() as string, sReplace() as string
const cNbArgMax=3		&apos; nombre d&apos;arguments maximum pour les fonctions acceptant un nb variable
						&apos; de paramètres (matrices, systèmes...). Cependant, en cas de dépassement, le programme redimensionnera
						&apos; le tableau. Il n&apos;y aura donc pas d&apos;erreurs, juste un léger ralentissement.
global iIndexFormule as integer
global iNbObjets as integer
public sCas as string
public bTagCalc as boolean &apos;vrai si la formule est une instruction calc. Utile pour la réévaluation si un paramètre change

sub main

	Dim mgr as Object, AddinCAS as Object
	Dim Resultat as Variant
	Expression=&quot;1;2&quot;
	mgr=getProcessServiceManager()
	AddinCAS=mgr.createInstance(&quot;CmathOOo.CAS&quot;)
	Resultat=AddinCAS.cadd(array(&quot;2&quot;,&quot;3&quot;))
	
	aFuncInst = GetProcessServiceManager.createInstance(&quot;com.sun.star.sheet.FunctionAccess&quot;)
   dim aData() as variant
   aData() = Array (50)
   result = aFuncInst.callFunction (&quot;cracine&quot;, aData())
end sub

sub FormuleEtEvalFormelle
	FormuleEtEval(false)
end sub

sub FormuleEtEvalNumerique
	FormuleEtEval(true)
end sub

sub FormuleEtEval(bEvalNumerique as boolean)
	dim oViewCursor as Object, oTextCursor as Object, oTempCursor as Object
	dim oFormule as Object, Arbre as Variant, sFormuleCmath as String, sFormule as String, sFormuleOOo as String
	dim oFormuleEval as object, sFormuleCmathEval as string, ArbreEval as Variant, sFormuleOOoEval as string, sFormuleEval as string
	dim iTaille as Integer, bGras as boolean, sPolice as String, i as integer
	dim sVariable as string
	dim bAffichage as boolean, bEgal as boolean
	dim sNbDigits as string

    oViewCursor = ThisComponent.getCurrentController().getViewCursor()
	on error goto textnull
	oTextCursor=oViewCursor.Text.createTextCursorByRange(oViewCursor)
	on error goto 0
    sPolice=oViewCursor.CharFontName
    iTaille=oViewCursor.Charheight
    bGras=(oViewCursor.CharWeight=com.sun.star.awt.FontWeight.BOLD)
    oTempCursor=oTextCursor.Text.CreateTextCursorByRange(oTextCursor.getEnd()) 
	sFormule=SelectionnerFormule(oTextCursor,0)
	if sFormule=&quot;&quot; then 
		&apos; évaluer la dernière formmule
		oLesObjets=thisComponent.getEmbeddedObjects
		i=oLesObjets.count
		do
			i=i-1
			if i&lt;0 then i=oLesObjets.count-1
		loop while not(estFormule(oLesObjets(i))) or i&lt;0
		if i&gt;=0 then
			oFormule=oLesObjets(i)
       		sFormuleCmath=lireTagFormule(oFormule.Model)
     		Arbre=chaine2arbre(lireTagArbre(oFormule.Model))
      		if sFormuleExtraite=&quot;&quot; then
       			&apos; pas de Tag formule, reprendre le contenu de la formule
				sFormuleCmath=&quot;OOo(&quot;+oFormule.Model.Formula+&quot;)&quot;
       		end if
       		bEgal = false
		else
			&apos; pas de formule trouvée
			exit sub
		endif
	else
		bEgal = true
		if oTextCursor.getstring()=&quot;&quot; then
			&apos; une seule formule sélectionnée
			&apos; récupérer l&apos;arbre
			sEnum=oTextCursor.getAvailableServiceNames
			oObjets=oTextCursor.createContentEnumeration(sEnum(0))
			if oObjets.HasMoreElements then
				oFormule=oObjets.NextElement
				if oFormule.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
					if oFormule.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
			       		&apos;c&apos;est une formule
			       		sFormuleCmath=lireTagFormule(oFormule.Model)
			       		Arbre=chaine2arbre(lireTagArbre(oFormule.Model))
			       		if sFormuleExtraite=&quot;&quot; then
			       			&apos; pas de Tag formule, reprendre le contenu de la formule
							sFormuleCmath=&quot;OOo(&quot;+oFormule.Model.Formula+&quot;)&quot;
			       		end if
			       	endif
			    endif
			endif 
		    oTextCursor.goRight(1,True)		
		else
			&apos; évaluer la fomule du texte
			sFormuleCmath=sFormule
			sFormule=BugDu2x(sFormule)
			Arbre=cmath2arbre(sFormule)
			LitParametresFormules &apos;ici pour définir le symbole de la multiplication
			sFormuleOOo=arbre2OOo(Arbre)
		    oFormule=InsereFormule(oTextCursor, sPolice, iTaille, bGras,  sFormuleOOo, bModeTexte)
			ecrireTagFormule(oFormule.Model,sFormuleCmath)
			ecrireTagArbre(oFormule.Model,arbre2chaine(Arbre))
		endif
	
	endif
		
	&apos;évaluer
	bAffichage=true
	&apos; s&apos;il c&apos;est une affectation ne pas afficher de résultat
	if isArray(Arbre) then
		select case arbre(0)
		case &quot;:=&quot;
			bAffichage=false
			&apos; mettre à jour les formules du document
			sVariable=arbre2cas(Arbre(1))
			&apos; voir si c&apos;est une fonction
			i=instr(sVariable,&quot;(&quot;)
			if i&gt;0 then	sVariable=left(sVariable,i-1)
			majCalculsCas(sVariable)
		end select
	endif
	if bEvalNumerique=true then
		sNbDigits=mParams.LitParametre(&quot;TextFieldDigits&quot;)
		if sNbDigits=&quot;&quot; then 
			sNbDigits=&quot;3&quot;
		endif
		&apos;if left(sFormuleCmath,8)&lt;&gt;&quot;evaluer(&quot; then 
			sFormuleCmathEval=&quot;evaluer(&quot;+sFormuleCmath+&quot;,&quot;+sNbDigits+&quot;)&quot;
		&apos;else
		&apos;	sFormuleCmathEval=sFormuleCmath
		&apos;endif
	else
		&apos;if left(sFormuleCmath,9)&lt;&gt;&quot;calculer(&quot; then 
			sFormuleCmathEval=&quot;calculer(&quot;+sFormuleCmath+&quot;)&quot;
		&apos;else
		&apos;	sFormuleCmathEval=sFormuleCmath
		&apos;endif
	endif
	if bAffichage=true then
		if bEgal = true then
			if bEvalNumerique=true then 
				oTextCursor.Text.insertString(oTextCursor, &quot; en&quot;, FALSE)
				InsereExpressionCmathOOo
				oTextCursor.Text.insertString(oTextCursor, &quot; &quot;, FALSE)
			else
				oTextCursor.Text.insertString(oTextCursor, &quot; = &quot;, FALSE)
			end if
		endif
		sFormuleEval=BugDu2x(sFormuleCmathEval)
		ArbreEval=cmath2arbre(sFormuleEval)
		sFormuleOOoEval=arbre2OOo(ArbreEval)
    	oFormuleEval=InsereFormule(oTextCursor, sPolice, iTaille, bGras,  sFormuleOOoEval, bModeTexte)
		ecrireTagFormule(oFormuleEval.Model,sFormuleCmathEval)
		ecrireTagArbre(oFormuleEval.Model,arbre2chaine(ArbreEval))
		ecrireTagCas(oFormuleEval.Model)
		iIndexFormule=0
	endif
	&apos;thisComponent.CurrentController.Select(oTextCursor.getEnd())
	iIndexFormule=0
    Exit Sub
	textnull:
	on error goto 0
	&apos; voir si équation seule pour remplacer par le texte de la formule		
	msgbox(&quot;Impossible d&apos;analyser la zone de texte&quot;)
end sub


sub FormuleTexte
	Formule(true)
end sub

sub FormuleCentree
	Formule(False)
end sub

sub Formule(bModeTexte as boolean)
	dim oViewCursor as Object, oTextCursor as Object, oTempCursor as Object
	dim oFormule as Object, oCurFormle as Object, Arbre as Variant
	dim sPolice as String, sFormuleCmath as string, sFormule as String, sFormuleOOo as String
	dim iTaille as Integer, bGras as boolean, i as integer
	dim sEval as string, sVariable as string
	
	    oViewCursor = ThisComponent.getCurrentController().getViewCursor()
&apos;	    if not isEmpty(oViewCursor.Text) then
		on error goto textnull
		oTextCursor=oViewCursor.Text.createTextCursorByRange(oViewCursor)
		on error goto 0
	    sPolice=oViewCursor.CharFontName
	    iTaille=oViewCursor.Charheight
        bGras=(oViewCursor.CharWeight=com.sun.star.awt.FontWeight.BOLD)
        sCas=&quot;&quot;
        bTagCalc=false
	    oTempCursor=oTextCursor.Text.CreateTextCursorByRange(oTextCursor.getEnd())
	    if not(uneFormuleSelectionnee(OViewCursor, oTempCursor, sPolice, iTaille)) then
			sFormule=SelectionnerFormule(oTextCursor,0)
			if sFormule=&quot;&quot; then exit sub
			sFormuleCmath=sFormule
			sFormule=BugDu2x(sFormule)
			Arbre=cmath2arbre(sFormule)
			LitParametresFormules
			sFormuleOOo=arbre2OOo(Arbre)
		    oFormule=InsereFormule(oTextCursor, sPolice, iTaille, bGras, sFormuleOOo, bModeTexte)
		    oCurFormule=oFormule.Model &apos;Model
			if not(isNull(oCurFormule)) then
				ecrireTagFormule(oCurFormule,sFormuleCmath)
				ecrireTagArbre(oCurFormule,arbre2chaine(Arbre))
				if sCas&lt;&gt;&quot;&quot; then ecrireTagCas(oCurFormule)
				&apos; if bTagCalc=true then ecrireTagCalc(oCurFormule,true)
				&apos; vérifier s&apos;il y a une affectation pour l&apos;envoyer vers giac
				if isArray(Arbre) then
					if Arbre(0)=&quot;:=&quot; then
						&apos; passer l&apos;affectation à giac
						sCas=arbre2cas(Arbre)
						sEval=CmathOOoCAS(sCas)
						&apos; mettre à jour les formules du document
						sVariable=arbre2cas(Arbre(1))
						&apos; voir si c&apos;est une fonction
						i=instr(sVariable,&quot;(&quot;)
						if i&gt;0 then	sVariable=left(sVariable,i-1)
						majCalculsCas(sVariable)
					end if
				end if
			end if
	    &apos; remet à zéro pour le rappel ultérieur des formules précedentes
	    iIndexFormule=0
	    end if
	    Exit Sub
		textnull:
		on error goto 0
		msgbox(&quot;Impossible d&apos;analyser la zone de texte&quot;)	
end sub

&apos;--------------------------------------------------------------------------------------
Function InsereFormule(oTextCursor as Object, sPolice as String, iTaille as Integer, bGras as boolean, sFormule as String, bModeTexte as boolean) as object
dim obj as object
&apos;dim iGras as integer
dim version as double
dim curseurVisible as object 
if sFormule&lt;&gt;&quot;&quot; then
	version=OOoVersion()
	obj=oDocOOo.CreateInstance(&quot;com.sun.star.text.TextEmbeddedObject&quot;)
	obj.CLSID=&quot;078B7ABA-54FC-457F-8551-6147e776a997&quot;
    obj.AnchorType=com.sun.star.text.TextContentAnchorType.AS_CHARACTER
	oDocOOo.getCurrentController().select(oTextCursor)
    oTextCursor.Text.insertTextContent(oTextCursor, obj, true)
    &apos;iGras=oViewCursor.CharWeight
    if version&lt;3.4 then
    	AffecteParametresFormule(obj.embeddedObject, sPolice, iTaille, bGras, sFormule, bModeTexte)
    else
		AffecteParametresFormule(obj.Model, sPolice, iTaille, bGras, sFormule, bModeTexte)		
	   	obj.ExtendedControlOverEmbeddedObject.update()
   	endif
   	obj.LeftMargin=0
  	obj.RightMargin=0
  	oDocOOo.CurrentController.Select(oTextCursor.getEnd())
  	&apos;curseurVisible=ThisComponent.currentcontroller.ViewCursor
  	&apos;curseurVisible.gotoRange(oTextCursor,false)
	InsereFormule=obj
end if
end function


&apos;--------------------------------------------------------------------------------------
function estFormule(objet as object)
&apos; renvoie vrai si l&apos;objet est une formule
	dim a as object
	if objet.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
		&apos; a=objet.embeddedObject &apos; ne sert à rien mais contourne un bug : la propriété  embeddedObject vaut Null au premier appel si bcp d&apos;équations à la suite
		if objet.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
			estFormule=true
		else
			estFormule=false
		endif
	endif
end function

sub simplifierFormule
&apos; simplifie la formule précédent le curseur ou bien s&apos;il n&apos;y a pas de formule avant le curseur,
&apos; insère la dernière formule tapée simplifiée
	dim oViewCursor as Object, oTextCursor as Object, oTempCursor as Object
	dim sFormule as string
	dim oFormuleEval as object, sFormuleCmathEval as string, ArbreEval as Variant, sFormuleOOoEval as string, sFormuleEval as string
	dim oLesObjets as object, oCurFormule as object
	dim sEnum as object, oFormule as object, oObjets as object
	dim i as integer
	dim sEval as string, sArbre as string, sTagCas as string

    oViewCursor = ThisComponent.getCurrentController().getViewCursor()
	on error goto textnull
	oTextCursor=oViewCursor.Text.createTextCursorByRange(oViewCursor)
	on error goto 0
	&apos; voir si une formule est juste avant le curseur
	&apos; si oui la modifier
	oTextCursor.goLeft(1,True)
	sEnum=oTextCursor.getAvailableServiceNames
	oObjets=oTextCursor.createContentEnumeration(sEnum(0))
	oTextCursor.goRight(1,false)
	if oObjets.HasMoreElements then
		oFormule=oObjets.NextElement
		if oFormule.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
			if oFormule.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
				oCurFormule=oFormule.Model
			endif
		endif
	endif
	if isNull(oCurFormule) then
		oLesObjets=thisComponent.getEmbeddedObjects
		i=oLesObjets.count
		do
			i=i-1
			if i&lt;0 then i=oLesObjets.count-1
		loop while not(estFormule(oLesObjets(i))) or i&lt;0
		if i&gt;=0 then
			oFormule=oLesObjets(i)
			oCurFormule=oFormule.Model		
		endif
	end if
	if not(isNull(oCurFormule)) then
		LitParametresFormule(oCurFormule)
		sTagFormule=lireTagFormule(oCurFormule)
		if sTagFormule=&quot;&quot; then sTagFormule=&quot;&quot;&quot;Simplification impossible&quot;&quot;&quot;
		if left(sTagFormule,11)&lt;&gt;&quot;simplifier(&quot; then 
			sFormuleCmathEval=&quot;simplifier(&quot;+sTagFormule+&quot;)&quot;
		else
			sFormuleCmathEval=sTagFormule
		endif
		sFormuleEval=BugDu2x(sFormuleCmathEval)
		ArbreEval=cmath2arbre(sFormuleEval)
		sFormuleOOoEval=arbre2OOo(ArbreEval)
		if isNull(oLesObjets) then
			oFormuleEval=oFormule
			oFormuleEval.Model.formula=sFormuleOOoEval			
		else
	    	oFormuleEval=InsereFormule(oTextCursor, sPolice, iTaille, bGras,  sFormuleOOoEval, bModeTexte)
		endif
		ecrireTagFormule(oFormuleEval.Model,sFormuleCmathEval)
		ecrireTagArbre(oFormuleEval.Model,arbre2chaine(ArbreEval))
		ecrireTagCas(oFormuleEval.Model)
&apos;			sCas=arbre2cas(arbre)
&apos;			if problemeEval(sCas)=&quot;&quot; then
&apos;				if sTagCas&lt;&gt;&quot;&quot; then 
&apos;					&apos;reprendre le tag de la formule pour conserver les références aux objets
&apos;					sTagCas=&quot;simplifier(&quot;+sTagCas+&quot;)&quot;
&apos;				else
&apos;					sTagCas=&quot;simplifier(&quot;+sCas+&quot;)&quot;
&apos;				endif
&apos;				sCas=&quot;simplifier(&quot;+sCas+&quot;)&quot;
&apos;				sEval=CmathOOoCAS(sCas)
&apos;				Arbre=cas2arbre(sEval)
&apos;				sFormule=arbre2OOo(Arbre)
&apos;				sFormule=BugDu2x(sFormule)
&apos;				oFormule=InsereFormule(oTextCursor, sPolice, iTaille, bGras, sFormule, bModeTexte)
&apos;				oCurFormule=oFormule.Model
&apos;				if not(isNull(oCurFormule)) then
&apos;					ecrireTagFormule(oCurFormule,arbre2cmath(Arbre))
&apos;					ecrireTagArbre(oCurFormule,arbre2chaine(Arbre))
&apos;					ecrireTagCas(oCurFormule,sTagCas)
&apos;				end if
&apos;			else
&apos;				oTextCursor.Text.insertString(oTextCursor, &quot; Impossible à simplifier à cause de &quot;+problemeEval(sCas), FALSE)
&apos;			endif
&apos;		endif
	endif
	exit sub
	textnull:
	on error goto 0
	msgbox(&quot;Impossible d&apos;analyser la zone de texte&quot;)
end sub


sub formulePrecedente
&apos; insère au point d&apos;insertion la formule n-1
&apos; si une formule est présente avant le curseur, elle est effacée
	dim oViewCursor as Object, oTextCursor as Object, oTempCursor as Object
	dim oLesObjets as object, oLaFormule as object
	dim sEnum as object, oFormule as object, oObjets as object
	dim i as integer
	dim bPremierAppel as boolean
	
	&apos; premier appel ?
    bPremierAppel=true
    oViewCursor = ThisComponent.getCurrentController().getViewCursor()
	oTextCursor=oViewCursor.Text.createTextCursorByRange(oViewCursor)
	oTextCursor.goLeft(1,True)
	sEnum=oTextCursor.getAvailableServiceNames
	oObjets=oTextCursor.createContentEnumeration(sEnum(0))
	oTextCursor.goRight(1,false)
	if oObjets.HasMoreElements then
		oFormule=oObjets.NextElement
		if oFormule.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
			if oFormule.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
				&apos;oFormule.dispose
				bPremierAppel=false
			endif
		endif
	endif
	oLesObjets=thisComponent.getEmbeddedObjects
	if bPremierAppel=true then
		iNbObjets=oLesObjets.count
		iIndexFormule=iNbObjets
	endif
	if iNbObjets&gt;0 then
		i=iIndexFormule
		do
			i=i-1
			if i&lt;0 then 
				i=iNbObjets-1
				&apos; if i=0 then exit do &apos;une seule formule
			endif
		loop while not(estFormule(oLesObjets(i))) &apos; or i=iIndexFormule
&apos;		if i&lt;&gt;iIndexFormule then
			oLaFormule=oLesObjets(i)
			LitParametresFormule(oLaFormule.Model)
			if bPremierAppel=true then
			    oFormule=InsereFormule(oTextCursor, sPolice, iTaille, bGras, sTexteFormule, bModeTexte)		
			else
				oFormule.Model.formula=sTexteFormule
			endif
		    iIndexFormule=i
&apos;		endif
	endif
end sub

sub formuleSuivante
&apos; insère au point d&apos;insertion la formule n+1
&apos; si une formule est présente avant le curseur, elle est effacée
	dim oViewCursor as Object, oTextCursor as Object, oTempCursor as Object
	dim oLesObjets as object, oLaFormule as object
	dim sEnum as object, oFormule as object, oObjets as object
	dim i as integer
	dim bPremierAppel as boolean
	
	&apos; premier appel ?
    bPremierAppel=true
    oViewCursor = ThisComponent.getCurrentController().getViewCursor()
	oTextCursor=oViewCursor.Text.createTextCursorByRange(oViewCursor)
	oTextCursor.goLeft(1,True)
	sEnum=oTextCursor.getAvailableServiceNames
	oObjets=oTextCursor.createContentEnumeration(sEnum(0))
	oTextCursor.goRight(1,false)
	if oObjets.HasMoreElements then
		oFormule=oObjets.NextElement
		if oFormule.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
			if oFormule.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
				&apos;oFormule.dispose
				bPremierAppel=false
			endif
		endif
	endif
	oLesObjets=thisComponent.getEmbeddedObjects
	if bPremierAppel=true then
		iNbObjets=oLesObjets.count
		iIndexFormule=0
	endif
	if iNbObjets&gt;0 then
		i=iIndexFormule
		do
			i=i+1
			if i=iNbObjets then i=0
		loop while not(estFormule(oLesObjets(i))) &apos; or i=iIndexFormule
&apos;		if i&lt;&gt;iIndexFormule then
			oLaFormule=oLesObjets(i)
			LitParametresFormule(oLaFormule.Model)
			if bPremierAppel=true then
			    oFormule=InsereFormule(oTextCursor, sPolice, iTaille, bGras, sTexteFormule, bModeTexte)		
			else
				oFormule.Model.formula=sTexteFormule
			endif
		    iIndexFormule=i
&apos;		endif
	endif
end sub




&apos;--------------------------------------------------------------------------------------
function uneFormuleSelectionnee(OViewCursor as object, oTextCursor as object, sPolice as string, iTaille as integer) as boolean
&apos; teste si une seule formule séléctionnée
&apos; si oui la remplace par sa formule (undo) et renvoie vrai
&apos; sinon renvoie faux

	dim sFormuleExtraite as string
	dim oObjets as object, oFormule as object, sFormule as string, sCaractere as string
	dim iNiveauPar as integer, iAsc as integer
	dim sEnum() as string, sCarac as string
	dim sNom1 as string, sNom2 as string
	uneFormuleSelectionnee=False
	If oTextCursor.IsCollapsed() then
		oTextCursor.goLeft(1,True)
	end if
	sEnum=oTextCursor.getAvailableServiceNames
	oObjets=oTextCursor.createContentEnumeration(sEnum(0))
	if oObjets.HasMoreElements then
		oFormule=oObjets.NextElement
		if oFormule.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
			if oFormule.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
	       		&apos;c&apos;est une formule
	       		sFormuleExtraite=lireTagFormule(oFormule.Model)
	       		if sFormuleExtraite=&quot;&quot; then
	       			&apos; pas de Tag formule, reprendre le contenu de la formule
					sFormuleExtraite=&quot;OOo(&quot;+oFormule.Model.Formula+&quot;)&quot;
	       		end if
				oTextCursor.goLeft(1,True)
				sCarac=left(oTextCursor.getstring(),1)+&quot; &quot;
				iAsc=asc(sCarac)
				if sCarac&lt;&gt;&quot; &quot; then oTextCursor.goRight(1,True)
				if (iAsc&lt;33) then
					&apos; vérifier s&apos;il y a une formule
					sEnum=oTextCursor.getAvailableServiceNames
					oObjets=oTextCursor.createContentEnumeration(sEnum(0))
					&apos; il y en a déjà au moins une
					sNom1=oFormule.Name
					if oObjets.HasMoreElements then
						oFormule=oObjets.NextElement
					endif
					sNom2=oFormule.Name
					if sNom1=sNom2 then
						&apos; une seule formule
						oFormule.dispose
						&apos;dim i as integer					
						&apos;do while len(sFormuleExtraite)&gt;0
						&apos;	i=instr(sFormuleExtraite,&quot;OOo(&quot;)
						&apos;	if i=0 then 
						oTextCursor.Text.insertString(oTextCursor, sFormuleExtraite, FALSE)
						thisComponent.CurrentController.Select(oTextCursor.getEnd())
						&apos;		i=len(sFormuleExtraite)
						&apos;	else
						&apos;		oTextCursor.Text.insertString(oTextCursor, left(sFormuleExtraite,i-1), FALSE)
								&apos; aller chercher la formule contenue dans OOo
						&apos;		iNiveauPar=1
						&apos;		sFormule=&quot;&quot;			
						&apos;		i=i+3
						&apos;		do while iNiveauPar&gt;0
						&apos;			i=i+1
						&apos;			sCaractere=Mid(sFormuleExtraite,i,1)
						&apos;			select case sCaractere
						&apos;			case &quot;(&quot; 
						&apos;				iNiveauPar=iNiveauPar+1
						&apos;			case &quot;)&quot;					
						&apos;				iNiveauPar=iNiveauPar-1
						&apos;			end select
						&apos;			sFormule=sFormule+sCaractere
						&apos;		loop
						&apos;		sFormule=left(sFormule,len(sFormule)-1)
						&apos;	    oFormule=InsereFormule(OViewCursor, oTextCursor, sPolice, iTaille, sFormule, bModeTexte)
						&apos;		if not(isNull(oFormule)) then ecrireTagFormule(oFormule,sFormule)
						&apos;	endif
						&apos;	i=i+1
						&apos;	sFormuleExtraite=mid(sFormuleExtraite,i)
						&apos;loop
						uneFormuleSelectionnee=True
					endif
				end if
			endif
		endif
	endif
end function

&apos;--------------------------------------------------------------------------------------
Function SelectionnerFormuleEnPassantPrimes(oTextCursor as Object,iNbCarac as integer) as String
&apos; sélectionner iNbCarac caractères sans compter les primes
dim i as integer
dim sFormule as string, nbCarac as integer, sCarac as string

sFormule=&quot;&quot;
nbCarac=0
for i=1 to iNbCarac
	do 
		oTextCursor.goRight(nbCarac,false)
		nbCarac=nbCarac+1
		sFormule=SelectionnerFormule(oTextCursor,nbCarac)
	loop while left(sFormule,1)=&quot;&apos;&quot;   	
next i
iNbCarac=nbCarac
SelectionnerFormuleEnPassantPrimes=sFormule
end function

&apos;--------------------------------------------------------------------------------------
Function SelectionnerFormule(oTextCursor as Object,iNbCarac as integer) as String
&apos; si iNbCarac=0, sélectionner jusqu&apos;à un espace ou équivalent
&apos; sinon, sélectionner iNbCarac caractères


	dim sTexteFormule as string,sFormuleExtraite as string
	dim i as integer
	dim oTempCursor as object, oObjets as object, oFormule as object
	dim sEnum() as string, sCarac as string
	
	sTexteFormule=&quot;&quot;
	If oTextCursor.IsCollapsed() then
		if iNbCarac=0 then
			oTextCursor.goLeft(1,True)
			do while not DebutFormule(oTextCursor)
				oTextCursor.goLeft(1,True)
			loop
		else
			oTextCursor.goLeft(iNbCarac,True)
		end if
	end if
	&apos; parcours du texte sélectionné à la recherche de formules
	oTempCursor=oTextCursor.Text.CreateTextCursorByRange(oTextCursor.getEnd())
	do while oTextCursor.Text.compareRegionStarts(oTempCursor,oTextCursor)&lt;0
		oTempCursor.goLeft(0,False)
		oTempCursor.goLeft(1,True)
		sCarac=oTempCursor.getString()
		if sCarac&lt;&gt;&quot;&quot; and sCarac&lt;&gt;chr(160) then &apos;éliminer l&apos;espace insécable
			&apos; c&apos;est du texte
			sTexteFormule=sCarac+sTexteFormule
		else
			sEnum=oTempCursor.getAvailableServiceNames
			oObjets=oTempCursor.createContentEnumeration(sEnum(0))
			if oObjets.HasMoreElements then
				oFormule=oObjets.NextElement
				if oFormule.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
					if oFormule.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
	  		       		&apos;c&apos;est une formule
	  		       		sFormuleExtraite=lireTagFormule(oFormule.Model)
	  		       		sFormuleExtraite=elagueCommentaire(sFormuleExtraite)
	  		       		if sFormuleExtraite=&quot;&quot; then
		  		       		&apos; pas de Tag formule, reprendre le contenu de la formule
		  		       		&apos; 
							sFormuleExtraite=&quot;OOo(&quot;+oFormule.Model.Formula+&quot;)&quot;
	  		       		end if
						sTexteFormule=sFormuleExtraite+sTexteFormule
&apos;	   	       			if right(sFormuleExtraite,2)=&quot;{}&quot; then
	   	       				&apos; c&apos;est une insertion telle que {}times{} etc...
&apos;							sTexteFormule=&quot;**&quot;+mid(sFormuleExtraite,3,len(sFormuleExtraite)-4)+&quot;**&quot;+sTexteFormule
&apos;						else
							&apos; c&apos;est une formule
&apos;							sTexteFormule=&quot;{&quot;+sFormuleExtraite+&quot;}&quot;+sTexteFormule
&apos;						end if
					endif
				endif
			endif
	
		end if
	loop
	SelectionnerFormule=sTexteFormule
end Function

&apos;--------------------------------------------------------------------------------------
Function DebutFormule(oTextCursor as Object) as boolean
&apos;repère le début de la formule

	dim sCarac as string
	dim iAsc as integer
	
	sCarac=left(oTextCursor.getstring(),1)
	iAsc=asc(sCarac+&quot; &quot;)
	&apos; si espace ou tabulation ou début de phrase alors le début est trouvé
	if (sCarac=&quot; &quot;) or (iAsc=9) or (iAsc=10) then
		oTextCursor.goRight(1,True)
		DebutFormule=True
	else if (oTextCursor.isStartOfSentence()=True) then
			DebutFormule=True
		else
			DebutFormule=False
		end if
	end if
end function

&apos;-------------------------------------------------------------------------------------
Function SubstitutionVirgule(sFormule as String) as String
	&apos; recherche d&apos;une virgule :
	&apos; si elle est entourée de chiffres elle est fait partie d&apos;un nombre
	&apos; sinon, c&apos;est un séparateur (listes, ...)
	dim i as integer, iPosVirg as integer
	i=1
	iPosVirg=Instr(sFormule,&quot;,&quot;)
	Do while iPosVirg&gt;i
		if InStr(&quot;0123456789&quot;,mid(sFormule,iPosVirg-1,1))=0 or InStr(&quot;0123456789&quot;,mid(sFormule,iPosVirg+1,1))=0 then
			sFormule=left(sFormule,iPosVirg-1)+&quot;OOo({nitalic ,})&quot;+mid(sFormule,iPosVirg+1)
			iPosVirg=iPosVirg+14
		end if
		i=iPosVirg
		iPosVirg=i+Instr(mid(sFormule,i+1),&quot;,&quot;)
	loop
	SubstitutionVirgule=sFormule
end function

&apos;-------------------------------------------------------------------------------------
Function BugDu2x(sFormule as String) as String
	&apos; recherche d&apos;une multiplication implicite entre un chiffre et une lettre
	&apos; si trouvée, ajouter deux espaces, symbole de multiplication implicite
	&apos; pourra être effacé après correction du bug http://www.openoffice.org/issues/show_bug.cgi?id=45689
	dim i as integer
	dim iChiffre as integer
	dim iLettre as integer
	i=1
	do while i&lt;len(sFormule)
		iChiffre=asc(mid(sFormule,i,1))
		iLettre=asc(mid(sFormule,i+1,1))
		if ((iChiffre&gt;47 and iChiffre&lt;58) and ((iLettre&gt;96 and iLettre&lt;123) or (iLettre&gt;64 and iLettre&lt;91))) then
			sFormule=left(sFormule,i)&amp;&quot;  &quot;&amp;mid(sFormule,i+1)
			i=i+3
		else
			i=i+1
		end if
	loop
	BugDu2x=sFormule
end function


