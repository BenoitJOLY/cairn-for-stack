		oTextCursor.CharFontName=&quot;Cmathcal&quot;
	end if
 	oTextCursor.goRight(1,False)
    oTextCursor.CharFontName=sPolice
end sub




&apos;--------------------------------------------------------------------------------------
function ArgumentsCmath(sFormule as String, iNbArg as Integer) as Variant
&apos; renvoie un tableau contenant les arguments de la fonction
&apos; si iNbArg=0, on ne sait pas à l&apos;avance le nb d&apos;arguments (ex : matrice, ...)
&apos; sinon, on lit iNbArg arguments

	dim iPos as integer, iCompteurArg as integer, iNiveauPar as integer
	dim sCaractere as string
	dim sArguments(iNbArg) as String
	iCompteurArg=0
	iPos=1
	iNiveauPar=0
	Do While iPos&lt;=len(sFormule)
		iCompteurArg=iCompteurArg+1
		Do While iPos&lt;=len(sFormule) AND Mid(sFormule,iPos,1)&lt;&gt;&quot;;&quot; AND Mid(sFormule,iPos,1)&lt;&gt;&quot;,&quot;
			if UBound(sArguments())&lt;iCompteurArg then
				&apos;j&apos;en remets 10 de plus
				redim preserve sArguments(iCompteurArg) as String
			end if
			sCaractere=Mid(sFormule,iPos,1)
			sArguments(iCompteurArg)=sArguments(iCompteurArg) + sCaractere
			Select Case sCaractere
			Case &quot;(&quot;
				iNiveauPar=iNiveauPar+1
				do while iNiveauPar&gt;0
					iPos=iPos+1
					if iPos&gt;len(sFormule) then
						msgbox(&quot;Erreur de parenthèses !&quot;)
						stop
					end if
					sCaractere=Mid(sFormule,iPos,1)				
					sArguments(iCompteurArg)=sArguments(iCompteurArg) + sCaractere
					if sCaractere=&quot;(&quot; then
						iNiveauPar=iNiveauPar+1
					end if
					if sCaractere=&quot;)&quot; then
						iNiveauPar=iNiveauPar-1
					end if
				loop
			Case &quot;{&quot;	&apos;prévoir {}
				iNiveauPar=iNiveauPar+1
				do while iNiveauPar&gt;0
					iPos=iPos+1
					if iPos&gt;len(sFormule) then
						msgbox(&quot;Erreur d&apos;accolades !&quot;)
						stop
					end if
					sCaractere=Mid(sFormule,iPos,1)				
					sArguments(iCompteurArg)=sArguments(iCompteurArg) + sCaractere
					if sCaractere=&quot;{&quot; then
						iNiveauPar=iNiveauPar+1
					end if
					if sCaractere=&quot;}&quot; then
						iNiveauPar=iNiveauPar-1
					end if
				loop
			Case &quot;[&quot;,&quot;]&quot;
				iNiveauPar=iNiveauPar+1
				do while iNiveauPar&gt;0
					iPos=iPos+1
					if iPos&gt;len(sFormule) then
						msgbox(&quot;Erreur de crochets !&quot;)
						stop
					end if
					sCaractere=Mid(sFormule,iPos,1)				
					sArguments(iCompteurArg)=sArguments(iCompteurArg) + sCaractere
					if sCaractere=&quot;[&quot; or sCaractere=&quot;]&quot; then
						iNiveauPar=iNiveauPar-1
					end if
				loop
			Case chr(34)
				iNiveauPar=iNiveauPar+1
				do while iNiveauPar&gt;0
					iPos=iPos+1
					if iPos&gt;len(sFormule) then
						msgbox(&quot;Erreur de guillemets !&quot;)
						stop
					end if
					sCaractere=Mid(sFormule,iPos,1)				
					sArguments(iCompteurArg)=sArguments(iCompteurArg) + sCaractere
					if sCaractere=chr(34) then
						iNiveauPar=iNiveauPar-1
					end if
				loop
			end select
			iPos=iPos+1
		loop
		if iPos&lt;=len(sFormule) then
			iPos=iPos+1
		end if
	loop
	&apos;if iNbArg=0 then
		&apos; la tableau sArguments aura une taille égale au nombre de d&apos;arguments
	&apos;	redim preserve sArguments(iCompteurArg-1) as String
	&apos;end if
	ArgumentsCmath=sArguments()
end function



&apos;--------------------------------------------------------------------------------------
sub InsereExpressionCmathOOo
&apos; 	parcours les 3 caractères précédents le curseur à la recherche d&apos;une insertion
&apos; 	convention : 
&apos; 	les formules sont encadrées de {}
&apos;	les insertions &quot;autotextes&quot; (F3) sont encadrées de $$
&apos;	les autres caractères sont insérés dans le texte sans formatage

	dim oViewCursor as object, oTextCursor as object, oObjets as object
	dim sEnum as object, oFormule as object
	dim sPolice as string, sSymbole as string, bGras as boolean
	dim iTaille as integer, i as integer, j as integer, k as integer, iNiveauAcc as integer
	dim sExpression(1 to 3) as string, iNbCarac(1 to 3) as integer
	
    oViewCursor = ThisComponent.getCurrentController().getViewCursor()
    sPolice=oViewCursor.CharFontName
    iTaille=oViewCursor.Charheight
    bGras=(oViewCursor.CharWeight=com.sun.star.awt.FontWeight.BOLD)

    j=1
	i=1
	do 
		on error goto textnull
		oViewCursor.goLeft(1,True)
		on error goto 0
		oTextCursor=oViewCursor.Text.createTextCursorByRange(oViewCursor)
		&apos; si c&apos;est une formule alors fin du scan		
		sEnum=oTextCursor.getAvailableServiceNames
		oObjets=oTextCursor.createContentEnumeration(sEnum(0))
		if oObjets.HasMoreElements then
			oFormule=oObjets.NextElement
			if oFormule.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
				if oFormule.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
  		       		&apos;c&apos;est une formule
  		       		exit do
				endif
			endif
		endif		
		sSymbole=oTextCursor.getString()
		sExpression(j)=sSubstitutionF8(sSymbole)
		if sExpression(j)&lt;&gt;&quot;&quot; then 
			iNbCarac(j)=i
			j=j+1
		end if
		i=i+1
	loop while (i&lt;4 and DebutFormule(oTextCursor)=false)
	oTextCursor.collapseToEnd
&apos;	j-1 donne le nb de cas.
	Select Case j
	Case 2
		&apos; pas d&apos;ambiguïté
		oTextCursor.goLeft(iNbCarac(1),True)
		j=1
	Case 1
		&apos; rien trouvé
		oViewCursor.collapseToEnd
		Msgbox(&quot;Aucune insertion trouvée !&quot;)
		exit sub
	Case Else
		&apos; choix par boîte de dialogue
		dim oDlg as Object, oList as Object
		DialogLibraries.LoadLibrary(&quot;CmathOOo&quot;)
		oDlg = CreateUnoDialog( DialogLibraries.CmathOOo.DialogChoixInsertionF8)
		oList=oDlg.GetControl(&quot;ListBox1&quot;)
		for i=1 to j-1
			&apos;oList.Model.StringItemList()=Array(sExpression(1),sExpression(2))
			oList.addItem(right(sSymbole,iNbcarac(i))&amp;&quot; : &quot;&amp;sExpression(i),i)
		next i
		oList.selectItemPos(0,true)
		oDlg.Execute
		j=oList.SelectedItemPos+1
		oDlg.Dispose
		oTextCursor.goLeft(iNbCarac(j),True)
	End Select
	&apos;effacer la selection
	oTextCursor.String=&quot;&quot;
	oViewCursor.collapseToEnd
	&apos; arrivé ici, sExpression(j) contient l&apos;expression à insérer
	for i=1 to len(sExpression(j))
		sSymbole=mid(sExpression(j),i,1)
		Select Case sSymbole
		Case chr(34)
			&apos;insérer le texte
			k=instr(mid(sExpression(j),i+1),chr(34))						
			if k&gt;0 then
				oTextCursor.Text.insertString(oTextCursor, mid(sExpression(j),i+1,k-1), FALSE)
				i=i+k
			else
				&apos; s&apos;il n&apos;y a pas de deuxième guillemet (ne devrait pas se produire)
				oTextCursor.Text.insertString(oTextCursor, &quot; erreur de guillemet &quot;, FALSE)
				&apos; ignorer le guillemet
			end if
			
		
		Case &quot;{&quot;
			&apos; formule
			k=i
			&apos; rechercher la formule
			iNiveauAcc=1
			do while iNiveauAcc&gt;0
					k=k+1
					if k&gt;len(sExpression(j)) then
						msgbox(&quot;Erreur d&apos;accolades !&quot;)
						stop
					end if
					sSymbole=Mid(sExpression(j),k,1)				
					if sSymbole=&quot;{&quot; then
						iNiveauAcc=iNiveauAcc+1
					end if
					if sSymbole=&quot;}&quot; then
						iNiveauAcc=iNiveauAcc-1
					end if
			loop
			LitParametresFormules
			InsereFormule(oTextCursor, sPolice, iTaille, bGras, mid(sExpression(j),i+1,k-i-1),False)
			&apos;ecrireTagFormule(oFormule,sFormuleCmath)
			i=k
		Case &quot;$&quot;
			&apos; rechercher l&apos;autotexte
			k=instr(mid(sExpression(j),i+1),&quot;$&quot;)						
			if k&gt;0 then
				dim oAutoTextContainer as object, oGroup as object, oEntry as object
				oAutoTextContainer = createUnoService(&quot;com.sun.star.text.AutoTextContainer&quot;)
				on Error GoTo AutoTextErreur
				oGroup = oAutoTextContainer.getByName(&quot;CmathOOofr&quot;)
				dim a as string
				a=mid(sExpression(j),i+1,k-1)
				oEntry = oGroup.getByName(mid(sExpression(j),i+1,k-1))
				oEntry.applyTo(oTextCursor)
&apos;				oTextCursor.goRight(1,True)
				AutoTextErreur:
				on error goto 0
				i=i+k+1
			end if	
			&apos;dim Array(0) as new com.sun.star.beans.PropertyValue 
			&apos;dispatcher.executeDispatch(oFrame, &quot;.uno:ExpandGlossary&quot;, &quot;&quot;, 0, Array())
			rem dispatcher.executeDispatch(oFrame, &amp;quot;.uno:ResetAttributes&amp;quot;, &amp;quot;&amp;quot;, 0, Array())
			rem    ligne prÃ©cÃ©dente en commentaire pour Ã©viter le formattage du paragraphe
			rem    dans le style par dÃ©faut, dont l&amp;apos;alignement...
			
		Case Else
			&apos; ne devrait pas se produire normalement
			&apos; insérer le texte sans interprétation au cas où...
			oTextCursor.Text.insertString(oTextCursor, sSymbole, FALSE)
		end select 
	next i
&apos;	oViewCursor.gotoRange(oTextCursor.end)
	Exit Sub
	textnull:
	on error goto 0
	msgbox(&quot;Zone de texte non détectée&quot;)
end sub

sub End_DialogChoixInsertionF8(Evenement as Object)
	dim code as integer
	code=Evenement.KeyCode
	if code=com.sun.star.awt.Key.RETURN or code=com.sun.star.awt.Key.SPACE then
		Evenement.Source.Context.EndExecute
	end if
end sub


&apos;--------------------------------------------------------------------------------------
sub InsereFormuleF3
	dim oViewCursor as object, oTextCursor as object
	dim sPolice as string, sSymbole as string, sFormule as string
	dim iTaille as integer
    oViewCursor = ThisComponent.getCurrentController().getViewCursor()
	oTextCursor=oViewCursor.Text.createTextCursorByRange(oViewCursor)
    sPolice=oViewCursor.CharFontName
    iTaille=oViewCursor.Charheight
	&apos;aller chercher le caractère $
	oTextCursor.goLeft(1,True)
	&apos; effacer le saut de ligne
	if asc(oTextCursor.getstring())=13 then oTextCursor.SetString(&quot;&quot;)
	do while left(oTextCursor.getstring(),1)&lt;&gt;&quot;$&quot;
		oTextCursor.goLeft(1,True)
	loop
	sFormule=mid(oTextCursor.getString(),2)
	InsereFormule(oTextCursor, sPolice, iTaille, oViewCursor.CharWeight=com.sun.star.awt.FontWeight.BOLD, sFormule,False)
end sub



