&apos;gestion de la numérotation
sub CreerStyleListeNumerotee(oDoc as object)
dim lesFamilles as object, uneFamille as object, nouvStyle as object

	lesFamilles=oDoc.StyleFamilies
	uneFamille=lesFamilles.getByName(&quot;NumberingStyles&quot;)
	if uneFamille.hasByName(&quot;Liste Numerotee CmathOOo&quot;) then
		nouvStyle=uneFamille.getByName(&quot;Liste Numerotee CmathOOo&quot;)
	else
	&apos;création
		nouvStyle=oDoc.CreateInstance(&quot;com.sun.star.style.NumberingStyle&quot;)
&apos;		nouvStyle.NumberingRules.IsAutomatic=true
&apos;		nouvStyle.NumberingRules.IsContinuousNumbering=true
		uneFamille.insertByName(&quot;Liste Numerotee CmathOOo&quot;,nouvStyle)
		SetNumberingRuleProperty(nouvStyle,0,&quot;LeftMargin&quot;,500)
		SetNumberingRuleProperty(nouvStyle,0,&quot;FirstLineOffset&quot;,-500)
		SetNumberingRuleProperty(nouvStyle,0,&quot;SymbolTextDistance&quot;,0)
		SetNumberingRuleProperty(nouvStyle,0,&quot;NumberingType&quot;,com.sun.star.style.NumberingType.ARABIC)
		SetNumberingRuleProperty(nouvStyle,1,&quot;LeftMargin&quot;,1000)
		SetNumberingRuleProperty(nouvStyle,1,&quot;FirstLineOffset&quot;,-500)
		SetNumberingRuleProperty(nouvStyle,1,&quot;SymbolTextDistance&quot;,0)
		SetNumberingRuleProperty(nouvStyle,1,&quot;NumberingType&quot;,com.sun.star.style.NumberingType.CHARS_LOWER_LETTER)
		SetNumberingRuleProperty(nouvStyle,2,&quot;LeftMargin&quot;,1500)
		SetNumberingRuleProperty(nouvStyle,2,&quot;FirstLineOffset&quot;,-500)
		SetNumberingRuleProperty(nouvStyle,2,&quot;SymbolTextDistance&quot;,0)
		SetNumberingRuleProperty(nouvStyle,2,&quot;NumberingType&quot;,com.sun.star.style.NumberingType.ROMAN_LOWER)
	end if
&apos;	a=nouvStyle.NumberingRules
&apos;	b=a.getCount()
&apos;	c=a.getByIndex(0)
 &apos;   d=c(10)
	&apos;SetNumberingRuleProperty(nouvStyle,0,&quot;CharStyleName&quot;,&quot;Bullet Symbols&quot;)
	&apos;SetNumberingRuleProperty(nouvStyle,0,&quot;BulletChar&quot;, chr(2022))
end sub

sub AbaisserNumerotation
dim oDoc as Object, oCurseur as Object
oDoc=ThisComponent
oCurseur=ThisComponent.getCurrentController().getViewCursor()
if isEmpty(oCurseur.NumberingRules) then
	CreerStyleListeNumerotee(oDoc)
	oCurseur.NumberingStyleName=&quot;Liste Numerotee CmathOOo&quot;
	oCurseur.ParaIsNumberingRestart=true
else
	oCurseur.NumberingLevel=oCurseur.NumberingLevel+1
end if		
end sub

sub RemonterNumerotation
dim oCurseur as Object
oCurseur=ThisComponent.getCurrentController().getViewCursor()
	if oCurseur.NumberingLevel=0 then
		oCurseur.NumberingStyleName=&quot;&quot;
	else
		oCurseur.NumberingLevel=oCurseur.NumberingLevel-1
	end if
end sub

Function DetermineOS as Integer
	If Getguitype = 1 Then
		DetermineOS = 1
	ElseIf Getguitype 	= 4 and FileExists(&quot;/Users&quot;) Then
		DetermineOS = 3
	Else
		DetermineOS = 4
	Endif
End Function


Function IsMacOS as Boolean
	IsMacOS = False
	If Getguitype 	= 4 and FileExists(&quot;/Users&quot;) Then IsMacOS = True
End Function

Function PoliceScriptTrouvee(sLeNomPoliceScript as String) as Boolean
	Dim oWindow    &apos;The container window supports the awt XDevice interface.
	Dim oDescript  &apos;Array of awt FontDescriptor structures
  	Dim s$         &apos;Temporary string variable to hold all of the string names.
  	Dim i%         &apos;General index variable
  	Dim Presente as Boolean

	Presente = False
	oWindow = ThisComponent.getCurrentController().getFrame().getContainerWindow()
  	oDescript = oWindow.getFontDescriptors()
 	&apos;s = &quot;&quot;

	For i = LBound(oDescript) to UBound(oDescript)
    	&apos;s = s &amp; oDescript(i).Name &amp; &quot;, &quot;
    	If oDescript(i).Name = sLeNomPoliceScript Then Presente = True  
  	Next
  	PoliceScriptTrouvee = Presente
End Function

Function OOoVersion() As Double
  &apos;Retreives the running OOO version
  &apos;modifié par cdeval : renvoie un décimal
  Dim aSettings, aConfigProvider
  Dim aParams2(0) As new com.sun.star.beans.PropertyValue
  Dim sProvider$, sAccess$
  sProvider = &quot;com.sun.star.configuration.ConfigurationProvider&quot;
  sAccess   = &quot;com.sun.star.configuration.ConfigurationAccess&quot;
  aConfigProvider = createUnoService(sProvider)
  aParams2(0).Name = &quot;nodepath&quot;
  aParams2(0).Value = &quot;/org.openoffice.Setup/Product&quot;
  aSettings = aConfigProvider.createInstanceWithArguments(sAccess, aParams2())
  OOOVersion=val(aSettings.getbyname(&quot;ooSetupVersion&quot;))
End Function



&apos; fonctions obsolètes -------------------------------------------------------------------------------------
Function SubstitutionsAvantTraitement(sFormule as String) as String
	dim i as integer, j as integer, iPosAcc as integer, iPosGuil as integer, iNiveauAcc as integer
	dim iPosCas as integer, iNiveauPar as integer
	dim iPosVirg as integer, k as integer
	dim sCaractere as string
	dim n as integer
	dim sSubstitution as string
	
	if sFormule&lt;&gt;&quot;&quot; then
		iPosAcc=Instr(sFormule,&quot;{&quot;)
		iPosGuil=Instr(sFormule,&quot;&quot;&quot;&quot;)
		if iPosAcc+iPosGuil&gt;0 then &apos;ne pas substituer à l&apos;intérieur d&apos;un commentaire ou d&apos;une formule déjà traitée
			if (iPosAcc&gt;0 and iPosGuil&gt;iPosAcc) or iPosGuil=0 then
				iNiveauAcc=1
				i=iPosAcc
				do while iNiveauAcc&gt;0
						i=i+1
						if i&gt;len(sFormule) then
							msgbox(&quot;Erreur d&apos;accolades !&quot;)
							stop
						end if
						sCaractere=Mid(sFormule,i,1)				
						if sCaractere=&quot;{&quot; then
							iNiveauAcc=iNiveauAcc+1
						end if
						if sCaractere=&quot;}&quot; then
							iNiveauAcc=iNiveauAcc-1
						end if
				loop
				SubstitutionsAvantTraitement=SubstitutionsAvantTraitement(left(sFormule,iPosAcc-1))+mid(sFormule,iPosAcc,i-iPosAcc+1)+SubstitutionsAvantTraitement(mid(sFormule,i+1))
				exit function
			else
				i=Instr(mid(sFormule,iPosGuil+1),&quot;&quot;&quot;&quot;)
				if i=0 then
					msgbox(&quot;Erreur de guillemets !&quot;)
					stop
				end if
				SubstitutionsAvantTraitement=SubstitutionsAvantTraitement(left(sFormule,iPosGuil-1))+mid(sFormule,iPosGuil,i+1)+SubstitutionsAvantTraitement(mid(sFormule,i+iPosGuil+1))
				exit function
			end if
		end if

		iPosCas=Instr(sFormule,&quot;cas(&quot;)
		if iPosCas&gt;0 then &apos;ne pas modifier l&apos;intérieur d&apos;une commande GIAC
			iNiveauPar=1
			i=iPosCas+3
			do while iNiveauPar&gt;0
				i=i+1
				if i&gt;len(sFormule) then
					msgbox(&quot;Erreur de parenthèsage !&quot;)
					stop
				end if
				sCaractere=Mid(sFormule,i,1)				
				if sCaractere=&quot;(&quot; then
					iNiveauPar=iNiveauPar+1
				end if
				if sCaractere=&quot;)&quot; then
					iNiveauPar=iNiveauPar-1
				end if
			loop
			SubstitutionsAvantTraitement=SubstitutionsAvantTraitement(left(sFormule,iPosCas-1))+mid(sFormule,iPosCas,i-iPosCas+1)+SubstitutionsAvantTraitement(mid(sFormule,i+1))
			exit function
		end if
		
		&apos; les substitutions peuvent commencer maintenant		
		sFormule=BugDu2x(sFormule)
		sFormule=SubstitutionVirgule(sFormule)
		&apos; substitutions mots-clé touche F8
&apos;		i=0
		i=Instr(sFormule,&quot;$&quot;)

&apos;		do while j&gt;i
			&apos;i=j
		if i&gt;0 then
			&apos; prise en charge des 2 caractères après $
			sSubstitution=sSubstitutionF8(mid(sFormule,i+1,2))
			if sSubstitution=&quot;&quot; then
				sSubstitution=&quot;{color red{&quot;&quot;??&quot;&quot;}}&quot;
			else
				&apos; enlever les {} qui encadrent les formules 
				&apos; les guillemets sont gardés pour que le contenu soit bien du texte dans la formule
				sSubstitution=EnleveAccolades(sSubstitution)
			end if
			sFormule=SubstitutionsAvantTraitement(left(sFormule,i-1))+sSubstitution+SubstitutionsAvantTraitement(mid(sFormule,i+3))
		else
		
			&apos;initialisation si besoin
			&apos;évite de définir n tableaux identiques lors des appels récursifs
			if UBound(sSearch())&lt;0 then
				sSearch() = Array( &quot;arcsin&quot;,&quot;arccos&quot;,&quot;arctan&quot;,&quot;arccot&quot;,&quot;arsinh&quot;,&quot;arcosh&quot;,&quot;artanh&quot;,&quot;arcoth&quot;,_
								&quot;cosh&quot;,&quot;sinh&quot;,&quot;tanh&quot;,&quot;coth&quot;,&quot;cos&quot;,&quot;sin&quot;,&quot;tan&quot;,&quot;cot&quot;,_
								&quot;argch&quot;,&quot;argsh&quot;,&quot;argth&quot;,&quot;ch&quot;,&quot;sh&quot;,&quot;th&quot;,_
								&quot;ln&quot;,&quot;e^&quot;,&quot;--&quot;,&quot;...&quot;,&quot;&lt;=&quot;,&quot;arg&quot;,&quot;card&quot;,_
								&quot;&gt;=&quot;,&quot;&lt;&gt;&quot;,&quot;==&quot;,&quot;|&quot;,&quot;^-&quot;,&quot;^+&quot;,&quot;=&quot;,&quot;&lt;&quot;,&quot;&gt;&quot;)
				sReplace() = Array(&quot; arcsin &quot;,&quot; arccos &quot;,&quot; arctan &quot;,&quot; arccot &quot;,&quot; arsinh &quot;,&quot;  arcosh &quot;,&quot; artanh &quot;,&quot; arcoth &quot;,_
								&quot; cosh &quot;,&quot; sinh &quot;,&quot; tanh &quot;,&quot; coth &quot;,&quot; cos &quot;,&quot; sin &quot;,&quot; tan &quot;,&quot; cot &quot;,_
								&quot; func argch &quot;,&quot; func argsh &quot;,&quot; func argth &quot;,&quot; func ch &quot;,&quot; func sh &quot;,&quot; func th &quot;,_
								&quot; ln &quot;,&quot; func e^&quot;,&quot;*rightarrow*&quot;,&quot; dotslow &quot;,&quot;**leslant**&quot;,&quot;&quot;&quot;arg&quot;&quot;&quot;,&quot;&quot;&quot;card&quot;&quot;&quot;,_
								&quot;**geslant**&quot;,&quot;**neq**&quot;,&quot;**equiv**&quot;,&quot;**divides**&quot;,&quot;^&quot;&quot;−&quot;&quot;&quot;,&quot;^&quot;&quot;+&quot;&quot;&quot;,&quot;**=**&quot;,&quot;**&lt;**&quot;,&quot;**&gt;**&quot;)
			end if
			For n = LBound(sSearch()) To UBound(sSearch())
				i=Instr(1,sFormule,sSearch(n),0)
				if i&gt;0 then
					sFormule=SubstitutionsAvantTraitement(left(sFormule,i-1))+sReplace(n)+SubstitutionsAvantTraitement(mid(sFormule,i+len(sSearch(n))))
					exit for
				end if
			Next n
		end if
	end if
	SubstitutionsAvantTraitement=sFormule
end function

Function EnleveAccolades(sFormule as string) as string
&apos; enlever les accolades qui encadrent les formules 
&apos; les guillemets sont gardés pour que le contenu soit bien du texte dans la formule
&apos; les {} sont remplacés par **
dim i as integer, j as integer
dim temp as string, sSymbole as string
dim iNiveauAcc as integer

temp=&quot;&quot;
i=inStr(sFormule,&quot;{&quot;)
j=0
do while i&gt;j
		&apos; rechercher la formule
		temp=temp+mid(sFormule,j+1,i-j-1)
		j=i
		iNiveauAcc=1
		do while iNiveauAcc&gt;0
			j=j+1
			if j&gt;len(sFormule) then
				sFormule=&quot;Erreur d&apos;accolades !&quot;
			else
				sSymbole=Mid(sFormule,j,1)				
				if sSymbole=&quot;{&quot; then
					iNiveauAcc=iNiveauAcc+1
				end if
				if sSymbole=&quot;}&quot; then
					iNiveauAcc=iNiveauAcc-1
				end if
			end if
		loop
		if j&lt;=len(sFormule) then
			&apos; pas d&apos;erreurs d&apos;accolades
			temp=temp+mid(sFormule,i+1,j-i-1)
			i=inStr(mid(sFormule,j+1),&quot;{&quot;)+j
		end if

loop
temp=temp+mid(sFormule,j+1)
j=0
i=Instr(temp,&quot;{}&quot;)
Do while i&gt;j
	temp=left(temp,i-1)+&quot;**&quot;+mid(temp,i+2)
	j=i+2
	i=j+Instr(mid(temp,j),&quot;{}&quot;)-1
loop

EnleveAccolades=temp
end Function



&apos;-------------------------------------------------------------------------------------------------------
sub SubstitutionsApresTraitement(sFormule as String) as String
	dim sSearchAfter() as string, sReplaceAfter() as string
	dim n as integer, i as integer
	
	sSearchAfter() = Array(&quot;;&quot;,&quot;  &quot;,&quot;*=*&quot;,&quot;*&lt;*&quot;,&quot;*&gt;*&quot;,&quot;*&lt;&gt;*&quot;)
	sReplaceAfter() = Array(&quot;{nitalic ;}&quot;,&quot; &quot;,&quot;=&quot;,&quot;&lt;&quot;,&quot;&gt;&quot;,&quot;&lt;&gt;&quot;)
	For n = LBound(sSearchAfter()) To UBound(sSearchAfter())
		i=Instr(sFormule,sSearchAfter(n))
		do while i&gt;0
			sFormule=left(sFormule,i-1)+sReplaceAfter(n)+mid(sFormule,i+len(sSearchAfter(n)))
			i=Instr(i+len(sReplaceAfter(n)),sFormule,sSearchAfter(n))
		loop
	Next n
	SubstitutionsApresTraitement=sFormule
end sub


</script:module>