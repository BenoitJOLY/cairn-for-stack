&apos;--------------------------------------------------------------------------------------
sub Vecteur
	dim oViewCursor as object, oTextCursor as object
	dim sPolice as string, iTaille as integer, sFormule as string
	dim sFormuleOOo as string, iNbCarac as integer
	dim Arbre as variant
    oViewCursor = ThisComponent.getCurrentController().getViewCursor()
	oTextCursor=oViewCursor.Text.createTextCursorByRange(oViewCursor)
    sPolice=oViewCursor.CharFontName
    iTaille=oViewCursor.Charheight
    
   	If oTextCursor.IsCollapsed() then
		&apos; les primes ne comptent pas comme un caractère (fonction vecteurs, etc...)
	   	iNbCarac=2
		sFormule=SelectionnerFormuleEnPassantPrimes(oTextCursor,iNbCarac)
		if left(sFormule,1)&lt;&quot;A&quot; and left(sFormule,1)&lt;&gt;&quot;$&quot; then
			oTextCursor.goRight(iNbCarac,False)
			sFormule=SelectionnerFormuleEnPassantPrimes(oTextCursor,1)
		end if
	else
			sFormule=SelectionnerFormule(oTextCursor,0)			
	end if
	sFormule=&quot;vec(&quot;+sFormule+&quot;)&quot;
	Arbre=cmath2arbre(sFormule)
	sFormuleOOo=arbre2OOo(Arbre)
	LitParametresFormules
    oFormule=InsereFormule(oTextCursor, sPolice, iTaille,oViewCursor.CharWeight=com.sun.star.awt.FontWeight.BOLD, sFormuleOOo, bModeTexte)
	oCurFormule=oFormule.Model
	if not(isNull(oCurFormule)) then
		ecrireTagFormule(oCurFormule,sFormule)
		ecrireTagArbre(oCurFormule,arbre2chaine(Arbre))
	endif
end sub

