function bEstCeSigne(char as String) as boolean
	&apos; si char est une de ces opérations, alors ne pas traiter la somme ou la différence
	bEstCeSigne=(InStr(&quot;+-*/=&quot;&amp;&quot;&gt;&quot;&amp;&quot;&lt;&quot;&amp;&quot;&amp;&quot;&amp;&quot;|&quot;&amp;&quot;~&quot;&amp;&quot;^&quot;&amp;&quot;_&quot;&amp;&quot;\&quot;,char)&gt;0)
end function

