	oDialog=oEvt.Source.Context
	sName=oEvt.Source.Model.Name
	select case sName
	case &quot;ComboBoxPolices&quot;
		sPolice=oDialog.Model.ComboBoxPolices.Text
	case &quot;ScrollBarTaille&quot;
		iTaille=oEvt.Source.Model.ScrollValue
		oDialog.Model.TextFieldTaille.Text=ltrim(str(iTaille))	
	case &quot;TextFieldTaille&quot;
		if val(oDialog.Model.TextFieldTaille.Text)&lt;&gt;0 then iTaille=val(oDialog.Model.TextFieldTaille.Text)
