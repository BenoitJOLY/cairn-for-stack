function maj_image(oEvt as variant) as boolean
	dim oControl as object
   	dim sControl as string
   	oControl=oEvt.source.Model
   	sControl=oControl.Name
   	select case sControl
   	case &quot;TextFieldEspacement&quot;, &quot;ScrollBarEspacement&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/espacement.1.png&quot;
   	case &quot;TextFieldInterligne&quot;, &quot;ScrollBarInterligne&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/espacement.2.png&quot;   	
   	case &quot;TextFieldEspRacine&quot;, &quot;ScrollBarEspRacine&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/espacement.3.png&quot;   	

   	case &quot;TextFieldMargeGauche&quot;, &quot;ScrollBarMargeGauche&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/bordures.1.png&quot;   	
   	case &quot;TextFieldMargeDroite&quot;, &quot;ScrollBarMargeDroite&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/bordures.2.png&quot;   	
   	case &quot;TextFieldMargeHaute&quot;, &quot;ScrollBarMargeHaute&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/bordures.3.png&quot;   	
   	case &quot;TextFieldMargeBasse&quot;, &quot;ScrollBarMargeBasse&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/bordures.4.png&quot;   	

   	case &quot;TextFieldIndexSup&quot;, &quot;ScrollBarIndexSup&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/index.1.png&quot;
   	case &quot;TextFieldIndexSub&quot;, &quot;ScrollBarIndexSub&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/index.2.png&quot;   	

   	case &quot;TextFieldHauteurNumerateur&quot;, &quot;ScrollBarHauteurNumerateur&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/fractions.1.png&quot;
   	case &quot;TextFieldProfondeurDenominateur&quot;, &quot;ScrollBarProfondeurDenominateur&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/fractions.2.png&quot;
   	case &quot;TextFieldLongueurExcessive&quot;, &quot;ScrollBarLongueurExcessive&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/fractions.3.png&quot;
   	case &quot;TextFieldEpaisseurTrait&quot;, &quot;ScrollBarEpaisseurTrait&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/fractions.4.png&quot;

   	case &quot;TextFieldHauteurMaxi&quot;, &quot;ScrollBarHauteurMaxi&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/limites.1.png&quot;
   	case &quot;TextFieldHauteurMini&quot;, &quot;ScrollBarHauteurMini&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/limites.2.png&quot;

   	case &quot;TextFieldDepassementLateral&quot;, &quot;ScrollBarDepassementLateral&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/parentheses.1.png&quot;
   	case &quot;TextFieldEspacementParentheses&quot;, &quot;ScrollBarEspacementParentheses&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/parentheses.2.png&quot;
   	case &quot;CheckBoxAjusterParentheses&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/parentheses.1.png&quot;
   	case &quot;TextFieldDepassement&quot;, &quot;ScrollBarDepassement&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/parentheses.1.png&quot;

   	case &quot;TextFieldHauteurPrimaire&quot;, &quot;ScrollBarHauteurPrimaire&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/symboles.1.png&quot;
   	case &quot;TextFieldEspaceMinimum&quot;, &quot;ScrollBarEspaceMinimum&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/symboles.2.png&quot;
		
   	case &quot;TextFieldDepassementOperateur&quot;, &quot;ScrollBarDepassementOperateur&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/operateurs.1.png&quot;
   	case &quot;TextFieldEspacementOperateur&quot;, &quot;ScrollBarEspacementOperateur&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/operateurs.2.png&quot;
		
   	case &quot;TextFieldInterligneMatrice&quot;, &quot;ScrollBarInterligneMatrice&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/matrices.1.png&quot;
   	case &quot;TextFieldEspacementMatrice&quot;, &quot;ScrollBarEspacementMatrice&quot;
		oImage.ImageUrl=sCheminCmathOOo+&quot;Images/matrices.2.png&quot;

   	end select
	maj_image=true
end function




