sub LitParametresFormule(oFormule as object)
&apos; lit les paramètres de la formule sélectionnée
  	bAjusterParentheses=oFormule.IsScaleAllBrackets
   	iMargeGauche=oFormule.LeftMargin
 	iMargeDroite=oFormule.RightMargin
 	iMargeBasse=oFormule.BottomMargin
 	iMargeHaute=oFormule.TopMargin
	iEspacement=oFormule.RelativeSpacing
	iInterligne=oFormule.RelativeLineSpacing
	iEspRacine=oFormule.RelativeRootSpacing
	iIndexSub=oFormule.RelativeIndexSubscript
	iIndexSup=oFormule.RelativeIndexSuperscript
	iHauteurNumerateur=oFormule.RelativeFractionNumeratorHeight
	iProfondeurDenominateur=oFormule.RelativeFractionDenominatorDepth
	iLongueurExcessive=oFormule.RelativeFractionBarExcessLength
	iEpaisseurTrait=oFormule.RelativeFractionBarLineWeight
	iHauteurMaxi=oFormule.RelativeUpperLimitDistance
	iHauteurMini=oFormule.RelativeLowerLimitDistance
	iDepassementLateral=oFormule.RelativeBracketExcessSize
	iEspacementParentheses=oFormule.RelativeBracketDistance
	iDepassement=oFormule.RelativeScaleBracketExcessSize
	iHauteurPrimaire=oFormule.RelativeSymbolPrimaryHeight
	iEspaceMinimum=oFormule.RelativeSymbolMinimumHeight
	iDepassementOperateur=oFormule.RelativeOperatorExcessSize
	iEspacementOperateur=oFormule.RelativeOperatorSpacing
	iInterligneMatrice=oFormule.RelativeMatrixLineSpacing
	iEspacementMatrice=oFormule.RelativeMatrixColumnSpacing
  	sPolice=oFormule.FontNameVariables    
   	iTaille=oFormule.BaseFontHeight
  	bGras=oFormule.FontVariablesIsBold
  	bModeTexte=oFormule.IsTextMode
  	sTexteFormule=oFormule.formula
end sub


sub LitParametresFormules
	&apos; lit les paramètres des formules définis par l&apos;utilisateur
	Dim sChemin as String, sUrl as string, Resultat as object
	Dim mgr as Object, AddinCAS as Object
    if bParametresInitialises=false then
    	&apos; recharger les paramètres de l&apos;utilisateur
		sSymbolMultiplication=mParams.LitParametre(&quot;sSymbolMultiplication&quot;)
		if sSymbolMultiplication=&quot;&quot; then
			&apos; jamais défini, les initialiser par défaut
			ParametresFormulesParDefaut
		else
			iMargeGauche=val(mParams.LitParametre(&quot;iMargeGauche&quot;))
			iMargeDroite=val(mParams.LitParametre(&quot;iMargeDroite&quot;))
			iMargeHaute=val(mParams.LitParametre(&quot;iMargeHaute&quot;))
			iMargeBasse=val(mParams.LitParametre(&quot;iMargeBasse&quot;))
			iEspacement=val(mParams.LitParametre(&quot;iEspacement&quot;))
			iInterligne=val(mParams.LitParametre(&quot;iInterligne&quot;))
			iEspRacine=val(mParams.LitParametre(&quot;iEspRacine&quot;))
			iIndexSub=val(mParams.LitParametre(&quot;iIndexSub&quot;))
			iIndexSup=val(mParams.LitParametre(&quot;iIndexSup&quot;))
			iHauteurNumerateur=val(mParams.LitParametre(&quot;iHauteurNumerateur&quot;))
			iProfondeurDenominateur=val(mParams.LitParametre(&quot;iProfondeurDenominateur&quot;))
			iLongueurExcessive=val(mParams.LitParametre(&quot;iLongueurExcessive&quot;))
			iEpaisseurTrait=val(mParams.LitParametre(&quot;iEpaisseurTrait&quot;))
			iHauteurMaxi=val(mParams.LitParametre(&quot;iHauteurMaxi&quot;))
			iHauteurMini=val(mParams.LitParametre(&quot;iHauteurMini&quot;))
			iDepassementLateral=val(mParams.LitParametre(&quot;iDepassementLateral&quot;))
			iEspacementParentheses=val(mParams.LitParametre(&quot;iEspacementParentheses&quot;))
			if mParams.LitParametre(&quot;bAjusterParentheses&quot;)=&quot;false&quot; then
				bAjusterParentheses=false
			else
				bAjusterParentheses=true
			endif
			iDepassement=val(mParams.LitParametre(&quot;iDepassement&quot;))
			iHauteurPrimaire=val(mParams.LitParametre(&quot;iHauteurPrimaire&quot;))
			iEspaceMinimum=val(mParams.LitParametre(&quot;iEspaceMinimum&quot;))
			iDepassementOperateur=val(mParams.LitParametre(&quot;iDepassementOperateur&quot;))
			iEspacementOperateur=val(mParams.LitParametre(&quot;iEspacementOperateur&quot;))
			iInterligneMatrice=val(mParams.LitParametre(&quot;iInterligneMatrice&quot;))
			iEspacementMatrice=val(mParams.LitParametre(&quot;iEspacementMatrice&quot;))
			if mParams.LitParametre(&quot;bBornesIntegralesVerticales&quot;)=&quot;true&quot; then
				bBornesIntegralesVerticales=true
			else
				bBornesIntegralesVerticales=false
			endif		
			if mParams.LitParametre(&quot;bMajDroite&quot;)=&quot;false&quot; then
				bMajDroite=false
			else
				bMajDroite=true
			endif
			if mParams.LitParametre(&quot;biComplexe&quot;)=&quot;false&quot; then
				biComplexe=false
			else
				biComplexe=true
			endif			
			if mParams.LitParametre(&quot;beExpo&quot;)=&quot;false&quot; then
				beExpo=false
			else
				beExpo=true
			endif			

		endif
		&apos; chargement de l&apos;aide Giac, nécessaire pour reconnaitre les commandes Giac
		&apos; et les synonymes
		on error goto PasCmathOOoCAS
		BasicLibraries.LoadLibrary(&quot;CmathOOoCAS&quot;)
		&apos;wait 500
		sUrl=mCalc.fCheminCmathOOoCAS()+&quot;Giac/&quot;
		sChemin=convertFromUrl(sUrl)
		mgr=getProcessServiceManager()
		AddinCAS=mgr.createInstance(&quot;CmathOOo.CAS&quot;)
		langue=thisComponent.CharLocale.Language
		&apos; english par défaut
		if langue=&quot;&quot; then langue=&quot;en&quot;
		Resultat=AddinCAS.cas1(Array(sChemin,langue))
		PasCmathOOoCAS:
		on error goto 0
		bParametresInitialises=true
	endif    
end sub


sub AffecteParametresFormule(oFormule as object, sPolice as string, iTaille as integer, bGras as boolean, sFormule as string, bModeTexte as boolean)
	dim sTags as string
	dim i as integer
	&apos; sauvegarder les Tags
	i=instr(oFormule.formula,&quot;%%&quot;)
	if i&gt;0 then
		sTags=mid(oFormule.formula,i)
	endif
  	oFormule.FontNameVariables=sPolice    
   	oFormule.FontNameNumbers=sPolice
  	oFormule.FontNameText=sPolice
  	oFormule.FontNameFunctions=sPolice
  	oFormule.FontVariablesIsItalic=true
   	oFormule.BaseFontHeight=iTaille
	if GetGuiType()=3 then &apos;Mac
		oFormule.CustomFontNameSans=&quot;Cmath Calligraphique&quot;
	   	oFormule.CustomFontNameSerif=&quot;Cmath Script&quot;
	   	oFormule.CustomFontNameFixed=&quot;Courier New&quot;
  	else
		oFormule.CustomFontNameSans=&quot;Cmathcal&quot;
	   	oFormule.CustomFontNameSerif=&quot;Cmathscr&quot;
	   	oFormule.CustomFontNameFixed=&quot;Courier New&quot;	   	
  	end if
  	oFormule.IsScaleAllBrackets=bAjusterParentheses
  	oFormule.IsTextMode=bModeTexte
   	oFormule.LeftMargin=iMargeGauche
 	oFormule.RightMargin=iMargeDroite
 	oFormule.BottomMargin=iMargeBasse
 	oFormule.TopMargin=iMargeHaute
	oFormule.RelativeSpacing=iEspacement
	oFormule.RelativeLineSpacing=iInterligne
	oFormule.RelativeRootSpacing=iEspRacine
	oFormule.RelativeIndexSubscript=iIndexSub
	oFormule.RelativeIndexSuperscript=iIndexSup
	oFormule.RelativeFractionNumeratorHeight=iHauteurNumerateur
	oFormule.RelativeFractionDenominatorDepth=iProfondeurDenominateur
	oFormule.RelativeFractionBarExcessLength=iLongueurExcessive
	oFormule.RelativeFractionBarLineWeight=iEpaisseurTrait
	oFormule.RelativeLowerLimitDistance=iHauteurMini
	oFormule.RelativeUpperLimitDistance=iHauteurMaxi
	oFormule.RelativeBracketExcessSize=iDepassementLateral
	oFormule.RelativeBracketDistance=iEspacementParentheses
	oFormule.RelativeScaleBracketExcessSize=iDepassement
	oFormule.RelativeSymbolPrimaryHeight=iHauteurPrimaire
	oFormule.RelativeSymbolMinimumHeight=iEspaceMinimum
	oFormule.RelativeOperatorExcessSize=iDepassementOperateur
	oFormule.RelativeOperatorSpacing=iEspacementOperateur
	oFormule.RelativeMatrixLineSpacing=iInterligneMatrice
	oFormule.RelativeMatrixColumnSpacing=iEspacementMatrice
  	oFormule.FontFixedIsBold=bGras
  	oFormule.FontSansIsBold=bGras
  	oFormule.FontSerifIsBold=bGras
  	oFormule.FontFunctionsIsBold=bGras
  	oFormule.FontNumbersIsBold=bGras
  	oFormule.FontTextIsBold=bGras
  	oFormule.FontVariablesIsBold=bGras 
  	if i&gt;0 then sFormule=sFormule+sTags
  	oFormule.formula=sFormule
  	oFormule.setmodified(TRUE)	
end sub


Function SortedFontDescriptors(oDoc, bDuplicates As Boolean)
  Dim oWindow          &apos;Container window AWT XDevice interface.
  Dim oFonts()         &apos;Array of awt FontDescriptor structures.
  Dim oFinalFonts()    &apos;Font descriptors to return.
  Dim nIndex() As Long &apos;Indirect sorted index into.
  Dim sName$           &apos;Font name.
  Dim i&amp;               &apos;General index variable.
  Dim j&amp;               &apos;General index variable.
  Dim n&amp;               &apos;General utility variable.
  Dim k&amp;               &apos;General utility variable.
  Dim bChanged As Boolean

  oWindow  = oDoc.getCurrentController().getFrame().getContainerWindow()
  oFonts() = oWindow.getFontDescriptors()
  ReDim nIndex(UBound(oFonts()))
  n = UBound(oFonts())
  REM First, obtain an index into the unique values.
  For i = 0 to n
    nIndex(i) = i
  Next

  REM Sort the data!
  For i = 0 To n-1
    bChanged = False
    For j = 1 To n-i
      If oFonts(nIndex(j-1)).Name &gt; oFonts(nIndex(j)).Name Then
        k = nIndex(j-1)
        nIndex(j-1) = nIndex(j)
        nIndex(j) = k
        bChanged = True
      End If
    Next
    If NOT bChanged Then Exit For
  Next

  REM Copy the font descriptor.
  sName = &quot;&quot;
  oFinalFonts() = DimArray(n)
  j = -1
  For i = 0 To n
    If bDuplicates OR (sName &lt;&gt; oFonts(nIndex(i)).Name) Then
      j = j + 1
      oFinalFonts(j) = oFonts(nIndex(i))
      sName = oFinalFonts(j).Name
    End If
  Next
  REM Bug alert, if I do NOT perform a ReDim Preserve, then the returned 
  REM value is Empty; even if the array does not change in size.
  ReDim Preserve oFinalFonts(j)
  SortedFontDescriptors = oFinalFonts()
End Function
</script:module>