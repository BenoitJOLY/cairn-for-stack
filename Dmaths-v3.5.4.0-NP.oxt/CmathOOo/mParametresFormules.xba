sub test
 dim obj as object, oLesObjets as object, oLaFormule as object
 dim nbOjets as integer, i as integer, iTopMargin as integer

 oLesObjets=ThisComponent.getEmbeddedObjects
 a=oLesObjets.hasByName(&quot;Objet5&quot;)
 oLaFormule=oLesObjets.getByName(&quot;Objet5&quot;)
 resultgetElementNames=oLesObjets.getElementNames() 
 nbObjets=oLesObjets.count-1
 for i=0 to nbObjets
	oLaFormule=oLesObjets(i)

	if oLaFormule.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
		if oLaFormule.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
	        &apos;sTexteFormule =  oLaFormule.Model.Formula
	        iTopMargin=oLaFormule.Model.TopMargin
	        oLaFormule.Model.TopMargin=iTopMargin+1
	        oLaFormule.Model.TopMargin=0
	        oLaFormule.Model.BottomMargin=5
		endif
	endif
 next i	

end sub

Sub forceAlignement
 dim obj as object, oLesObjets as object, oLaFormule as object
 dim nbOjets as integer, i as integer, iTopMargin as integer
 if OOoVersion()&lt;3.4 then
	msgbox(&quot;Possible uniquement à partir de OOo version 3.4&quot;)
 	exit sub
 endif
 obj=ThisComponent.createInstance(&quot;com.sun.star.document.Settings&quot;)
 obj.MathBaselineAlignment=true
 oLesObjets=ThisComponent.getEmbeddedObjects
 nbObjets=oLesObjets.count-1
 for i=0 to nbObjets
	oLaFormule=oLesObjets(i)
	if oLaFormule.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
		a=oLaFormule.Model &apos; ne sert à rien mais contourne un bug : la propriété  embeddedObject vaut Null au premier appel si bcp d&apos;équations à la suite
		if oLaFormule.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
	        &apos;sTexteFormule =  oLaFormule.Model.Formula
	        iTopMargin=oLaFormule.Model.TopMargin
	        oLaFormule.Model.TopMargin=iTopMargin+1
	        oLaFormule.Model.TopMargin=0
	        oLaFormule.Model.BottomMargin=5
			oLaFormule.ExtendedControlOverEmbeddedObject.update()
		endif
	endif
 next i	
End sub

sub forceAlignement2 &apos; gardée au cas où
 dim obj as object, oLesObjets as object, oLaFormule as object, oTextCursor as object, oFormuleAlignee as object
 dim nbOjets as integer, i as integer, indexFormule as integer
 if OOoVersion()&lt;3.4 then
	msgbox(&quot;Possible uniquement à partir de OOo version 3.4&quot;)
 	exit sub
 endif
 obj=ThisComponent.createInstance(&quot;com.sun.star.document.Settings&quot;)
 obj.MathBaselineAlignment=true
 oTextCursor=thisComponent.Text.createTextCursor
 &apos;LitParametresFormules
 oLesObjets=ThisComponent.getEmbeddedObjects
 nbObjets=oLesObjets.count-1
 indexFormule=0
 for i=0 to nbObjets
	oLaFormule=oLesObjets(indexFormule)
	if oLaFormule.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
		if oLaFormule.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
       		LitParametresFormule(oCurFormule)
			oPosFormule=oLaFormule.getAnchor().getEnd()
			oTextCursor = oLaFormule.getAnchor().getText().createTextCursorByRange(oPosFormule)
			oLaFormule.dispose
			indexFormule=indexFormule-1
			&apos;thisComponent.Text.insertString(oTextCursor,&quot;Formule alignée :&quot;,false)
			oFormuleAlignee=InsereFormule(oTextCursor, sPolice, iTaille, bGras, sTexteFormule, bModeTexte)
			&apos; todo : voir si encadrement
		endif
	endif
	indexFormule=indexFormule+1
 next i	
 bParametresInitialises=false
end sub


Sub AffecteFormule
	dim oPgb as object, oLesObjets as object
	dim oViewCursor as object, oTextCursor as object
	dim sSymbole as string, sMonEnum() as string
	dim iNombreMax as integer, iCas as integer, i as integer, compte as integer
	dim sDescriptionsPolices() as variant, sNomsPolices() as string
	&apos;dim exitOK as integer
	
	&apos;exitOK=com.sun.star.ui.dialogs.ExecutableDialogResults.OK
	oLaFormule=ThisComponent.getCurrentSelection()
	if oLaFormule.getImplementationName = &quot;SwXTextEmbeddedObject&quot; then
		&apos; une seule formule sélectionnée
		litParametresFormule(oLaFormule.Model)
		&apos;sPolice=oLaFormule.Model.FontNameVariables
		&apos;iTaille=oLaFormule.Model.BaseFontHeight
	  	&apos;bModeTexte=oLaFormule.Model.IsTextMode
	  	&apos;bGras=oLaFormule.Model.FontFunctionsIsBold
		&apos;sTexteFormule=oLaFormule.Model.formula
		bFormuleSelectionnee=true
	else
		&apos; prendre les paramètres utilisateur
	    oViewCursor = ThisComponent.getCurrentController().getViewCursor()
		oTextCursor=oViewCursor.Text.createTextCursorByRange(oViewCursor)
		sPolice=oTextCursor.CharFontName
		iTaille=oTextCursor.CharHeight
		bGras=False
		LitParametresFormules
	end if
	DialogLibraries.LoadLibrary(&quot;CmathOOo&quot;)
	oDialogParametresFormules = CreateUnoDialog( DialogLibraries.CmathOOo.DialogParametresFormules)
	oDialogParametresFormules.Model.Step=1
	sDescriptionsPolices=SortedFontDescriptors(ThisComponent,false)
	redim sNomsPolices(ubound(sDescriptionsPolices)) as string
	for i=0 to ubound(sDescriptionsPolices)
		sNomsPolices(i)=sDescriptionsPolices(i).Name
	next i
	oDialogParametresFormules.Model.ComboBoxPolices.StringItemList=sNomsPolices
	oDialogParametresFormules.Model.ComboBoxPolices.Text=sPolice

	BasicLibraries.LoadLibrary(&quot;CmInstall&quot;)
	sCheminCmathOOo=CmInstall.AboutCmathOOo.fCheminCmathOOo()
	oImage = oDialogParametresFormules.Model.ImageControlParam
	oImage.ScaleImage=false
	oImage.ImageUrl=sCheminCmathOOo+&quot;Images/espacement.1.png&quot;
	
	oDialogParametresFormules.Model.TextFieldTaille.Text=iTaille
	oDialogParametresFormules.Model.ScrollBarTaille.ScrollValueMin=1
	oDialogParametresFormules.Model.ScrollBarTaille.ScrollValueMax=30
	oDialogParametresFormules.Model.ScrollBarTaille.ScrollValue=iTaille
		
	oDialogParametresFormules.Model.ScrollBarEspacement.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarEspacement.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarEspacement.ScrollValue=iEspacement
	oDialogParametresFormules.Model.TextFieldEspacement.Text=ltrim(str(iEspacement))

	oDialogParametresFormules.Model.ScrollBarInterligne.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarInterligne.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarInterligne.ScrollValue=iInterligne
	oDialogParametresFormules.Model.TextFieldInterligne.Text=ltrim(str(iInterligne))

	oDialogParametresFormules.Model.ScrollBarEspRacine.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarEspRacine.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarEspRacine.ScrollValue=iEspRacine
	oDialogParametresFormules.Model.TextFieldEspRacine.Text=ltrim(str(iEspRacine))

	oDialogParametresFormules.Model.ScrollBarMargeDroite.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarMargeDroite.ScrollValueMax=200
	oDialogParametresFormules.Model.ScrollBarMargeDroite.ScrollValue=iMargeDroite
	oDialogParametresFormules.Model.TextFieldMargeDroite.Text=ltrim(str(iMargeDroite))
		
	oDialogParametresFormules.Model.ScrollBarMargeGauche.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarMargeGauche.ScrollValueMax=200
	oDialogParametresFormules.Model.ScrollBarMargeGauche.ScrollValue=iMargeGauche
	oDialogParametresFormules.Model.TextFieldMargeGauche.Text=ltrim(str(iMargeGauche))

	oDialogParametresFormules.Model.ScrollBarMargeHaute.ScrollValueMax=200
	oDialogParametresFormules.Model.ScrollBarMargeHaute.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarMargeHaute.ScrollValue=iMargeHaute
	oDialogParametresFormules.Model.TextFieldMargeHaute.Text=ltrim(str(iMargeHaute))

	oDialogParametresFormules.Model.ScrollBarMargeBasse.ScrollValueMax=200
	oDialogParametresFormules.Model.ScrollBarMargeBasse.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarMargeBasse.ScrollValue=iMargeBasse
	oDialogParametresFormules.Model.TextFieldMargeBasse.Text=ltrim(str(iMargeBasse))

	oDialogParametresFormules.Model.ScrollBarIndexSup.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarIndexSup.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarIndexSup.ScrollValue=iIndexSup
	oDialogParametresFormules.Model.TextFieldIndexSup.Text=ltrim(str(iIndexSup))

	oDialogParametresFormules.Model.ScrollBarIndexSub.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarIndexSub.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarIndexSub.ScrollValue=iIndexSub
	oDialogParametresFormules.Model.TextFieldIndexSub.Text=ltrim(str(iIndexSub))

	oDialogParametresFormules.Model.ScrollBarHauteurNumerateur.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarHauteurNumerateur.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarHauteurNumerateur.ScrollValue=iHauteurNumerateur
	oDialogParametresFormules.Model.TextFieldHauteurNumerateur.Text=ltrim(str(iHauteurNumerateur))

	oDialogParametresFormules.Model.ScrollBarProfondeurDenominateur.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarProfondeurDenominateur.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarProfondeurDenominateur.ScrollValue=iProfondeurDenominateur
	oDialogParametresFormules.Model.TextFieldProfondeurDenominateur.Text=ltrim(str(iProfondeurDenominateur))

	oDialogParametresFormules.Model.ScrollBarLongueurExcessive.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarLongueurExcessive.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarLongueurExcessive.ScrollValue=iLongueurExcessive
	oDialogParametresFormules.Model.TextFieldLongueurExcessive.Text=ltrim(str(iLongueurExcessive))

	oDialogParametresFormules.Model.ScrollBarEpaisseurTrait.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarEpaisseurTrait.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarEpaisseurTrait.ScrollValue=iEpaisseurTrait
	oDialogParametresFormules.Model.TextFieldEpaisseurTrait.Text=ltrim(str(iEpaisseurTrait))

	oDialogParametresFormules.Model.ScrollBarHauteurMaxi.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarHauteurMaxi.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarHauteurMaxi.ScrollValue=iHauteurMaxi
	oDialogParametresFormules.Model.TextFieldHauteurMaxi.Text=ltrim(str(iHauteurMaxi))

	oDialogParametresFormules.Model.ScrollBarHauteurMini.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarHauteurMini.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarHauteurMini.ScrollValue=iHauteurMini
	oDialogParametresFormules.Model.TextFieldHauteurMini.Text=ltrim(str(iHauteurMini))

	oDialogParametresFormules.Model.ScrollBarDepassementLateral.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarDepassementLateral.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarDepassementLateral.ScrollValue=iDepassementLateral
	oDialogParametresFormules.Model.TextFieldDepassementLateral.Text=ltrim(str(iDepassementLateral))

	oDialogParametresFormules.Model.ScrollBarEspacementParentheses.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarEspacementParentheses.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarEspacementParentheses.ScrollValue=iEspacementParentheses
	oDialogParametresFormules.Model.TextFieldEspacementParentheses.Text=ltrim(str(iEspacementParentheses))

	if bAjusterParentheses=false then
		oDialogParametresFormules.Model.CheckBoxAjusterParentheses.State=0
	else
		oDialogParametresFormules.Model.CheckBoxAjusterParentheses.State=1
	endif

	oDialogParametresFormules.Model.ScrollBarDepassement.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarDepassement.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarDepassement.ScrollValue=iDepassement
	oDialogParametresFormules.Model.TextFieldDepassement.Text=ltrim(str(iDepassement))

	oDialogParametresFormules.Model.ScrollBarHauteurPrimaire.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarHauteurPrimaire.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarHauteurPrimaire.ScrollValue=iHauteurPrimaire
	oDialogParametresFormules.Model.TextFieldHauteurPrimaire.Text=ltrim(str(iHauteurPrimaire))

	oDialogParametresFormules.Model.ScrollBarEspaceMinimum.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarEspaceMinimum.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarEspaceMinimum.ScrollValue=iEspaceMinimum
	oDialogParametresFormules.Model.TextFieldEspaceMinimum.Text=ltrim(str(iEspaceMinimum))

	oDialogParametresFormules.Model.ScrollBarDepassementOperateur.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarDepassementOperateur.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarDepassementOperateur.ScrollValue=iDepassementOperateur
	oDialogParametresFormules.Model.TextFieldDepassementOperateur.Text=ltrim(str(iDepassementOperateur))

	oDialogParametresFormules.Model.ScrollBarEspacementOperateur.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarEspacementOperateur.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarEspacementOperateur.ScrollValue=iEspacementOperateur
	oDialogParametresFormules.Model.TextFieldEspacementOperateur.Text=ltrim(str(iEspacementOperateur))

	oDialogParametresFormules.Model.ScrollBarInterligneMatrice.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarInterligneMatrice.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarInterligneMatrice.ScrollValue=iInterligneMatrice
	oDialogParametresFormules.Model.TextFieldInterligneMatrice.Text=ltrim(str(iInterligneMatrice))

	oDialogParametresFormules.Model.ScrollBarEspacementMatrice.ScrollValueMax=100
	oDialogParametresFormules.Model.ScrollBarEspacementMatrice.ScrollValueMin=0
	oDialogParametresFormules.Model.ScrollBarEspacementMatrice.ScrollValue=iEspacementMatrice
	oDialogParametresFormules.Model.TextFieldEspacementMatrice.Text=ltrim(str(iEspacementMatrice))
	
	select case sSymbolMultiplication
	case &quot; &quot;
		oDialogParametresFormules.Model.OptionButtonAucun.State=1
	case &quot; cdot &quot;
		oDialogParametresFormules.Model.OptionButtonPoint.State=1
	case &quot; times &quot;
		oDialogParametresFormules.Model.OptionButtonCroix.State=1	
	end select
	
	if bGras=false then
		oDialogParametresFormules.Model.CheckBoxGras.State=0
	else
		oDialogParametresFormules.Model.CheckBoxGras.State=1
	endif
	
	if bBornesIntegralesVerticales=true then
		oDialogParametresFormules.Model.OptionButtonVerticale.State=1
	else
		oDialogParametresFormules.Model.OptionButtonDroite.State=1	
	endif


	if bMajDroite=true then
		oDialogParametresFormules.Model.OptionButtonDroit.State=1
	else
		oDialogParametresFormules.Model.OptionButtonItalique.State=1	
	endif

	if biComplexe=true then
		oDialogParametresFormules.Model.OptionButtonComplexe.State=1
	else
		oDialogParametresFormules.Model.OptionButtonIVariable.State=1	
	endif
	
	if beExpo=true then
		oDialogParametresFormules.Model.OptionButtoneExpo.State=1
	else
		oDialogParametresFormules.Model.OptionButtoneVariable.State=1	
	endif
	

	
	&apos;if bFormuleSelectionnee=true then
	&apos;	oDialogParametresFormules.Model.LabelIntro.Label=&quot;Choisissez les paramètres de la formule sélectionnée. &quot; &amp; chr(13) &amp;_
	&apos;		&quot;Après chaque modification de l&apos;une des valeurs, la formule se modifie dans le document.&quot;
	&apos;else
	&apos;	oDialogParametresFormules.Model.LabelIntro.Label=&quot;Choisissez les paramètres des formules. &quot; &amp; chr(13) &amp;_
	&apos;		&quot;Les modifications seront appliquées après la fermeture de cette boîte de dialogue.&quot;	
	&apos;end if
	if not(IsNull(StarDesktop.CurrentFrame)) then
		parentSize=StarDesktop.CurrentFrame.ComponentWindow.Size
		Xpos=(parentSize.Width)-(oDialogParametresFormules.Size.Width)
		Ypos=0
	else
		Xpos=0
		Ypos=0
	end if
	oDialogParametresFormules.setPosSize(Xpos,Ypos,0,0,com.sun.star.awt.PosSize.POS)
	oDialogParametresFormules.Execute()
end sub
	


sub applique_params
	dim iCas as integer
	dim sTagArbre as string 
	dim sTagFormule as string
	iTaille=val(oDialogParametresFormules.Model.TextFieldTaille.Text)
	sPolice=oDialogParametresFormules.Model.ComboBoxPolices.Text
	if IsNumeric(iTaille) then
		if IsNull(oLaFormule) then
			Message=&quot;Le redimensionnement ne fonctionne pas sur un nouveau document&quot;+chr(10)
			message=message+&quot;Veuillez enregistrer, quitter et réouvrir votre document&quot;+chr(10)
			message=message+chr(10)+&quot;Désolé&quot;
			msgbox message,64,&quot;problème ...&quot;
			exit sub
		endif
		if oLaFormule.getImplementationName = &quot;SwXTextEmbeddedObject&quot; then
		&apos;	un objet seul est selectionné
			iCas=1
			&apos; appliquer sur tout le document
			oLaFormule=Thiscomponent
		else
			if thiscomponent.getcurrentcontroller.viewcursor.iscollapsed then
				iCas=2 &apos;rien selectionné on applique à tout
				oLaFormule=Thiscomponent
			else
				iCas=3 &apos;portion selectionnée
				oLaFormule=oLaFormule.getbyIndex(0)
				sMonEnum=oLaFormule.getAvailableServiceNames
				oLesObjets=oLaFormule.createContentEnumeration(sMonEnum(0))
			endif
		endif
		&apos;mise en place barre de progression
		iNombreMax=Thiscomponent.drawpage.count
		oPgb=Thiscomponent.currentcontroller.statusIndicator
		oPgb.Start (&quot;Paramétrage en cours ...&quot;,iNombreMax)
		oPgb.value=0
		
		select case iCas
		
			&apos;case 1:
				&apos; ne rien faire, les modifs ont été appliquées en temps réel
			
				&apos;if oLaFormule.embeddedObject.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then 
				&apos;	sTexteFormule=oLaFormule.embeddedobject.formula
				&apos;	&apos;oLaFormule.embeddedobject.formula=&quot;&quot;
				&apos;	oLaFormule.embeddedobject.BaseFontHeight=iTaille
				 &apos; 	oLaFormule.EmbeddedObject.FontNameVariables=sPolice
				 &apos; 	oLaFormule.EmbeddedObject.FontVariablesIsItalic=true
				 &apos; 	oLaFormule.EmbeddedObject.FontNameNumbers=sPolice
				 &apos; 	oLaFormule.EmbeddedObject.FontNameText=sPolice
				 &apos; 	oLaFormule.EmbeddedObject.FontNameFunctions=sPolice
				 &apos; 	oLaFormule.embeddedobject.RelativeSpacing=iEspacement
				&apos;	oLaFormule.embeddedobject.LeftMargin=iMargeGauche
				&apos;	oLaFormule.embeddedobject.RightMargin=iMargeDroite	  	
				&apos;	oLaFormule.embeddedobject.formula=sTexteFormule
				&apos;	oLaFormule.embeddedObject.setmodified(true)
				&apos;endif	
			case 1,2:
				oLesObjets=oLaFormule.getEmbeddedObjects
				for i=0 to oLesObjets.count-1
					oPgb.value=i
					oLaFormule=oLesObjets(i)
					if oLaFormule.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
						a=oLaFormule.Model &apos; ne sert à rien mais contourne un bug : la propriété Model vaut Null au premier appel si bcp d&apos;équations à la suite
						if oLaFormule.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
							&apos;EncadrerFormule(oLaFormule)
							&apos; voir si le tag arbre est présent pour affecter le symboleMultiplié
				       		sTagArbre=lireTagArbre(oLaFormule.Model)
				       		&apos;sTagFormule=lireTagFormule(oLaFormule.Model)
				       		if sTagArbre=&quot;&quot; then
				       			sTexteFormule=oLaFormule.Model.formula
				       		else
				       			sTexteFormule=arbre2OOo(chaine2arbre(sTagArbre))
				       		endif							
							AffecteParametresFormule(oLaFormule.Model, oDialogParametresFormules.Model.ComboBoxPolices.Text,_
								val(oDialogParametresFormules.Model.TextFieldTaille.Text), oDialogParametresFormules.Model.CheckBoxGras.State, sTexteFormule, oLaFormule.Model.IsTextMode)
							&apos; préserver les tags arbre et formules
							if sTagArbre&lt;&gt;&quot;&quot; then ecrireTagArbre(oLaFormule.Model,sTagArbre)
							&apos;if sTagFormule&lt;&gt;&quot;&quot; then ecrireTagFormule(oLaFormule.Model,sTagFormule)
							oLaFormule.ExtendedControlOverEmbeddedObject.update()
							&apos;oLaFormule.Model.setmodified(true)
							&apos;EncadrerFormule(oLaFormule)
						endif
					endif
				next i	
				oPgb.end
			case 3:
				compte=0
				while oLesObjets.HasMoreElements
					oPgb.value=clng(compte+1)
					oLaFormule=oLesObjets.NextElement
					if oLaFormule.getImplementationName=&quot;SwXTextEmbeddedObject&quot; then
						a=oLaFormule.Model &apos; ne sert à rien mais contourne un bug : la propriété Model vaut Null au premier appel si bcp d&apos;équations à la suite
						if oLaFormule.Model.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
							&apos;EncadrerFormule(oLaFormule)
							&apos; voir si le tag arbre est présent pour affecter le symboleMultiplié
				       		sTagArbre=lireTagArbre(oLaFormule.Model)
				       		&apos;sTagFormule=lireTagFormule(oLaFormule.Model)
				       		if sTagArbre=&quot;&quot; then
				       			sTexteFormule=oLaFormule.Model.formula
				       		else
				       			sTexteFormule=arbre2OOo(chaine2arbre(sTagArbre))
				       		endif							
							AffecteParametresFormule(oLaFormule.Model, oDialogParametresFormules.Model.ComboBoxPolices.Text,_
								val(oDialogParametresFormules.Model.TextFieldTaille.Text), oDialogParametresFormules.Model.CheckBoxGras.State, sTexteFormule, oLaFormule.Model.IsTextMode)
							&apos; préserver les tags arbre et formules
							if sTagArbre&lt;&gt;&quot;&quot; then ecrireTagArbre(oLaFormule.Model,sTagArbre)
							&apos;if sTagFormule&lt;&gt;&quot;&quot; then ecrireTagFormule(oLaFormule.Model,sTagFormule)
							oLaFormule.ExtendedControlOverEmbeddedObject.update()
							&apos;oLaFormule.Model.setmodified(true)
							&apos;EncadrerFormule(oLaFormule)
						endif
						&apos;if oLaFormule.embeddedObject.getImplementationName=&quot;com.sun.star.comp.math.FormulaDocument&quot; then
						&apos;	AffecteParametresFormule(oLaFormule.EmbeddedObject, oDialogParametresFormules.Model.ComboBoxPolices.Text,_
						&apos;		val(oDialogParametresFormules.Model.TextFieldTaille.Text), oLaFormule.embeddedobject.formula, oLaFormule.embeddedobject.IsTextMode)
						&apos;	oLaFormule.embeddedObject.setmodified(true)
						&apos;endif
					endif
				wend
				oPgb.end
		end select
	endif
	bParametresInitialises=false
	oDialogParametresFormules.Endexecute()
end sub

sub fin_dialog
	&apos; rétablir les paramètres utilisateur
	bParametresInitialises=false
	oDialogParametresFormules.Endexecute()
end sub

