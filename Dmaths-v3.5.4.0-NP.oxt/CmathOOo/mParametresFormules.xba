		oDialog.Model.TextFieldInterligneMatrice.Text=ltrim(str(iInterligneMatrice))

   	case &quot;TextFieldEspacementMatrice&quot;
		if val(oEvt.Source.Model.Text)&lt;&gt;0 then iEspacementMatrice=val(oEvt.Source.Model.Text)
		oDialog.Model.ScrollBarEspacementMatrice.ScrollValue=iEspacementMatrice
   	case &quot;ScrollBarEspacementMatrice&quot;
	   	iEspacementMatrice=oEvt.Source.Model.ScrollValue
		oDialog.Model.TextFieldEspacementMatrice.Text=ltrim(str(iEspacementMatrice))
	case &quot;OptionButtonPoint&quot;
		sSymbolMultiplication=&quot; cdot &quot;		
	case &quot;OptionButtonAucun&quot;
		sSymbolMultiplication=&quot; &quot;
	case &quot;OptionButtonCroix&quot;
		sSymbolMultiplication=&quot; times &quot;
	case &quot;OptionButtonVerticale&quot;
		bBornesIntegralesVerticales=true
	case &quot;OptionButtonDroite&quot;
		bBornesIntegralesVerticales=false
	case &quot;OptionButtonDroit&quot;
		bMajDroite=true
	case &quot;OptionButtonItalique&quot;
		bMajDroite=false
	case &quot;OptionButtonComplexe&quot;
		biComplexe=true
	case &quot;OptionButtonIVariable&quot;
		biComplexe=false
	case &quot;OptionButtoneExpo&quot;
		beExpo=true
	case &quot;OptionButtoneVariable&quot;
		beExpo=false
		
	end select
	
	&apos; si une seule formule est sélectionnée, appliquer tout de suite pour voir en temps réel
	&apos; les modifications
	if bFormuleSelectionnee=true then
		sTagArbre=lireTagArbre(oLaFormule.Model)
		&apos;sTagFormule=lireTagFormule(oLaFormule.Model)
		if sTagArbre&lt;&gt;&quot;&quot; then
			dim vArbre as variant
			vArbre=chaine2arbre(sTagArbre)
			sTexteFormule=arbre2OOo(chaine2arbre(sTagArbre))
		endif							
		AffecteParametresFormule(oLaFormule.Model, oDialog.Model.ComboBoxPolices.Text,_
			val(oDialog.Model.TextFieldTaille.Text), bGras, sTexteFormule, oLaFormule.Model.IsTextMode)
		&apos; préserver les tags arbre et formule
		if sTagArbre&lt;&gt;&quot;&quot; then ecrireTagArbre(oLaFormule.Model,sTagArbre)
		&apos;if sTagFormule&lt;&gt;&quot;&quot; then ecrireTagFormule(oLaFormule.Model,sTagFormule)
	end if	
end sub

sub EcritParametresFormules
			mParams.InsertParametre(&quot;sSymbolMultiplication&quot;,sSymbolMultiplication)
			mParams.InsertParametre(&quot;iMargeGauche&quot;,iMargeGauche)
			mParams.InsertParametre(&quot;iMargeDroite&quot;,iMargeDroite)
			mParams.InsertParametre(&quot;iMargeHaute&quot;,iMargeHaute)
			mParams.InsertParametre(&quot;iMargeBasse&quot;,iMargeBasse)
			mParams.InsertParametre(&quot;iEspacement&quot;,iEspacement)
			mParams.InsertParametre(&quot;iInterligne&quot;,iInterligne)
			mParams.InsertParametre(&quot;iEspRacine&quot;,iEspRacine)
			mParams.InsertParametre(&quot;iIndexSub&quot;,iIndexSub)
			mParams.InsertParametre(&quot;iIndexSup&quot;,iIndexSup)
			mParams.InsertParametre(&quot;iHauteurNumerateur&quot;,iHauteurNumerateur)
			mParams.InsertParametre(&quot;iProfondeurDenominateur&quot;,iProfondeurDenominateur)
			mParams.InsertParametre(&quot;iLongueurExcessive&quot;,iLongueurExcessive)
			mParams.InsertParametre(&quot;iEpaisseurTrait&quot;,iEpaisseurTrait)
			mParams.InsertParametre(&quot;iHauteurMaxi&quot;,iHauteurMaxi)
			mParams.InsertParametre(&quot;iHauteurMini&quot;,iHauteurMini)
