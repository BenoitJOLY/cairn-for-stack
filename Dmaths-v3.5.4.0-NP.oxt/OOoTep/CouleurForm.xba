Option Explicit

dim oCouleurForm as Object

Sub Main
	oCouleurForm=LoadDialog(&quot;OOoTep&quot;,&quot;CouleurForm&quot;)
End Sub

Sub CouleurForm_MAJLabel()
	if val(oCouleurForm.Model.TextField1.Text)&gt;255 then oCouleurForm.Model.TextField1.Text=&quot;255&quot;
	if val(oCouleurForm.Model.TextField2.Text)&gt;255 then oCouleurForm.Model.TextField2.Text=&quot;255&quot;
	if val(oCouleurForm.Model.TextField3.Text)&gt;255 then oCouleurForm.Model.TextField3.Text=&quot;255&quot;
	if val(oCouleurForm.Model.TextField1.Text)&lt;0 then oCouleurForm.Model.TextField1.Text=&quot;0&quot;
	if val(oCouleurForm.Model.TextField2.Text)&lt;0 then oCouleurForm.Model.TextField2.Text=&quot;0&quot;
	if val(oCouleurForm.Model.TextField3.Text)&lt;0 then oCouleurForm.Model.TextField3.Text=&quot;0&quot;
	oCouleurForm.Model.Image1.Backgroundcolor=rgb(oCouleurForm.Model.TextField1.Text,oCouleurForm.Model.TextField2.Text,oCouleurForm.Model.TextField3.Text)
    oCouleurForm.Model.ScrollBar1.ScrollValue = oCouleurForm.Model.TextField1.Text
    oCouleurForm.Model.ScrollBar2.ScrollValue = oCouleurForm.Model.TextField2.Text
    oCouleurForm.Model.ScrollBar3.ScrollValue = oCouleurForm.Model.TextField3.Text
&apos;    oCouleurForm.Model.TextField1.Text = (oCouleurForm.Model.Image17.BackColor And 255)
&apos;    oCouleurForm.Model.TextField2.Text = (oCouleurForm.Model.Image17.BackColor And 65280) / 256
&apos;    oCouleurForm.Model.TextField3.Text = (oCouleurForm.Model.Image17.BackColor And 16711680) / 65536
End Sub

Private Sub CouleurForm_CommandButton1_Click()
    CouleurForm_MAJLabel
    oCouleurForm.Model.Label8.Label=&quot;O&quot;
    oCouleurForm.EndExecute()
End Sub

Private Sub CouleurForm_CommandButton2_Click()
    oCouleurForm.Model.Label8.Label=&quot;N&quot;
    oCouleurForm.EndExecute()
End Sub

Private Sub CouleurForm_TextField()
	CouleurForm_MAJLabel
End Sub

Private Sub CouleurForm_ScrollBar()
dim delta

	if val(oCouleurForm.Model.TextField1.Text) &lt;&gt; oCouleurForm.Model.ScrollBar1.ScrollValue then 
		delta=-val(oCouleurForm.Model.TextField1.Text)+ oCouleurForm.Model.ScrollBar1.ScrollValue
		oCouleurForm.Model.TextField1.Text=oCouleurForm.Model.ScrollBar1.ScrollValue
		if oCouleurForm.Model.CheckBox1.State then
			oCouleurForm.Model.TextField2.Text=oCouleurForm.Model.ScrollBar2.ScrollValue+delta
			oCouleurForm.Model.TextField3.Text=oCouleurForm.Model.ScrollBar3.ScrollValue+delta
		end if
	else
		if val(oCouleurForm.Model.TextField2.Text) &lt;&gt; oCouleurForm.Model.ScrollBar2.ScrollValue then 
			delta=-val(oCouleurForm.Model.TextField2.Text)+ oCouleurForm.Model.ScrollBar2.ScrollValue
			oCouleurForm.Model.TextField2.Text=oCouleurForm.Model.ScrollBar2.ScrollValue
			if oCouleurForm.Model.CheckBox1.State then
				oCouleurForm.Model.TextField1.Text=oCouleurForm.Model.ScrollBar1.ScrollValue+delta
				oCouleurForm.Model.TextField3.Text=oCouleurForm.Model.ScrollBar3.ScrollValue+delta
			end if
		else
			if val(oCouleurForm.Model.TextField3.Text) &lt;&gt; oCouleurForm.Model.ScrollBar3.ScrollValue then
				delta=-val(oCouleurForm.Model.TextField3.Text)+ oCouleurForm.Model.ScrollBar3.ScrollValue
				oCouleurForm.Model.TextField3.Text=oCouleurForm.Model.ScrollBar3.ScrollValue
				if oCouleurForm.Model.CheckBox1.State then
					oCouleurForm.Model.TextField1.Text=oCouleurForm.Model.ScrollBar1.ScrollValue+delta
					oCouleurForm.Model.TextField2.Text=oCouleurForm.Model.ScrollBar2.ScrollValue+delta
				end if
			end if
		end if
	end if
	CouleurForm_MAJLabel
End Sub

Private Sub CouleurForm_TypeTrait()
	oCouleurForm.Model.Image1.HelpText= oCouleurForm.Model.ComboBox1.Text &amp; &quot; &quot; &amp; oCouleurForm.Model.TextField4.Text &amp; &quot; pt&quot;
End Sub

Private Sub CouleurForm_Image(UneImage as Object)
	oCouleurForm.Model.TextField1.Text=(UneImage.BackgroundColor and 16711680) / 65536
	oCouleurForm.Model.TextField2.Text=(UneImage.BackgroundColor and 65280) / 256
	oCouleurForm.Model.TextField3.Text=(UneImage.BackgroundColor and 255)
	CouleurForm_MAJLabel
End Sub

Private Sub CouleurForm_Image1()
	CouleurForm_Image oCouleurForm.Model.ImageControl1
End Sub

