		oDocumentTexte.lockControllers
		curseurVisible = oDocumentTexte.currentController.viewcursor
		CurseurVisible.String = uneDescription
		oDispatcher = createUnoService( &quot;com.sun.star.frame.DispatchHelper&quot; )
