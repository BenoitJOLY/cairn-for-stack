					<value xml:lang="fr">Inserer un document Writer</value>
					<value xml:lang="de">Insert a Writer document</value>
					<value xml:lang="en">Insert a Writer document</value>
					<value xml:lang="it">Insert a Writer document</value>
					<value xml:lang="es">Insert a Writer document</value>					
				</prop>
