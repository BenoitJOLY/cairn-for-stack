rem macro mise au point le 16 novembre 2012

Sub Convert_Formulae_to_Bitmaps
		
		Dim oDoc, oDocDraw, oDrawPage, pgb as Object
		Dim iCount as Integer
		Dim s as String
		oDoc = ThisComponent
		rem initialise le status indicator
		pgb = oDoc.currentcontroller.statusIndicator
		oDrawPage = oDoc.DrawPage	
		iCount = oDrawPage.Count
		pgb.Start (sVocab(iLang,308),iCount)
		
		rem ouvre un draw document invisible
		Dim mFileProperties(0) As New com.sun.star.beans.PropertyValue
		mFileProperties(0).Name = &quot;Hidden&quot;
		mFileProperties(0).Value = True
		sUrl = &quot;private:factory/sdraw&quot;
		oDocDraw = StarDesktop.LoadComponentFromURL(sUrl,&quot;_blank&quot;,0,mFileProperties()
		
		s = &quot;com.sun.star.text.GraphicObject&quot;
		
		For I = 0 to iCount-1
			pgb.Value = i
			maBarredeConvertion.Value = 60 + 35*((i+1)/iCount)			
			
			oMonEquation = oDrawPage.getByIndex(iCount-I-1)		
			If (oMonEquation.ImplementationName = &quot;SwXTextEmbeddedObject&quot; or (oMonEquation.ImplementationName=&quot;SwXShape&quot; and oMonEquation.ShapeType=&quot;com.sun.star.drawing.GroupShape&quot; and oTailleFormule.GetControl(&quot;CheckBox9&quot;).State=1))   Then
			
				on error resume next
				rem implemente l&apos;image
				oMonImage = oDoc.createInstance(s)
				
				rem memorise la position de la formule
				oPosFormule = oMonEquation.getAnchor().getEnd()
		        oAnchor = oMonEquation.getAnchor().getText().createTextCursorByRange(oPosFormule)
		
				rem selectionne la formule et memorise ses proprietes		
				oDoc.CurrentController.Select(oMonEquation)
				
				oMonImage.VertOrient = oMonEquation.VertOrient
				oMonImage.VertOrientPosition = oMonEquation.VertOrientPosition
				oMonImage.VertOrientRelation = oMonEquation.VertOrientRelation	
				oMonImage.Size = oMonEquation.Size
				oMonImage.AnchorType = oMonEquation.AnchorType
				
				If oMonEquation.ImplementationName =&quot;SwXTextEmbeddedObject&quot; Then
				oMonImage.LeftBorder = oMonEquation.LeftBorder
				oMonImage.LeftBorderDistance = oMonEquation.LeftBorderDistance
				oMonImage.RightBorder = oMonEquation.RightBorder
				oMonImage.RightBorderDistance = oMonEquation.RightBorderDistance
				oMonImage.TopBorder = oMonEquation.TopBorder
				oMonImage.TopBorderDistance = oMonEquation.TopBorderDistance
				oMonImage.BottomBorder = oMonEquation.BottomBorder
				oMonImage.BottomBorderDistance = oMonEquation.BottomBorderDistance				
				Endif
				
				rem copie et supprime la formule
				ClipboardCopy(oDoc)
				ToucheSuppr(oDoc)
				rem colle le metafichier GDI
				ClipboardPasteSpecial(oDocDraw)
			 	rem insere l&apos;image		 	
				oAnchor.getText().insertTextContent( oAnchor , oMonImage , false)	
			
				rem colle le graphic ...	
				oMonImageProvisoire = oDocDraw.DrawPages(0).GetByIndex(0)
				oMonImage.Graphic = oMonImageProvisoire.Graphic
				ToucheSuppr(oDocDraw)
			Endif
		Next I
		
		rem ferme ...
		pgb.End
		oDocDraw.dispose

End Sub




rem macro mise au poit le 1er mai 2011, finalisee le 14 novembre 2012
rem elle convertit les objets dune page en image
Sub Convert_Formulae_to_Bitmaps_v1
		
		Dim oDoc, oDrawPage, oDocDraw as Object
		oDoc = ThisComponent
		oDrawPage = oDoc.DrawPage
		
		rem implemente le service dexportation
		Dim mFileProperties(0) As New com.sun.star.beans.PropertyValue
		Dim aPos As New com.sun.star.awt.Point
		Dim props(1) As New com.sun.star.beans.PropertyValue
		serv = CreateUnoService(&quot;com.sun.star.drawing.GraphicExportFilter&quot;)
		
		rem ouvre un draw document invisible
		mFileProperties(0).Name = &quot;Hidden&quot;
		mFileProperties(0).Value = True
		sUrl = &quot;private:factory/sdraw&quot;
		oDocDraw = StarDesktop.LoadComponentFromURL(sUrl,&quot;_blank&quot;,0,mFileProperties()
		aPos.X = 0
		aPos.Y = 0
		oPage = oDocDraw.DrawPages(0)
		With oPage
			.BorderBottom = 0
			.BorderLeft = 0
			.BorderRight = 0
			.BorderTop = 0
		End with 
		
		rem implemente 
		s = &quot;com.sun.star.text.GraphicObject&quot;
		oBitmaps = oDoc.CreateInstance(&quot;com.sun.star.drawing.BitmapTable&quot;)
		
		rem locale le fichier dexport
		sURL = ConvertToURL(getRepertoirePath(&quot;user&quot;)&amp; getPathSeparator &amp; &quot;config&quot; &amp; getPathSeparator) &amp; &quot;imag&quot; 
		
		rem le status indicator
		iCount = oDrawPage.Count
		pgb = oDoc.currentcontroller.statusIndicator
		pgb.Start (sVocab(iLang,308),iCount)
		
		For I = 0 to iCount-1
			rem les barres de progression bougent
			pgb.Value = i
			maBarredeConvertion.Value = 60 + 35*((i+1)/iCount)
			Rem on repere la formule	
			oMonEquation = oDrawPage.getByIndex(iCount-I-1)
		&apos;	MRI oMonEquation
			If (oMonEquation.ImplementationName = &quot;SwXTextEmbeddedObject&quot;) or (oMonEquation.ImplementationName=&quot;SwXShape&quot; and oMonEquation.ShapeType=&quot;com.sun.star.drawing.GroupShape&quot; and oTailleFormule.GetControl(&quot;CheckBox9&quot;).State=1)   Then
			&apos;and oMonEquation.CLSID =&quot;078B7ABA-54FC-457F-8551-6147e776a997&quot; ) _
			 
				on error resume next
				oMonImage = oDoc.createInstance(s)
				oPosFormule = oMonEquation.getAnchor().getEnd()
		        oAnchor = oMonEquation.getAnchor().getText().createTextCursorByRange(oPosFormule)
		        &apos; recupere la position
				oDoc.CurrentController.Select(oMonEquation)

				ClipboardCopy(oDoc)
				rem copie le presse papier dans le doc draw
				ClipboardPaste(oDocDraw)

				oMonEquationDraw = oDocDraw.DrawPages(0).getByIndex(0)
				oMonEquationDraw.setPosition(aPos)
			
				oMonEquationDraw.Size = oMonEquation.Size
						
				oDocDraw.DrawPages(0).Height =  oMonEquation.Size.Height
				oDocDraw.DrawPages(0).Width = oMonEquation.Size.Width				
					
				serv.setSourceDocument(oPage)
				props(0).Name = &quot;URL&quot;
				props(0).Value = sURL + cstr(I) + &quot;.svm&quot;
				props(1).Name = &quot;FilterName&quot;
				props(1).Value =&quot;draw_svm_Export&quot;
				resultat = serv.filter(props())
				ToucheSuppr(oDocDraw)
				oAnchor = oMonEquation.getAnchor()
				oMonImage.graphicURL = sURL &amp; cstr(I) &amp; &quot;.svm&quot;
				
				oMonImage.VertOrient = oMonEquation.VertOrient
				oMonImage.VertOrientPosition = oMonEquation.VertOrientPosition
				oMonImage.VertOrientRelation = oMonEquation.VertOrientRelation	
				oMonImage.Size = oMonEquation.Size
				oMonImage.AnchorType = oMonEquation.AnchorType
				If oMonEquation.ImplementationName =&quot;SwXTextEmbeddedObject&quot; Then
					oMonImage.LeftBorder = oMonEquation.LeftBorder
					oMonImage.LeftBorderDistance = oMonEquation.LeftBorderDistance
					oMonImage.RightBorder = oMonEquation.RightBorder
					oMonImage.RightBorderDistance = oMonEquation.RightBorderDistance
					oMonImage.TopBorder = oMonEquation.TopBorder
					oMonImage.TopBorderDistance = oMonEquation.TopBorderDistance
					oMonImage.BottomBorder = oMonEquation.BottomBorder
					oMonImage.BottomBorderDistance = oMonEquation.BottomBorderDistance
				Endif
						
				
				oDoc.DrawPage.remove(oMonEquation)

				oAnchor.getText().insertTextContent( oAnchor , oMonImage , false)
			
				&apos; insere l&apos;image			
			
				sNom = oMonImage.LinkDisplayName
						
				If oBitmaps.HasByName(sNom) Then oBitmaps.removeByName(sNom)
				oBitmaps.InsertByName(sNom,oMonImage.GraphicURL)		
				sNewURL = oBitmaps.getByName(sNom)
				oMonImage.graphicURL = sNewURL	
			Endif
		Next I
		rem ferme le document dessin
		oDocDraw.Dispose()
		rem supprime les images crees
		For I = 0 to iCount
			If FileExists(sURL &amp; cstr(I) &amp; &quot;.svm&quot;) Then Kill sURL &amp; cstr(I) &amp; &quot;.svm&quot;
		Next i
		rem on ferme le status indicator
		pgb.End
End Sub




