Sub LanceChoixAHmath3D
	oCreeGdmath.GetControl(&quot;CommandButton1&quot;).SetEnable(False) 
	oChoixGdmath = LoadDialog(&quot;Dmaths&quot;,&quot;ChoixAHmath3D&quot;)
	oChoixGdmath.Execute()
End Sub

Sub LanceCreationAHmath3D(oEvt as Object)
	oChoixGdmath.EndExecute()	
	Dim sWriterDocument As String
	Dim mFileProperties() As New com.sun.star.beans.PropertyValue
	sWriterDocument = fChemindmaths+&quot;AHmath3D.odt&quot;
	monAHmath3D = StarDesktop.LoadComponentFromURL(sWriterDocument,&quot;_blank&quot;, 0, mFileProperties())
	Globalscope.BasicLibraries.LoadLibrary(&quot;OOoAHmath3D&quot;)
	rem lance la macro de création de l&apos;objet
	OOoAHmath3D.ahOutilsDraw.Lancermacro(oEvt.Source.Model.Name)
	Dmaths.Module6.LanceChoixPointsAHmath3D	
End Sub

Sub LanceChoixPointsAHmath3D
	oChoixPointsAHmath3D = LoadDialog(&quot;Dmaths&quot;,&quot;ChoixPointsAHmath3D&quot;)
	exitOK = com.sun.star.ui.dialogs.ExecutableDialogResults.OK
	If oChoixPointsAHmath3D.Execute = ExitOK Then
		oCreeGdmath.GetControl(&quot;CommandButton4&quot;).SetEnable(True) 
		Rem deselectionne
		ToucheEchap(monAHmath3D)
		OOoAHmath3D.NomPointDroite.MacroPrincipaleNomPointDroite
	Else
		oCreeGdmath.GetControl(&quot;CommandButton4&quot;).SetEnable(False) 
		Call ColleCreationAHmath3D
	Endif
End Sub

Sub ColleCreationAHmath3D 	

	mapageAHmath3D = monAHmath3D.DrawPage

	If mapageAHmath3D.Count &gt; 2 Then
		ToucheEchap(monAHmath3D)
		Dim oShapesAH, oAjoute as Object
		oShapesAH = createUnoService(&quot;com.sun.star.drawing.ShapeCollection&quot;)
		For I=0 To mapageAHmath3D.Count-1
			oAjoute = mapageAHmath3D.getByIndex(I)
		If oAjoute.ShapeType &lt;&gt; &quot;com.sun.star.drawing.ControlShape&quot; Then oShapesAH.Add(oAjoute) 							
		Next I
	&apos;	mapageAHmath3D.Group(oShapesAH)
	&apos;	oAjoute = mapageAHmath3D.getByIndex(1)
	&apos;	Exit Sub
		&apos;Wait 2000
		monAHmath3D.CurrentController.Select(oShapesAH)	
	 	If OOoName() = &quot;LibreOffice&quot; Then Print sVocab(iLang,275)
	 &apos;	If OOoName() = &quot;LibreOffice&quot; Then Avertir(275)
	 	&apos;Wait 2000
		GrouperDansWriter(monAHmath3D)
		&apos;DispatchSimple(&quot;FormatGroup&quot;, monAHmath3D.CurrentController.Frame)
	EndIf
	
	ClipBoardCopy(monAHmath3D)
	&apos;DispatchSimple(&quot;Copy&quot;,  monAHmath3D.CurrentController.Frame)
	ToucheEchap(monAHmath3D)

	monAHmath3D.Close(True)
	oDocumentF.CurrentController.Frame.ContainerWindow.ToFront	
	Wait 500

	ClipBoardPaste(oDocumentF)
&apos;	DispatchSimple(&quot;Paste&quot;, oDocumentF.CurrentController.Frame)

	oCreeGdmath.GetControl(&quot;ScrollBar1&quot;).Enable = TRUE
	oCreeGdmath.GetControl(&quot;ScrollBar2&quot;).Enable = TRUE
	
	rem positionne lobjet
	Dim LaPos As New com.sun.star.awt.Point
	Dim Lobjet as Object
	Lobjet = oDocumentF.currentController.selection.getByIndex(0)
	LaPos.X = LeCadre.Position.X  
	LaPos.Y = LeCadre.Position.Y + LeCadre.Size.Height - Lobjet.Size.Height
	Lobjet.Setposition(LaPos)
	oCreeGdmath.GetControl(&quot;ScrollBar1&quot;).Value = LaPos.Y
	oCreeGdmath.GetControl(&quot;ScrollBar2&quot;).Value = LaPos.X 
	oCreeGdmath.GetControl(&quot;CommandButton2&quot;).SetEnable(True) 
	oCreeGdmath.GetControl(&quot;CommandButton4&quot;).SetEnable(False) 
	oCreeGdmath.GetControl(&quot;CommandButton3&quot;).SetEnable(False) 			
End Sub

