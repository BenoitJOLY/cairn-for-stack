	oCreeGdmath.GetControl(&quot;TextFieldZoom&quot;).Text = oDocumentF.currentController.ZoomValue
	oCreeGdmath.GetControl(&quot;CommandButton1&quot;).Model.ImageURL = ConvertToURL(fChemindmaths &amp; &quot;icons/addons/AHmath3D_26.bmp&quot;)
	oCreeGdmath.GetControl(&quot;CommandButton4&quot;).Model.ImageURL = ConvertToURL(fChemindmaths &amp; &quot;icons/addons/coller.bmp&quot;) 	
	oCreeGdmath.GetControl(&quot;CommandButton4&quot;).SetEnable(False) 
	oCreeGdmath.GetControl(&quot;CommandButton2&quot;).SetEnable(False) 
	oFigure.SetVisible(False)
 	oCreeGdmath.Execute()
