        InsertSourceIntegrale(Test)
        bEcritduTexteSelectionne = False
    Endif
    Form1 = False
    oBoite.Endexecute()
	If Form = True Then 
		oTextIndex = oBoiteFormuleGraphique.getControl(&quot;TextField1&quot;).Peer
		CursorPos = CursorPos + Len(Test)
	End If
End Sub

