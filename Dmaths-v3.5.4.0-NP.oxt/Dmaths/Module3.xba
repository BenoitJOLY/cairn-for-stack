			Axex(2).y=((Ymaxi-OrdonneeAxeX)/NUY+MargeY)*1000+100
			Axex(3).x=(MargeX+(AbsMaxi-AbsMini)/NUX)*1000+300
			Axex(3).y=((Ymaxi-OrdonneeAxeX)/NUY+MargeY)*1000
			Axex(4).x=(MargeX+(AbsMaxi-AbsMini)/NUX)*1000 + 100
