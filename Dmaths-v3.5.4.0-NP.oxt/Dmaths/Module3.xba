		Rep(0).y= (MargeY-(1-Ymaxi)/NUY)*1000+200
		Rep(1).x= (MargeX-AbsMini/NUX)*1000
		Rep(1).y= (MargeY-(1-Ymaxi)/NUY)*1000
		Rep(2).x= (MargeX-AbsMini/NUX)*1000-100
		Rep(2).y= (MargeY-(1-Ymaxi)/NUY)*1000+200
