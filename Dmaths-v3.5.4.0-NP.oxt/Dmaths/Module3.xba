			aPosNomAbscisses.x = (MargeX+(AbsMaxi-AbsMini)/NUX)*1000 + 200
			aPosNomAbscisses.y = ((Ymaxi-OrdonneeAxeX)/NUY+MargeY)*1000 - 200
			oNomAbscisses.Position = aPosNomAbscisses
