<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="ah" script:language="StarBasic">&apos;----------------------------------------------------------------------------
&apos;-Donne le focus à un élément d&apos;une boite de dialogue
&apos;---------------------------------------------------------------------------
sub ReceptionFocus(Dial as object, monElement as string)
dim k1 as object
k1 = Dial.getControl(monElement)
k1.setfocus
end sub

&apos;--------------------------------------------------------------------------------
&apos;renvoie true si la chaine d&apos;une zone de texte est un nombre et qu&apos;elle est
&apos; comprise entre borne1 et borne2 incluses
&apos;option entier teste aussi si le nombre est un entier
&apos;--------------------------------------------------------------------------------
function estunnombreentrebornes(variable as variant,borne1 as double, borne2 as double,optional entier as boolean) as boolean
dim var1 as boolean, nombre1 as double, nombre2 as double

if isMissing(entier) then
entier = false
end if

  var1=IsNumeric(variable)
  if var1 = true then
  nombre1 = CDbl(variable)
     if entier = true then
          nombre2 = Fix(nombre1)
          else
          nombre2 = nombre1
     end if
     
     if nombre1&lt;borne1 or nombre1&gt;borne2 or nombre2&lt;&gt;nombre1 then
       var1 = false
     end if
    
  estunnombreentrebornes = var1
  end if
end function


&apos;---------------------------------------------------------------------------------
&apos;valide une zone texte comme un nombre (option : un entier) compris entre 2 bornes
&apos;écrit une valeur defaut si elle n&apos;est pas valide
&apos;function qui renvoie 0 ou 1
&apos;---------------------------------------------------------------------------------

function ZT_Nbre(Dial as object, CaseTexte as string, borne1 as double, borne2 as double,ValDef as double, monMessage as string , optional entier as boolean) as integer
Dim  k1 as object, Val1 as Double, VF1 as boolean

if isMissing(entier) then
   entier = false
end if

k1 = Dial.getControl(CaseTexte)
VF1 = estunnombreentrebornes(k1.Peer.Text,borne1,borne2,entier)

if VF1 = false then
k1.Peer.Text = ValDef
msgbox(monMessage)
ReceptionFocus(Dial,CaseTexte)
end if

if VF1 = false then
ZT_Nbre = 0
else
ZT_Nbre = 1
end if
end function

&apos;------------------------------------------------------------------------------
&apos;affecte un texte d&apos;aide à un élément d&apos;une boite de dialogue
&apos;--------------------------------------------------------------------------------
sub TexteAide(Dial as object, monElement as string, messageAide as string)
Dim k1 as object
k1 = Dial.getcontrol(monElement)
k1.Model.HelpText=messageAide
end sub
</script:module>