Option Explicit

private UnPoint As object
dim oDeplacePointForm as object

Sub Main
    DeplacePointForm.TracePoint
    oDeplacePointForm.Execute()
End Sub

Private Sub DeplacePointForm_TextBox1_Change()
dim tang as string
	on error resume next
	tang=oDeplacePointForm.Model.TextField1.Text
	if instr(1,tang,&quot;.&quot;)&lt;&gt;0 then 
		tang=left(tang,len(tang)-2) &amp; right(tang,1)
	else
		tang=tang &amp; &quot;0&quot;
	end if
	oDeplacePointForm.Model.ScrollBar1.ScrollValue=val(tang)
	TracePoint
End Sub

Private Sub DeplacePointForm_CommandButton1_Click()
	on error resume next
    oDocumentDessin.DrawPages.GetByIndex(0).remove(UnPoint)
    oDeplacePointForm.endexecute()
End Sub

Private Sub DeplacePointForm_ScrollBar1()
dim tang as string

	tang=oDeplacePointForm.Model.ScrollBar1.ScrollValue
	if right(tang,1)&lt;&gt;&quot;0&quot; then
		tang=left(tang,len(tang)-1) &amp; &quot;.&quot; &amp; right(tang,1)
	else
		tang=left(tang,len(tang)-1) &amp; &quot;.&quot; &amp; right(tang,1)
	end if
	oDeplacePointForm.Model.TextField1.Text=tang
	TracePoint
End Sub

Private Sub TracePoint()
on error resume next
Dim x6, y6, rayon, xx, yy, ang
    x6 = Val(oDeplacePointForm.Model.Label1.Label)
    y6 = Val(oDeplacePointForm.Model.Label2.Label)
    rayon = Val(oDeplacePointForm.Model.Label3.Label)
    ang=oDeplacePointForm.Model.ScrollBar1.ScrollValue
    xx = int(x6 + rayon * Cos(ang*Pi/1800))
    yy = int(y6 + rayon * Sin(ang*Pi/1800))
    oDocumentDessin.DrawPages.GetByIndex(0).remove(UnPoint)
    UnPoint=InsereLigne(xx-200, yy , xx + 200, yy)
	oDeplacePointForm.Model.Label5.Label=xx
	oDeplacePointForm.Model.Label6.Label=yy
End Sub

</script:module>