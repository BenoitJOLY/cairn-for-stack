	oTrapezeForm.Model.CheckBox9.Enabled = True
	TrapezeForm_CheckBox9_Click

	oTrapezeForm.Model.Label1.Label = &quot;a&quot;
	oTrapezeForm.Model.Label5.Label = &quot;cm&quot;

