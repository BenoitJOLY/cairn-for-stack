    CodageALabel2 = &quot;5&quot;
    CodageAForm_Terminate()
End Sub

Sub CodageAForm_CommandButton6_Click()
    CodageALabel2 = &quot;6&quot;
    CodageAForm_Terminate()
End Sub

Sub CodageAForm_CommandButton7_Click()
    CodageALabel2 = &quot;8&quot;
    CodageAForm_Terminate()
End Sub

Sub CodageAForm_CommandButton8_Click()
    CodageALabel2 = &quot;6&quot;
