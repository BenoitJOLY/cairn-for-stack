public CodageALabel2 as string
Public oCodageAForm as object

Sub Main
End Sub

Sub AfficheCodageAForm()
	oCodageAForm = LoadDialog(&quot;OOoGdmath&quot;,&quot;CodageAForm&quot;)
	ChangeTitreDialog(oCodageAForm)
    oCodageAForm.Model.CommandButton1.ImageURL=fCheminImages &amp; &quot;codageangle1.gif&quot;
    oCodageAForm.Model.CommandButton2.ImageURL=fCheminImages &amp; &quot;codageangle2.gif&quot;
    oCodageAForm.Model.CommandButton3.ImageURL=fCheminImages &amp; &quot;codageangle3.gif&quot;
    oCodageAForm.Model.CommandButton4.ImageURL=fCheminImages &amp; &quot;codageangle4.gif&quot;
    oCodageAForm.Model.CommandButton5.ImageURL=fCheminImages &amp; &quot;codageangle5.gif&quot;
    oCodageAForm.Model.CommandButton6.ImageURL=fCheminImages &amp; &quot;codageangle6.gif&quot;
    oCodageAForm.Model.CommandButton7.ImageURL=fCheminImages &amp; &quot;codageangle7.gif&quot;
    oCodageAForm.Model.CommandButton8.ImageURL=fCheminImages &amp; &quot;codageangle8.gif&quot;
    oCodageAForm.Model.CommandButton9.ImageURL=fCheminImages &amp; &quot;codageangle9.gif&quot;
	oCodageAForm.Execute()
end sub

Sub CodageAForm_CommandButton1_Click()
    CodageALabel2 = &quot;1&quot;
    CodageAForm_Terminate()
End Sub

Sub CodageAForm_CommandButton2_Click()
    CodageALabel2 = &quot;4&quot;
    CodageAForm_Terminate()
End Sub

