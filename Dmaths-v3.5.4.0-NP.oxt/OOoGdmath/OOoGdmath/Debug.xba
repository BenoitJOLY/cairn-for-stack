Option Explicit

Global laBoiteDeDialogue as Object

Dim oDebugForm as Object

Sub Main
Dim i
	oDebugForm=LoadDialog(&quot;OOoGdmath&quot;,&quot;DebugForm&quot;)
	ChangeTitreDialog(oDebugForm)
&apos;	For i = 1 to 23
&apos;		oDebugForm.GetControl(&quot;ImageControl&quot; &amp; trim(str(i))).Model.Border = -1
&apos;	Next i
    oDebugForm.Model.ImageControl1.ImageURL=fCheminImages &amp; &quot;menu_triangle.gif&quot;
    oDebugForm.Model.ImageControl6.ImageURL=fCheminImages &amp; &quot;menu_carre.gif&quot;
    oDebugForm.Model.ImageControl2.ImageURL=fCheminImages &amp; &quot;menu_cercle.gif&quot;
    oDebugForm.Model.ImageControl13.ImageURL=fCheminImages &amp; &quot;menu_losange.gif&quot;
