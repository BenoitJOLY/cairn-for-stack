    oDebugForm.Model.ImageControl24.ImageURL=fCheminImages &amp; &quot;menu_trapeze.gif&quot;
    oDebugForm.Model.ImageControl25.ImageURL=fCheminImages &amp; &quot;menu_parametres.gif&quot;
    oDebugForm.Model.ImageControl26.ImageURL=fCheminImages &amp; &quot;menu_segment.gif&quot;
    oDebugForm.Model.ImageControl27.ImageURL=fCheminImages &amp; &quot;menu_thales.gif&quot;
    Rem permet de desactiver la mise en forme des expressions si Dmaths présente 
    If Globalscope.BasicLibraries.hasByName(&quot;Dmaths&quot;) Then
    oDebugForm.Model.ImageControl11.EnableVisible=False
    EndIf
    oDebugForm.Model.Step = 2
	oDebugForm.Execute()
End Sub

Sub RestaureBoiteDialogue()
	RestaureForm laBoitedeDialogue
End Sub

Private Sub DebugForm_AnnulerBouton_Click()
	oDebugForm.EndExecute()
End Sub

Private Sub DebugForm_OkBouton_Click(evt)
	If evt.Source.Model.Name &lt;&gt; &quot;ImageControl25&quot; Then oDebugForm.EndExecute()
	select case evt.Source.Model.Name
	case &quot;ImageControl1&quot;
		TriangleForm.Main 
	case &quot;ImageControl2&quot;
		CercleForm.Main
	case &quot;ImageControl3&quot;
		DroiteGForm.Main
	case &quot;ImageControl4&quot;
		AngleDDForm.Main
	case &quot;ImageControl5&quot;
		ArcDCForm.Main
	case &quot;ImageControl6&quot;
		CarreForm.Main
	case &quot;ImageControl7&quot;
		QuadrillageForm.Main
	case &quot;ImageControl8&quot;
		RectangleForm.Main
	case &quot;ImageControl9&quot;
		RepFractionForm.Main
	case &quot;ImageControl10&quot;
		ReseauForm.Main
	case &quot;ImageControl11&quot;
		InsereExpression.Main
	case &quot;ImageControl12&quot;
		Gdmath.RedresseTexte()
	case &quot;ImageControl13&quot;
		LosangeCode.Main
	case &quot;ImageControl14&quot;
		ParalleloCode.Main
	case &quot;ImageControl15&quot;
		Rapporteur.Main
	case &quot;ImageControl16&quot;
		CammCode.Main
	case &quot;ImageControl17&quot;
		AdditionCode.Main
	case &quot;ImageControl18&quot;
		MultiCode.Main
	case &quot;ImageControl19&quot;
		DivisionCode.Main
	case &quot;ImageControl20&quot; 
		ChangerTexteCode.Main
	case &quot;ImageControl21&quot;
		RepereCode.Main
	case &quot;ImageControl22&quot;
		PolygoneRegulierCode.Main
	case &quot;ImageControl23&quot;
		ChangerPoliceCode.Main
	case &quot;ImageControl24&quot;
		TrapezeCode.Main
	case &quot;ImageControl25&quot;
		NommageCode.AfficheNommageForm
	case &quot;ImageControl26&quot;
		ahSegment.Main
	case &quot;ImageControl27&quot;
		ahThales.Main
	End select
End Sub

Sub SourisAucun(evt as Object)
Dim i
	For i = 1 to 23
		ChangeImage oDebugForm.GetControl(&quot;ImageControl&quot; &amp; trim(str(i))).Model, 0
&apos;		oDebugForm.GetControl(&quot;ImageControl&quot; &amp; trim(str(i))).Model.Border = -1
	Next i
End Sub

Sub SourisExt(evt as Object)
	ChangeImage(evt.Source.Model, 0)
End Sub

Sub SourisIn(evt as Object)
	ChangeImage(evt.Source.Model, 1)
End Sub

Sub ChangeImage(evt as Object, etat As Integer) 
Dim unNom

	unNom = evt.ImageURL
	unNom = Mid(unNom, InStr(unNom, &quot;menu_&quot;))
	unNom = Left(unNom, Len(unNom) - 4)
	If Etat=0 Then
	    evt.ImageURL=fCheminImages &amp; unNom &amp; &quot;.gif&quot;
&apos;		evt.Border = -1
	Else
	    evt.ImageURL=fCheminImages &amp; unNom &amp; &quot;.png&quot;
&apos;		evt.Border = 1
	End If
End Sub

</script:module>