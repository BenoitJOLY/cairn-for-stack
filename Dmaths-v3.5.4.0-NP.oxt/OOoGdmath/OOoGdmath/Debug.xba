    oDebugForm.Model.ImageControl21.ImageURL=fCheminImages &amp; &quot;menu_repere.gif&quot;
    oDebugForm.Model.ImageControl7.ImageURL=fCheminImages &amp; &quot;menu_quadrillage.gif&quot;
    oDebugForm.Model.ImageControl10.ImageURL=fCheminImages &amp; &quot;menu_reseau.gif&quot;
    oDebugForm.Model.ImageControl4.ImageURL=fCheminImages &amp; &quot;menu_anglededroite.gif&quot;
    oDebugForm.Model.ImageControl5.ImageURL=fCheminImages &amp; &quot;menu_arcdecercle.gif&quot;
    oDebugForm.Model.ImageControl16.ImageURL=fCheminImages &amp; &quot;menu_camembert.gif&quot;
    oDebugForm.Model.ImageControl9.ImageURL=fCheminImages &amp; &quot;menu_repfraction.gif&quot;
    oDebugForm.Model.ImageControl15.ImageURL=fCheminImages &amp; &quot;menu_rapporteur.gif&quot;
    oDebugForm.Model.ImageControl17.ImageURL=fCheminImages &amp; &quot;menu_addition.gif&quot;
    oDebugForm.Model.ImageControl18.ImageURL=fCheminImages &amp; &quot;menu_multiplication.gif&quot;
    oDebugForm.Model.ImageControl19.ImageURL=fCheminImages &amp; &quot;menu_division.gif&quot;
    oDebugForm.Model.ImageControl12.ImageURL=fCheminImages &amp; &quot;menu_redresse_texte.gif&quot;
    oDebugForm.Model.ImageControl11.ImageURL=fCheminImages &amp; &quot;menu_expression.gif&quot;
    oDebugForm.Model.ImageControl20.ImageURL=fCheminImages &amp; &quot;menu_deplace_texte.gif&quot;
    oDebugForm.Model.ImageControl22.ImageURL=fCheminImages &amp; &quot;menu_polygoneregulier.gif&quot;
