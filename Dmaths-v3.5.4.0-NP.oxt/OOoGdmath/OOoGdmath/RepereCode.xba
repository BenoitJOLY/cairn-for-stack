            RemplaceItem(oRepereForm, &quot;ComboBox20&quot;, ListBox1, ExtraitTypeTrait(oRepereForm.Model.Image5.HelpText))
            RemplaceItem(oRepereForm, &quot;ListBox1&quot;, ListBox1, texte$)
        End If
    End If
End Sub

