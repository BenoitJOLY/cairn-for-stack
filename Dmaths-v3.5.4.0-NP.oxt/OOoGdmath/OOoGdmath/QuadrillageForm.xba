Option Explicit

Dim oQuadrillageForm as object

Sub Main
	oQuadrillageForm = LoadDialog(&quot;OOoGdmath&quot;,&quot;QuadrillageForm&quot;)
	ChangeTitreDialog(oQuadrillageForm)
&apos;	xray.xray oQuadrillageForm.Model.Image10
	oQuadrillageForm.Model.Step = 1
&apos;	RestaureForm(oQuadrillageForm)
	oQuadrillageForm.Execute()
End Sub

Private Sub QuadrillageForm_CommandButton1_Click()
Dim nl, nc, llarg, lhaut,a as boolean
Dim Shapes as Object,posx,posy

oQuadrillageForm.Model.Step = 2
oQuadrillageForm.Model.Label12.Label = Chaine(&quot;tracquad&quot;) &apos;&quot;Tracé du quadrillage&quot;
InitialiseDessin(False)
PointInsertion posx, posy
Shapes=InitialiseGroupe()
nl = Int(Val(oQuadrillageForm.Model.TextField3.Text))
nc = Int(Val(oQuadrillageForm.Model.TextField4.Text))
llarg = oQuadrillageForm.Model.TextField1.Text
RemplaceVirgulePoint llarg
llarg = Val(llarg) * 1000
lhaut = oQuadrillageForm.Model.TextField2.Text
RemplaceVirgulePoint lhaut
lhaut = Val(lhaut) * 1000
If (nl * nc &lt;&gt; 0) Then
    If oQuadrillageForm.Model.OptionButton6.State Then PlateauLogarithmique llarg, lhaut, nl, nc,Shapes
    If oQuadrillageForm.Model.OptionButton7.State Then PlateauSemilogarithmique llarg, lhaut, nl, nc,Shapes
    If oQuadrillageForm.Model.OptionButton2.State Then PlateauCarreau nl, nc, 2, 2,Shapes
    If oQuadrillageForm.Model.OptionButton3.State Then PlateauMillimetre nl, nc, 2, 2,Shapes
    a=oQuadrillageForm.Model.CheckBox1.State
    If Not a Then
        If oQuadrillageForm.Model.OptionButton1.State Then PlateauCarre nl, nc, 2, 2,Shapes
        If oQuadrillageForm.Model.OptionButton4.State Then PlateauTriangle nl, nc, posx, posy, llarg,Shapes
        If oQuadrillageForm.Model.OptionButton5.State Then PlateauHexagone nl, nc, posx, posy, llarg,Shapes
        If oQuadrillageForm.Model.OptionButton8.State Then PlateauRectangle llarg, lhaut, nl, nc,Shapes
    Else
        If oQuadrillageForm.Model.OptionButton1.State Then PlateauCelluleCarre nl, nc, 2, 2,Shapes
        If oQuadrillageForm.Model.OptionButton4.State Then PlateauCelluleTriangle nl, nc, posx, posy, llarg,Shapes
        If oQuadrillageForm.Model.OptionButton5.State Then PlateauCelluleHexa nl, nc, posx, posy, llarg,Shapes
        If oQuadrillageForm.Model.OptionButton8.State Then PlateauCelluleRectangle llarg, lhaut, nl, nc,Shapes
    End If
End If
Shapes=GroupeObjet(Shapes)
DeplaceSelection posx,posy,Shapes
TermineDessin()
oQuadrillageForm.EndExecute()
	sauveForm(oQuadrillageForm)
End Sub

