Option Explicit

private UneLigne As object
dim oDeplaceDiametreForm as object

Sub Main
End Sub

Private Sub DeplaceDiametreForm_TextBox1_Change()
dim tang as string
	on error resume next
	tang=oDeplaceDiametreForm.Model.TextField1.Text
	if instr(1,tang,&quot;.&quot;)&lt;&gt;0 then 
		tang=left(tang,len(tang)-2) &amp; right(tang,1)
	else
		tang=tang &amp; &quot;0&quot;
	end if
	oDeplaceDiametreForm.Model.ScrollBar2.ScrollValue=val(tang)
	TraceDiametre
End Sub

Private Sub DeplaceDiametreForm_CommandButton1_Click()
	on error resume next
    oDocumentDessin.DrawPages.GetByIndex(0).remove(UneLigne)
    oDeplaceDiametreForm.endexecute()
End Sub

Private Sub DeplaceDiametreForm_ScrollBar1()
dim tang as string

	tang=oDeplaceDiametreForm.Model.ScrollBar2.ScrollValue
	if right(tang,1)&lt;&gt;&quot;0&quot; then
		tang=left(tang,len(tang)-1) &amp; &quot;.&quot; &amp; right(tang,1)
	else
		tang=left(tang,len(tang)-1) &amp; &quot;.&quot; &amp; right(tang,1)
	end if
	oDeplaceDiametreForm.Model.TextField1.Text=tang
	TraceDiametre
End Sub

Private Sub TraceDiametre()
on error resume next
Dim x6, y6, rayon, xx, yy,xx1,yy1,ang
    x6 = Val(oDeplaceDiametreForm.Model.Label1.Label)
    y6 = Val(oDeplaceDiametreForm.Model.Label2.Label)
    rayon = Val(oDeplaceDiametreForm.Model.Label3.Label)
    ang=oDeplaceDiametreForm.Model.ScrollBar2.ScrollValue
    xx = x6 + rayon * Cos(ang*3.1415926/1800)
    yy = y6 + rayon * Sin(ang*3.1415926/1800)
    xx1 = x6 - rayon * Cos(ang*3.1415926/1800)
    yy1 = y6 - rayon * Sin(ang*3.1415926/1800)
    oDocumentDessin.DrawPages.GetByIndex(0).remove(UneLigne)
    UneLigne=InsereLigne(xx1, yy1, xx, yy)
	oDeplaceDiametreForm.Model.Label5.Label=xx
	oDeplaceDiametreForm.Model.Label6.Label=yy
End Sub

</script:module>