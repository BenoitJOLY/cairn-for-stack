    oRectangleForm.Model.CheckBox7.Enabled = (oRectangleForm.Model.CheckBox1.State = 1 Or oRectangleForm.Model.CheckBox2.State = 1)
End Sub

Private Sub RectangleForm_CheckBox3_Click()
    oRectangleForm.Model.CheckBox9.Enabled = (oRectangleForm.Model.CheckBox3.State = 1 Or oRectangleForm.Model.CheckBox4.State = 1)
End Sub

Private Sub RectangleForm_CheckBox4_Click()
    oRectangleForm.Model.CheckBox9.Enabled = (oRectangleForm.Model.CheckBox3.State = 1 Or oRectangleForm.Model.CheckBox4.State = 1)
