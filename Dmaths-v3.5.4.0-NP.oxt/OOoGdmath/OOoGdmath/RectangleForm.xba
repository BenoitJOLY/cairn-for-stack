    ChangeCouleur oRectangleForm.Model.ImageControl8
End Sub

Private Sub RectangleForm_Image9_Click()
    ChangeCouleur oRectangleForm.Model.ImageControl9
End Sub

Private Sub RectangleForm_OkBouton_Click()
Dim UneLigne As Object
Dim afmesure, t1, t2, a, b, posx, posy, x0, y0, x1, y1, x2, y2, x3, y3, xn, yn
Dim UnRectangle as Object, mm1, mm2, ga, gb, xm, ym
Dim Shapes as Object
Dim MessageErreur as String

On Error GoTo erreur
&apos; Dessiner un rectangle

	MessageErreur = &quot;Je n&apos;ai pas pu tracer le rectangle.&quot;
    oRectangleForm.EndExecute()
	SauveForm(oRectangleForm)

	InitialiseDessin(False)
    afmesure = (oRectangleForm.Model.CheckBox5.State = 1)
    t1 = oRectangleForm.Model.TextField1.Text
    t2 = oRectangleForm.Model.TextField2.Text
    RemplaceVirgulePoint t1
    RemplaceVirgulePoint t2
    a = Val(t1)
    b = Val(t2)
    PointInsertion posx, posy
    t1 = oRectangleForm.Model.TextField1.Text
    t2 = oRectangleForm.Model.TextField2.Text
    Shapes=InitialiseGroupe
    If (oRectangleForm.Model.OptionButton1.State = 1) Then
        a = a * 1000
        b = b * 1000
        If CestUneFigureGeometrique Then
            posx = (xmin + xmax) / 2 - a / 2
            posy = (ymin + ymax) / 2 - b / 2
        End If
        x0 = posx
        y0 = posy
        x1 = x0 + a
        y1 = y0
        x2 = x1
        y2 = y1 + b
        x3 = x0
        y3 = y2
        UnRectangle = InsereQuadrilatere(x0, y0, x1, y1, x2, y2, x3, y3, Shapes, oRectangleForm.Model.ImageControl9)
        If afmesure Then
            InsereTexte t1 &amp; MIif(oRectangleForm.Model.CheckBox40.State = 0, &quot; cm&quot;, &quot;&quot;), (x0 + x1) / 2, (y0 + y1) / 2, Shapes,0
            InsereTexte t2 &amp; MIif(oRectangleForm.Model.CheckBox40.State = 0, &quot; cm&quot;, &quot;&quot;), (x1 + x2) / 2, (y1 + y2) / 2, Shapes,0
        End If
    End If
    If (oRectangleForm.Model.OptionButton2.State = 1) Then
    	if b &lt;= a Then MessageErreur = MessageErreur &amp; chr(10) &amp; chr(10) &amp; &quot;La diagonale d&apos;un rectangle doit être&quot; &amp; chr(10) &amp;  &quot;plus longue que les côtés...&quot;
        a = a * 1000
        b = b * 1000
        If CestUneFigureGeometrique Then
            posx = (xmin + xmax) / 2 - a / 2
            posy = (ymin + ymax) / 2 - Sqr(b * b - a * a) / 2
        End If
        x0 = posx
        y0 = posy
        x1 = x0 + a
        y1 = y0
        x2 = x1
        y2 = y1 + Sqr(b * b - a * a)
        x3 = x0
        y3 = y2
        UnRectangle=InsereQuadrilatere(x0, y0, x1, y1, x2, y2, x3, y3, Shapes,oRectangleForm.Model.ImageControl9)
        If afmesure Then
            InsereTexte t1 &amp; MIif(oRectangleForm.Model.CheckBox40.State = 0, &quot; cm&quot;, &quot;&quot;), (x0 + x1) / 2, (y0 + y1) / 2, Shapes,0
            InsereTexte t2 &amp; MIif(oRectangleForm.Model.CheckBox40.State = 0, &quot; cm&quot;, &quot;&quot;), (x1 + x3) / 2, (y1 + y3) / 2, Shapes,0
        End If
    End If
    If (oRectangleForm.Model.OptionButton3.State = 1) Then
        b = b * 1000
        a = a * Pi / 180
        If CestUneFigureGeometrique Then
            posx = (xmin + xmax) / 2 - b * Cos((Pi - a) / 2) / 2
            posy = (ymin + ymax) / 2 - b * Sin((Pi - a) / 2) / 2
        End If
        x0 = posx
        y0 = posy
        x1 = x0 + b * Cos((Pi - a) / 2)
        y1 = y0
        x2 = x1
        y2 = y0 + b * Sin((Pi - a) / 2)
        x3 = x0
        y3 = y2
        UnRectangle=InsereQuadrilatere(x0, y0, x1, y1, x2, y2, x3, y3, Shapes,oRectangleForm.Model.ImageControl9)
        If afmesure Then
            InsereTexte t1 &amp; MIif(oRectangleForm.Model.CheckBox40.State = 0, &quot;°&quot;, &quot;&quot;), (x0 + x2) / 2, (y0 + y2) / 2, Shapes,0
            InsereTexte t2 &amp; MIif(oRectangleForm.Model.CheckBox40.State = 0, &quot; cm&quot;, &quot;&quot;), (x1 + 3 * x3) / 4, (y1 + 3 * y3) / 4, Shapes,0
        End If
        MarqueAngle x0, y0, (x0 + x2) / 2, (y0 + y2) / 2, x1, y1, (Val(t1) &gt; 180), 1, 0, Shapes
    End If
    If (oRectangleForm.Model.OptionButton4.State = 1) Then
        b = b * 1000
        a = a * Pi / 180
        If CestUneFigureGeometrique Then
            posx = (xmin + xmax) / 2 - b / (2 * Tan(a))
            posy = (ymin + ymax) / 2 - b / 2
        End If
        x0 = posx
        y0 = posy
        x1 = x0 + b / Tan(a)
        y1 = y0
        x2 = x1
        y2 = y1 + b
        x3 = x0
        y3 = y2
        UnRectangle=InsereQuadrilatere(x0, y0, x1, y1, x2, y2, x3, y3, Shapes,oRectangleForm.Model.ImageControl9)
        If afmesure Then
            InsereTexte t1 &amp; MIif(oRectangleForm.Model.CheckBox40.State = 0, &quot;°&quot;, &quot;&quot;), x0, y0, Shapes,0
            InsereTexte t2 &amp; MIif(oRectangleForm.Model.CheckBox40.State = 0, &quot; cm&quot;, &quot;&quot;), (x1 + x2) / 2, (y1 + y2) / 2, Shapes,0
        End If
        MarqueAngle x1, y1, x0, y0, x2, y2, (Val(t1) &gt; 180), 1, 0, Shapes
    End If
    If (oRectangleForm.Model.OptionButton5.State = 1) Then
        b = b * 1000
        a = a * Pi /180
        If CestUneFigureGeometrique Then
            posx = (xmin + xmax) / 2 - b / 2
            posy = (ymin + ymax) / 2 - b * Tan(a) / 2
        End If
        x0 = posx
        y0 = posy
        x1 = x0 + b
        y1 = y0
        x2 = x1
        y2 = y1 + b * Tan(a)
        x3 = x0
        y3 = y2
        UnRectangle=InsereQuadrilatere(x0, y0, x1, y1, x2, y2, x3, y3, Shapes,oRectangleForm.Model.ImageControl9)
        If afmesure Then
            InsereTexte t1 &amp; MIif(oRectangleForm.Model.CheckBox40.State = 0, &quot;°&quot;, &quot;&quot;), x0, y0, Shapes,0
            InsereTexte t2 &amp; MIif(oRectangleForm.Model.CheckBox40.State = 0, &quot; cm&quot;, &quot;&quot;), (x0 + x1) / 2, (y0 + y1) / 2, Shapes,0
        End If
        MarqueAngle x1, y1, x0, y0, x2, y2, (Val(t1) &gt; 180), 1, 0, Shapes
    End If
    
    If oRectangleForm.Model.CheckBox6.State = 1 Then
        MarqueAngleDroit x0, y0, x1, y1, Shapes, oRectangleForm.Model.ImageControl9
        MarqueAngleDroit x1, y1, x2, y2, Shapes, oRectangleForm.Model.ImageControl9
        MarqueAngleDroit x2, y2, x3, y3, Shapes, oRectangleForm.Model.ImageControl9
        MarqueAngleDroit x3, y3, x0, y0, Shapes, oRectangleForm.Model.ImageControl9
    End If
    If oRectangleForm.Model.CheckBox8.Enabled And oRectangleForm.Model.CheckBox8.State = 1 Then
        CodeLongueur x0, y0, x1, y1, val(oRectangleForm.Model.Label9.Label), Shapes, oRectangleForm.Model.ImageControl9
        CodeLongueur x3, y3, x2, y2, val(oRectangleForm.Model.Label9.Label), Shapes, oRectangleForm.Model.ImageControl9
        CodeLongueur x0, y0, x3, y3, val(oRectangleForm.Model.Label10.Label), Shapes, oRectangleForm.Model.ImageControl9
        CodeLongueur x1, y1, x2, y2, val(oRectangleForm.Model.Label10.Label), Shapes, oRectangleForm.Model.ImageControl9
    End If
    mm1 = False
    mm2 = False
    If oRectangleForm.Model.CheckBox1.State = 1 Then
        UneLigne=InsereLigne(x0, y0, x2, y2, Shapes, oRectangleForm.Model.ImageControl7)
        If oRectangleForm.Model.CheckBox7.Enabled And oRectangleForm.Model.CheckBox7.State = 1 Then
            CodeLongueur x0, y0, (x0 + x2) / 2, (y0 + y2) / 2, val(oRectangleForm.Model.Label8.Label), Shapes, oRectangleForm.Model.ImageControl7
            CodeLongueur x2, y2, (x0 + x2) / 2, (y0 + y2) / 2, val(oRectangleForm.Model.Label8.Label), Shapes, oRectangleForm.Model.ImageControl7
            If oRectangleForm.Model.CheckBox2.State = 0 Then
                MarqueMilieu x0, y0, x2, y2, Shapes, oRectangleForm.Model.ImageControl7
                mm1 = True
            End If
        End If
    End If
    If oRectangleForm.Model.CheckBox2.State = 1 Then
        UneLigne=InsereLigne(x1, y1, x3, y3, Shapes, oRectangleForm.Model.ImageControl7)
        If oRectangleForm.Model.CheckBox7.Enabled And oRectangleForm.Model.CheckBox7.State = 1 Then
            CodeLongueur x1, y1, (x1 + x3) / 2, (y1 + y3) / 2, val(oRectangleForm.Model.Label8.Label), Shapes, oRectangleForm.Model.ImageControl7
            CodeLongueur x3, y3, (x1 + x3) / 2, (y1 + y3) / 2, val(oRectangleForm.Model.Label8.Label), Shapes, oRectangleForm.Model.ImageControl7
            If oRectangleForm.Model.CheckBox1.State = 0 Then
                MarqueMilieu x1, y1, x3, y3, Shapes, oRectangleForm.Model.ImageControl7
                mm2 = True
            End If
        End If
    End If
    If oRectangleForm.Model.CheckBox3.State = 1 Then
        UneLigne=InsereLigne((x0 + x1) / 2, y0, (x0 + x1) / 2, y2, Shapes, oRectangleForm.Model.ImageControl8)
    End If
    If oRectangleForm.Model.CheckBox4.State = 1 Then
        UneLigne=InsereLigne(x0, (y1 + y2) / 2, x1, (y1 + y2) / 2, Shapes, oRectangleForm.Model.ImageControl8)
    End If
    ga = 20
    gb = ga - 2
    If CestUneFigureGeometrique Then
        AjoutePoint x0, y0, oRectangleForm.Model.TextField3.Text, InsereTexte(oRectangleForm.Model.TextField3.Text, (ga * x0 - x1 - x3) / gb, (ga * y0 - y1 - y3) / gb, Shapes), True
        AjoutePoint x1, y1, oRectangleForm.Model.TextField4.Text, InsereTexte(oRectangleForm.Model.TextField4.Text, (ga * x1 - x0 - x2) / gb, (ga * y1 - y0 - y2) / gb, Shapes), True
        AjoutePoint x2, y2, oRectangleForm.Model.TextField5.Text, InsereTexte(oRectangleForm.Model.TextField5.Text, (ga * x2 - x1 - x3) / gb, (ga * y2 - y1 - y3) / gb, Shapes), True
        AjoutePoint x3, y3, oRectangleForm.Model.TextField6.Text, InsereTexte(oRectangleForm.Model.TextField6.Text, (ga * x3 - x1 - x2) / gb, (ga * y3 - y1 - y2) / gb, Shapes), True
        LesCarres(NbCarre).nom = oRectangleForm.Model.TextField3.Text &amp; oRectangleForm.Model.TextField4.Text &amp; oRectangleForm.Model.TextField5.Text &amp; oRectangleForm.Model.TextField6.Text
        LesCarres(NbCarre).Point(0) = oRectangleForm.Model.TextField3.Text
        LesCarres(NbCarre).Point(1) = oRectangleForm.Model.TextField4.Text
        LesCarres(NbCarre).Point(2) = oRectangleForm.Model.TextField5.Text
        LesCarres(NbCarre).Point(3) = oRectangleForm.Model.TextField6.Text
        LesCarres(NbCarre).Shape = UnRectangle
        NbCarre = NbCarre + 1
    End If
    If oRectangleForm.Model.CheckBox10.State = 1 And (Not CestUneFigureGeometrique) Then
    	NormaliseCoordonnees(xn, yn, x1, y1, x0, y0, x3, y3)
        InsereTexte(oRectangleForm.Model.TextField3.Text, xn, yn, Shapes, 0, 0, 0)
    	NormaliseCoordonnees(xn, yn, x0, y0, x1, y1, x2, y2)
        InsereTexte(oRectangleForm.Model.TextField4.Text, xn, yn, Shapes, 0, 0, 0)
    	NormaliseCoordonnees(xn, yn, x1, y1, x2, y2, x3, y3)
        InsereTexte(oRectangleForm.Model.TextField5.Text, xn, yn, Shapes, 0, 0, 0)
    	NormaliseCoordonnees(xn, yn, x2, y2, x3, y3, x0, y0)
        InsereTexte(oRectangleForm.Model.TextField6.Text, xn, yn, Shapes, 0, 0, 0)
    End If
    Dim TraceCroix as Boolean
    TraceCroix = Not (((oRectangleForm.Model.CheckBox2.State = 0) And (Not mm1)) or ((oRectangleForm.Model.CheckBox1.State = 0) And (Not mm2)) or (oRectangleForm.Model.CheckBox1.State = 1 and oRectangleForm.Model.CheckBox2.State = 1))
    If oRectangleForm.Model.CheckBox11.State = 1 Then
        xm = (x0 + x2) / 2
        ym = (y0 + y2) / 2
        
        If (oRectangleForm.Model.CheckBox2.State = 0) And (Not mm1) Then MarqueMilieu x0, y0, x2, y2, Shapes, oRectangleForm.Model.ImageControl7
        If (oRectangleForm.Model.CheckBox1.State = 0) And (Not mm2) Then MarqueMilieu x1, y1, x3, y3, Shapes, oRectangleForm.Model.ImageControl7
        AjoutePoint xm, ym, oRectangleForm.Model.TextField7.Text, InsereTexte(oRectangleForm.Model.TextField7.Text, xm, ym, Shapes), TraceCroix, 0, Shapes
    End If
    If oRectangleForm.Model.CheckBox18.State = 1 Then
        xm = (x0 + x2) / 2
        ym = (y0 + y2) / 2
        If oRectangleForm.Model.CheckBox11.State = 0 And oRectangleForm.Model.CheckBox20.State = 1 Then
            If (oRectangleForm.Model.CheckBox2.State = 0) And (Not mm1) Then MarqueMilieu x0, y0, x2, y2, Shapes, oRectangleForm.Model.ImageControl7
            If (oRectangleForm.Model.CheckBox1.State = 0) And (Not mm2) Then MarqueMilieu x1, y1, x3, y3, Shapes, oRectangleForm.Model.ImageControl7
            AjoutePoint xm, ym, oRectangleForm.Model.TextField7.Text, InsereTexte(oRectangleForm.Model.TextField7.Text, xm, ym, Shapes), TraceCroix, 0, Shapes
        End If
        InsereCercle xm, ym, Sqr((x0 - xm) ^ 2 + (y0 - ym) ^ 2), Shapes, oRectangleForm.Model.ImageControl11
    End If
	Dim aPoint As New com.sun.star.awt.Point
    Dim TheSize as new com.sun.star.awt.Size
    Dim Group as Object
    Dim Coeff
    
	aPoint.x=3000
	aPoint.y=3000
	Group = GroupeObjet(Shapes)
	Group.Position=aPoint
	TheSize=Group.Size
	coeff=oRectangleForm.Model.Echelle.Text
	RemplaceVirgulePoint(coeff)
	TheSize.width = TheSize.Width*val(coeff)/100
	TheSize.height= TheSize.Height*val(coeff)/100
	Group.Size=TheSize
	TermineDessin()
Exit Sub
erreur:
	TermineDessin()
    MsgBox MessageErreur
End Sub

Private Sub RectangleForm_OptionButton1_Click()
    oRectangleForm.Model.CheckBox1.State = 0
    oRectangleForm.Model.CheckBox2.State = 0
    RectangleForm_ActiveLabel 1, 1
End Sub

Private Sub RectangleForm_OptionButton2_Click()
    oRectangleForm.Model.CheckBox1.State = 0
    oRectangleForm.Model.CheckBox2.State = 1
    RectangleForm_ActiveLabel 1, 1
End Sub

Private Sub RectangleForm_OptionButton3_Click()
    oRectangleForm.Model.CheckBox1.State = 1
    oRectangleForm.Model.CheckBox2.State = 1
    RectangleForm_ActiveLabel 0, 1
End Sub

Private Sub RectangleForm_OptionButton4_Click()
    oRectangleForm.Model.CheckBox1.State = 1
    oRectangleForm.Model.CheckBox2.State = 0
    RectangleForm_ActiveLabel 0, 1
End Sub

Private Sub RectangleForm_OptionButton5_Click()
    oRectangleForm.Model.CheckBox1.State = 1
    oRectangleForm.Model.CheckBox2.State = 0
    RectangleForm_ActiveLabel 0, 1
End Sub

Private Sub RectangleForm_Maj_Label()
    oRectangleForm.Model.CheckBox1.Label = &quot;[&quot; &amp; MIif(val(oRectangleForm.Model.TextField3.Text) &lt; val(oRectangleForm.Model.TextField5.Text), oRectangleForm.Model.TextField3.Text &amp; oRectangleForm.Model.TextField5.Text, oRectangleForm.Model.TextField5.Text &amp; oRectangleForm.Model.TextField3.Text) &amp; &quot;]&quot;
    oRectangleForm.Model.CheckBox2.Label = &quot;[&quot; &amp; MIif(val(oRectangleForm.Model.TextField4.Text) &lt; val(oRectangleForm.Model.TextField6.Text), oRectangleForm.Model.TextField4.Text &amp; oRectangleForm.Model.TextField6.Text, oRectangleForm.Model.TextField6.Text &amp; oRectangleForm.Model.TextField4.Text) &amp; &quot;]&quot;
