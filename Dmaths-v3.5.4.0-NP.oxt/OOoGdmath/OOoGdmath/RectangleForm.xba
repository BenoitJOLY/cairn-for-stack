	AfficheCodageLForm()
    oRectangleForm.Model.Label8.Label = oCodageLForm.Model.Label2.label
    RectangleForm_AfficheBouton()
End Sub

Private Sub RectangleForm_CommandButton2_Click()
	AfficheCodageLForm()
    oRectangleForm.Model.Label9.Label = oCodageLForm.Model.Label2.label
    RectangleForm_AfficheBouton()
End Sub

Private Sub RectangleForm_CommandButton3_Click()
	AfficheCodageLForm()
    oRectangleForm.Model.Label10.Label = oCodageLForm.Model.Label2.label
    RectangleForm_AfficheBouton()
End Sub

