Option Explicit

Dim oRectangleForm as Object

Sub Main
on error resume next
	oRectangleForm=LoadDialog(&quot;OOoGdmath&quot;,&quot;RectangleForm&quot;)
	ChangeTitreDialog(oRectangleForm)
&apos;	RestaureForm(oRectangleForm)
	oRectangleForm.Model.Step=1
    oRectangleForm.Model.ImageControl1.ImageURL = fCheminImages &amp; &quot;rec1.gif&quot;
    oRectangleForm.Model.ImageControl2.ImageURL = fCheminImages &amp; &quot;rec2.gif&quot;
    oRectangleForm.Model.ImageControl3.ImageURL = fCheminImages &amp; &quot;rec3.gif&quot;
    oRectangleForm.Model.ImageControl4.ImageURL = fCheminImages &amp; &quot;rec4.gif&quot;
    oRectangleForm.Model.ImageControl5.ImageURL = fCheminImages &amp; &quot;rec5.gif&quot;
    RectangleForm_AfficheBouton()
	oRectangleForm.Execute()
End Sub

Private Sub RectangleForm_AfficheBouton()
Dim AfficheBouton as Boolean
    AfficheBouton = (oRectangleForm.Model.CheckBox8.State = 1 )
	oRectangleForm.GetControl(&quot;ImageControl12&quot;).Visible = AfficheBouton
	oRectangleForm.GetControl(&quot;ImageControl13&quot;).Visible = AfficheBouton
	oRectangleForm.GetControl(&quot;ImageControl14&quot;).Visible = AfficheBouton
	oRectangleForm.GetControl(&quot;ImageControl15&quot;).Visible = AfficheBouton
	oRectangleForm.GetControl(&quot;ImageControl10&quot;).Visible = (oRectangleForm.Model.CheckBox7.State = 1 )

    oRectangleForm.Model.ImageControl10.ImageURL = fCheminImages &amp; &quot;codagelongueur&quot; &amp; oRectangleForm.Model.Label8.Label &amp; &quot;.gif&quot;
    oRectangleForm.Model.ImageControl12.ImageURL = fCheminImages &amp; &quot;codagelongueur&quot; &amp; oRectangleForm.Model.Label9.Label &amp; &quot;.gif&quot;
    oRectangleForm.Model.ImageControl13.ImageURL = fCheminImages &amp; &quot;codagelongueur&quot; &amp; oRectangleForm.Model.Label9.Label &amp; &quot;.gif&quot;
    oRectangleForm.Model.ImageControl14.ImageURL = fCheminImages &amp; &quot;codagelongueur&quot; &amp; oRectangleForm.Model.Label10.Label &amp; &quot;.gif&quot;
    oRectangleForm.Model.ImageControl15.ImageURL = fCheminImages &amp; &quot;codagelongueur&quot; &amp; oRectangleForm.Model.Label10.Label &amp; &quot;.gif&quot;
End Sub

Private Sub RectangleForm_ActiveLabel(et1, et2)
    RectangleForm_Maj_Label
    If (et1) Then oRectangleForm.Model.Label4.Label = &quot;cm&quot; Else oRectangleForm.Model.Label4.Label = &quot;°&quot;
    If (et2) Then oRectangleForm.Model.Label5.Label = &quot;cm&quot; Else oRectangleForm.Model.Label5.Label = &quot;°&quot;
    oRectangleForm.Model.CheckBox7.Enabled = (oRectangleForm.Model.CheckBox1.State = 1 Or oRectangleForm.Model.CheckBox2.State = 1)
End Sub

Private Sub RectangleForm_AnnulerBouton_Click()
    oRectangleForm.EndExecute()
	SauveForm(oRectangleForm)
End Sub

