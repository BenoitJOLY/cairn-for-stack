    oRectangleForm.Model.CheckBox20.Enabled = (oRectangleForm.Model.CheckBox18.State = 1)
    oRectangleForm.Model.TextField8.Enabled = (oRectangleForm.Model.CheckBox18.State = 1)
End Sub

