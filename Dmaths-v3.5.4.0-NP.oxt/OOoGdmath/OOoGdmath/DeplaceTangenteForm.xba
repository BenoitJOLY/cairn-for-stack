Option Explicit
private UneLigne As object
private UneCroix As object
dim oDeplaceTangenteForm as object

Sub Main
End Sub

Private Sub DeplaceTangenteForm_TextBox1_Change()
dim tang as string
	on error resume next
	tang=oDeplaceTangenteForm.Model.TextField1.Text
	if instr(1,tang,&quot;.&quot;)&lt;&gt;0 then 
		tang=left(tang,len(tang)-2) &amp; right(tang,1)
	else
		tang=tang &amp; &quot;0&quot;
	end if
	oDeplaceTangenteForm.Model.ScrollBar1.ScrollValue=val(tang)
	TraceTangente
End Sub

Private Sub DeplaceTangenteForm_CommandButton1_Click()
	on error resume next
    oDocumentDessin.DrawPages.GetByIndex(0).remove(UneLigne)
    oDocumentDessin.DrawPages.GetByIndex(0).remove(UneCroix)
    oDeplaceTangenteForm.endexecute()
End Sub
Private Sub DeplaceTangenteForm_ScrollBar1()
dim tang as string

	tang=oDeplaceTangenteForm.Model.ScrollBar1.ScrollValue
	if right(tang,1)&lt;&gt;&quot;0&quot; then
		tang=left(tang,len(tang)-1) &amp; &quot;.&quot; &amp; right(tang,1)
	else
		tang=left(tang,len(tang)-1) &amp; &quot;.&quot; &amp; right(tang,1)
	end if
	oDeplaceTangenteForm.Model.TextField1.Text=tang
	TraceTangente
End Sub

Private Sub TraceTangente()
on error resume next
Dim x6, y6, rayon, xx, yy,ang,xx1,yy1
    x6 = Val(oDeplaceTangenteForm.Model.Label1.Label)
    y6 = Val(oDeplaceTangenteForm.Model.Label2.Label)
    rayon = Val(oDeplaceTangenteForm.Model.Label3.Label)
    ang=oDeplaceTangenteForm.Model.ScrollBar1.ScrollValue
    xx = x6 + rayon * Cos(ang*Pi/1800)
    yy = y6 + rayon * Sin(ang*Pi/1800)
    xx1=xx+3000*cos(ang*Pi/1800+Pi/2)
    yy1=yy+3000*sin(ang*Pi/1800+Pi/2)
	oDeplaceTangenteForm.Model.Label5.Label=int(xx)
	oDeplaceTangenteForm.Model.Label6.Label=int(yy)
	oDeplaceTangenteForm.Model.Label7.Label=int(xx1)
	oDeplaceTangenteForm.Model.Label8.Label=int(yy1)
    oDocumentDessin.DrawPages.GetByIndex(0).remove(UneLigne)
    oDocumentDessin.DrawPages.GetByIndex(0).remove(UneCroix)
    UneLigne=InsereLigne(xx1, yy1,2*xx-xx1, 2*yy-yy1)
    UneCroix=croix(xx,yy)
End Sub


</script:module>