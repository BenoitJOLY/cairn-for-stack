					<prop oor:name="Target" oor:type="xs:string">
						<value>_self</value>
					</prop>
					<prop oor:name="ImageIdentifier" oor:type="xs:string">
						<value>%origin%/OOoGdmath/Bitmaps/menu_redresse</value>
					</prop>
				</node>
					<node oor:name="btn04" oor:op="replace">
					<prop oor:name="Context" oor:type="xs:string">
						<value>com.sun.star.text.TextDocument,com.sun.star.drawing.DrawingDocument</value>
					</prop>
					<prop oor:name="Title" oor:type="xs:string">
						<value xml:lang="fr">Déplace les textes</value>
						<value xml:lang="et">Déplace les textes</value>
						<value xml:lang="de">Änderung von Textpositionen</value>
						<value xml:lang="pt">Mover o texto</value>
						<value xml:lang="es">Mover el texto</value>
					</prop>
					<prop oor:name="URL" oor:type="xs:string">
						<value>macro:///OOoGdmath.ChangerTexteCode.Main</value>
					</prop>
					<prop oor:name="Target" oor:type="xs:string">
						<value>_self</value>
					</prop>
					<prop oor:name="ImageIdentifier" oor:type="xs:string">
						<value>%origin%/OOoGdmath/Bitmaps/menu_changer</value>
