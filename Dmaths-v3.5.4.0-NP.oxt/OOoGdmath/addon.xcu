		<node oor:name="OfficeToolBar">
		<node oor:name="org.openoffice.Office.addon.OOoGdmathBarre1" oor:op="replace">
				<prop oor:name="Title" oor:type="xs:string">
					<value>Gdmath</value>
				</prop>
				<node oor:name="ToolBarItems">					
					<node oor:name="btn01" oor:op="replace">
						<prop oor:name="Context" oor:type="xs:string">
							<value>com.sun.star.text.TextDocument,com.sun.star.drawing.DrawingDocument</value>
						</prop>
						<prop oor:name="Title" oor:type="xs:string">
							<value>OOoGdmath</value>
						</prop>
						<prop oor:name="URL" oor:type="xs:string">
							<value>macro:///OOoGdmath.Debug.Main</value>
						</prop>
						<prop oor:name="Target" oor:type="xs:string">
