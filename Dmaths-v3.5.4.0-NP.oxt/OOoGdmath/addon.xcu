						</prop>
						<prop oor:name="ImageIdentifier" oor:type="xs:string">
							<value>%origin%/OOoGdmath/Bitmaps/Gdmath</value>
						</prop>
					</node>
					<node oor:name="btn07" oor:op="replace">
					<prop oor:name="URL">
						<value>private:separator</value>
					</prop>
				</node>
					<node oor:name="btn02" oor:op="replace">
					<prop oor:name="Context" oor:type="xs:string">
						<value>com.sun.star.text.TextDocument,com.sun.star.drawing.DrawingDocument</value>
					</prop>
					<prop oor:name="Title" oor:type="xs:string">
						<value xml:lang="fr">Redresse les textes</value>
						<value xml:lang="et">Redresse les textes</value>
						<value xml:lang="de">Ausrichtung von Grafiktext</value>
						<value xml:lang="pt">Realinhar o texto</value>
						<value xml:lang="es">Alinear el texto</value>
					</prop>
					<prop oor:name="URL" oor:type="xs:string">
						<value>macro:///OOoGdmath.Gdmath.RedresseTexte</value>
