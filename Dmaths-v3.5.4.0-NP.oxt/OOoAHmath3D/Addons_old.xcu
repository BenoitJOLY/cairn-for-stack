					</prop>
					<prop oor:name="ImageIdentifier" oor:type="xs:string">
						<value/>
					</prop>
				</node>

				<node oor:name="bo08" oor:op="replace">
					<prop oor:name="Context" oor:type="xs:string">
						<value>com.sun.star.text.TextDocument</value>
					</prop>
					<prop oor:name="Title" oor:type="xs:string">
						<value xml:lang="fr">Insère une pyramide régulière à base carrée (ou une pyramide à base rectangulaire) en perspective cavalière</value>
                                                <value xml:lang="pt">Inserir uma pirâmide regular de base quadrada/rectangular em perspectiva cavaleira</value>
						<value xml:lang="de">3D-Pyramide: rechteckige Grundfläche (Kavalierperspektive)</value>
						<value xml:lang="en">3D-pyramid: rectangular base (cavalier perspective)</value>
					        <value xml:lang="et">3D-pyramid: rectangular base (cavalier perspective)</value>
					</prop>
					<prop oor:name="URL" oor:type="xs:string">
						<value>macro:///OOoAHmath3D.PyrRectPc.PyrRectPcMacroPrincipale</value>
					</prop>
					<prop oor:name="Target" oor:type="xs:string">
						<value>_self</value>
					</prop>
					<prop oor:name="ImageIdentifier" oor:type="xs:string">
						<value/>
					</prop>
				</node>
				
				<node oor:name="bo09" oor:op="replace">
					<prop oor:name="Context" oor:type="xs:string">
						<value>com.sun.star.text.TextDocument</value>
					</prop>
					<prop oor:name="Title" oor:type="xs:string">
						<value xml:lang="fr">Insère un tronc de pyramide régulière à base carrée (ou à base rectangulaire) en perspective cavalière</value>
                                                <value xml:lang="pt">Inserir um tronco de pirâmide regular de base quadrada/rectangular em perspectiva cavaleira</value>
						<value xml:lang="de">3D-Pyramidenstumpf: rechteckige Grundfläche (Kavalierperspektive)</value>
						<value xml:lang="en">3D-truncated pyramid: rectangular base (cavalier perspective)</value>
                                                <value xml:lang="et">3D-truncated pyramid: rectangular base (cavalier perspective)</value>
					</prop>
					<prop oor:name="URL" oor:type="xs:string">
						<value>macro:///OOoAHmath3D.TroncPyrPc.TroncPyrPcMacroPrincipale</value>
					</prop>
					<prop oor:name="Target" oor:type="xs:string">
						<value>_self</value>
					</prop>
					<prop oor:name="ImageIdentifier" oor:type="xs:string">
						<value/>
					</prop>
				</node>
				
				<node oor:name="bo10" oor:op="replace">
					<prop oor:name="Context" oor:type="xs:string">
						<value>com.sun.star.text.TextDocument</value>
					</prop>
					<prop oor:name="Title" oor:type="xs:string">
						<value xml:lang="fr">Insère une pyramide "coin de pavé droit" à base rectangulaire en perspective cavalière</value>
                                                <value xml:lang="pt">Inserir pirâmide de canto quadrado, base rectangular em perspectiva cavaleira</value>
					        <value xml:lang="de">3D-Pyramide: Quaderecke, rechteckige Grundfläche (Kavalierperspektive)</value>
					        <value xml:lang="en">3D-pyramid: cuboid-corner, rectangular base (cavalier perspective)</value>
                                                <value xml:lang="et">3D-pyramid: cuboid-corner, rectangular base (cavalier perspective)</value>
					</prop>
					<prop oor:name="URL" oor:type="xs:string">
						<value>macro:///OOoAHmath3D.PyrOrthPc.PyrOrthPcMacroPrincipale</value>
					</prop>
					<prop oor:name="Target" oor:type="xs:string">
						<value>_self</value>
					</prop>
					<prop oor:name="ImageIdentifier" oor:type="xs:string">
						<value/>
					</prop>
				</node>
				
				<node oor:name="bo11" oor:op="replace">
					<prop oor:name="Context" oor:type="xs:string">
						<value>com.sun.star.text.TextDocument</value>
					</prop>
