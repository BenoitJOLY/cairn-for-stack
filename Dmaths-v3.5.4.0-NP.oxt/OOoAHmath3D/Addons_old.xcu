					<prop oor:name="Target" oor:type="xs:string">
						<value>_self</value>
					</prop>
					<prop oor:name="ImageIdentifier" oor:type="xs:string">
						<value/>
					</prop>
				</node>
				
				<node oor:name="bo04" oor:op="replace">
					<prop oor:name="Context" oor:type="xs:string">
						<value>com.sun.star.text.TextDocument</value>
					</prop>
					<prop oor:name="Title" oor:type="xs:string">
						<value xml:lang="fr">Insère un cône de révolution en 3D</value>
						<value xml:lang="pt">Inserir um cone de revolução em 3D</value>
						<value xml:lang="de">3D-Kegel</value>
						<value xml:lang="en">3D-cone</value>
