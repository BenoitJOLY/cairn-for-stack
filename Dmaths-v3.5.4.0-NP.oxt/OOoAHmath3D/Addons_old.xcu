		<node oor:name="OfficeToolBar">
			<node oor:name="org.openoffice.Office.addon.OOoAHmath3D.OfficeToolBar" oor:op="replace">
				<prop oor:name="Title" oor:type="xs:string">
				    <value>AHmaths3D</value>
				</prop>
				<node oor:name="ToolBarItems">														
				<node oor:name="bo01" oor:op="replace">
					<prop oor:name="Context" oor:type="xs:string">
						<value>com.sun.star.text.TextDocument</value>
					</prop>
					<prop oor:name="Title" oor:type="xs:string">
						<value xml:lang="fr">Insère un prisme droit en 3D</value>
						<value xml:lang="pt">Inserir um prisma reto em 3D</value>
						<value xml:lang="de">3D-Prisma</value>
						<value xml:lang="en">3D-prism</value>
						<value xml:lang="et">3D-prism</value>
					</prop>
					<prop oor:name="URL" oor:type="xs:string">
						<value>macro:///OOoAHmath3D.Prisme.PrismeMacroPrincipale</value>
					</prop>
					<prop oor:name="Target" oor:type="xs:string">
						<value>_self</value>
					</prop>
					<prop oor:name="ImageIdentifier" oor:type="xs:string">
						<value/>
					</prop>
				</node>
				
				
				<node oor:name="bo02" oor:op="replace">
					<prop oor:name="Context" oor:type="xs:string">
						<value>com.sun.star.text.TextDocument</value>
					</prop>
					<prop oor:name="Title" oor:type="xs:string">
					        <value xml:lang="fr">Insère un cylindre de révolution en 3D</value>
					        <value xml:lang="pt">Inserir um cilindro de revolução em 3D</value>
					        <value xml:lang="de">3D-Zylinder</value>
					        <value xml:lang="en">3D-cylinder</value>
					        <value xml:lang="et">3D-cylinder</value>
					</prop>
					<prop oor:name="URL" oor:type="xs:string">
