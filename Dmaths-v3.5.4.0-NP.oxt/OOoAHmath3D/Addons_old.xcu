					</prop>
					<prop oor:name="Title" oor:type="xs:string">
						<value xml:lang="fr">Insère une sphère en 3D</value>				
						<value xml:lang="pt">Inserir uma esfera em 3D</value>
                                                <value xml:lang="de">3D-Kugel</value>
						<value xml:lang="en">3D-sphere</value>
						<value xml:lang="et">3D-sphere</value>
