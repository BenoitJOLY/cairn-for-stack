REM  *****  BASIC  *****

Option Explicit

Private RepConeDlg(23) as variant
Private monDlg as object

sub ConeMacroPrincipale &apos;macro principale

appelerBoiteDialogueCone()

if RepConeDlg(21) = true then   
 DRAWversWRITER(&quot;Cone.ConstructionCone()&quot;)
 PositionObjetWriter(LastForme)
end if

end Sub
&apos;------------------------------------------------------------------------------------------------------
Sub appelerBoiteDialogueCone()

Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;ConeDlg&quot;)
&apos;-------------------------initialisation de la boite de dialogue-----------------------
Initialisation(monDlg,CheminDessin(&quot;Dessins/Cone/cone1.gif/&quot;))
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs et des infobulles ------
for i = 1 to 5
RepConeDlg(i + 18) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	

monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub

&apos;----------------------------------------------------------------------------------------------------
sub ConstructionCone()
TracerCone(10000,10000,RepConeDlg(0)*1000,RepConeDlg(1)*1000,RepConeDlg(2))
end sub

&apos;------------------------------------------------------------------------------------------------------
sub TracerCone(Xcentre as Double, Ycentre as Double , Rayon as Double , h1 as Double, AngIncl as Double)
Dim RadAngIncl as Double, AngleSecteurEllipse as double, AngleSecteurDisque as Double
Dim XSommet as Double, YSommet as  Double, YAngle as Double, XAngle as Double, AngleRayon as double, AngleDiam as double
Dim XTang1 as Double,   XTang2 as Double, YTang as  Double, vect1X as double, vect1Y as double
Dim a as double, b as double
Dim c as double, d as double, h as double


RadAngIncl =abs(AngIncl * pi / 180)  &apos;abs car il me faut un angle positif à cause du signe des sin
XSommet = Xcentre
if RepConeDlg(18) = 1 then           &apos;hauteur réelle sélectionnée
   h = h1*cos(RadAngIncl)            
   else
   h = h1                            
end if                                    

YSommet = Ycentre - h
AngleDiam = RepConeDlg(13)* pi/180
AngleRayon = RepConeDlg(9)* pi/180

a = Rayon
b = Rayon * sin(RadAngIncl)

if YSommet &lt; Ycentre - b then

&apos;tracé des tangentes et du cercle
YTang = Ycentre - b*b/h
XTang1 = Xcentre - a*sqr(1-b*b/(h*h))
XTang2 = Xcentre + a*sqr(1-b*b/(h*h))
YAngle = Ycentre - a*b / h
XAngle = XTang2
AngleSecteurDisque = Atn((Ycentre - YAngle)/(XAngle - Xcentre))*180/pi

c = a * sqr(1-b*b/(h*h))
d = b*b/h
AngleSecteurEllipse = 180 * Atn(d/c) / pi


&apos;le 3ème argument de ArcEllipse est la largeur de l&apos;ellipse entière
&apos;le 4ème argument de ArcEllipse est la hauteur de l&apos;ellipse entière
if AngIncl &gt; 0 then
ArcEllipseDraw(Xcentre - a, Ycentre - b,2*a,2*b,&quot;pointillé&quot;,AngleSecteurDisque,180 - AngleSecteurDisque)
ArcEllipseDraw(Xcentre - a, Ycentre - b ,2*a,2*b,&quot;plein&quot;,180 - AngleSecteurDisque ,AngleSecteurDisque )
end if
if AngIncl &lt; 0 then
ArcEllipseDraw(Xcentre - a, Ycentre - b,2*a,2*b,&quot;plein&quot;,AngleSecteurDisque,180 - AngleSecteurDisque)
ArcEllipseDraw(Xcentre - a, Ycentre - b,2*a,2*b,&quot;plein&quot;,180 - AngleSecteurDisque ,AngleSecteurDisque )
end if
if AngIncl = 0 then
SegmentDraw(Xcentre - a, Ycentre ,  Xcentre + a , Ycentre ,30,&quot;plein&quot;)
end if
SegmentDraw(Xsommet, Ysommet,  XTang1,  YTang,30,&quot;plein&quot;)
SegmentDraw(Xsommet, Ysommet,  XTang2,  YTang,30,&quot;plein&quot;)

&apos;tracé d&apos;un rayon
if RepConeDlg(4) = 1 then
  if RepConeDlg(8) = 1 then    &apos;rayon particulier
    if RepConeDlg(5) = 1 then
    SegmentDraw(Xcentre, Ycentre ,  Xcentre + a * cos(AngleRayon), Ycentre - a * sin(AngleRayon)*sin(RadAngIncl),30,&quot;plein&quot;)
    else
    SegmentDraw(Xcentre, Ycentre ,  Xcentre + a * cos(AngleRayon), Ycentre - a * sin(AngleRayon)*sin(RadAngIncl),30,&quot;pointillé&quot;)
    end if
  end if
  if RepConeDlg(7) = 1 then   &apos;rayon par défaut
   if RepConeDlg(5) = 1 then
    SegmentDraw(Xcentre, Ycentre ,  XTang2, YTang,30,&quot;plein&quot;)
    else
    SegmentDraw(Xcentre, Ycentre ,  XTang2, YTang,30,&quot;pointillé&quot;)
    end if
  end if
end if

&apos;tracé de la hauteur
if RepConeDlg(14) = 1 then
   if  RepConeDlg(15) = 1 then
   SegmentDraw(XSommet, YSommet ,  Xcentre , Ycentre,30,&quot;plein&quot;)
   else
   SegmentDraw(XSommet, YSommet ,  Xcentre , Ycentre,30,&quot;pointillé&quot;)
   end if
   &apos;tracé de l&apos;angle droit
   if RepConeDlg(17) = 1 then
    if  RepConeDlg(4) = 1 and  RepConeDlg(7) = 1 then &apos;si rayon par défaut
    vect1X = ((XTang2 - Xcentre)/sqr(PuisN(XTang2 - Xcentre,2)+PuisN(YTang - Ycentre,2)))
    vect1Y = -((YTang - Ycentre)/sqr(PuisN(XTang2 - Xcentre,2)+PuisN(YTang - Ycentre,2)))
    end if
    if RepConeDlg(4) = 1 and   RepConeDlg(8) = 1 then &apos;si rayon particulier
    vect1X = (( a * cos(AngleRayon))/sqr(PuisN( a * cos(AngleRayon),2)+PuisN(a * sin(AngleRayon)*sin(RadAngIncl),2)))
    vect1Y = ((a * sin(AngleRayon)*sin(RadAngIncl))/sqr(PuisN( a * cos(AngleRayon),2)+PuisN(a * sin(AngleRayon)*sin(RadAngIncl),2)))
    end if
    if  RepConeDlg(10) = 1 and RepConeDlg(4) = 0 then &apos;si diamètre sans rayon
    vect1X = (( a * cos(AngleDiam))/sqr(PuisN( a * cos(AngleDiam),2)+PuisN(a * sin(AngleDiam)*sin(RadAngIncl),2)))
    vect1Y = ((a * sin(AngleDiam)*sin(RadAngIncl))/sqr(PuisN( a * cos(AngleDiam),2)+PuisN(a * sin(AngleDiam)*sin(RadAngIncl),2)))
    end if
    if  RepConeDlg(10) = 0 and RepConeDlg(4) = 0 then &apos;si aucun diamètre aucun rayon 
    vect1X = abs((XTang2 - Xcentre)/sqr(PuisN(XTang2 - Xcentre,2)+PuisN(YTang - Ycentre,2)))
    vect1Y = abs((YTang - Ycentre)/sqr(PuisN(XTang2 - Xcentre,2)+PuisN(YTang - Ycentre,2)))
    end if
    QuadrilatereDraw(Xcentre, Ycentre , Xcentre + vect1X * 250 ,Ycentre - vect1Y * 250  ,Xcentre +  vect1X * 250 ,Ycentre -  vect1Y * 250 - 250,Xcentre, Ycentre - 250 , 30)
  end if	
end if
end if

if YSommet &gt;= Ycentre - b then
    ArcEllipseDraw(Xcentre - a, Ycentre - b,2*a,2*b,&quot;plein&quot;,0,180)
    ArcEllipseDraw(Xcentre - a, Ycentre- b ,2*a,2*b,&quot;plein&quot;,180,0)
    CercleDraw(Xsommet - 10, Ysommet - 10, 20, 30)
    &apos;tracé d&apos;un rayon
    if RepConeDlg(4) = 1 then
       if RepConeDlg(8) = 1 then  &apos;rayon particulier
          if RepConeDlg(5) = 1 then
          SegmentDraw(Xcentre, Ycentre ,  Xcentre + a * cos(AngleRayon), Ycentre - a * sin(AngleRayon)*sin(RadAngIncl),30,&quot;plein&quot;)
          else
          SegmentDraw(Xcentre, Ycentre ,  Xcentre + a * cos(AngleRayon), Ycentre - a * sin(AngleRayon)*sin(RadAngIncl),30,&quot;pointillé&quot;)
          end if
       end if
       if RepConeDlg(7) = 1 then &apos;rayon par défaut
         if RepConeDlg(5) = 1 then
         SegmentDraw(Xcentre, Ycentre ,  Xcentre + a * cos(pi/4), Ycentre - a * sin(pi/4)*sin(RadAngIncl),30,&quot;plein&quot;)
         else
         SegmentDraw(Xcentre, Ycentre ,  Xcentre + a * cos(pi/4), Ycentre - a * sin(pi/4)*sin(RadAngIncl),30,&quot;pointillé&quot;)
       end if
         
       end if
    end if

&apos;tracé de la hauteur
   if RepConeDlg(14) = 1 then
      if  RepConeDlg(15) = 1 then
      SegmentDraw(XSommet, YSommet ,  Xcentre , Ycentre,30,&quot;plein&quot;)
      else
      SegmentDraw(XSommet, YSommet ,  Xcentre , Ycentre,30,&quot;pointillé&quot;)
      end if
&apos;tracé de l&apos;angle droit
   if RepConeDlg(17) = 1 then
      if  RepConeDlg(4) = 1 and  RepConeDlg(7) = 1 then &apos;si rayon par défaut
         vect1X = 1
         vect1Y = 1
      end if
      if RepConeDlg(4) = 1 and   RepConeDlg(8) = 1 then &apos;si rayon particulier
         vect1X = (( a * cos(AngleRayon))/sqr(PuisN( a * cos(AngleRayon),2)+PuisN(a * sin(AngleRayon)*sin(RadAngIncl),2)))
         vect1Y = ((a * sin(AngleRayon)*sin(RadAngIncl))/sqr(PuisN( a * cos(AngleRayon),2)+PuisN(a * sin(AngleRayon)*sin(RadAngIncl),2)))
      end if
      if  RepConeDlg(10) = 1 and RepConeDlg(4) = 0 then &apos;si diamètre sans rayon 
         vect1X = (( a * cos(AngleDiam))/sqr(PuisN( a * cos(AngleDiam),2)+PuisN(a * sin(AngleDiam)*sin(RadAngIncl),2)))
         vect1Y = ((a * sin(AngleDiam)*sin(RadAngIncl))/sqr(PuisN( a * cos(AngleDiam),2)+PuisN(a * sin(AngleDiam)*sin(RadAngIncl),2)))
      end if
      if  RepConeDlg(10) = 0 and RepConeDlg(4) = 0 then &apos;si aucun diamètre aucun rayon 
         vect1X = 1
         vect1Y = 1
      end if
    QuadrilatereDraw(Xcentre, Ycentre , Xcentre + vect1X * 250 ,Ycentre - vect1Y * 250,Xcentre +  vect1X * 250 ,Ycentre -  vect1Y * 250 - 250, Xcentre, Ycentre - 250 , 30)
   end if	
 end if
end if



&apos;tracé du centre de la base
if RepConeDlg(3) = 1 then
SegmentDraw(Xcentre-100, Ycentre + 100*sin(RadAngIncl) ,  Xcentre + 100, Ycentre - 100*sin(RadAngIncl),30,&quot;plein&quot;)
SegmentDraw(Xcentre-100, Ycentre - 100*sin(RadAngIncl),  Xcentre + 100,  Ycentre + 100*sin(RadAngIncl),30,&quot;plein&quot;)
end if
&apos;tracé d&apos;un diamètre
if RepConeDlg(10) = 1 then
    if RepConeDlg(11) = 1 then
    SegmentDraw(Xcentre - a * cos(AngleDiam), Ycentre + a * sin(AngleDiam)*sin(RadAngIncl),  Xcentre + a * cos(AngleDiam), Ycentre - a * sin(AngleDiam)*sin(RadAngIncl),30,&quot;plein&quot;)
    else
    SegmentDraw(Xcentre - a * cos(AngleDiam), Ycentre + a * sin(AngleDiam)*sin(RadAngIncl) ,  Xcentre + a * cos(AngleDiam), Ycentre - a * sin(AngleDiam)*sin(RadAngIncl),30,&quot;pointillé&quot;)
    end if
end if

end sub

&apos;****************************************************Gestion de la boite de dialogue*****************************************************************

Sub GestionInfoBulle
TexteAide(monDlg,&quot;RepCone1&quot;, &quot;0&lt; ... &lt;= 10&quot;)
TexteAide(monDlg,&quot;RepCone2&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;RepCone3&quot;, &quot;-90&lt;= ... &lt;= 90&quot;)
TexteAide(monDlg,&quot;RepCone10&quot;, &quot;0&lt;= ... &lt;= 360&quot;)
TexteAide(monDlg,&quot;RepCone14&quot;, &quot;0&lt;= ... &lt;= 180&quot;)
end sub


sub GestionCase1
Aspect2BoutonsRadio(monDlg,&quot;RepCone5&quot;,&quot;RepCone6&quot;,&quot;RepCone7&quot;)
Aspect2BoutonsRadio(monDlg,&quot;RepCone5&quot;,&quot;RepCone8&quot;,&quot;RepCone9&quot;)
AspectLabel(monDlg,&quot;RepCone5&quot;,&quot;Label14&quot;)
AspectCheckbox(monDlg,&quot;RepCone5&quot;,&quot;RepCone10&quot;,0)
end sub
sub GestionCase2
Aspect2BoutonsRadio(monDlg,&quot;RepCone11&quot;,&quot;RepCone12&quot;,&quot;RepCone13&quot;)
AspectCheckbox(monDlg,&quot;RepCone11&quot;,&quot;RepCone14&quot;,0)
AspectLabel(monDlg,&quot;RepCone11&quot;,&quot;Label15&quot;)
end sub

sub GestionCase3
Aspect2BoutonsRadio(monDlg,&quot;RepCone15&quot;,&quot;RepCone16&quot;,&quot;RepCone17&quot;)
AspectCheckbox(monDlg,&quot;RepCone15&quot;,&quot;RepCone18&quot;)
end sub


sub GestionImage
ChangerImagePrincipalex2(monDlg , &quot;RepCone3&quot;, CheminDessin(&quot;Dessins/Cone/cone1.gif/&quot;),CheminDessin(&quot;Dessins/Cone/cone2.gif/&quot;), CheminDessin(&quot;Dessins/erreur.gif/&quot;))
end sub



sub GestionBoutonOK  
Dim i as integer, test(6) as integer

&apos;-----------------------Gestion des erreurs de saisie
test(1) = ZT_Nbre(monDlg,  &quot;RepCone1&quot;, 0.001 , 10 , 3 , RepConeDlg(19),)
test(2) = ZT_Nbre(monDlg,  &quot;RepCone2&quot;, 0.001 , 20 , 5 , RepConeDlg(20),) 
test(3) = ZT_Nbre(monDlg,  &quot;RepCone3&quot;, -90 , 90 , 10 , RepConeDlg(21),)
test(4) = ZT_Nbre(monDlg,  &quot;RepCone10&quot;, 0 , 360 , 0 , RepConeDlg(22),) 
test(5) = ZT_Nbre(monDlg,  &quot;RepCone14&quot;, 0 , 180 , 0 , RepConeDlg(23),)   &apos; 0 ou 1

     
test(0) = test(1)*test(2)*test(3)*test(4)*test(5)   
&apos;---------------------- (test(0) contient 1 si tout est ok 0 sinon)

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
    for i = 1 to 3
    RepConeDlg(i - 1) = CDbl(monDlg.getControl(&quot;RepCone&quot;&amp;i).Peer.Text)
    Next
    RepConeDlg(9) = CDbl(monDlg.getControl(&quot;RepCone10&quot;).Peer.Text)
    RepConeDlg(13) = CDbl(monDlg.getControl(&quot;RepCone14&quot;).Peer.Text)
    for i = 4 to 9
    RepConeDlg(i - 1) = monDlg.getControl(&quot;RepCone&quot;&amp;i).Model.state  
    Next 
    for i = 11 to 13
    RepConeDlg(i - 1) = monDlg.getControl(&quot;RepCone&quot;&amp;i).Model.state  
    Next
    for i = 15 to 20
    RepConeDlg(i - 1) = monDlg.getControl(&quot;RepCone&quot;&amp;i).Model.state  
    Next

    RepConeDlg(21) = true  
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé

&apos;---------------------    RepConeDlg(21) = true quand tout est validé
    monDlg.endExecute
end if

End Sub
</script:module>