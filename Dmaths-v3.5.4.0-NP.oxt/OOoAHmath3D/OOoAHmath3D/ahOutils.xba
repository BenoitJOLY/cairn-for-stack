REM  *****  BASIC  *****


&apos;--------------------------------------------------------------------------------
&apos;Renvoie la dernière forme d&apos;une page writer
&apos;--------------------------------------------------------------------------------
Function LastForme as Object
Dim monDocument As Object, maPage As Object, NombreFormes as Double
Dim maForme As Object

monDocument = ThisComponent
maPage = monDocument.DrawPage

NombreFormes = maPage.Count
maForme = maPage(NombreFormes - 1)
&apos;msgbox(maForme.LayerName)    information sur la couche de dessin
LastForme = maForme
end Function

&apos;--------------------------------------------------------------------------------
&apos;Groupe les n dernières forme d&apos;une page et selectionne la forme finale
&apos;--------------------------------------------------------------------------------
sub GroupeFormes (n as variant)
Dim monDocument As Object, maPage As Object, NombreFormes as Double,GroupElements as object, maForme1 as object, maForme2 as object

monDocument = ThisComponent
maPage = monDocument.DrawPage

NombreFormes = maPage.Count

GroupElements = createUnoService(&quot;com.sun.star.drawing.ShapeCollection&quot;)
for i = 1 to n
GroupElements.add(maPage(NombreFormes - i))
Next
maForme1 = maPage.group(GroupElements)
maForme2 = LastForme
maForme2.Surround = com.sun.star.text.WrapTextMode.THROUGHT  &apos;text au travers
maForme2.Opaque = true
monDocument.CurrentController.select(maForme2)&apos; La methode select ne fonctionne plus avec oo3.3 mais ne fait pas bugger le programme
end sub


&apos;--------------------------------------------------------------------------------
&apos;renvoie le min et le max d&apos;un tableau à 1 ligne et n colonnes
&apos;--------------------------------------------------------------------------------
function MinMax(tableauNx1 as variant) as variant
Dim IndexMin as Integer, IndexMax as Integer, Min as Double, Max as Double
Dim k as Integer

&apos;IndexMin = LBound(tableauNx1)
IndexMax = UBound(tableauNx1)

Min = tableauNx1(0)
Max = tableauNx1(0)

for k = 1 to IndexMax
if tableauNx1(k) &lt; Min then
   Min = tableauNx1(k)
end if
if tableauNx1(k) &gt; Max then
   Max = tableauNx1(k)
end if
Next

MinMax = Array(Min, Max)

end function

&apos;--------------------------------------------------------------------------------
&apos;renvoie la xième ligne d&apos;un tableau a m lignes et n colonnes
&apos;--------------------------------------------------------------------------------

function Lignex(x as integer, monTableau as variant) as variant
Dim k as integer, IndexMax as Double
Dim meineTabelle as variant

IndexMax = Ubound(monTableau)     &apos;n = IndexMax    m = Ubound(montableau(0))

Dim var1(IndexMax) as variant

for k = 0 to IndexMax

meineTabelle = monTableau(k)
var1(k) = meineTabelle(x - 1)
&apos;var1(k) = monTableau(k)(x - 1)
next
Lignex = var1
end function


&apos;--------------------------------------------------------------------------------
&apos;--- supprime la j ème valeur d&apos;un tableau à 1 ligne et n colonnes - commence à zéro
&apos;--- et renvoie le tableau avec les colonnes décalées vers la gauche et vide la dernière
&apos;--------------------------------------------------------------------------------

function SupjTab1xN(monTableau as variant, j as integer) as variant
Dim IndexMax as Double , k as integer
IndexMax = Ubound(monTableau)

Dim TabProvisoire(IndexMax) as variant
for k = 0 to IndexMax
if k&lt;j then
TabProvisoire(k)=monTableau(k)
end if
if k&gt;j then
TabProvisoire(k-1)=monTableau(k)
end if
TabProvisoire(IndexMax)= &quot;&quot;
next
SupjTab1xN = TabProvisoire
end function


&apos;--------------------------------------------------------------------------------
&apos;crée un tableau 2 lignes n colonnes a partir de 2 lignes de n cases
&apos;--------------------------------------------------------------------------------
function Tableau2xN(Ligne1 as  variant, Ligne2 as variant) as variant

Dim Index as integer, Point(1) as variant, k as integer

Index = UBound(Ligne1)

Dim varTab1(Index) as variant

for k = 0 to Index
Point = array(Ligne1(k),Ligne2(k))
varTab1(k) = Point
Next

Tableau2xN = varTab1

end function

&apos;--------------------------------------------------------------------------------
&apos;crée un tableau 3 lignes n colonnes a partir de 3 lignes de n cases
&apos;--------------------------------------------------------------------------------
function Tableau3xN(Ligne1 as  variant, Ligne2 as variant, Ligne3 as variant) as variant

Dim Index as integer, Point(2) as variant, k as integer

Index = UBound(Ligne1)

Dim varTab1(Index) as variant

for k = 0 to Index
Point = array(Ligne1(k),Ligne2(k),Ligne3(k))
varTab1(k) = Point
Next

Tableau3xN = varTab1

end function

&apos;--------------------------------------------------------------------------------
&apos;crée un tableau 4 lignes n colonnes a partir de 4 lignes de n cases
&apos;--------------------------------------------------------------------------------
function Tableau4xN(Ligne1 as  variant, Ligne2 as variant, Ligne3 as variant ,  Ligne4 as variant) as variant

Dim Index as integer, Point(3) as variant, k as integer

Index = UBound(Ligne1)

Dim varTab1(Index) as variant

for k = 0 to Index
Point = array(Ligne1(k),Ligne2(k),Ligne3(k),Ligne4(k))
varTab1(k) = Point
Next

Tableau4xN = varTab1

end function

&apos;--------------------------------------------------------------------------------
&apos;supprime tous les dessins d&apos;une page
&apos;--------------------------------------------------------------------------------
sub SupprimeDessins
Dim monDocument As Object, maPage As Object, NombreFormes as Double, maForme as object
Dim k as integer
monDocument = ThisComponent
maPage = monDocument.DrawPage
NombreFormes = maPage.Count
msgbox(NombreFormes)
for k = 1 to NombreFormes
maForme = maPage(NombreFormes - k)
maPage.remove(maForme)
Next

end sub


&apos;--------------------------------------------------------------------------------
&apos;renvoie la puissance N d&apos;un nombre avec N&gt;= 1
&apos;--------------------------------------------------------------------------------
function PuisN(Nombre as double, N as integer)
Dim J as integer, Reponse as double

Reponse = 1
for j = 1 to N
Reponse = Reponse * Nombre
Next
PuisN = Reponse
end function

&apos;--------------------------------------------------------------------------------
&apos;renvoie true si la chaine d&apos;une zone de texte est un nombre et qu&apos;elle est
&apos; comprise entre borne1 et borne2 incluses
&apos;option entier teste aussi si le nombre est un entier
&apos;--------------------------------------------------------------------------------
function estunnombreentrebornes(variable as variant,borne1 as double, borne2 as double,optional entier as boolean) as boolean
dim var1 as boolean, nombre1 as double, nombre2 as double

if isMissing(entier) then
entier = false
end if
  var1=IsNumeric(variable)
  if var1 = true then
  nombre1 = CDbl(variable)
     if entier = true then
          nombre2 = Fix(nombre1)
          else
          nombre2 = nombre1
     end if
     
     if nombre1&lt;borne1 or nombre1&gt;borne2 or nombre2&lt;&gt;nombre1 then
       var1 = false
     end if
    
  estunnombreentrebornes = var1
  end if
end function




&apos;---------------------------------------------------------------------------------------------------
&apos;function traduction qui récupère du texte quand le multilanguage est activé 
&apos;d&apos;après le livre de Bernard Marcelly et Laurent Godard : Macros OOoBASIC et API
&apos;----------------------------------------------------------------------------------------------------
Function trad(dlg As Object, libelle As String) As String
Dim rr As Object
rr = dlg.Model.ResourceResolver
trad = rr.resolveString(Mid(libelle, 2))
End Function


&apos;---------------------------------------------------------------------------------------------------
&apos;positionne la forme &quot;dessin&quot; sur la page writer
&apos;---------------------------------------------------------------------------------------------------

sub PositionObjetWriter(dessin as object,optional PosX as Double, optional PosY as Double) &apos;macro principale
Dim ahDoc As Object, ahMonTexte As object, ahMonCurseur As object, ahCurseurVisible As object, NumPageVisible as integer
Dim positionForme As New com.sun.star.awt.Point

if Ismissing(PosX) then 
PosX = 7000
end if
if Ismissing(PosY) then 
PosY = 7000
end if

ahDoc = ThisComponent
dessin.AnchorType = com.sun.star.text.TextContentAnchorType.AT_PAGE  &apos;défini l&apos;ancrage par rapport à la page
positionForme.x = PosX 
positionForme.y = PosY 

dessin.Position = positionForme

end sub


&apos;--------------------------------------------------------------------------------
&apos;fonction qui renvoie l&apos;angle par rapport à la hauteur
&apos;angle positif pour les points à droites de la hauteur et négatif à gauche
&apos;macro prisme et macro pyramide
&apos;--------------------------------------------------------------------------------
Function AnglePtbaseSomCentre(Xa as Double, Ya as Double, Xs as Double, Ys as Double) as variant
Dim monDocument As Object, maPage As Object, varAngle as Double

monDocument = ThisComponent
maPage = monDocument.DrawPage

if Ya &lt;&gt; Ys then
  if Xa &gt;= Xs then
  varAngle =  Atn((Xs - Xa)/(Ys - Ya))
     if varAngle &lt;0 then
     varAngle = pi + varAngle
     end if
  AnglePtbaseSomCentre = varAngle
  end if
  
  if Xa &lt; Xs then
  varAngle = Atn((Xs - Xa)/(Ys - Ya))
    if varAngle &gt; 0 then 
    varAngle = varAngle - pi
    end if
  AnglePtbaseSomCentre = varAngle
  end if
end if
if Ya = Ys then
  if Xa &gt;= Xs then
  AnglePtbaseSomCentre = pi/2
  else
  AnglePtbaseSomCentre = -1 * pi/2
  end if
end if
end function

     

&apos;--------------------------------------------------------------------------------
&apos;Dégroupe une forme et renvoie le nombre d&apos;éléments qui la constitue
&apos;--------------------------------------------------------------------------------
function DegrouperForme (maForme as Object) as Double

Dim monDocument As Object, maPage As Object, uneForme As Object, NombreFormes as variant
Dim x As Long, NombreElements as variant

monDocument = ThisComponent
maPage = monDocument.DrawPage
NombreFormes = maPage.Count
NombreElements = 0
maForme = maPage(NombreFormes - 1)

if maForme.ShapeType = &quot;com.sun.star.drawing.GroupShape&quot; then
   NombreElements = maForme.Count
   maPage.ungroup(maForme)
end if
DegrouperForme = NombreElements
End function

&apos;----------------------------------------------------------------------------------
&apos;propriété &quot;texte au travers&quot; sur les n dernières formes d&apos;une page writer
&apos;----------------------------------------------------------------------------------

sub TexteTravers (n as variant)
Dim monDocument As Object, maPage As Object, NombreFormes as Double,GroupElements as object, ahForme as object

monDocument = ThisComponent
maPage = monDocument.DrawPage

NombreFormes = maPage.Count
GroupElements = createUnoService(&quot;com.sun.star.drawing.ShapeCollection&quot;)
for i = 1 to n
ahForme = maPage(NombreFormes - i)
ahForme.Surround = com.sun.star.text.WrapTextMode.THROUGHT

Next
end sub


