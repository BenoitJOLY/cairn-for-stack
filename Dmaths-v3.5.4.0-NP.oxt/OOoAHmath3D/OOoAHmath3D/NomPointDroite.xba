REM  *****  BASIC  *****


Option Explicit
Global ah3Dmespolices() as string, ah3DTest as variant
Private ahMonTableau(87) As String, ahTaille As Integer, ahPolice As String, ahGras As Boolean , ahItalique As Boolean
Private ahPositionY As Integer, ahHauteurPage As Integer
Private monDlg as object, PoliceDoc as string


&apos;--------------------------------------------------------------------------------
&apos;teste si le programme a deja été lancé
&apos;si oui, la liste des polices se trouve déja dans ah3Dmespolices (variable global)  
&apos;si non, récupère la liste des polices est la stocke dans ah3Dmespolices
&apos;---------------------------------------------------------------------------------
sub FirstTime()
 if IsEmpty(ah3DTest) = true then
 ah3Dmespolices = ListePolices
 ah3DTest = &quot;programme déjà effectué&quot;
 end if
end sub

&apos;--------------------------------------------------------------------------------
sub InsereZoneTexte &apos;macro principale
Dim NbreZones as integer


FirstTime()
appelerDialogue()
if  ahMontableau(86) = true then
DRAWversWRITER(&quot;NomPointDroite.ConstructionZT()&quot;)
PositionObjetWriter(LastForme,0,ahPositionY) 
NbreZones = DegrouperForme(LastForme)  &apos;Dégroupe toutes les zones de texte et renvoie leur nombre
TexteTravers(NbreZones) 
GroupeFormes(1)     &apos;selectionne la dernière zone de texte
end if
end Sub


&apos;---------------------------------------------------------------------------------------------------
&apos; ici sont les programmes secondaires lancés par la macro InsereZoneTexte
&apos;---------------------------------------------------------------------------------------------------

Sub appelerDialogue()
Dim NomPoint As String, i As Integer, active As Boolean, j as integer, var1 as object, coche As Object
Dim lettre As String
	
monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;InserZoneDlg&quot;)

&apos;------------------------------------------------------------------------
&apos;récupération des données du dialogue dans ahMonTableau
&apos;-------------------------------------------------------------------------

if monDlg.execute = com.sun.star.ui.dialogs.ExecutableDialogResults.OK then

    for i = 1 to 86
        coche = monDlg.getControl(&quot;lettre_&quot;&amp;i)  &apos; coche = case à cocher nommée lettre_i
        active = coche.Model.State                        &apos; active = true si la boite à cocher est cochée

       if active = true then                       &apos; si active = true alors l&apos;étiquette de la boite à cocher est stockée dans une cellule de la variable &quot;montableau&quot;
          lettre = trad(monDlg, coche.Model.Label)
          ahMonTableau( i - 1) = lettre
       else
          ahMontableau (i - 1) = &quot;0&quot;
       end if
  Next  
&apos; ------------mets fin à la macro dans le cas ou aucune lettre n&apos;est cochée -----------------------------------------
dim test as boolean, monMessage as string
test = false
for i = 1 to  86
if ahMontableau (i - 1) &lt;&gt; &quot;0&quot; then
test = true
end if
next
if test = false then
monMessage = monDlg.getControl(&quot;Message3&quot;).Peer.Text
msgbox(monMessage)
end
end if
&apos;----------------------------------------------------------------------------------------------------------

  ahTaille = monDlg.getControl(&quot;NumericField1&quot;).Value     &apos; récupération de la taille de la police
  ahPolice = monDlg.getControl(&quot;Police&quot;).Text     &apos; récupération de la police d&apos;écriture
  ahGras = monDlg.getControl(&quot;BoutonGras&quot;).State          &apos; récupération des options gras et italique
  ahItalique = monDlg.getControl(&quot;BoutonItalique&quot;).State

  if monDlg.getControl(&quot;BoutonHaut&quot;).State = true then    &apos; récupération du positionnement sur la page
     ahPositionY = 1000
  end if
  if monDlg.getControl(&quot;BoutonMilieu&quot;).State = true then
     ahPositionY = 15000
  end if
   if monDlg.getControl(&quot;BoutonBas&quot;).State = true then
     ahPositionY = 25000
  end if
   ahMontableau(86) = true &apos;renvoie true si la boite de dialogue est fermée par le bouton OK
end if
	
monDlg.dispose
End Sub


&apos;----------------------------------------------------------------------------------------------------------------------
&apos;affiche une zone de texte contenant le texte contenu dans la variable ahPoint
&apos;----------------------------------------------------------------------------------------------------------------------

Sub ZoneDeTexte(ahPoint as string)
Dim ahZone as Object, monCurseur As Object, monDocument As Object, monTexte As Object, ahEspion as object, ahChaine As Object, Page as object
Dim i As Integer, ahCurseurVisible As object


monDocument =  ahDocumentDraw
Page = ahPageDraw


	ahZone = monDocument.createInstance(&quot;com.sun.star.drawing.TextShape&quot;)
	Page.add(ahZone)
    ahZone.TextAutoGrowHeight = true &apos;la hauteur de la zone s&apos;adapte au contenu du texte
    ahZone.TextAutoGrowWidth = true  &apos;la largeur de la zone s&apos;adapte au contenu du texte
  

	With ahZone
		.LineStyle = com.sun.star.drawing.LineStyle.NONE               &apos;pas de cadre
      	.String = ahPoint	
        if ahGras = true then                                          &apos;gras
        .CharWeight = com.sun.star.awt.FontWeight.BOLD
        end if
        if ahItalique = true then                                      &apos; italique
        .CharPosture = com.sun.star.awt.FontSlant.ITALIC
        end if
        .CharFontName = ahPolice                                        &apos;police d&apos;écriture
        .CharHeight = ahTaille                                           &apos;taille de la police
       
	End With
&apos; mets en indice les chiffres pour (d1) (d2) etc ...   
    for i = 1 to 6
      if ahPoint = &quot;(d&quot; &amp; i &amp;&quot;)&quot; then
    ahChaine = ahZone.Text
    ahEspion = ahChaine.createTextCursor
    ahEspion.gotoStart(False)
    ahEspion.goRight(2,False)
    ahEspion.goRight(1,True)
    ahEspion.CharEscapement = -20
    ahEspion.CharEscapementHeight = 70
    ahEspion.String = i
      end if
   Next

End sub



&apos;---------------------------------------------------------------------------------
sub TraceZT()
Dim j As Integer, ahTexte As String, decalage As Long, LargeurTotale As Long, maZoneTexte as object
Dim  positionForme As New com.sun.star.awt.Point

decalage = 1000
LargeurTotale = 0
&apos;récupère le texte contenu dans mon tableau et teste si cette valeur est différente de 0
&apos;Si cette valeur est différente de zéro, elle est copiée dans la variable Point
&apos;La variable Point est récupérée par la macro ZoneDeTexte qui l&apos;affiche
if ahMonTableau(86) = true then
for j = 1 to 86
ahTexte = ahMonTableau (j - 1)
  if ahTexte &lt;&gt; &quot;0&quot; then
     &apos; --------------------------------------------gère l&apos;affichage sur plusieurs lignes
     if LargeurTotale &lt; 19000 then
     positionForme.x = LargeurTotale + 1000
     positionForme.y = ahPositionY
     end if
     if (LargeurTotale &gt;= 19000) and (LargeurTotale &lt; 38000) then
     positionForme.x = LargeurTotale - 18000
     positionForme.y = ahPositionY + 2000
     end if
     if (LargeurTotale &gt;= 38000) and (LargeurTotale &lt; 57000) then
     positionForme.x = LargeurTotale - 37000
     positionForme.y = ahPositionY + 4000
     end if
     if (LargeurTotale &gt;= 57000) and (LargeurTotale &lt; 76000) then
     positionForme.x = LargeurTotale - 56000
     positionForme.y = ahPositionY + 6000
     end if
     if (LargeurTotale &gt;= 76000) and (LargeurTotale &lt; 95000) then
     positionForme.x = LargeurTotale - 75000
     positionForme.y = ahPositionY + 8000
     end if
     if (LargeurTotale &gt;= 95000) and (LargeurTotale &lt; 114000) then
     positionForme.x = LargeurTotale - 94000
     positionForme.y = ahPositionY + 10000
     end if
     if LargeurTotale &gt;= 114000 then
     positionForme.x = LargeurTotale - 113000
     positionForme.y = ahPositionY + 12000
     end if
     &apos;--------------------------------------------
     ZoneDeTexte(ahTexte)
     maZoneTexte = LastFormeDraw
     maZoneTexte.position = positionforme
     LargeurTotale = 500 + LargeurTotale + maZoneTexte.Size.Width  &apos;Largeur totale des zones de texte espacés de 5 mm
     
  end if
      
Next
end if

end sub


&apos;----------------------------------------------------------------------------
sub ConstructionZT()
TraceZT()
end sub

&apos;------------------------------------------------------------------------------
&apos;procédure a déclencher à l&apos;ouverture du dialogue InsereZoneDlg
&apos;permet de mettre la police du doc par défaut
&apos;------------------------------------------------------------------------------

sub gestioncasePolice
Dim  k1 as object
k1 = monDlg.getControl(&quot;Police&quot;)
k1.Model.StringItemList= ah3Dmespolices
k1.Model.Text = PoliceDoc
end sub


&apos;-------------------------------------------------------------------------------
&apos;Function inspirée sur Cmath de Christophe Devalland 
&apos;Modif : ajout d&apos;une barre de progression BarreProgDlg
&apos;-------------------------------------------------------------------------------
private monDlg2 as object, champProgres1 As Object, quotient as integer &apos;*****ajout à la fonction originale 

Function SortedFontDescriptors(oDoc, bDuplicates As Boolean)
  Dim oWindow          &apos;Container window AWT XDevice interface.
  Dim oFonts()         &apos;Array of awt FontDescriptor structures.
  Dim oFinalFonts()    &apos;Font descriptors to return.
  Dim nIndex() As Long &apos;Indirect sorted index into.
  Dim sName$           &apos;Font name.
  Dim i&amp;               &apos;General index variable.
  Dim j&amp;               &apos;General index variable.
  Dim n&amp;               &apos;General utility variable.
  Dim k&amp;               &apos;General utility variable.
  Dim bChanged As Boolean 
  dim val As Double    &apos;*****ajout à la fonction originale : Val = valeur des barres de progressions

  oWindow  = oDoc.getCurrentController().getFrame().getContainerWindow()
  oFonts() = oWindow.getFontDescriptors()
  ReDim nIndex(UBound(oFonts()))
  n = UBound(oFonts())
  REM First, obtain an index into the unique values.
  
 &apos;*****ajout à la fonction originale ****************************************** 
   quotient = int(10000/n)
   champProgres1 = monDlg2.getControl(&quot;ProgressBar1&quot;)
   champProgres1.value = 10000 - n * quotient
   monDlg2.getcontrol(&quot;Label1&quot;).Text = monDlg2.getControl(&quot;Message1&quot;).Peer.Text
 &apos;*****************************************************************************
  
  For i = 0 to n
    nIndex(i) = i
  Next

  REM Sort the data!
  For i = 0 To n-1
  &apos;*****ajout à la fonction originale ****************************************** 
  val = champProgres1.Value 
  champProgres1.value = ValeurProgressBar(val, 10000, 10000, n ) 
  &apos;*****************************************************************************
    bChanged = False
    For j = 1 To n-i
      If oFonts(nIndex(j-1)).Name &gt; oFonts(nIndex(j)).Name Then
        k = nIndex(j-1)
        nIndex(j-1) = nIndex(j)
        nIndex(j) = k
        bChanged = True
      End If
    Next
    If NOT bChanged Then 
    champProgres1.value = 10000 &apos;*****ajout à la fonction originale 
    Exit For
    end if
  Next
  &apos;*****ajout à la fonction originale ****************************************** 
  champProgres1.value = 10000 - n * quotient + quotient
  monDlg2.getcontrol(&quot;Label1&quot;).Text = monDlg2.getControl(&quot;Message2&quot;).Peer.Text
  &apos;*****************************************************************************
  REM Copy the font descriptor.
  sName = &quot;&quot;
  oFinalFonts() = DimArray(n)
  j = -1
  
  For i = 0 To n
  &apos;*****ajout à la fonction originale ****************************************** 
  val = champProgres1.Value&apos;*****ajout à la fonction originale
  champProgres1.value = ValeurProgressBar(val, 10000, 10000, n ) 
  &apos;*****************************************************************************
    If bDuplicates OR (sName &lt;&gt; oFonts(nIndex(i)).Name) Then
      j = j + 1
      oFinalFonts(j) = oFonts(nIndex(i))
      sName = oFinalFonts(j).Name
    End If
  Next
  monDlg2.EndExecute&apos;*****ajout à la fonction originale 
  
  
  REM Bug alert, if I do NOT perform a ReDim Preserve, then the returned 
  REM value is Empty; even if the array does not change in size.
  ReDim Preserve oFinalFonts(j)
  SortedFontDescriptors = oFinalFonts()
End Function

&apos;------------------------------------------------------------------------------------
&apos;function inspirée d&apos;une procédure de Cmath de Christophe Devalland 
&apos;------------------------------------------------------------------------------------
function ListePolices as variant
	dim dlg as object, bibli as object
	Dim av As Double, champProgres As Object, i as integer
	dim sDescriptionsPolices() as variant, sNomsPolices() as string
    	
    sDescriptionsPolices=SortedFontDescriptors(ThisComponent,false)
            
	redim sNomsPolices(ubound(sDescriptionsPolices)) as string
	for i=0 to ubound(sDescriptionsPolices)
		sNomsPolices(i)=sDescriptionsPolices(i).Name
	next i
	ListePolices = sNomsPolices
	
end function
&apos;-------------------------------------------------------------------------------------
&apos;Police selectionnée dans le document
&apos;function inspirée d&apos;une procédure de Cmath de Christophe Devalland 
&apos;-------------------------------------------------------------------------------------
function PoliceActive as string
dim oViewCursor as object, oTextCursor as object, sPolice as string
	    oViewCursor = ThisComponent.getCurrentController().getViewCursor()
		oTextCursor=oViewCursor.Text.createTextCursorByRange(oViewCursor)
		sPolice=oTextCursor.CharFontName
		PoliceActive = sPolice
end function


&apos;-------------------------------------------------------------------------------
&apos;il faut que partage &lt; ecart
&apos;mettre la valeur max de la pabrre de progression à 10000
&apos;-------------------------------------------------------------------------------

function ValeurProgressBar(Val0 as integer, val1 as integer, Ecart as integer, partage as integer) as double
Dim k as integer, var1 as integer

if Val0 + quotient &lt;= Val1 then
ValeurProgressBar = Val0 + quotient
else
ValeurProgressBar = Val1
end if

end function

&apos;---------------------------------------------------------------------------
&apos;la procédure InsèreZoneTexte doit être déclenchée à la réception du focus
&apos;du label1 dans BarreProgDlg
&apos;---------------------------------------------------------------------------
 sub MacroPrincipaleNomPointDroite
 
 PoliceDoc = PoliceActive
 if IsEmpty(ah3DTest) = true then
 monDlg2 = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;BarreProgDlg&quot;)
 monDlg2.execute
 else
 InsereZoneTexte()
 end if
 end sub
  
