REM  *****  BASIC  *****

Option Explicit

Private RepPrismeDlg(24) as variant
Private monDlg as object

sub PrismeMacroPrincipale &apos;macro principale

appelerBoiteDialoguePrisme()

if RepPrismeDlg(24) = true then   
DRAWversWRITER(&quot;Prisme.ConstructionPrisme()&quot;)
PositionObjetWriter(LastForme)
end if

end Sub
 
&apos;----------------------------------------------------------------------------------------------------------------------------
 
Sub appelerBoiteDialoguePrisme()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;PrismeDlg&quot;)
&apos;--------------------------initialisation de la boite de dialogue---------------------		
Initialisation(monDlg,CheminDessin(&quot;Dessins/Prisme/prisme1.gif/&quot;),5)
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs ------
for i = 1 to 5
RepPrismeDlg(i + 18) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	

monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if

End Sub

&apos;----------------------------------------------------------------------------------------------------------------------------
sub ConstructionPrisme()
Dim variable1 as variant
variable1 = BasesPrisme(10000, 10000 , RepPrismeDlg(1)*1000 ,RepPrismeDlg(3)*1000, RepPrismeDlg(2),RepPrismeDlg(0), RepPrismeDlg(4))
TracerPrisme(variable1,RepPrismeDlg(4))
end sub




&apos;--------------coordonnées des sommets des bases-----------------------------------------------------------------------------

Function BasesPrisme(Xcentre as Double, Ycentre as Double , Rayon as Double ,Hauteur as double, DegRot as Double, n as Double, AngIncl as Double) as variant
Dim Centre1(1) as variant, Centre2(1) as variant, PointA as variant,  PointB as variant
Dim CoordSomBase1(n + 1) as variant, CoordSomBase2(n + 1) as variant &apos;CoordSomBase1 = base inf    CoordSomBase2 = base sup
Dim k As Integer, R as Integer, RadRot as Double, RadAngIncl as Double, h as double


RadRot = pi*DegRot/180
RadAngIncl = pi* AngIncl/180

if RepPrismeDlg(13) = true then              &apos;hauteur réelle sélectionnée
  h = Hauteur*cos(RadAngIncl) 
  else
  h = Hauteur                             &apos; hauteur sur le dessin selectionnée
end if  


Centre1 = Array(Xcentre,Ycentre * Sin(RadAngIncl)) &apos;coord du centre de la base inf
Centre2 = Array(Xcentre,Ycentre * Sin(RadAngIncl) - h) &apos;coord du centre de la base sup
CoordSomBase1(0) = Centre1
CoordSomBase2(0) = Centre2

for k = 1 to n + 1 &apos;coord des sommets avec le 1er qui reapparait en dernier
PointA = Array(Xcentre + Rayon*cos(k*2*pi/n + RadRot),(Ycentre - Rayon*Sin(k*2*pi/n + RadRot))* Sin(RadAngIncl))
CoordSomBase1(k) = PointA
PointB = Array(PointA(0),(PointA(1)-h))
CoordSomBase2(k)= PointB
next

BasesPrisme = Tableau4xN(Lignex(1,CoordSomBase1),Lignex(2,CoordSomBase1),Lignex(1,CoordSomBase2),Lignex(2,CoordSomBase2))

end Function

&apos;-------------Angles entre les sommets de la base inférieure, centre de la base inférieure, centre de la base supérieure

&apos;tableau regroupant tous les angles entre le sommet et les points de la base
function PrismeAngles(TouslesAbs as variant, TouslesOrd as variant, AbsSommet as Double, OrdSommet as Double) as variant
Dim j as integer, IndexMax as variant

IndexMax = UBound(TouslesAbs)
Dim varAngles(IndexMax) as variant
varAngles(0) = &quot;non défini&quot;

For j = 1 to IndexMax
varAngles(j) = AnglePtbaseSomCentre(TouslesAbs(j),TouslesOrd(j),AbsSommet,OrdSommet)
Next

PrismeAngles = varAngles

end function

&apos;--------------------------------------------------Tracé du prisme----------------------------------------------

sub TracerPrisme(CoordBases as variant, AngIncl as Double)

Dim Xmin as Double, Xmax as Double, k as integer, n as integer
Dim MesAbs as variant, MesOrd as variant, AbsCentre1 as double, OrdCentre1 as double, MesAngles as variant, AbsCentre2 as double, OrdCentre2 as double
Dim AngleMin as double, AngleMax as double, Yanglemin as double, Yanglemax as double,Xanglemin as double, Xanglemax as double
Dim Condition1 as boolean, Condition2 as Boolean, RadAngIncl as double
Dim meineTabelle, meineTabelle1, meineTabelle2 as variant
Dim Vect1(1) as double, Norme1 as double , Vect2(1) as double, Norme2 as double &apos;-------vect pour tracer les angles droits

n =  Ubound(CoordBases) - 1
RadAngIncl = pi* AngIncl/180
MesAbs =  Lignex(1,CoordBases)
MesOrd = Lignex(2,CoordBases)

meineTabelle = MinMax(MesAbs)
Xmin = meineTabelle(0)
Xmax = meineTabelle(1)
&apos; Xmin = MinMax(MesAbs)(0)
&apos; Xmax = MinMax(MesAbs)(1)

AbsCentre1 = MesAbs(0)
OrdCentre1 = MesOrd(0)

meineTabelle = CoordBases(0)
AbsCentre2 = meineTabelle(2)
OrdCentre2 = meineTabelle(3)
&apos; AbsCentre2 = CoordBases(0)(2)
&apos; OrdCentre2 = CoordBases(0)(3)

MesAngles = PrismeAngles(MesAbs, MesOrd, AbsCentre1, OrdCentre1)
For k = 1 to n
   if MesAbs(k) = Xmin then
   AngleMin = MesAngles(k)
   end if
   if MesAbs(k) = Xmax then
   AngleMax = MesAngles(k)
   end if
   next
for k = 1 to n
  if abs(AngleMin - MesAngles(k))&lt;0.0001 then
  Yanglemin = MesOrd(k)
  Xanglemin = MesAbs(k)
  end if
  if abs(AngleMax - MesAngles(k))&lt;0.0001 then
  Yanglemax = MesOrd(k)
  Xanglemax = MesAbs(k)
  end if
next

 
&apos;1- tracé du prisme---------------------------

if AngIncl &gt;=0 then
for k = 1 to n

meineTabelle1 = CoordBases(k)
meineTabelle2 = CoordBases(k+1)

     if MesOrd(k) &gt;= Yanglemin + (MesAbs(k) - Xanglemin)*(Yanglemin - Yanglemax)/(Xanglemin - Xanglemax)  then
         Condition1 = true
         else
         Condition1 = false
     end if
     if MesOrd(k+1) &gt;= Yanglemin + (MesAbs(k+1) - Xanglemin)*(Yanglemin - Yanglemax)/(Xanglemin - Xanglemax)  then
         Condition2 = true
         else
         Condition2 = false
     end if

     SegmentDraw(MesAbs(k), meineTabelle1(3),  MesAbs(k+1), meineTabelle2(3),30,&quot;plein&quot;) &apos;base supérieure
&apos;     SegmentDraw(MesAbs(k), CoordBases(k)(3),  MesAbs(k+1), CoordBases(k+1)(3),30,&quot;plein&quot;) &apos;base supérieure
     
     if Condition1 = true and Condition2 = true then 
      SegmentDraw(MesAbs(k), MesOrd(k),  MesAbs(k+1), MesOrd(k+1),30,&quot;plein&quot;) &apos;base inférieure
      else
      SegmentDraw(MesAbs(k), MesOrd(k),  MesAbs(k+1), MesOrd(k+1),30,&quot;pointillé&quot;) &apos;base inférieure
     end if
     if Condition1 = true then
     
     SegmentDraw(MesAbs(k), MesOrd(k),  meineTabelle1(2),  meineTabelle1(3),30,&quot;plein&quot;) &apos;arêtes latérales
 &apos;     SegmentDraw(MesAbs(k), MesOrd(k),  CoordBases(k)(2),  CoordBases(k)(3),30,&quot;plein&quot;) &apos;arêtes latérales
     else

     SegmentDraw(MesAbs(k), MesOrd(k),  meineTabelle1(2),  meineTabelle1(3),30,&quot;pointillé&quot;) &apos;arêtes latérales
&apos;     SegmentDraw(MesAbs(k), MesOrd(k),  CoordBases(k)(2),  CoordBases(k)(3),30,&quot;pointillé&quot;) &apos;arêtes latérales
     end if
          
next
end if

if AngIncl &lt;0 then
for k = 1 to n

meineTabelle1 = CoordBases(k)
meineTabelle2 = CoordBases(k+1)

     if MesOrd(k) &lt;= Yanglemin + (MesAbs(k) - Xanglemin)*(Yanglemin - Yanglemax)/(Xanglemin - Xanglemax)  then
         Condition1 = true
         else
         Condition1 = false
     end if
     if MesOrd(k+1) &lt;= Yanglemin + (MesAbs(k+1) - Xanglemin)*(Yanglemin - Yanglemax)/(Xanglemin - Xanglemax)  then
         Condition2 = true
         else
         Condition2 = false
     end if

     SegmentDraw(MesAbs(k), MesOrd(k),  MesAbs(k+1), MesOrd(k+1),30,&quot;plein&quot;) &apos;base inférieure
     
     if Condition1 = true and Condition2 = true then 
     
      SegmentDraw(MesAbs(k), meineTabelle1(3),  MesAbs(k+1), meineTabelle2(3),30,&quot;plein&quot;) &apos;base supérieure
&apos;      SegmentDraw(MesAbs(k), CoordBases(k)(3),  MesAbs(k+1), CoordBases(k+1)(3),30,&quot;plein&quot;) &apos;base supérieure
      else

     SegmentDraw(MesAbs(k), meineTabelle1(3),  MesAbs(k+1), meineTabelle2(3),30,&quot;pointillé&quot;) &apos;base supérieure
&apos;     SegmentDraw(MesAbs(k), CoordBases(k)(3),  MesAbs(k+1), CoordBases(k+1)(3),30,&quot;pointillé&quot;) &apos;base supérieure
     end if
     if Condition1 = true then

     SegmentDraw(MesAbs(k), MesOrd(k),  meineTabelle1(2),  meineTabelle1(3),30,&quot;plein&quot;) &apos;arêtes latérales
&apos;     SegmentDraw(MesAbs(k), MesOrd(k),  CoordBases(k)(2),  CoordBases(k)(3),30,&quot;plein&quot;) &apos;arêtes latérales
     else

     SegmentDraw(MesAbs(k), MesOrd(k),  meineTabelle1(2),  meineTabelle1(3),30,&quot;pointillé&quot;) &apos;arêtes latérales
&apos;     SegmentDraw(MesAbs(k), MesOrd(k),  CoordBases(k)(2),  CoordBases(k)(3),30,&quot;pointillé&quot;) &apos;arêtes latérales
     end if
          
next
end if


if RepPrismeDlg(5) = 1 then   &apos;------------Tracé des centres------------------
SegmentDraw(AbsCentre1-100, OrdCentre1 - 100 * sin(RadAngIncl) ,  AbsCentre1+100 , OrdCentre1 + 100 * sin(RadAngIncl) , 30,&quot;plein&quot;)
SegmentDraw(AbsCentre1-100, OrdCentre1 + 100 * sin(RadAngIncl),  AbsCentre1+100, OrdCentre1 - 100 * sin(RadAngIncl) , 30,&quot;plein&quot;)
SegmentDraw(AbsCentre2-100, OrdCentre2 - 100 * sin(RadAngIncl) ,  AbsCentre2+100 , OrdCentre2 + 100 * sin(RadAngIncl) , 30,&quot;plein&quot;)
SegmentDraw(AbsCentre2-100, OrdCentre2 + 100 * sin(RadAngIncl),  AbsCentre2+100, OrdCentre2 - 100 * sin(RadAngIncl) , 30,&quot;plein&quot;)
end if
if RepPrismeDlg(6) = 1 then   &apos;------------Tracé de la hauteur ------------------
    if RepPrismeDlg(14) = true then  
    SegmentDraw(AbsCentre1, OrdCentre1 ,  AbsCentre2 , OrdCentre2 ,30,&quot;plein&quot;)
    else
    SegmentDraw(AbsCentre1, OrdCentre1 ,  AbsCentre2 , OrdCentre2 , 30,&quot;pointillé&quot;)
    end if
    
    &apos;------------Tracé des angles droits ------------------
    Norme1 = sqr(PuisN(Xanglemax - AbsCentre1 , 2) + PuisN(Yanglemax - OrdCentre1 , 2))
    Vect1(0) = (Xanglemax - AbsCentre1)/Norme1
    Vect1(1) = (Yanglemax - OrdCentre1)/Norme1
    Norme2 = sqr(PuisN(Xanglemin - AbsCentre1 , 2) + PuisN(Yanglemin - OrdCentre1 , 2))
    Vect2(0) = (Xanglemin - AbsCentre1)/Norme2
    Vect2(1) = (Yanglemin - OrdCentre1)/Norme2
    
    if RepPrismeDlg(7) = 1 then  
     if RepPrismeDlg(9) = 0  and RepPrismeDlg(10) = 1 then   &apos;si uniquement rayon gauche de tracé
        SegmentDraw(AbsCentre2, OrdCentre2 ,  AbsCentre2 + Vect2(0)*500 , OrdCentre2 + Vect2(1)*500 , 30,&quot;plein&quot;)
        QuadrilatereDraw(AbsCentre2, OrdCentre2 ,  AbsCentre2 + Vect2(0)*250 , OrdCentre2 + Vect2(1)*250, AbsCentre2 + Vect2(0)*250 , OrdCentre2 + Vect2(1)*250 + 250  , AbsCentre2, OrdCentre2 +  250 ,30,&quot;plein&quot;)
     else     
     SegmentDraw(AbsCentre2, OrdCentre2 ,  AbsCentre2 + Vect1(0)*500 , OrdCentre2 + Vect1(1)*500 , 30,&quot;plein&quot;)
     QuadrilatereDraw(AbsCentre2, OrdCentre2 ,  AbsCentre2 + Vect1(0)*250 , OrdCentre2 + Vect1(1)*250, AbsCentre2 + Vect1(0)*250 , OrdCentre2 + Vect1(1)*250 + 250  , AbsCentre2, OrdCentre2 +  250 ,30,&quot;plein&quot;)
     end if
    end if
    if RepPrismeDlg(8) = 1 then 
      if RepPrismeDlg(11) = 0  and RepPrismeDlg(12) = 1 then  &apos;si uniquement rayon gauche de tracé
      SegmentDraw(AbsCentre1, OrdCentre1 ,  AbsCentre1 + Vect2(0)*500 , OrdCentre1 + Vect2(1)*500 , 30,&quot;plein&quot;)
      QuadrilatereDraw(AbsCentre1, OrdCentre1 ,  AbsCentre1 + Vect2(0)*250 , OrdCentre1 + Vect2(1)*250, AbsCentre1 + Vect2(0)*250 , OrdCentre1 + Vect2(1)*250 - 250  , AbsCentre1, OrdCentre1 -  250 ,30,&quot;plein&quot;)
      else    
      SegmentDraw(AbsCentre1, OrdCentre1 ,  AbsCentre1 + Vect1(0)*500 , OrdCentre1 + Vect1(1)*500 , 30,&quot;plein&quot;)
      QuadrilatereDraw(AbsCentre1, OrdCentre1 ,  AbsCentre1 + Vect1(0)*250 , OrdCentre1 + Vect1(1)*250 , AbsCentre1 + Vect1(0)*250 , OrdCentre1 + Vect1(1)*250 - 250  , AbsCentre1, OrdCentre1 - 250 ,30,&quot;plein&quot;)
      end if
    end if
end if    
     &apos;------------Tracé des segments &quot;rayon&quot; ------------------
    
    if RepPrismeDlg(9) = 1 then
       if RepPrismeDlg(15) = true then
       SegmentDraw(AbsCentre2, OrdCentre2,  Xanglemax,Yanglemax-abs(OrdCentre2-OrdCentre1) ,30,&quot;plein&quot;)
       else
       SegmentDraw(AbsCentre2, OrdCentre2,  Xanglemax,Yanglemax-abs(OrdCentre2-OrdCentre1) ,30,&quot;pointillé&quot;)
       end if
    end if   
    if RepPrismeDlg(10) = 1 then
       if RepPrismeDlg(16) = true then
       SegmentDraw(AbsCentre2, OrdCentre2,  Xanglemin,Yanglemin-abs(OrdCentre2-OrdCentre1) ,30,&quot;plein&quot;)
       else
       SegmentDraw(AbsCentre2, OrdCentre2,  Xanglemin,Yanglemin-abs(OrdCentre2-OrdCentre1) ,30,&quot;pointillé&quot;)
       end if       
    end if
    if RepPrismeDlg(11) = 1 then
       if RepPrismeDlg(17) = true then
       SegmentDraw(AbsCentre1, OrdCentre1,  Xanglemax,Yanglemax ,30,&quot;plein&quot;)
       else
       SegmentDraw(AbsCentre1, OrdCentre1,  Xanglemax,Yanglemax ,30,&quot;pointillé&quot;)       
       end if
    end if
    if RepPrismeDlg(12) = 1 then
       if RepPrismeDlg(18) = true then    
       SegmentDraw(AbsCentre1, OrdCentre1,  Xanglemin,Yanglemin ,30,&quot;plein&quot;)
       else
       SegmentDraw(AbsCentre1, OrdCentre1,  Xanglemin,Yanglemin ,30,&quot;pointillé&quot;)       
       end if
    end if
    
    
end sub


&apos;****************************************************Gestion de la boite de dialogue*****************************************************************

sub GestionCase1
Aspect2BoutonsRadio(monDlg,&quot;RepPrisme7&quot;,&quot;StyleA1&quot;,&quot;StyleB1&quot;)
Aspect2BoutonsRadio(monDlg,&quot;RepPrisme10&quot;,&quot;StyleA2&quot;,&quot;StyleB2&quot;)
Aspect2BoutonsRadio(monDlg,&quot;RepPrisme11&quot;,&quot;StyleA3&quot;,&quot;StyleB3&quot;)
Aspect2BoutonsRadio(monDlg,&quot;RepPrisme12&quot;,&quot;StyleA4&quot;,&quot;StyleB4&quot;)
Aspect2BoutonsRadio(monDlg,&quot;RepPrisme13&quot;,&quot;StyleA5&quot;,&quot;StyleB5&quot;)
AspectLabel(monDlg,&quot;RepPrisme7&quot;,&quot;RepPrisme8&quot;)
AspectLabel(monDlg,&quot;RepPrisme7&quot;,&quot;RepPrisme9&quot;)
end sub

Sub GestionInfoBulle
TexteAide(monDlg,&quot;RepPrisme1&quot;, &quot;1&lt;= ... &lt;= 50&quot;)
TexteAide(monDlg,&quot;RepPrisme2&quot;, &quot;0&lt; ... &lt;= 10&quot;)
TexteAide(monDlg,&quot;RepPrisme3&quot;, &quot;0&lt;= ... &lt;= 180&quot;)
TexteAide(monDlg,&quot;RepPrisme4&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;RepPrisme5&quot;, &quot;-90&lt;= ... &lt;= 90&quot;)
end sub

sub GestionImage
ChangerImagePrincipalex2(monDlg , &quot;RepPrisme5&quot;, CheminDessin(&quot;Dessins/Prisme/prisme1.gif/&quot;),CheminDessin(&quot;Dessins/Prisme/prisme2.gif/&quot;), CheminDessin(&quot;Dessins/erreur.gif/&quot;))
end sub

sub GestionBoutonOK  
Dim i as integer, test(6) as integer

&apos;-----------------------Gestion des erreurs de saisie
test(1) = ZT_Nbre(monDlg,  &quot;RepPrisme1&quot;, 3 , 50 , 5 ,  RepPrismeDlg(19),true)
test(2) = ZT_Nbre(monDlg,  &quot;RepPrisme2&quot;, 0.001 , 10 , 3 ,  RepPrismeDlg(20),) 
test(3) = ZT_Nbre(monDlg,  &quot;RepPrisme3&quot;, 0 , 180 , 20 ,  RepPrismeDlg(21),)
test(4) = ZT_Nbre(monDlg,  &quot;RepPrisme4&quot;, 0 , 20 , 5 ,  RepPrismeDlg(22),) 
test(5) = ZT_Nbre(monDlg,  &quot;RepPrisme5&quot;, -90 , 90 , 20 ,  RepPrismeDlg(23),)   &apos; 0 ou 1
     
test(0) = test(1)*test(2)*test(3)*test(4)*test(5)   &apos;-- test(0) contient 1 si tout est ok 0 sinon

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
 
    for i = 1 to 5
    RepPrismeDlg(i - 1) = CDbl(monDlg.getControl(&quot;RepPrisme&quot;&amp;i).Peer.Text)  
    Next
    for i = 6 to 14
    RepPrismeDlg(i - 1) = monDlg.getControl(&quot;RepPrisme&quot;&amp;i).state  
    Next 
    for i = 1 to 5
    RepPrismeDlg(13 + i) = monDlg.getControl(&quot;StyleA&quot;&amp;i).state 
    next
       
    RepPrismeDlg(24) = true  &apos;RepPrismeDlg(24) = true quand tout est validé
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé


    monDlg.endExecute
end if

End Sub

</script:module>