REM  *****  BASIC  *****

option explicit


Private RepPolyedre0Dlg(2) as variant,RepPolyedre1Dlg(6) as variant , CompteurAjout as integer
Private monDlg as object, maListeTab as variant, ahTexteTab(100) as variant
Private absTab(25) as double, ordTab(25) as double, mesAretesTab(100) as variant
&apos;----------------------------------------------

&apos;----------1ere boite de dialogue------------------------------------------------------------
&apos;--------------------------------------------------------------------------------------------
Sub appelerBoiteDialoguePolyedre0()

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;Polyedre0Dlg&quot;)
&apos;-------------------------initialisation de la 1ere boite de dialogue-----------------
Initialisation(monDlg,)	
GestionInfoBulle0
&apos;------------------------ récupération des messages d&apos;erreurs et des infobulles ------
RepPolyedre0Dlg(0) = monDlg.getControl(&quot;Message1&quot;).Peer.Text
&apos;--------------------------------------------------------------------------------------	
monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub

&apos;-------2eme boite de dialogue------------------------------------------------------------------
&apos;-----------------------------------------------------------------------------------------------
Sub appelerBoiteDialoguePolyedre1()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;Polyedre1Dlg&quot;)		
&apos;-------------------------initialisation de la 2eme boite de dialogue-----------------
for i = 1 to RepPolyedre0Dlg(1)
ElementInactif(monDlg, &quot;Sommet&quot;&amp;i, &quot;actif&quot;)
ElementInactif(monDlg, &quot;abs&quot;&amp;i, &quot;actif&quot;)
ElementInactif(monDlg, &quot;virgule&quot;&amp;i, &quot;actif&quot;)
ElementInactif(monDlg, &quot;ord&quot;&amp;i, &quot;actif&quot;)
ElementInactif(monDlg, &quot;parenthese&quot;&amp;i, &quot;actif&quot;)
next
GestionAffichageSommets
Initialisation(monDlg,CheminDessin(&quot;Dessins/Polyedre/Polyedre1.gif/&quot;),)
GestionAffichageNbreAretes
ReceptionFocus(monDlg,&quot;abs1&quot;)
GestionInfoBulle1
initialisationCoord
&apos;------------------------ récupération des messages d&apos;erreurs et des infobulles ------
for i = 1 to 4
RepPolyedre1Dlg(2 + i) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next

monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub

&apos;----------------corps du programme--------------------------------------------------------
&apos;------------------------------------------------------------------------------------------
sub PolyedreMacroPrincipale()
Dim i as integer
CompteurAjout=0
appelerBoiteDialoguePolyedre0()

if RepPolyedre0Dlg(2) = true then                  &apos;la 1ere boite de dialogue est fermée
Dim monTabSommets(RepPolyedre0Dlg(1)-1)            &apos;crée monTabSommets (defini localement) de Dimension égale au nombre de sommets 
                                                   
  for i = 65 to (64+RepPolyedre0Dlg(1))            &apos; monTabSommets contient le nom des sommets :  A  B  C  D etc...
  monTabSommets(i-65)=chr(i)
  next
   
 maListeTab = monTabSommets()                      &apos;maListeTAb (defini en private) reçoit la liste des sommets
 appelerBoiteDialoguePolyedre1()                   &apos;appelle la 2eme boite de dialogue
 end if
 
 if RepPolyedre1Dlg(2) = true then                 &apos;la 2eme boite de dialogue est fermée
 styleSegments                                     &apos;initialise mesAretesTab (private) tableau de 3 lignes contenant :
                                                   &apos;le nom du point d&apos;origine, celui du point final et le style du segment
 DRAWversWRITER(&quot;Polyedre.ConstructionPolyedre()&quot;)
 PositionObjetWriter(LastForme)
end if



end sub

&apos;--------------------------------------------------------------------------------------------------------
&apos; Tracer du polyèdre
&apos; CompteurAjout contient le nombre d&apos;arêtes à tracer
&apos;-------------------------------------------------------------------------------------------------------

sub ConstructionPolyedre
Dim ahVar1 as double, ahVar2 as double, ahVar3 as double, ahVar4 as double, ahVar5 as string,i as integer
for i = 1 to CompteurAjout
ahVar1 = absTab(mesAretesTab(i)(0))*1000
ahVar2 = ordTab(mesAretesTab(i)(0))*(-1000)
ahVar3 = absTab(mesAretesTab(i)(1))*1000
ahVar4 = ordTab(mesAretesTab(i)(1))*(-1000)
ahVar5 = mesAretesTab(i)(2)
SegmentDraw(ahVar1, ahVar2, ahVar3, ahVar4, 30,ahVar5)
next

end sub




&apos;------------------------------------------------------------------------------------------
&apos;récupération des coordonnées des sommets dans les 2 tableaux abs(25) et ord(25)
&apos;------------------------------------------------------------------------------------------
Sub RecupCoordSommets
Dim i as integer
for i=1 to RepPolyedre0Dlg(1)
absTab(i)=CDbl(ReponseTexte(monDlg, &quot;abs&quot;&amp;i))
ordTab(i)=CDbl(ReponseTexte(monDlg, &quot;ord&quot;&amp;i))
next
end sub


&apos;-------------------------------------------------------------------------------------------------------
&apos;affiche la liste des sommets dans les listes de choix  extA et extB de la 2eme boite
&apos; apres avoir validé l&apos;étape 1
&apos;------------------------------------------------------------------------------------------------------
sub GestionAffichageSommets
AffectTextLabel3(monDlg, maListeTab(), &quot;extA&quot;)
AffectTextLabel3(monDlg, maListeTab(), &quot;extB&quot;)
end sub


&apos;------------------------------------------------------------------------------------------------------------------
&apos;------ajoute des aretes à tracer à la zone de texte et à la liste de la boite de dialogue
&apos;------------------------------------------------------------------------------------------------------------------
sub AjouterAretes
Dim monExtA as string, monExtB as string, ahSegment as string, ahTexte as string, ahStyle as string,i as integer
CompteurAjout = CompteurAjout + 1   &apos;compte le nombre de segemnt à tracer
Dim mesSegments(CompteurAjout-1) as string &apos;tableau contenant tous les segments à tracer


ahTexte = ReponseTexte(monDlg, &quot;Aretes&quot;)
monExtA = ReponseListe(monDlg,&quot;extA&quot;)(0)
monExtB = ReponseListe(monDlg,&quot;extB&quot;)(0)
ahStyle = ReponseListe(monDlg,&quot;Style&quot;)(0)
ahSegment = &quot;[&quot;+monExtA+monExtB+&quot;]   &quot;+ahStyle &apos;texte avec le nom du segment et son style

ahTexteTab(CompteurAjout-1)=ahSegment &apos;ajoute un segment au tableau de dim 100 contenant tous les segments à tracer - déclaré en private
ahTexte = ahTexte+ahSegment+chr(13)
AffectTextLabel2(monDlg,ahTexte, &quot;Aretes&quot;)&apos;ecris dans la zone de texte les segments ajoutés
for i = 0 to CompteurAjout-1
mesSegments(i)=ahTexteTab(i)
next

GestionAffichageNbreAretes

AffectTextLabel3(monDlg, mesSegments(), &quot;Aretes2&quot;)
SelectionListe(monDlg,&quot;Aretes2&quot;,CompteurAjout-1)
GestionBoutonSup
ReceptionFocus(monDlg,&quot;extA&quot;)

end sub

&apos;------------------------------------------------------------------------------------------------------------------
&apos;------supprime des aretes à tracer à la zone de texte et à la liste de la boite de dialogue
&apos;------------------------------------------------------------------------------------------------------------------
sub SupprimerAretes
Dim ahRangSegment as string, TabProv1 as variant, TabProv2 as variant, i as integer, ahtexte as string

CompteurAjout = CompteurAjout - 1

ahRangSegment = ReponseListe(monDlg,&quot;Aretes2&quot;)(1)
ahTexteTab=SupjTab1xN(ahTexteTab(), ahRangSegment)

if CompteurAjout = 0 then  &apos;gère le cas où il n&apos;y a aucun segment à supprimer
Dim AucunSegment(0) as string
ahtexte=&quot;&quot;
AucunSegment(0)=ahTexteTab(0)
AffectTextLabel3(monDlg, AucunSegment(), &quot;Aretes2&quot;)
end if

if compteurAjout&gt;0 then
Dim mesSegments(CompteurAjout-1) as string
  for i = 0 to CompteurAjout-1
    mesSegments(i)=ahTexteTab(i)
  next

  for i = 0 to CompteurAjout-1
    ahtexte=ahtexte+mesSegments(i)+chr(13)
  next

AffectTextLabel3(monDlg, mesSegments(), &quot;Aretes2&quot;)
SelectionListe(monDlg,&quot;Aretes2&quot;,CompteurAjout-1)

end if

GestionAffichageNbreAretes
AffectTextLabel2(monDlg,ahTexte, &quot;Aretes&quot;)

GestionBoutonSup
ReceptionFocus(monDlg,&quot;extA&quot;)
end sub

&apos;--------------------------------------------------------------------------------------------
&apos;------- rend actif ou inactif le bouton supprimer
&apos;----------------------------------------------------------------------------------------------
sub GestionBoutonSup

 if CompteurAjout=0 then
ElementInactif(monDlg, &quot;BoutonSup&quot;, &quot;inactif&quot;)
ElementInactif(monDlg, &quot;BoutonOK&quot;, &quot;inactif&quot;)
else
ElementInactif(monDlg, &quot;BoutonSup&quot;, &quot;actif&quot;)
ElementInactif(monDlg, &quot;BoutonOK&quot;, &quot;actif&quot;)
end if
end sub

&apos;--------------------------------------------------------------------------------------------
&apos;------- gère l&apos;affichage du nombre d&apos;arêtes
&apos;----------------------------------------------------------------------------------------------
sub GestionAffichageNbreAretes
Dim MessageInfo1 as string
MessageInfo1 = CompteurAjout
AffectTextLabel2(monDlg,MessageInfo1, &quot;InfoAretes&quot;)
end sub

&apos;--------------------------------------------------------------------------------------------
&apos;------- Affecte les messages d&apos;aide au zone de texte abs et ord
&apos;----------------------------------------------------------------------------------------------
sub GestionInfoBulle1
Dim i as integer, messageAide1 as string, messageAide2 as string
messageAide1 = &quot;0 &lt;=  ..... &lt;= 21&quot;
messageAide2 = &quot;0 &lt;=  ..... &lt;= 30&quot;
for i = 1 to RepPolyedre0Dlg(1)
TexteAide(monDlg, &quot;abs&quot;&amp;i, messageAide1)
TexteAide(monDlg, &quot;ord&quot;&amp;i, messageAide2)
next
end sub


&apos;--------------------------------------------------------------------------------------------
&apos;------- Affecte les étiquettes des points à la zone étape 1
&apos;----------------------------------------------------------------------------------------------
sub initialisationCoord
Dim i as integer

for i = 1 to 25
AffectTextLabel2(monDlg,chr(i+64)&amp;&quot; (&quot;, &quot;Sommet&quot;&amp;i)
AffectTextLabel2(monDlg, &quot;;&quot;, &quot;virgule&quot;&amp;i)
AffectTextLabel2(monDlg,&quot;)&quot;, &quot;parenthese&quot;&amp;i)
next
end sub


&apos;----------------------------------------------------------------------
&apos;Gestion du bouton Valider1 qui met fin à la saisie des coordonnées
&apos;--------------------------------------------------------------------------
sub GestionVal1
Dim i as integer, test(2) as integer

test(0)=1
&apos;-----------------------Gestion des erreurs de saisie
for i = 1 to RepPolyedre0Dlg(1)
test(1) = ZT_Nbre(monDlg, &quot;abs&quot; &amp; i, 0, 21,5, RepPolyedre1Dlg(3) &amp; chr(64+i) &amp; &quot; &quot; &amp; RepPolyedre1Dlg(4),)
test(2) = ZT_Nbre(monDlg, &quot;ord&quot; &amp; i, 0, 21,5, RepPolyedre1Dlg(5) &amp; chr(64+i) &amp; &quot; &quot; &amp; RepPolyedre1Dlg(6),)
test(0) = test(0)*test(1)*test(2)
next
&apos;---------------------- (test(0) contient 1 si tout est ok 0 sinon)

if test(0) = 1 then
 RecupCoordSommets
 ElementInactif(monDlg, &quot;BoutonAjouter&quot;, &quot;actif&quot;)
 ElementInactif(monDlg, &quot;extA&quot;, &quot;actif&quot;)
 ElementInactif(monDlg, &quot;extB&quot;, &quot;actif&quot;)
 ElementInactif(monDlg, &quot;Aretes2&quot;, &quot;actif&quot;)
 ElementInactif(monDlg, &quot;Style&quot;, &quot;actif&quot;)
 ElementInactif(monDlg, &quot;BoutonRetour&quot;,&quot;actif&quot;)
 ElementInactif(monDlg, &quot;BoutonValider1&quot;,&quot;inactif&quot;)

 if CompteurAjout &gt; 0 then
 ElementInactif(monDlg, &quot;BoutonSup&quot;, &quot;actif&quot;)
 end if

 for i = 1 to RepPolyedre0Dlg(1)
 ElementInactif(monDlg, &quot;Sommet&quot;&amp;i, &quot;inactif&quot;)
 ElementInactif(monDlg, &quot;abs&quot;&amp;i, &quot;inactif&quot;)
 ElementInactif(monDlg, &quot;virgule&quot;&amp;i, &quot;inactif&quot;)
 ElementInactif(monDlg, &quot;ord&quot;&amp;i, &quot;inactif&quot;)
 ElementInactif(monDlg, &quot;parenthese&quot;&amp;i, &quot;inactif&quot;)
 next
end if
end sub

&apos;----------------------------------------------------------------------
&apos;Gestion du bouton Retour qui permet de revenir à la saisie des coordonnées
&apos;--------------------------------------------------------------------------
sub GestionBoutonRetour
Dim i as integer
ElementInactif(monDlg, &quot;BoutonAjouter&quot;, &quot;inactif&quot;)
ElementInactif(monDlg, &quot;BoutonSup&quot;, &quot;inactif&quot;)
ElementInactif(monDlg, &quot;extA&quot;, &quot;inactif&quot;)
ElementInactif(monDlg, &quot;extB&quot;, &quot;inactif&quot;)
ElementInactif(monDlg, &quot;Aretes2&quot;, &quot;inactif&quot;)
ElementInactif(monDlg, &quot;Style&quot;, &quot;inactif&quot;)
ElementInactif(monDlg, &quot;BoutonValider1&quot;,&quot;actif&quot;)
ElementInactif(monDlg, &quot;BoutonRetour&quot;,&quot;inactif&quot;)

for i = 1 to RepPolyedre0Dlg(1)
ElementInactif(monDlg, &quot;Sommet&quot;&amp;i, &quot;actif&quot;)
ElementInactif(monDlg, &quot;abs&quot;&amp;i, &quot;actif&quot;)
ElementInactif(monDlg, &quot;virgule&quot;&amp;i, &quot;actif&quot;)
ElementInactif(monDlg, &quot;ord&quot;&amp;i, &quot;actif&quot;)
ElementInactif(monDlg, &quot;parenthese&quot;&amp;i, &quot;actif&quot;)
next
end sub

&apos;-------------------------------------------------------------------------------
&apos;récupère le style des segments dans un tabeau à 3 lignes et 100 colonnes
&apos;ligne1 des origines : retourne des entiers   1 pour A  2 pour B etc
&apos;ligne2 des extrémités : retourne des entiers   1 pour A  2 pour B etc
&apos;ligne3 des style : retourne peil ou pointillé
&apos;---------------------------------------------------------------------------------
sub StyleSegments
dim i as integer, monsegment as string, monstyleprov as string, monabsprov as string, monordprov as string
dim PointOrigineTab(100) as integer, PointFinTab(100) as integer,styleTab(100) as string

for i = 1 to CompteurAjout
monsegment = ahTexteTab(i-1)
monabsprov = Mid(monsegment, 2,1)
monordprov = Mid(monsegment, 3,1)
monstyleprov = Mid(monsegment, 9,10)
PointOrigineTab(i) = Asc(monabsprov)-64
PointFinTab(i)=  Asc(monordprov)-64


if monstyleprov=&quot;__________&quot; then
  styleTab(i)=&quot;plein&quot;
  else
  styleTab(i)= &quot;pointillé&quot;
end if
next

mesAretesTab= Tableau3xN(PointOrigineTab,PointFinTab,styleTab)

end sub

&apos;--------------------------------------------------------------------------------------------------------
&apos;--------------------------gestion de la 1ère boite de dialogue------------------------------------------
&apos;---------------------------------------------------------------------------------------------------------
sub GestionBoutonOK0  
Dim test(1) as integer

&apos;-----------------------Gestion des erreurs de saisie

test(1) = ZT_Nbre(monDlg,  &quot;NbreSommets&quot;, 4 , 25 , 4 , RepPolyedre0Dlg(0),true) 
&apos;---------------------- (test(1) contient 1 si tout est ok 0 sinon)

if test(1) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
     RepPolyedre0Dlg(1) = CDbl(monDlg.getControl(&quot;NbreSommets&quot;).Peer.Text)
     RepPolyedre0Dlg(2) = true  &apos;renvoie true si la boite de dialogue est fermée par le bouton OK
    
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    monDlg.endExecute
end if
end sub


Sub GestionInfoBulle0
TexteAide(monDlg,&quot;NbreSommets&quot;, &quot;4&lt;= ... &lt;= 25&quot;)
end sub


&apos;--------------------------------------------------------------------------------------------------------
&apos;--------------------------gestion de la 2ème boite de dialogue------------------------------------------
&apos;---------------------------------------------------------------------------------------------------------

sub GestionBoutonOK1  

    RepPolyedre1Dlg(2)= true &apos;---------------------   RepPolyedre0Dlg(2)= true quand tout est validé
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    monDlg.endExecute

End Sub



</script:module>