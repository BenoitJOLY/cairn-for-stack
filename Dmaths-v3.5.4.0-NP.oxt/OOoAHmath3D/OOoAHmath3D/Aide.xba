REM  *****  BASIC  *****

Sub Aide
Dim sv As Object, doc As String
sv = createUnoService(&quot;com.sun.star.system.SystemShellExecute&quot;)
doc = &quot;http://ahmath3d.free.fr/aide/aide.html&quot;
sv.execute(doc, &quot;&quot;, 0)
End Sub

sub Aide2
Dim monDocument As Object, adresseDoc As String
Dim propFich(0) As New com.sun.star.beans.PropertyValue
adresseDoc = convertToURL(CheminDessin(&quot;Aide.odt&quot;))	
&apos;propFich(0).Name = &quot;Hidden&quot;
&apos;propFich(0).Value = True&apos; charger en invisible
monDocument = StarDesktop.LoadComponentFromURL(AdresseDoc, &quot;_blank&quot;, 0, propFich())
&apos;MsgBox(&quot;Le document va apparaître&quot;)
monDocument.CurrentController.Frame.ContainerWindow.Visible = True
end sub

sub MonSite
Dim sv As Object, doc As String
sv = createUnoService(&quot;com.sun.star.system.SystemShellExecute&quot;)
doc = &quot;http://ahmath3d.free.fr/aide/aide.html&quot;
sv.execute(doc, &quot;&quot;, 0)
end sub
