REM  *****  BASIC  *****

option explicit


Private RepPatConeDlg(9) as variant
Private monDlg as object
&apos;----------------------------------------------


Sub appelerBoiteDialoguePatCone()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;PatConeDlg&quot;)		
&apos;-------------------------initialisation de la boite de dialogue----------------------
Initialisation(monDlg,CheminDessin(&quot;Dessins/PatCone/PatCone1.gif/&quot;),)
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs et des infobulles ------
for i = 1 to 3
RepPatConeDlg(i + 6) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	

monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub

sub PatConeMacroPrincipale()

appelerBoiteDialoguePatCone()

if RepPatConeDlg(6) = true then
   DRAWversWRITER(&quot;PatCone.ConstructionPatCone()&quot;)
   PositionObjetWriter(LastForme)
end if

end sub


sub ConstructionPatCone()
Dim R as double, h as double, g as double, AngleCentre as Double
Dim Xbase as double , Ybase as double, AngleFin as Long

R = RepPatConeDlg(0)*1000

   if RepPatConeDlg(2) = true then 
         h = RepPatConeDlg(1)*1000
         g = sqr(r*r+h*h)
   else
         g = RepPatConeDlg(1)*1000
         h = sqr(g*g-R*R)
   end if

AngleCentre = 360*R/g

if AngleCentre&gt;270 then
   AngleFin = AngleCentre + 90 - 360
   else
   AngleFin = AngleCentre + 90
end if

Xbase = 10000 + (g+R)*cos((90+AngleCentre/2)*pi/180)
Ybase = 10000 - (g+R)*sin((90+AngleCentre/2)*pi/180)
PortionDisqueDraw(10000,10000,g,9000, AngleFin*100,0)
CercleDraw(Xbase,Ybase,R,0)


  if RepPatConeDlg(4) = true then 
  LanguetteDraw(10000,10000,10000,10000-g,&quot;gauche&quot;,0)
  end if


end sub



&apos;****************************************************Gestion de la boite de dialogue*****************************************************************

Sub GestionInfoBulle
TexteAide(monDlg,&quot;PatConeDlg1&quot;, &quot;0 &lt; ... &lt;= 10&quot;)
TexteAide(monDlg,&quot;PatConeDlg2&quot;, &quot;0 &lt; ... &lt;= 20&quot;)
end sub


sub GestionBoutonOK  
Dim i as integer, test(2) as integer, val1 as double, Etat1 as Boolean, MesErreur as string

Etat1 =  monDlg.getControl(&quot;PatConeDlg4&quot;).state
MesErreur = RepPatConeDlg(8)

&apos;-----------------------Gestion des erreurs de saisie
test(1) = ZT_Nbre(monDlg, &quot;PatConeDlg1&quot;, 0.001 , 10 , 3 ,RepPatConeDlg(7),)

If Etat1 = false then
test(2) = ZT_Nbre(monDlg,  &quot;PatConeDlg2&quot;, 0.001 , 20 , 5 ,RepPatConeDlg(8),)
end if
if Etat1 = true then    &apos;test: segment generateur &gt; rayon
   if test(1) = 1 then
   val1 = CDbl(ReponseTexte(monDlg, &quot;PatConeDlg1&quot;)) + 0.001
   test(2) = ZT_Nbre(monDlg,  &quot;PatConeDlg2&quot;, val1 , 20 , 5 ,RepPatConeDlg(9),)
   else
   test(2) = 1
   end if
end if

    
test(0) = test(1)*test(2)

&apos;---------------------- (test(0) contient 1 si tout est ok 0 sinon)

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
 
    for i = 1 to 2
    RepPatConeDlg(i - 1) = CDbl(monDlg.getControl(&quot;PatConeDlg&quot;&amp;i).Peer.Text)  
    Next
    for i = 3 to 6
    RepPatConeDlg(i - 1) = monDlg.getControl(&quot;PatConeDlg&quot;&amp;i).state 
    next
          
    RepPatConeDlg(6) = true  
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé

&apos;---------------------    RepPatCylDlg(6) = true quand tout est validé
    monDlg.endExecute
end if

End Sub

</script:module>