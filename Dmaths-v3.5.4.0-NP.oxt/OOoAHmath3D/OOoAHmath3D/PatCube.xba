REM  *****  BASIC  *****

option explicit


Private RepPatCubeDlg(15) as variant
Private monDlg as object
&apos;----------------------------------------------


Sub appelerBoiteDialoguePatCube()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;PatCubeDlg&quot;)		
&apos;------------------------initialisation de la boite de dialogue-----------------------
Initialisation(monDlg,CheminDessin(&quot;Dessins/PatCube/PatCube.gif/&quot;),)
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs et des infobulles ------
RepPatCubeDlg(15) = monDlg.getControl(&quot;Message1&quot;).Peer.Text
&apos;--------------------------------------------------------------------------------------	

monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub

&apos;---------------------------------------------------------------------------------------

sub PatCubeMacroPrincipale()

appelerBoiteDialoguePatCube()

if RepPatCubeDlg(14) = true then
   DRAWversWRITER(&quot;PatCube.ConstructionPatCube()&quot;)
   PositionObjetWriter(LastForme)
end if
end sub


&apos;---------------------------------------------------------------------------------------
&apos;Construction du patron suivant les réponses du dialogue
&apos;Macro qui est lancé dans DRAWversWRITER()
&apos;----------------------------------------------------------------------------------------

sub ConstructionPatCube()
Dim arete as Double, i as integer

arete = RepPatCubeDlg(0) * 1000

&apos;-------------gestion des patrons 1 à 6-------------
&apos;- ligne2 de carrés-------------------
for i=1 to 6
if RepPatCubeDlg(i)=true then
CarreDraw(2000, 2000+ arete, 2000 + arete, 2000+ arete)
CarreDraw(2000+arete, 2000+ arete, 2000 + arete*2, 2000+ arete)
CarreDraw(2000+arete*2, 2000+ arete, 2000 + arete*3, 2000+ arete)
CarreDraw(2000+arete*3, 2000+ arete, 2000 + arete*4, 2000+ arete)
end if
next

&apos;- ligne 1 et3 de carrés--------------
if RepPatCubeDlg(1) = true then
CarreDraw(2000, 2000, 2000 + arete, 2000)
CarreDraw(2000, 2000+ arete*2, 2000 + arete, 2000+ arete*2)
end if

if RepPatCubeDlg(2) = true then
CarreDraw(2000, 2000, 2000 + arete, 2000)
CarreDraw(2000+arete, 2000+ arete*2, 2000 + arete*2, 2000+ arete*2)
end if

if RepPatCubeDlg(3) = true then
CarreDraw(2000, 2000, 2000 + arete, 2000)
&apos;-ligne3 de carrés
CarreDraw(2000+arete*2, 2000+ arete*2, 2000 + arete*3, 2000+ arete*2)
end if

if RepPatCubeDlg(4) = true then
CarreDraw(2000, 2000, 2000 + arete, 2000)
CarreDraw(2000+arete*3, 2000+ arete*2, 2000 + arete*4, 2000+ arete*2)
end if

if RepPatCubeDlg(5) = true then
CarreDraw(2000+arete, 2000, 2000 + arete*2, 2000)
CarreDraw(2000+arete, 2000+ arete*2, 2000 + arete*2, 2000+ arete*2)
end if

if RepPatCubeDlg(6) = true then
CarreDraw(2000+arete, 2000, 2000 + arete*2, 2000)
CarreDraw(2000+arete*2, 2000+ arete*2, 2000 + arete*3, 2000+ arete*2)
end if

&apos;--------------gestion des patrons 7 à 10----------------------

&apos;---ligne 1 et 2 des carrés------
for i = 7 to 10
if RepPatCubeDlg(i)= true then
CarreDraw(2000+arete, 2000, 2000 + arete*2, 2000)
CarreDraw(2000+arete*2, 2000, 2000 + arete*3, 2000)

CarreDraw(2000+arete*2, 2000+ arete, 2000 + arete*3, 2000+ arete)
CarreDraw(2000+arete*3, 2000+ arete, 2000 + arete*4, 2000+ arete)
CarreDraw(2000+arete*4, 2000+ arete, 2000 + arete*5, 2000+ arete)
end if
next

&apos;--- ligne 1 et 2 des carrés
if RepPatCubeDlg(7) = true then
CarreDraw(2000+arete*2, 2000+ arete*2, 2000 + arete*3, 2000+ arete*2)
end if

if RepPatCubeDlg(8) = true then
CarreDraw(2000+arete*3, 2000+ arete*2, 2000 + arete*4, 2000+ arete*2)
end if

if RepPatCubeDlg(9) = true then
CarreDraw(2000+arete*4, 2000+ arete*2, 2000 + arete*5, 2000+ arete*2)
end if

if RepPatCubeDlg(10) = true then
CarreDraw(2000, 2000, 2000 + arete, 2000)
end if

&apos;-- gestion du patron 11

if RepPatCubeDlg(11) = true then
CarreDraw(2000+arete, 2000, 2000 + arete*2, 2000)
CarreDraw(2000+arete*2, 2000, 2000 + arete*3, 2000)

CarreDraw(2000+arete*2, 2000+ arete, 2000 + arete*3, 2000+ arete)
CarreDraw(2000+arete*3, 2000+ arete, 2000 + arete*4, 2000+ arete)

CarreDraw(2000+arete*3, 2000+ arete*2, 2000 + arete*4, 2000+ arete*2)
CarreDraw(2000+arete*4, 2000+ arete*2, 2000 + arete*5, 2000+ arete*2)
end if

&apos;------------gestion des bandes de collage ------------------------
if RepPatCubeDlg(12) = true then
 for i=1 to 4 
  if RepPatCubeDlg(i) = true then
  LanguetteDraw(2000,2000,2000+arete,2000,&quot;droite&quot;,30)
  LanguetteDraw(2000,2000,2000,2000+arete,&quot;gauche&quot;,30)
  LanguetteDraw(2000+arete,2000,2000+arete,2000+arete,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete*4,2000+arete,2000+arete*4,2000+arete*2,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete*(i-1),2000+arete*3,2000+arete*i,2000+arete*3,&quot;gauche&quot;,30)
  LanguetteDraw(2000+arete*(i-1),2000+arete*2,2000+arete*(i-1),2000+arete*3,&quot;gauche&quot;,30)
  LanguetteDraw(2000+arete*i,2000+arete*2,2000+arete*i,2000+arete*3,&quot;droite&quot;,30)
  end if
  next
  
   for i=5 to 6 
  if RepPatCubeDlg(i) = true then
  LanguetteDraw(2000+arete,2000,2000+arete*2,2000,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete,2000,2000+arete,2000+arete,&quot;gauche&quot;,30)
  LanguetteDraw(2000+arete*2,2000,2000+arete*2,2000+arete,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete*4,2000+arete,2000+arete*4,2000+arete*2,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete*(i-4),2000+arete*3,2000+arete*(i-3),2000+arete*3,&quot;gauche&quot;,30)
  LanguetteDraw(2000+arete*(i-4),2000+arete*2,2000+arete*(i-4),2000+arete*3,&quot;gauche&quot;,30)
  LanguetteDraw(2000+arete*(i-3),2000+arete*2,2000+arete*(i-3),2000+arete*3,&quot;droite&quot;,30)
  end if
  next
  
   for i=7 to 9 
  if RepPatCubeDlg(i) = true then
  LanguetteDraw(2000+arete,2000,2000+arete*2,2000,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete*2,2000,2000+arete*3,2000,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete*3,2000,2000+arete*3,2000+arete,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete,2000+arete,2000+arete*2,2000+arete,&quot;gauche&quot;,30)
  LanguetteDraw(2000+arete*(i-5),2000+arete*3,2000+arete*(i-4),2000+arete*3,&quot;gauche&quot;,30)
  LanguetteDraw(2000+arete*(i-4),2000+arete*2,2000+arete*(i-4),2000+arete*3,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete*(i-5),2000+arete*2,2000+arete*(i-5),2000+arete*3,&quot;gauche&quot;,30)
  end if
  next


if RepPatCubeDlg(10) = true then
  LanguetteDraw(2000,2000,2000+arete,2000,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete,2000,2000+arete*2,2000,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete*2,2000,2000+arete*3,2000,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete*3,2000,2000+arete*3,2000+arete,&quot;droite&quot;,30)
  LanguetteDraw(2000,2000,2000,2000+arete,&quot;gauche&quot;,30)
  LanguetteDraw(2000,2000+arete,2000+arete,2000+arete,&quot;gauche&quot;,30)
  LanguetteDraw(2000+arete,2000+arete,2000+arete*2,2000+arete,&quot;gauche&quot;,30)
end if

 if RepPatCubeDlg(11) = true then
  LanguetteDraw(2000+arete,2000,2000+arete*2,2000,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete*2,2000,2000+arete*3,2000,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete*3,2000,2000+arete*3,2000+arete,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete,2000+arete,2000+arete*2,2000+arete,&quot;gauche&quot;,30)
  LanguetteDraw(2000+arete*3,2000+arete*3,2000+arete*4,2000+arete*3,&quot;gauche&quot;,30)
  LanguetteDraw(2000+arete*4,2000+arete*2,2000+arete*5,2000+arete*2,&quot;droite&quot;,30)
  LanguetteDraw(2000+arete*3,2000+arete*2,2000+arete*3,2000+arete*3,&quot;gauche&quot;,30)
  end if
end if

end sub

&apos;****************************************************Gestion de la boite de dialogue*****************************************************************

Sub GestionInfoBulle
TexteAide(monDlg,&quot;arete&quot;, &quot;0 &lt;= ... &lt;= 20&quot;)
end sub

sub GestionBoutonOK  
Dim i as integer, test(3) as integer

&apos;-----------------------Gestion des erreurs de saisie
test(3) = ZT_Nbre(monDlg,  &quot;arete&quot;, 0.001 , 20 , 3 ,  RepPatCubeDlg(15),)  &apos; 0 ou 1

if test(3) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
 
    RepPatCubeDlg(0) = CDbl(monDlg.getControl(&quot;arete&quot;).Peer.Text)  
    for i = 1 to 13
    RepPatCubeDlg(i) = monDlg.getControl(&quot;OptionButton&quot;&amp;i).state 
    next
          
    RepPatCubeDlg(14) = true  
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé

&apos;---------------------    RepPatCubeDlg(14) = true quand tout est validé
    monDlg.endExecute
end if

End Sub


</script:module>