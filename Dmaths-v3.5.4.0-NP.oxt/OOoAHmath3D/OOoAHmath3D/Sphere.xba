REM  *****  BASIC  *****

Option Explicit


Private RepSphereDlg(20) as variant
Private monDlg as object

sub SphereMacroPrincipale &apos;macro principale

Dim i As Integer, test As String, decalage As Long, NombreElements as variant
Dim NomSolide As String, nbre1 as variant, nbre2 as variant, nbre3 as variant, nbre4 as variant

appelerBoiteDialogueSphere()

if RepSphereDlg(20) = true then 
DRAWversWRITER(&quot;Sphere.ConstructionSphere()&quot;)
PositionObjetWriter(LastForme)
end if

end Sub

&apos;------------------------------------------------------------------------------------------------------
Sub appelerBoiteDialogueSphere()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;SphereDlg&quot;)
&apos;------------------------initialisation de la boite de dialogue-----------------------
Initialisation(monDlg,CheminDessin(&quot;Dessins/Sphere/sphere1.gif/&quot;),3)
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs-------------------------
for i = 1 to 4
RepSphereDlg(i + 14) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	

monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
    
End Sub



sub ConstructionSphere()
TracerSphere(10000,10000, RepSphereDlg(0)*1000,RepSphereDlg(1))
end sub


&apos;------------------------------------------------------------------------------------------------------
sub TracerSphere(Xcentre as Double, Ycentre as Double , Rayon as Double , AngIncl as Double)
Dim RadAngIncl as Double
Dim Abscentre1 as Double, Ordcentre1 as  Double, Abscentre2 as Double, Ordcentre2 as Double, Abscentre as Double, Ordcentre as  Double
Dim AngleRayon as double, AngleDiam as double, AngleRayon2 as double, AngleDiam2 as double, RadMeridien as double, RadParallele as double
Dim a as double, b as double, h1 as double, k as integer, b2 as double
Dim x1 as double, x2 as double, a1 as double, b1 as double, d1 as double



RadAngIncl =abs(AngIncl * pi / 180)  &apos;abs car il me faut un angle positif à cause du signe des sin
AbsCentre = Xcentre
OrdCentre = Ycentre


AngleDiam = RepSphereDlg(3)* pi/180
AngleRayon = RepSphereDlg(2)* pi/180

a = Rayon
b = Rayon * sin(RadAngIncl)

&apos;le 3ème argument de ArcEllipse est la largeur de l&apos;ellipse entière
&apos;le 4ème argument de ArcEllipse est la hauteur de l&apos;ellipse entière
if AngIncl &gt; 0 then
ArcEllipseDraw(Abscentre - a, Ordcentre -a   ,2*a,2*a,&quot;plein&quot;,0,180)
ArcEllipseDraw(Abscentre - a , Ordcentre - a  ,2*a,2*a,&quot;plein&quot;,180,0)
ArcEllipseDraw(Abscentre - a, Ordcentre -b  ,2*a,2*b,&quot;pointillé&quot;,0,180)
ArcEllipseDraw(Abscentre - a, Ordcentre -b  ,2*a,2*b,&quot;plein&quot;,180,0)
end if
if AngIncl &lt; 0 then
ArcEllipseDraw(Abscentre - a, Ordcentre -a   ,2*a,2*a,&quot;plein&quot;,0,180)
ArcEllipseDraw(Abscentre - a , Ordcentre -a  ,2*a,2*a,&quot;plein&quot;,180,0)
ArcEllipseDraw(Abscentre - a, Ordcentre -b  ,2*a,2*b,&quot;plein&quot;,0,180)
ArcEllipseDraw(Abscentre - a, Ordcentre -b ,2*a,2*b,&quot;pointillé&quot;,180,0)
end if

if AngIncl = 0 then
ArcEllipseDraw(Abscentre - a, Ordcentre -a   ,2*a,2*a,&quot;plein&quot;,0,180)
ArcEllipseDraw(Abscentre - a , Ordcentre -a ,2*a,2*a,&quot;plein&quot;,180,0)
SegmentDraw(AbsCentre-a, OrdCentre  ,  AbsCentre+a , OrdCentre  ,30,&quot;plein&quot;)

end if
&apos;----------------------tracer le centre de la sphère
if RepSphereDlg(4) = 1 then
SegmentDraw(AbsCentre-100, OrdCentre - 100 * sin(RadAngIncl) ,  AbsCentre+100 , OrdCentre + 100 * sin(RadAngIncl) , 30,&quot;plein&quot;)
SegmentDraw(AbsCentre-100, OrdCentre + 100 * sin(RadAngIncl),  AbsCentre+100, OrdCentre - 100 * sin(RadAngIncl) , 30,&quot;plein&quot;)
end if
&apos;-----------------------tracé de le diamètre Nord-Sud
if RepSphereDlg(5) = 1 then
  if RepSphereDlg(8) = true then
  SegmentDraw(AbsCentre, OrdCentre -a ,  AbsCentre , OrdCentre+a , 30,&quot;plein&quot;)
  else
  SegmentDraw(AbsCentre, OrdCentre -a ,  AbsCentre , OrdCentre+a , 30,&quot;pointillé&quot;)
  end if
end if
&apos;---------------------tracer un rayon
if RepSphereDlg(6) = 1 then
  if RepSphereDlg(9) = true then
  SegmentDraw(AbsCentre, OrdCentre ,  AbsCentre + a* cos(AngleRayon) , OrdCentre - a * sin(AngleRayon)*sin(RadAngIncl) , 30,&quot;plein&quot;)
  else
  SegmentDraw(AbsCentre, OrdCentre ,  AbsCentre + a* cos(AngleRayon) , OrdCentre- a * sin(AngleRayon) * sin(RadAngIncl) , 30,&quot;pointillé&quot;)
  end if
end if
&apos;--------------------tracer un diamètre
if RepSphereDlg(7) = 1 then
  if RepSphereDlg(10) = true then
  SegmentDraw(AbsCentre - a* cos(AngleDiam), OrdCentre+ a * sin(AngleDiam)*sin(RadAngIncl) ,  AbsCentre + a* cos(AngleDiam) , OrdCentre- a* sin(AngleDiam	)*sin(RadAngIncl) , 30,&quot;plein&quot;)
  else
  SegmentDraw(AbsCentre - a* cos(AngleDiam), OrdCentre+ a * sin(AngleDiam)*sin(RadAngIncl) ,  AbsCentre + a* cos(AngleDiam) , OrdCentre- a* sin(AngleDiam)*sin(RadAngIncl) , 30,&quot;pointillé&quot;)
  end if
end if

end sub
&apos;-------------------------------------------------------------------------------------------------------
&apos;gestion des boutons de la boite de dialogue

Sub GestionInfoBulle
TexteAide(monDlg,&quot;RepSph1&quot;, &quot;0&lt; ... &lt;= 10&quot;)
TexteAide(monDlg,&quot;RepSph2&quot;, &quot;-90&lt;= ... &lt;= 90&quot;)
TexteAide(monDlg,&quot;RepSph3&quot;, &quot;0&lt;= ... &lt;= 360&quot;)
TexteAide(monDlg,&quot;RepSph4&quot;, &quot;0&lt;= ... &lt;= 180&quot;)
end sub

sub GestionCase1
Aspect2BoutonsRadio(monDlg,&quot;RepSph6&quot;,&quot;StyleA1&quot;,&quot;StyleB1&quot;)
end sub

sub GestionCase3
Aspect2BoutonsRadio(monDlg,&quot;RepSph7&quot;,&quot;StyleA2&quot;,&quot;StyleB2&quot;)
AspectLabel(monDlg,&quot;RepSph7&quot;,&quot;Label22&quot;)
AspectLabel(monDlg,&quot;RepSph7&quot;,&quot;RepSph3&quot;)
end sub

sub GestionCase4
Aspect2BoutonsRadio(monDlg,&quot;RepSph8&quot;,&quot;StyleA3&quot;,&quot;StyleB3&quot;)
AspectLabel(monDlg,&quot;RepSph8&quot;,&quot;Label23&quot;)
AspectLabel(monDlg,&quot;RepSph8&quot;,&quot;RepSph4&quot;)
end sub


sub GestionImage
ChangerImagePrincipalex2(monDlg , &quot;RepSph2&quot;, CheminDessin(&quot;Dessins/Sphere/sphere1.gif/&quot;),CheminDessin(&quot;Dessins/Sphere/sphere2.gif/&quot;), CheminDessin(&quot;Dessins/erreur.gif/&quot;))
end sub



sub GestionBoutonOK  
Dim i as integer, test(6) as integer

&apos;-----------------------Gestion des erreurs de saisie
test(1) = ZT_Nbre(monDlg,  &quot;RepSph1&quot;, 0.001 , 10 , 3 , RepSphereDlg(15),)
test(2) = ZT_Nbre(monDlg,  &quot;RepSph2&quot;, -90 , 90 , 10 , RepSphereDlg(16),) 
test(3) = ZT_Nbre(monDlg,  &quot;RepSph3&quot;, 0 , 360 , 0 , RepSphereDlg(17),)
test(4) = ZT_Nbre(monDlg,  &quot;RepSph4&quot;, 0 , 180 , 0 , RepSphereDlg(18),) 
     
test(0) = test(1)*test(2)*test(3)*test(4) &apos;test(0) contient 1 si tout est ok 0 sinon

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
    for i = 1 to 4
    RepSphereDlg(i - 1) = CDbl(monDlg.getControl(&quot;RepSph&quot;&amp;i).Peer.Text)
    Next
    for i = 5 to 8
    RepSphereDlg(i - 1) = monDlg.getControl(&quot;RepSph&quot;&amp;i).state  
    Next
    for i = 1 to 3
    RepSphereDlg(7+i) = monDlg.getControl(&quot;StyleA&quot;&amp;i).state  
    Next 
        
    RepSphereDlg(20) = true  &apos;renvoie true si la boite de dialogue est fermée par le bouton OK
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    monDlg.endExecute
end if

End Sub


</script:module>