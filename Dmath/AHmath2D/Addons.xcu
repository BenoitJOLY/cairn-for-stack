<?xml version='1.0' encoding='UTF-8'?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Addons" oor:package="org.openoffice.Office">
<node oor:name="AddonUI">
	<node oor:name="Images">
		<node oor:name="org.openoffice.Office.addon.AHmath2D.image1" oor:op="replace">
			<prop oor:name="URL" oor:type="xs:string">
					<value>macro:///AHmath2D.ah2dMain.Main</value>
			</prop>
			<node oor:name="UserDefinedImages">
				<prop oor:name="ImageSmallURL" oor:type="xs:string">
					<value>%origin%/Images/icone_16.png</value>
				</prop>
				<prop oor:name="ImageBigURL" oor:type="xs:string">
					<value>%origin%/Images/icone_26.png</value>
				</prop>
			</node>
		</node>
	</node>
	
	<node oor:name="OfficeToolBar">
			<node oor:name="org.openoffice.Office.addon.AHmath2D.OfficeToolBar" oor:op="replace">
				<prop oor:name="Title" oor:type="xs:string">
					<value>AHmath2D</value>
				</prop>
				<node oor:name="ToolBarItems">
					<node oor:name="bo01" oor:op="replace">
						<prop oor:name="Context" oor:type="xs:string">
							<value>com.sun.star.text.TextDocument,com.sun.star.drawing.DrawingDocument</value>
						</prop>
						<prop oor:name="Title" oor:type="xs:string">
							<value xml:lang="fr">AHmath2D</value>
							<value xml:lang="en">AHmath2D</value>
						</prop>
						<prop oor:name="URL" oor:type="xs:string">
							<value>macro:///AHmath2D.ah2dMain.Main</value>
						</prop>
						<prop oor:name="Target" oor:type="xs:string">
							<value>_self</value>
						</prop>
						<prop oor:name="ImageIdentifier" oor:type="xs:string">
							<value></value>
						</prop>
					</node>
				</node>
				<!-- -->
					<node oor:name="bo01" oor:op="replace">
						<prop oor:name="Context" oor:type="xs:string">
							<value>com.sun.star.text.TextDocument,com.sun.star.drawing.DrawingDocument</value>
						</prop>
						<prop oor:name="Title" oor:type="xs:string">
							<value xml:lang="fr">AHmath2D</value>
							<value xml:lang="en">AHmath2D</value>
						</prop>
						<prop oor:name="URL" oor:type="xs:string">
							<value>macro:///AHmath2D.ah2dMain.Main</value>
						</prop>
						<prop oor:name="Target" oor:type="xs:string">
							<value>_self</value>
						</prop>
						<prop oor:name="ImageIdentifier" oor:type="xs:string">
							<value></value>
						</prop>
					</node>
		</node>
	</node>
</node>
</oor:component-data>