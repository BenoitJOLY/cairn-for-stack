Sub InfoElement
Dim oSelection as object
	if RepControl(monDlg,&quot;CommandButton25&quot;, &quot;CommandButton&quot;) = 1 then
	oSelection = mesFormes(0)
	eZorder = oSelection.Zorder
	oElementSimple = mesFormes(eZorder)
	oInfoES = InfoForme(oElementSimple)
	AspectForme(oElementSimple,oInfoES(8),100,array(RGB(0,0,255),oInfoES(6)(1)),oInfoES(7))
	else
	AspectForme(oElementSimple,oInfoES(8),0,oInfoES(6),oInfoES(7))
	End if
End Sub

&apos;------------------------------------------------------------------------- Info de l&apos;élément selectionné


sub AffichageInfo(oObjet as object)
Dim oInfo as variant, ChoixApercu as integer, i as integer, oAngle as Long, oAngleArrondi15 as integer, oAngleArc as Long
Dim oTitre as string

oInfo = InfoForme(oObjet)
oTitre = Trad(monDlg,MesMessages2(10))
AffectVarControl(monDlg,oInfo(10) ,&quot;info1&quot;,&quot;Label&quot;)
AffectVarControl(monDlg,oInfo(9) ,&quot;info4&quot;,&quot;Label&quot;)

if oInfo(10) = &quot;Segment&quot; then
AffectVarControl(monDlg,oInfo(4) &amp; &quot; cm / &quot; &amp; oInfo(5) &amp; &quot; °&quot;,&quot;info2&quot;,&quot;Label&quot;)
end if
if oInfo(10) = &quot;Cercle&quot; then 
AffectVarControl(monDlg,&quot;R = &quot; &amp; CInt(oInfo(4))/1000 &amp; &quot; cm&quot;,&quot;info2&quot;,&quot;Label&quot;)
AffectVarControl(monDlg, &quot; &quot; ,&quot;info3&quot;,&quot;Label&quot;)
end if
if oInfo(10) = &quot;Arc de cercle&quot; then 
oAngle = oInfo(5)(1) - oInfo(5)(0)
if oAngle &lt; 0 then oAngle = 360 + oAngle
AffectVarControl(monDlg,&quot;R = &quot; &amp; CInt(oInfo(4))/1000 &amp; &quot; cm / &quot; &amp; oTitre &amp; &quot; = &quot; &amp; oAngle &amp; &quot; °&quot;,&quot;info2&quot;,&quot;Label&quot;)
AffectVarControl(monDlg,&quot; &quot;,&quot;info3&quot;,&quot;Label&quot;)
end if
if oInfo(10) = &quot;Point&quot; then 
AffectVarControl(monDlg,&quot; &quot;,&quot;info2&quot;,&quot;Label&quot;)
AffectVarControl(monDlg,&quot; &quot;,&quot;info3&quot;,&quot;Label&quot;)
end if
if oInfo(10) = &quot;Inconnu&quot; or oInfo(10) = &quot;Surface coloriée&quot; or oInfo(10) = &quot;Codage&quot;  then 
AffectVarControl(monDlg,&quot; &quot;,&quot;info2&quot;,&quot;Label&quot;)
AffectVarControl(monDlg,&quot; &quot;,&quot;info2&quot;,&quot;Label&quot;)
end if
End sub



&apos;--------------------------------------------------------------------------------------
&apos; Attention oCollection peut contenir un point qui est une forme groupée de 2 segments
&apos;-----------------------------------------------------------------------------------------

sub IncrementerElement(k as integer, oCollection as object, optional oCouleur as  Long)
Dim nElements as Integer
    &apos;k = 1 pour suivant     k = -1 pour précédent
    &apos;K = 2 pour dernier     k = -2 pour premier
If IsMissing(oCouleur) then oCouleur = RGB(0,0,255)
nElements = oCollection.count
if nElements = 0 then
Exit sub
End if
AspectForme(oElementSimple,oInfoES(8),0,oInfoES(6),oInfoES(7))  &apos;Reaffecte les attributs originaux de oElementSimple (en mémoire) 
if k = 1 then eZorder = (eZorder + 1) MOD nElements
if k = 2 then eZorder = nElements - 1
if k = -1 then eZorder = (eZorder + nElements - 1) MOD nElements
if k = -2 then eZorder = 0
oElementSimple = oCollection(eZorder)          &apos;Recupere l&apos;element suivant
oInfoES = InfoForme(oElementSimple) &apos;met en mémoire les attributs de oElementSimple
if oInfoES(7)(0) &lt;&gt; 0 then  &apos;met en evidence oElementSimple suivant que la bordure est visible ou non
	AspectForme(oElementSimple,oInfoES(8),100,array(oCouleur,oInfoES(6)(1)),oInfoES(7)) 
	Else
	AspectForme(oElementSimple,oInfoES(8),100,array(oCouleur,oInfoES(6)(1)),array(1,oInfoES(7)(1)))
End if
AffichageInfo(oElementSimple)
end sub



sub ElementSuivant
Dim oTest as variant
IncrementerElement(1,mesFormes)
AffichageOrdre
end sub

sub ElementPrecedent
IncrementerElement(-1,mesFormes)
AffichageOrdre
end sub


sub ElementPremier
IncrementerElement(-2,mesFormes)
AffichageOrdre
end sub

sub ElementDernier
IncrementerElement(2,mesFormes)
AffichageOrdre
end sub

</script:module>