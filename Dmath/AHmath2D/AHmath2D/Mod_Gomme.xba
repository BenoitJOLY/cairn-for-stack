Sub GommeElement(oStep as integer)
Dim oElementChoisi as object, eOrdre as integer

	oReponseDlg(1) = RepControl(monDlg,&quot;ListBox14&quot;,&quot;ListBox&quot;)(1)
	oReponseDlg(2) = RepControl(monDlg,&quot;ListBox15&quot;,&quot;ListBox&quot;)(1)

    if oReponseDlg(1) = 0 then 
	oElementChoisi = oCollectionPointsMarques(oReponseDlg(2))
	oCollectionPointsMarques.remove(oElementChoisi)
    End if
	if oReponseDlg(1) = 1 then 
    oElementChoisi = oCollectionSegments(oReponseDlg(2))
    oCollectionSegments.remove(oElementChoisi)
    End if
    if oReponseDlg(1) = 2 then 
    oElementChoisi = oCollectionCercles(oReponseDlg(2))
    oCollectionCercles.remove(oElementChoisi)
    End if
    if oReponseDlg(1) = 3 then 
    oElementChoisi = oCollectionArcs(oReponseDlg(2))
    oCollectionArcs.remove(oElementChoisi)
    End if
    if oReponseDlg(1) = 4 then 
    oElementChoisi = oCollectionSurfaces(oReponseDlg(2))
    oCollectionSurfaces.remove(oElementChoisi)
    End if
    if oReponseDlg(1) = 5 then 
    EffaceDerniereConstruction
    End if
    if oReponseDlg(1) = 6 then 
    oElementChoisi = oCollectionRestes(oReponseDlg(2))
    oCollectionRestes.remove(oElementChoisi)
    End if
    if oReponseDlg(1) &lt;&gt; 5 then
	mesFormes.remove(oElementChoisi)
	oPageTemp.Remove(oElementChoisi)
	End if
end sub





sub SauvDerniereConstruction(oElementAjoute as object, optional avecVidange as boolean)

If IsMissing(avecVidange) then avecVidange = true

if oCollectionDerniereConst.hasElements = true and avecVidange = true then Vidange(oCollectionDerniereConst)
oCollectionDerniereConst.add(oElementAjoute)
End sub




sub EffaceDerniereConstruction
Dim i as integer
if oCollectionDerniereConst.hasElements = false then
	msgbox(Trad(monDlg,MesMessages2(0)))
End if
if oCollectionDerniereConst.hasElements = true then
	For i = 0 to oCollectionDerniereConst.count-1
	mesFormes.remove(oCollectionDerniereConst(i))
	oPageTemp.Remove(oCollectionDerniereConst(i))
	Next
	Vidange(oCollectionDerniereConst)
End if
End sub
</script:module>