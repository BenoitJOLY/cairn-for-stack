Sub ConstSurface(oStep as integer)
Dim monEllipse as object,oEllipseBis as object, monPolygone as object, oS as variant

if oStep = 20 then
	oReponseDlg(1) = RepControl(monDlg,&quot;ListBox10&quot;,&quot;ListBox&quot;)(1)

	If oReponseDlg(1) = 1 then
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox38&quot;,&quot;ListBox&quot;)(1)
		monEllipse = oCollectionArcCercles(oReponseDlg(2))
		If RepControl(monDlg,&quot;OptionButton9&quot;,&quot;OptionButton&quot;)= true then oEllipseBis = ChoixSurfaceArc(monEllipse,0)
		If RepControl(monDlg,&quot;OptionButton10&quot;,&quot;OptionButton&quot;)= true then oEllipseBis = ChoixSurfaceArc(monEllipse,2)
		If RepControl(monDlg,&quot;OptionButton11&quot;,&quot;OptionButton&quot;)= true then oEllipseBis = ChoixSurfaceArc(monEllipse,1)
		mesFormes.add(oEllipseBis)
		SauvDerniereConstruction(oEllipseBis)
	End if
	If oReponseDlg(1) = 0 then 
			oReponseDlg(2) = RepControl(monDlg,&quot;TextField40&quot;,&quot;TextField&quot;)
			oS = SommetsPolygone(oReponseDlg(2))
			Dim oTab(Ubound(oS)) as variant
			for i = 0 to Ubound(oS)
				if oS(i) &lt;&gt; -1 then 
				oTab(i) = oListePointsExistants(oS(i))
				Else
				msgbox(Trad(monDlg,Mesmessages2(7)))
				Exit sub
				end if
			Next
			
			for i = 0 to Ubound(oS)
			oTab(i) = oListePointsExistants(oS(i))
			Next
			monPolygone = ConstBezier(oTab)
			mesFormes.add(monPolygone)
			SauvDerniereConstruction(monPolygone)
	End if
End if

End sub


&apos;---------------------------------------------------------------
&apos;---oValeur = 0 (cercle) oValeur = 1 (secteur disque)  oValeur = 2 (Arc disque)   oValeur = 3 (Arc cercle)

Function ChoixSurfaceArc(oObjet as object, oValeur as Long)  as object
Dim oElementBis as Object, oInfo as variant
oInfo = InfoForme(oObjet)
if oInfo(10) = &quot;Cercle&quot; then
oElementBis = CercleDraw(oInfo(3).X,oInfo(3).Y,oInfo(4))
AspectForme(oElementBis,30,100,array(RGB(0,0,255),RGB(0,255,0)),array(0,1))
End if
if oInfo(10) = &quot;Arc de cercle&quot; then
oElementBis = ArcCercleDraw2(oInfo(3),oInfo(1),oInfo(2))
oElementBis.CircleKind = oValeur
AspectForme(oElementBis,30,100,array(RGB(0,0,255),RGB(0,255,0)),array(0,1))
End if
oElementBis.Zorder = 0

ChoixSurfaceArc = oElementBis
End function



Function ConstBezier(oTabSommets as variant) as object
Dim maLigne as object, nbrS as integer
nbrS = Ubound(oTabSommets)+1
if nbrS &gt;= 3 then
	maLigne = LigneBriseeDraw(nbrS, oTabSommets, true)
	maLigne.LineStyle = 0
End if
maLigne.Zorder = 0
ConstBezier = maLigne
End Function



&apos;---------------------------------------------------
&apos;  otxt = RepControl(monDlg,&quot;TextField40&quot;, &quot;TextField&quot;)
&apos; Renvois les indices des points ZT 
&apos;-----------------------------------------------------
Function SommetsPolygone(otxt as string) as variant
Dim i as integer, oLongueur as Long, oS as string

oLongueur =  Len(otxt)
Dim mesIndices(oLongueur-1) as Long, mesSommets(oLongueur-1) as string

for i = 0 to oLongueur-1
	mesSommets(i) = Mid(otxt,i+1,1)
Next 
for i = 0 to oLongueur-1
	mesIndices(i) = -1
Next 
	for i = 0 to uBound(oTabNomPoints)
		For j = 0 to oLongueur-1
			if mesSommets(j) = oTabNomPoints(i) then mesIndices(j) = i
		Next
	Next

SommetsPolygone = mesIndices
end Function
</script:module>