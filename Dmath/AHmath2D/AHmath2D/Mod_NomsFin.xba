Public mesNoms(67) as string


sub ConstNomsZoneTxt
Dim mDessinFinal as object, oNbrZoneTxt as integer, mCurseur as object

Dim i as integer, j as integer, uneZoneTxt as object,  oPosition as New com.sun.star.awt.Point, mObjetFinal as object
Dim mPolice as string, mTaille as integer,mGras as integer, mItalic as integer

mPolice = RepControl(monDlg,&quot;ListBox18&quot;,&quot;ListBox&quot;)(0)
mTaille = CInt(RepControl(monDlg,&quot;ListBox32&quot;,&quot;ListBox&quot;)(0))
oReponseDlg(1) = RepControl(monDlg,&quot;CheckBox70&quot;,&quot;CheckBox&quot;)
if oReponseDlg(1) = 0 then 
	mGras = 50
	Else
	mGras = 250
End if
mItalic = RepControl(monDlg,&quot;CheckBox71&quot;,&quot;CheckBox&quot;)
oNbrZoneTxt = 0

oPosition.X = 1000
mObjetFinal = oDocActif.CurrentSelection(0)
if IsShape(mObjetFinal) = true or IsGroupShape(mObjetFinal) = true then oPosition.Y = oInfoDoc(6)*1000

For i = 0 to 67
	if mesNoms(i) &lt;&gt; &quot;0&quot; then
		uneZoneTxt = ZoneTexteDraw(oDocActif,mesNoms(i), oPosition, Array(mTaille,mItalic,mGras,RGB(0,0,0),0, mPolice))    &apos;(taille, italique,gras,couleur, cadre)
		    if oDocActif.ImplementationName = &quot;SwXTextDocument&quot; then
	    		uneZoneTxt.AnchorType = 2 &apos; à la page
				uneZoneTxt.TextWrap = 1
			End if
			
   			for j = 1 to 6  &apos; mets en indice les chiffres pour (d1) (d2) etc ...
      			if mesNoms(i) = &quot;(d&quot; &amp; j &amp;&quot;)&quot; then
    				mCurseur = uneZoneTxt.Text.createTextCursor
    				mCurseur.gotoStart(False)
    				mCurseur.goRight(2,False)
    				mCurseur.goRight(1,True)
    				mCurseur.CharEscapement = -20
    				mCurseur.CharEscapementHeight = 70
    				mCurseur.String = j
      			end if
   			Next
			
		uneZoneTxt.Position = oPosition
		oNbrZoneTxt = oNbrZoneTxt + 1
		oPosition.X = 1000 + 1000 * (oNbrZoneTxt MOD 12)
		if (oNbrZoneTxt MOD 12) = 0 then oPosition.Y = oPosition.Y + 1000
	End if
Next
end sub



Sub RecupNomsElements
Dim i as integer, j as integer


For i = 0 to 67
mesNoms(i) = 0
Next
j = 0

For i = 2 to 69
	if RepControl(monDlg,&quot;CheckBox&quot;&amp;i,&quot;CheckBox&quot;) = 1 then 
	mesNoms(j) = Trad(monDlg,monDlg.getControl(&quot;CheckBox&quot;&amp;i).Model.Label)
	j = j + 1
	End if
Next

End sub

  
&apos;-------------------------------------------------------------------------------------
&apos;Defini la variable ahPolicesBasiques au demarrage de la macro principale
&apos;-------------------------------------------------------------------------------------
  
Function Liste_Polices as variant
Dim i as integer, policeDoc as String, oPolicesTab() as string

policeDoc = &quot;&quot;
if oDocActif.ImplementationName = &quot;SwXTextDocument&quot; then policeDoc = oDocActif.CurrentController.ViewCursor.CharFontName

if policeDoc = &quot;&quot; then oPolicesTab = Array(&quot;Arial&quot;,&quot;Atalante&quot;,&quot;Book Antiqua&quot;,&quot;Calibri&quot;,&quot;Century&quot;,&quot;Comic Sans MS&quot;,_
&quot;Courrier&quot;,&quot;DejaVu Serif&quot;,&quot;Franklin&quot;,&quot;Garamond&quot;,&quot;Georgia&quot;,&quot;Liberation Serif&quot;,&quot;Tahoma Helvetica&quot;,&quot;Times New Roman&quot;,&quot;Verdana&quot;)

if policeDoc &lt;&gt; &quot;&quot;	then oPolicesTab = Array(policeDoc,&quot;Arial&quot;,&quot;Atalante&quot;,&quot;Book Antiqua&quot;,&quot;Calibri&quot;,&quot;Century&quot;,&quot;Comic Sans MS&quot;,_
&quot;Courrier&quot;,&quot;DejaVu Serif&quot;,&quot;Franklin&quot;,&quot;Garamond&quot;,&quot;Georgia&quot;,&quot;Liberation Serif&quot;,&quot;Tahoma Helvetica&quot;,&quot;Times New Roman&quot;,&quot;Verdana&quot;)

Liste_Polices = oPolicesTab
end Function


Sub CheckBox_Click
Dim i as integer, oCocheTrouvee as boolean
oCocheTrouvee = false
For i = 2 to 69
	if  RepControl(monDlg,&quot;CheckBox&quot;&amp;i, &quot;CheckBox&quot;) = 1 then oCocheTrouvee = true
Next
If oCocheTrouvee = true then AttributControl(monDlg, &quot;CommandButton&quot;, Array(&quot;Couleur&quot;,65280,),Array(24) , )
If oCocheTrouvee = false then AttributControl(monDlg, &quot;CommandButton&quot;, Array(&quot;Couleur&quot;,16744576,),Array(24) , )

End sub
