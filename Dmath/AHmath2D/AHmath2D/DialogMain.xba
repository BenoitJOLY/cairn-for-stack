sub Termine_click
Dim maZone as object, n as integer
	monDlg.Model.Tag= &quot;fin&quot;
	If  Not IsNull(oElementSimple) then AspectForme(oElementSimple,oInfoES(8),0,oInfoES(6),oInfoES(7))
	monDlg.endExecute
end sub

sub Annule_click
	monDlg.EndExecute
end sub

&apos;-----------------------------------------------------------------------
&apos;--------------------renvoi sur le site officiel
&apos;---------------------------------------------------------------------

sub MonSite
Dim sv As Object, doc As String
sv = createUnoService(&quot;com.sun.star.system.SystemShellExecute&quot;)
doc = &quot;http://ahmath3d.free.fr/aide/aide.html&quot;
sv.execute(doc, &quot;&quot;, 0)
end sub



