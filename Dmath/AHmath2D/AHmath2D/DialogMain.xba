&apos;****************************************************************************************************
&apos;****************************************************************************************************
sub initialiseZoom
monDlg.getControl(&quot;TextField1&quot;).Text = oDocTemp.CurrentController.ZoomValue
end sub


Sub Zoomer(z As Integer)
oDocTemp.CurrentController.ZoomValue = z
oDocTemp.CurrentController.ZoomType = com.sun.star.view.DocumentZoomType.BY_VALUE
End Sub

sub Zoom_Modif
Dim test(1) as integer, monTexte as string

monTexte = RepControl(monDlg,&quot;TextField1&quot;,&quot;TextField&quot;)
test(0) = TextIsNumber(monTexte,true)
if test(0) = true then
  if  CInt(monTexte)&gt;=20 and CInt(monTexte)&lt;=600 then Zoomer(CInt(monTexte))
end if

end sub

sub DecalerPage(k1 as integer, k2 as integer)   &apos;k1 = +-1 ou 0 k2 = +-1 ou 0
Dim PosPage As New com.sun.star.awt.Point
Dim origX as Long, origY as Long
origX = oDocTemp.CurrentController.ViewOffset.X
origY = oDocTemp.CurrentController.ViewOffset.Y
PosPage.X = origX + k1*250
PosPage.Y = origY + k2*250
oDocTemp.CurrentController.ViewOffset = PosPage
end sub


sub DecalerPage_G
DecalerPage(1,0)
end sub

sub DecalerPage_D
DecalerPage(-1,0)
end sub

sub DecalerPage_H
DecalerPage(0,1)
end sub

sub DecalerPage_B
DecalerPage(0,-1)
end sub


