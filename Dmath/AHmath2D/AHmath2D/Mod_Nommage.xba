	ListBoxObjets(&quot;ListBox39&quot;, &quot;Segments&quot;)
	end if
	if RepControl(monDlg,&quot;OptionButton27&quot;, &quot;OptionButton&quot;)= true then
	AffichageNomsObjets(&quot;Cercles&quot;, &quot;&quot;)
	ListBoxObjets(&quot;ListBox39&quot;, &quot;Cercles&quot;)
	end if
	if RepControl(monDlg,&quot;OptionButton28&quot;, &quot;OptionButton&quot;)= true then
	AffichageNomsObjets(&quot;Arcs&quot;, &quot;&quot;)
	ListBoxObjets(&quot;ListBox39&quot;, &quot;Arcs&quot;)
	end if
	
	End if
	if oSelectionListe = 1 then
	DefTableauNoms(Array(&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;S&quot;,&quot;&quot;))
	AffichageNomsObjets(&quot;Surfaces&quot;, &quot;&quot;)
	ListBoxObjets(&quot;ListBox39&quot;, &quot;Surfaces&quot;)
	End if
End if

if oStepDlg = 40 then 
	oSelectionListe = RepControl(monDlg,&quot;ListBox40&quot;, &quot;ListBox&quot;)(1)
	if oSelectionListe = 0 then
	DefTableauNoms(Array(&quot;PM&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;))
	AffichageNomsObjets(&quot;PointsMarqués&quot;, &quot;&quot;)
	End if
	if oSelectionListe &gt; 0 then
	DefTableauNoms(Array(&quot;P&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;))
	AffichageNomsObjets(&quot;Points&quot;,&quot; &quot;)
	End if
End if



End sub

sub OptionButtonChoixObjets_Click
FinNommage
GestionNommage
if oStepDlg = 19 then
	AffichageMod_Modif
	ListBox31_Click
End if
if oStepDlg = 39 then TestCouleur
end sub




Function NbrObjetsDessines(oCollection as object) as variant
Dim a as integer, s as integer, c as integer, p as integer ,ca as integer, surf as integer, i as integer, r as integer
Dim oInfo as variant

a = 0
p=0
s=0
c=0
ca = 0
surf = 0
r = 0
if oCollection.count &lt;&gt; 0 then 
	for i = 0 to oCollection.count-1
		oInfo = InfoForme(oCollection(i))
		if oInfo(10) = &quot;Point&quot; then p = p+1
		if oInfo(10) = &quot;Segment&quot; then s = s+1
		if oInfo(10) = &quot;Cercle&quot; then c = c+1
		if oInfo(10) = &quot;Arc de cercle&quot; then a = a+1
		if oInfo(10) = &quot;Cercle&quot; or oInfo(10) = &quot;Arc de cercle&quot; then ca = ca+1
		if oInfo(10) = &quot;Surface coloriée&quot; then surf = surf+1
		if oInfo(10) = &quot;Inconnu&quot; or oInfo(10) = &quot;Codage&quot; then r = r+1
	Next
End if


NbrObjetsDessines = array(p,s,c,a,ca,surf,r)

End function



Function TableauTousPoints(oCollection as object)  as variant
Dim oPointTrouve  as  New com.sun.star.awt.Point, maListe(200) as  variant, maListe2(200) as variant
Dim i as integer, j as integer, k as integer, l as integer, monTest as boolean, oInfo as variant
j = 0

For i = 0 to oCollection.count - 1
	oInfo = InfoForme(oCollection(i))
		if oInfo(10) = &quot;Segment&quot; then 
		oPointTrouve.X = oInfo(1).X
		oPointTrouve.Y = oInfo(1).Y
		maListe(j) = oPointTrouve
		j = j+1
		oPointTrouve.X = oInfo(2).X
		oPointTrouve.Y = oInfo(2).Y
		maListe(j) = oPointTrouve
		j = j+1
		end if
		if oInfo(10) = &quot;Point&quot; then 
		oPointTrouve.X = oInfo(1).X
		oPointTrouve.Y = oInfo(1).Y
		maListe(j) = oPointTrouve
		j = j+1
		end if
		if oInfo(10) = &quot;Arc de cercle&quot; then 
		oPointTrouve.X = oInfo(1).X
		oPointTrouve.Y = oInfo(1).y
		maListe(j) = oPointTrouve
		j = j+1
		oPointTrouve.X = oInfo(2).X
		oPointTrouve.Y = oInfo(2).Y
		maListe(j) = oPointTrouve
		j = j+1
		end if
Next
&apos;ici j contient le nombre de sommets enregistrés avec des doublons
&apos;Def : 2 points sont doublons s&apos;ils sont dans un carré de 0,1mm de côté
&apos; la partie qui suit permet de sortir un tableau dimensionné sans doublons
l = 0
maListe2(l) = maListe(0)

For i = 1 to j-1
monTest = false
	For k = 0 to l
	if abs(maListe2(k).X - maListe(i).X) &lt; 10 and abs(maListe2(k).Y - maListe(i).Y)&lt; 10 then monTest = true
	next
	if monTest = false then 
	l = l+1
	maListe2(l) = maListe(i)
	end if
Next
Dim maListeFinale(l) as variant
For i = 0 to l
maListeFinale(i) = maListe2(i)
Next

TableauTousPoints = maListeFinale
end function


Function CreeCollectionObjets(oCollectionGlobale as object, oChoix1 as string, oChoix2 as string) as object
Dim i as integer, oInfo as variant, nvCollection as object
nvCollection= createUnoService(&quot;com.sun.star.drawing.ShapeCollection&quot;)
For i = 0 to oCollectionGlobale.count - 1
	oInfo = InfoForme(oCollectionGlobale(i))
	if IsFillShape(oCollectionGlobale(i)) = false then
	if oInfo(10) = oChoix1 or oInfo(10) = oChoix2 then nvCollection.add(oCollectionGlobale(i)) 
	End if
Next
CreeCollectionObjets = nvCollection
End function



Sub MAJCollection(oCollAvantMAJ as object, oCollectionGlobale as object, oChoix1 as string, oChoix2 as string)
Dim i as integer
Vidange(oCollAvantMAJ)
For i = 0 to oCollectionGlobale.count - 1
	oInfo = InfoForme(oCollectionGlobale(i))
	if IsFillShape(oCollectionGlobale(i)) = false then
	if oInfo(10) = oChoix1 or oInfo(10) = oChoix2 then oCollAvantMAJ.add(oCollectionGlobale(i)) 
	End if
	if IsFillShape(oCollectionGlobale(i)) = true then
	if oInfo(10) = oChoix1 or oInfo(10) = oChoix2 then oCollAvantMAJ.add(oCollectionGlobale(i)) 
	End if
Next

End sub




&apos; DefTableauNoms définit les variables oListePointsExistants,oCollectionDroites,oCollectionArcCercles,oTabNomPoints,oTabNomDroites,oTabNomArcCercles
Sub DefTableauNoms(optional oVar as variant)
Dim i as integer, oNbre as variant
Dim j as integer, n as integer, oNomM1 as string, oNomM2 as string


If IsMissing(oVar) then oVar = Array(&quot;P&quot;,&quot;S&quot;,&quot;D&quot;,&quot;C&quot;,&quot;A&quot;,&quot;C+A&quot;,&quot;S&quot;,&quot;R&quot;)

oNbre = oNbrObjets
&apos;initialisation des variable Noms
oTabNomPointsMarques = array(&quot;#&quot;)
oTabNomCercles = array(&quot;#&quot;)
oTabNomDroites = array(&quot;#&quot;)
oTabNomArcs = array(&quot;#&quot;)
oTabNomPoints = array(&quot;#&quot;)
oTabNomSurfaces = array(&quot;#&quot;)
oTabNomArcCercles = array(&quot;#&quot;)
oTabNomSegments = array(&quot;#&quot;)
oTabNomRestes = array(&quot;#&quot;)


if oVar(0) = &quot;PM&quot; then
if oNbre(0) &lt;&gt; 0 then
	MAJCollection(oCollectionPointsMarques,mesFormes,&quot;Point&quot;,&quot;--&quot;)
	n = oCollectionPointsMarques.count - 1
	Dim oTab8(n) as variant
	For i = 0 to n
		oTab8(i) = chr(65 + i)
	Next
	oTabNomPointsMarques = oTab8
End if
End if


if oVar(0) = &quot;P&quot; or oVar(0) = &quot;PM&quot; then
if oNbre(0) &lt;&gt; 0 or oNbre(1) &lt;&gt; 0 or oNbre(3) &lt;&gt; 0 then &apos;presence de points

	oListePointsExistants = TableauTousPoints(mesFormes)  &apos;tableau des points en variable points
    n = uBound(oListePointsExistants)
    Dim oTab1(n) as variant
	For i = 0 to n
		oTab1(i) = chr(65 + i)
	Next
	oTabNomPoints = oTab1
End if
End if

if oVar(1) = &quot;S&quot; then
if oNbre(1) &lt;&gt; 0 then &apos;presence de segments
	MAJCollection(oCollectionSegments,mesFormes,&quot;Segment&quot;,&quot;--&quot;)
	n = oCollectionSegments.count - 1
	Dim oTab6(n) as variant
	For i = 0 to n
		For j = 0 to UBound(oListePointsExistants)
			If abs(oCollectionSegments(i).Polygon(0).X - oListePointsExistants(j).X) &lt;=2 and abs(oCollectionSegments(i).Polygon(0).Y - oListePointsExistants(j).Y)&lt;=2 then oNomM1 = chr(65 + j)
			If abs(oCollectionSegments(i).Polygon(1).X - oListePointsExistants(j).X) &lt;=2 and abs(oCollectionSegments(i).Polygon(1).Y - oListePointsExistants(j).Y) &lt;=2 then oNomM2 = chr(65 + j)
		Next
	oTab6(i) = &quot;[&quot;+oNomM1+oNomM2+&quot;]&quot;
	Next
	oTabNomSegments = oTab6
end if
End if

if oVar(2) = &quot;D&quot; then
if oNbre(1) &lt;&gt; 0 then &apos;presence de segments
	MAJCollection(oCollectionDroites,mesFormes,&quot;Segment&quot;,&quot;--&quot;)
	n = oCollectionDroites.count - 1
	Dim oTab2(n) as variant
	For i = 0 to n
		For j = 0 to UBound(oListePointsExistants)
			If abs(oCollectionDroites(i).Polygon(0).X - oListePointsExistants(j).X) &lt;= 2 and abs(oCollectionDroites(i).Polygon(0).Y - oListePointsExistants(j).Y) &lt;=2 then oNomM1 = chr(65 + j)
			If abs(oCollectionDroites(i).Polygon(1).X - oListePointsExistants(j).X)&lt;=2 and abs(oCollectionDroites(i).Polygon(1).Y - oListePointsExistants(j).Y)&lt;=2 then oNomM2 = chr(65 + j)
		Next
	oTab2(i) = &quot;(&quot;+oNomM1+oNomM2+&quot;)&quot;
	Next
	oTabNomDroites = oTab2
end if
End if

if oVar(3) = &quot;C&quot; then
if oNbre(2)&lt;&gt;0 then &apos;presence de cercles
	MAJCollection(oCollectionCercles,mesFormes,&quot;Cercle&quot;,&quot;--&quot;)
	n = oCollectionCercles.count - 1
	Dim oTab7(n) as variant
	For i = 0 to n
		oTab7(i) = &quot;(C&quot;+(i+1)+&quot;)&quot;
	Next
	oTabNomCercles = oTab7
End if
End if

if oVar(4) = &quot;A&quot; then
if oNbre(3)&lt;&gt;0 then &apos;presence d&apos;arcs
	MAJCollection(oCollectionArcs,mesFormes,&quot;Arc de cercle&quot;,&quot;--&quot;)
	n = oCollectionArcs.count - 1
	Dim oTab5(n) as variant
	For i = 0 to n
		oTab5(i) = &quot;(C&quot;+(i+1)+&quot;)&quot;
	Next
	oTabNomArcs = oTab5
End if
End if

if oVar(5) = &quot;C+A&quot; then
if oNbre(4)&lt;&gt;0 then &apos;presence de cercles ou d&apos;arcs

	MAJCollection(oCollectionArcCercles,mesFormes,&quot;Cercle&quot;,&quot;Arc de cercle&quot;)
	n = oCollectionArcCercles.count - 1
	Dim oTab3(n) as variant
	For i = 0 to n
		oTab3(i) = &quot;(C&quot;+(i+1)+&quot;)&quot;
	Next
	oTabNomArcCercles = oTab3
End if
End if

if oVar(6) = &quot;S&quot; then

if  oNbre(5) &lt;&gt; 0 then
	MAJCollection(oCollectionSurfaces,mesFormes, &quot;Surface coloriée&quot;,&quot;--&quot;)
	n = oCollectionSurfaces.count - 1
	Dim oTab4(n) as variant
	For i = 0 to n
		oTab4(i) = &quot;(S&quot;+(i+1)+&quot;)&quot;
	Next
	oTabNomSurfaces = oTab4
End if
End if

if oVar(7) = &quot;R&quot; then

if  oNbre(6) &lt;&gt; 0 then

	MAJCollection(oCollectionRestes,mesFormes, &quot;Inconnu&quot;,&quot;Codage&quot;)
	n = oCollectionRestes.count - 1
	Dim oTab9(n) as variant
	For i = 0 to n
		oTab9(i) = &quot;R&quot;+(i+1)
	Next
	oTabNomRestes = oTab9
End if

End if

end Sub



Sub AffichageNomsObjets(oContenu1 as string, oContenu2 as string)
Dim oNomZT as object, nCercles as integer, nSurfaces as integer,nPoints as integer , oInfo as variant, cPosition as New com.sun.star.awt.Point
Dim oNbr2 as Variant, oTest(1) as variant, i as integer, nRestes as integer

oNbr2 = oNbrObjets

if oNbr2(0) &lt;&gt; 0 then
if oContenu1 = &quot;PointsMarqués&quot; then
	nPoints = oCollectionPointsMarques.Count
	Dim oPositionTab8(nPoints - 1) as variant
	For i = 0 to nPoints - 1
		oPositionTab8(i) = PositionNom(oCollectionPointsMarques(i))
	Next
	For i = 0 to nPoints - 1
	oNomZT = ZoneTexteDraw(oDocTemp,oTabNomPointsMarques(i),oPositionTab8(i))
	oCollectionZT.add(oNomZT)
	Next
End if
end if

if oNbr2(0) &lt;&gt; 0 or oNbr2(1) &lt;&gt; 0 or oNbr2(3) &lt;&gt; 0 then
if oContenu1 = &quot;Points&quot; then
	For i = 0 to UBound(oListePointsExistants)
	oNomZT = ZoneTexteDraw(oDocTemp,oTabNomPoints(i),oListePointsExistants(i))
	oCollectionZT.add(oNomZT)
	Next
end if
end if


if oNbr2(2) &lt;&gt; 0 then
if oContenu1 = &quot;Cercles&quot; or oContenu2 = &quot;Cercles&quot; then
	nCercles = oCollectionCercles.Count
	Dim oPositionTab1(nCercles - 1) as variant

	For i = 0 to nCercles - 1
		oPositionTab1(i) = PositionNom(oCollectionCercles(i))
	Next
	For i = 0 to nCercles - 1
	oNomZT = ZoneTexteDraw(oDocTemp,oTabNomCercles(i),oPositionTab1(i))
	oCollectionZT.add(oNomZT)
	Next
end if
End if

if oNbr2(3) &lt;&gt; 0 then
if oContenu1 = &quot;Arcs&quot; or oContenu2 = &quot;Arcs&quot; then
	nCercles = oCollectionArcs.Count
	Dim oPositionTab2(nCercles - 1) as variant
	For i = 0 to nCercles - 1
		oPositionTab2(i) = PositionNom(oCollectionArcs(i))
	Next
	For i = 0 to nCercles - 1
	oNomZT = ZoneTexteDraw(oDocTemp,oTabNomArcs(i),oPositionTab2(i))
	oCollectionZT.add(oNomZT)
	Next
end if
End if

if oNbr2(4) &lt;&gt; 0 then
if oContenu2 = &quot;Arcs+Cercles&quot; then
	nCercles = oCollectionArcCercles.Count
	Dim oPositionTab(nCercles - 1) as variant

	For i = 0 to nCercles - 1
	oPositionTab(i) = PositionNom(oCollectionArcCercles(i))
	Next
	For i = 0 to nCercles-1
	oNomZT = ZoneTexteDraw(oDocTemp,oTabNomArcCercles(i),oPositionTab(i))
	oCollectionZT.add(oNomZT)
	Next
end if
End if

if oContenu1 = &quot;Surfaces&quot; then
	if oNbr2(5) &lt;&gt; 0 then 
		nSurfaces = oCollectionSurfaces.Count
		Dim oPositionTab3(nSurfaces - 1) as variant
		For i = 0 to nSurfaces - 1
			oPositionTab3(i) = PositionNom(oCollectionSurfaces(i))
		Next
		For i = 0 to nSurfaces-1
		oNomZT = ZoneTexteDraw(oDocTemp,oTabNomSurfaces(i),oPositionTab3(i))
		oCollectionZT.add(oNomZT)
		Next
	End if
End if


if oContenu1 = &quot;Restes&quot; or oContenu2 = &quot;Restes&quot; then
if oNbr2(6) &lt;&gt; 0 then
	nRestes = oCollectionRestes.Count
	Dim oPositionTab9(nRestes - 1) as variant

	For i = 0 to nRestes - 1
		oPositionTab9(i) = PositionNom(oCollectionRestes(i))
	Next
	For i = 0 to nRestes - 1
	oNomZT = ZoneTexteDraw(oDocTemp,oTabNomRestes(i),oPositionTab9(i))
	oCollectionZT.add(oNomZT)
	Next
end if
End if

end sub



Sub ListBoxObjets(oNomListBox as string, oContenuListe as string, optional oNomListBox2)
Dim nvTableauNoms as variant, oNbr2 as Variant, oNbr3 as variant

oNbr2 = oNbrObjets

if oContenuListe = &quot;PointsMarqués&quot; then 
	AffectChoixListBox(monDlg,oTabNomPointsMarques,oNomListBox)
	if Not IsMissing(oNomListBox2) then AffectChoixListBox(monDlg,oTabNomPointsMarques,oNomListBox2)
end if
if oContenuListe = &quot;Points&quot; then 
	AffectChoixListBox(monDlg,oTabNomPoints,oNomListBox)
	if Not IsMissing(oNomListBox2) then AffectChoixListBox(monDlg,oTabNomPoints,oNomListBox2)
end if
if oContenuListe = &quot;Segments&quot; then 
	AffectChoixListBox(monDlg,oTabNomSegments,oNomListBox)
	if Not IsMissing(oNomListBox2) then AffectChoixListBox(monDlg,oTabNomSegments,oNomListBox2)
end if
if oContenuListe = &quot;Droites&quot; then 
	AffectChoixListBox(monDlg,oTabNomDroites,oNomListBox)
	if Not IsMissing(oNomListBox2) then AffectChoixListBox(monDlg,oTabNomDroites,oNomListBox2)
end if
if oContenuListe = &quot;Cercles&quot; then 
	AffectChoixListBox(monDlg,oTabNomCercles,oNomListBox)
	if Not IsMissing(oNomListBox2) then AffectChoixListBox(monDlg,oTabNomCercles,oNomListBox2)
end if
if oContenuListe = &quot;Arcs&quot; then 
	AffectChoixListBox(monDlg,oTabNomArcs,oNomListBox)
	if Not IsMissing(oNomListBox2) then AffectChoixListBox(monDlg,oTabNomArcs,oNomListBox2)
end if
if oContenuListe = &quot;Arcs+Cercles&quot; then 
	AffectChoixListBox(monDlg,oTabNomArcCercles,oNomListBox)
	if Not IsMissing(oNomListBox2) then AffectChoixListBox(monDlg,oTabNomArcCercles,oNomListBox2)
end if
if oContenuListe = &quot;Droites+ArcCercles&quot; then 
	if oNbr2(1) = 0 then nvTableauNoms = oTabNomArcCercles
	if oNbr2(4) = 0 then nvTableauNoms = oTabNomDroites
	if oNbr2(1) &lt;&gt; 0 and oNbr2(4) &lt;&gt; 0 then nvTableauNoms = FusionTab(oTabNomDroites,oTabNomArcCercles)
	AffectChoixListBox(monDlg,nvTableauNoms,oNomListBox)
	if Not IsMissing(oNomListBox2) then AffectChoixListBox(monDlg,nvTableauNoms,oNomListBox2)
end if
if oContenuListe = &quot;Surfaces&quot; then 
	AffectChoixListBox(monDlg,oTabNomSurfaces,oNomListBox)
	if Not IsMissing(oNomListBox2) then AffectChoixListBox(monDlg,oTabNomSurfaces,oNomListBox2)
End if
if oContenuListe = &quot;Restes&quot; then 
	AffectChoixListBox(monDlg,oTabNomRestes,oNomListBox)
	if Not IsMissing(oNomListBox2) then AffectChoixListBox(monDlg,oTabNomRestes,oNomListBox2)
end if
end sub



sub FinNommage
Dim i as integer, j as integer

If IsNull(oCollectionZT) = false then
	if oCollectionZT.count &gt; 0 then
		j = oCollectionZT.count - 1  
		For i = 0 to j 
		oPagetemp.Remove(oCollectionZT(i)) 
		Next
		Vidange(oCollectionZT)
	End if
End if

End sub


Function PositionNom(monElement as object) as variant
Dim oInfo as variant, oA as New com.sun.star.awt.Point, oB as New com.sun.star.awt.Point, oM as New com.sun.star.awt.Point
Dim oP as New com.sun.star.awt.Point, oV as New com.sun.star.awt.Point
Dim oAngle as Double, oAnglePos as Double
oInfo = InfoForme(monElement)

if oInfo(10) = &quot;Point&quot; then 
	oP = oInfo(1)
End if

if oInfo(10) = &quot;Cercle&quot; then 
	oP = Rotation(oInfo(3),45,oInfo(2))
End if

if oInfo(10) = &quot;Arc de cercle&quot; then 
	oAngle = oInfo(5)(1) - oInfo(5)(0)
	if oAngle &gt;= 0 then oAnglePos = oAngle/2
	if oAngle &lt; 0 then oAnglePos = (360 + oAngle)/2
	oP = Rotation(oInfo(3),oAnglePos,oInfo(1))
End if

if oInfo(10) = &quot;Surface coloriée&quot; then
	If oInfo(9) = &quot;com.sun.star.drawing.EllipseShape&quot; then
		if monElement.CircleKind = 0 then oP = oInfo(3)
		if monElement.CircleKind &lt;&gt; 0 then
				oAngle = oInfo(5)(1) - oInfo(5)(0)
				if oAngle &gt;= 0 then oAnglePos = oAngle/2
				if oAngle &lt; 0 then oAnglePos = (360 + oAngle)/2
				oA = Rotation(oInfo(3),oAnglePos,oInfo(1))
				oM = PointMilieu(Array(oInfo(1),oInfo(2)))
				oP = PointMilieu(Array(oA,oM))
		End if
	End if
	If oInfo(9) = &quot;com.sun.star.drawing.PolyPolygonShape&quot; then
	oA = monElement.Geometry(0)(0)
	oB = monElement.Geometry(0)(1)
	oV = Vecteur(oA,oB)
	oM = TranslationKV(0.3,oV,oA)
	oP.X = oInfo(0).X + oM.X
	oP.Y = oInfo(0).Y + oM.Y
	End if
End if

if oInfo(10) = &quot;Inconnu&quot; or oInfo(10) = &quot;Codage&quot; then 
	oP.X = oInfo(0).X + oInfo(0).Width/4
	oP.Y = oInfo(0).Y + oInfo(0).Height/4
End if

PositionNom = oP

End function

</script:module>