Sub ConstIsom(oStep as integer)
Dim oM1 as New com.sun.star.awt.Point, oI as New com.sun.star.awt.Point, oJ as New com.sun.star.awt.Point, oM2 as New com.sun.star.awt.Point
Dim oU1 as New com.sun.star.awt.Point, oU2 as New com.sun.star.awt.Point, oU3 as New com.sun.star.awt.Point
Dim oInfo1 as variant, oInfo(2) as variant
Dim oD1 as object, nvObjet as object, oD2 as object, oC1 as object
Dim oAngle1 as Double, oAngle2 as Double, oAngleRot as double
Dim oP  as New com.sun.star.awt.Point 

if oStep = 21 then
	oReponseDlg(1) = RepControl(monDlg,&quot;ListBox35&quot;,&quot;ListBox&quot;)(1)
	
	If oReponseDlg(1) = 0 then   &apos;Symétrie axiale
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox36&quot;,&quot;ListBox&quot;)(1)  &apos; axe
		oReponseDlg(3) = RepControl(monDlg,&quot;ListBox22&quot;,&quot;ListBox&quot;)(1)  &apos;antécédent
		
			oD1 = oCollectionDroites(oReponseDlg(2))
			oInfo1 = InfoForme(oD1)
			oU1 = Vecteur(oInfo1(1),oInfo1(2))
			oU2 = VecteurOrtho(oU1)
			if RepControl(monDlg,&quot;OptionButton14&quot;, &quot;OptionButton&quot;)= true then
				oP = oListePointsExistants(oReponseDlg(3))
				oM1 = TranslationKV(1,oU2,oP)
				oI = CoordIntersDroites(Array(oP,oM1),oD1)
				oU3 = Vecteur(oP,oI)
				oM2 = TranslationKV(1,oU3,oI)
				nvObjet = Point(oM2.X,oM2.Y)
			End if
			if RepControl(monDlg,&quot;OptionButton15&quot;, &quot;OptionButton&quot;)= true then
				oD2 = oCollectionDroites(oReponseDlg(3))
				oInfo2 = InfoForme(oD2)
				oM1 = TranslationKV(1,oU2,oInfo2(1))
				oM2 = TranslationKV(1,oU2,oInfo2(2))
				oI = CoordIntersDroites(Array(oInfo2(1),oM1),oD1)
				oJ = CoordIntersDroites(Array(oInfo2(2),oM2),oD1)
				oU1 = Vecteur(oInfo2(1),oI)   &apos;réutilisation des variables oU1 et oU2
				oU2 = Vecteur(oInfo2(2),oJ)   &apos;réutilisation des variables oU1 et oU2
				oM1 = TranslationKV(1,oU1,oI)  &apos;réutilisation de la variable oM1 
				oM2 = TranslationKV(1,oU2,oJ)
				nvObjet = SegmentDraw(oM1.X,oM1.Y,oM2.X,oM2.Y)
			End if
			if RepControl(monDlg,&quot;OptionButton20&quot;, &quot;OptionButton&quot;)= true then
			oC1 = oCollectionCercles(oReponseDlg(3))
			oInfo2 = InfoForme(oC1)
			oM1 = TranslationKV(1,oU2,oInfo2(3))
			oI = CoordIntersDroites(Array(oInfo2(3),oM1),oD1)
			oU1 = Vecteur(oInfo2(3),oI)   &apos;réutilisation de la variable oU1
			oM1 = TranslationKV(1,oU1,oI)  &apos;réutilisation de la variable oM1 
			nvObjet = CercleDraw(oM1.X,oM1.Y,oInfo2(4))
			End if
			if RepControl(monDlg,&quot;OptionButton21&quot;, &quot;OptionButton&quot;)= true then
			oC1 = oCollectionArcs(oReponseDlg(3))
			oInfo2 = InfoForme(oC1)
			oM1 = TranslationKV(1,oU2,oInfo2(3))
			oI = CoordIntersDroites(Array(oInfo2(3),oM1),oD1)
			oU1 = Vecteur(oInfo2(3),oI)   &apos;réutilisation de la variable oU1
			oM1 = TranslationKV(1,oU1,oI)  &apos;réutilisation de la variable oM1 
			oAngle1 = 2*oInfo1(5) - oInfo2(5)(1)
			oAngle2 = 2*oInfo1(5) - oInfo2(5)(0)
			nvObjet = ArcCercleDraw(oM1.X,oM1.Y,oInfo2(4),oAngle1,oAngle2)
		End if

	End if
	If oReponseDlg(1) = 1 then   &apos; Symétrie centrale
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox36&quot;,&quot;ListBox&quot;)(1)  &apos; centre
		oReponseDlg(3) = RepControl(monDlg,&quot;ListBox22&quot;,&quot;ListBox&quot;)(1)  &apos;antécédent
		
			oI = oListePointsExistants(oReponseDlg(2))
		
			if RepControl(monDlg,&quot;OptionButton14&quot;, &quot;OptionButton&quot;)= true then
				oP = oListePointsExistants(oReponseDlg(3))
				oU1 = Vecteur(oP(1),oI)
				oM1 = TranslationKV(1,oU1,oI)
				nvObjet = Point(oM1.X,oM1.Y)
			End if
			if RepControl(monDlg,&quot;OptionButton15&quot;, &quot;OptionButton&quot;)= true then
				oD2 = oCollectionDroites(oReponseDlg(3))
				oInfo2 = InfoForme(oD2)
				oU1 = Vecteur(oInfo2(1),oI)
				oU2 = Vecteur(oInfo2(2),oI)
				oM1 = TranslationKV(1,oU1,oI)
				oM2 = TranslationKV(1,oU2,oI)
				nvObjet = SegmentDraw(oM1.X,oM1.Y,oM2.X,oM2.Y)
			End if
			if RepControl(monDlg,&quot;OptionButton20&quot;, &quot;OptionButton&quot;)= true then
				oC1 = oCollectionCercles(oReponseDlg(3))
				oInfo2 = InfoForme(oC1)
				oU1 = Vecteur(oInfo2(3),oI)
				oM1 = TranslationKV(1,oU1,oI)
				nvObjet = CercleDraw(oM1.X,oM1.Y,oInfo2(4))
			End if
			if RepControl(monDlg,&quot;OptionButton21&quot;, &quot;OptionButton&quot;)= true then
				oC1 = oCollectionArcs(oReponseDlg(3))
				oInfo2 = InfoForme(oC1)
				oU1 = Vecteur(oInfo2(3),oI)
				oM1 = TranslationKV(1,oU1,oI)
				oAngle1 = (180 + oInfo2(5)(0))MOD 360
				oAngle2 = (180 + oInfo2(5)(1))MOD 360
				nvObjet = ArcCercleDraw(oM1.X,oM1.Y,oInfo2(4),oAngle1,oAngle2)
			End if
	End if
	If oReponseDlg(1) = 2 then   &apos; Translation
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox36&quot;,&quot;ListBox&quot;)(1)
		oReponseDlg(3) = RepControl(monDlg,&quot;ListBox37&quot;,&quot;ListBox&quot;)(1)
		oReponseDlg(4) = RepControl(monDlg,&quot;ListBox22&quot;,&quot;ListBox&quot;)(1)  &apos;antécédent
		oI = oListePointsExistants(oReponseDlg(2))
		oJ = oListePointsExistants(oReponseDlg(3))
		oU1 = Vecteur(oI,oJ)
			if RepControl(monDlg,&quot;OptionButton14&quot;, &quot;OptionButton&quot;)= true then
				oP = oListePointsExistants(oReponseDlg(4))
				oM1 = TranslationKV(1,oU1,oP(1))
				nvObjet = Point(oM1.X,oM1.Y)
			End if
			if RepControl(monDlg,&quot;OptionButton15&quot;, &quot;OptionButton&quot;)= true then
				oD2 = oCollectionDroites(oReponseDlg(4))
				oInfo2 = InfoForme(oD2)
				oM1 = TranslationKV(1,oU1,oInfo2(1))
				oM2 = TranslationKV(1,oU1,oInfo2(2))
				nvObjet = SegmentDraw(oM1.X,oM1.Y,oM2.X,oM2.Y)
			End if
			if RepControl(monDlg,&quot;OptionButton20&quot;, &quot;OptionButton&quot;)= true then
				oC1 = oCollectionCercles(oReponseDlg(4))
				oInfo2 = InfoForme(oC1)
				oM1 = TranslationKV(1,oU1,oInfo2(3))
				nvObjet = CercleDraw(oM1.X,oM1.Y,oInfo2(4))
			End if
			if RepControl(monDlg,&quot;OptionButton21&quot;, &quot;OptionButton&quot;)= true then
				oC1 = oCollectionArcs(oReponseDlg(4))
				oInfo2 = InfoForme(oC1)
				oM1 = TranslationKV(1,oU1,oInfo2(3))
				oAngle1 =oInfo2(5)(0)
				oAngle2 = oInfo2(5)(1)
				nvObjet = ArcCercleDraw(oM1.X,oM1.Y,oInfo2(4),oAngle1,oAngle2)
			End if
	End if
	If oReponseDlg(1) = 3 then   &apos; Rotation
	oReponseDlg(2) = RepControl(monDlg,&quot;ListBox36&quot;,&quot;ListBox&quot;)(1)
	oReponseDlg(3) = RepControl(monDlg,&quot;TextField39&quot;,&quot;TextField&quot;)
	oReponseDlg(4) = RepControl(monDlg,&quot;ListBox22&quot;,&quot;ListBox&quot;)(1)  &apos;antécédent
	oI = oListePointsExistants(oReponseDlg(2))
	oAngleRot = CDec(oReponseDlg(3))
			if RepControl(monDlg,&quot;OptionButton14&quot;, &quot;OptionButton&quot;)= true then
				oP = oListePointsExistants(oReponseDlg(4))
				oM1 = Rotation(oI,oAngleRot,oP(1))
				nvObjet = Point(oM1.X,oM1.Y)
			End if
			if RepControl(monDlg,&quot;OptionButton15&quot;, &quot;OptionButton&quot;)= true then
				oD2 = oCollectionDroites(oReponseDlg(4))
				oInfo2 = InfoForme(oD2)
				oM1 = Rotation(oI,oAngleRot,oInfo2(1))
				oM2 = Rotation(oI,oAngleRot,oInfo2(2))
				nvObjet = SegmentDraw(oM1.X,oM1.Y,oM2.X,oM2.Y)
			End if
			if RepControl(monDlg,&quot;OptionButton20&quot;, &quot;OptionButton&quot;)= true then
				oC1 = oCollectionCercles(oReponseDlg(4))
				oInfo2 = InfoForme(oC1)
				oM1 = Rotation(oI,oAngleRot,oInfo2(3))
				nvObjet = CercleDraw(oM1.X,oM1.Y,oInfo2(4))
			End if
			if RepControl(monDlg,&quot;OptionButton21&quot;, &quot;OptionButton&quot;)= true then
				oC1 = oCollectionArcs(oReponseDlg(4))
				oInfo2 = InfoForme(oC1)
				oM1 = Rotation(oI,oAngleRot,oInfo2(3))
				oAngle1 =(oInfo2(5)(0) + oAngleRot) MOD 360
				oAngle2 = (oInfo2(5)(1) + oAngleRot) MOD 360
				nvObjet = ArcCercleDraw(oM1.X,oM1.Y,oInfo2(4),oAngle1,oAngle2)
			End if
	
	End if
	mesFormes.add(nvObjet)	
	SauvDerniereConstruction(nvObjet)
End if
End Sub
</script:module>