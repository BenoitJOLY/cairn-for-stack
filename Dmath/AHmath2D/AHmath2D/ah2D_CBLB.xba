	AttributControl(monDlg, &quot;TextField&quot;, &quot;Visible&quot;, , Array(12,13,14))
	AttributControl(monDlg, &quot;Label&quot;, &quot;Visible&quot;, , Array(14,15,16))
	AffectVarControl(monDlg, &quot;90&quot;, &quot;TextField13&quot;,&quot;TextField&quot;)
end if
if oSelectionListe  = 0 then 
	AttributControl(monDlg, &quot;TextField&quot;, &quot;Visible&quot;, Array(12,13,14),)
	AttributControl(monDlg, &quot;Label&quot;, &quot;Visible&quot;, Array(14,15,16),)
end if
if oSelectionListe  = 2 then 
	AttributControl(monDlg, &quot;TextField&quot;, &quot;Visible&quot;, Array(13,14), Array(12))
	AttributControl(monDlg, &quot;Label&quot;, &quot;Visible&quot;, Array(15,16), Array(14))
end if
end sub

</script:module>