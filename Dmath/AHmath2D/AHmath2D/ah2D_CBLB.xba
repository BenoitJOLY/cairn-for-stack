sub CommandButton25_Click
	InfoElement
	if RepControl(monDlg,&quot;CommandButton25&quot;, &quot;CommandButton&quot;) = 1 then 
	AffichageInfo(oElementSimple)
	AttributControl(monDlg, &quot;CommandButtonNav&quot;,&quot;Actif&quot;,,Array(1,2,3,4))
	AttributControl(monDlg, &quot;BoutonZorder&quot;,&quot;Actif&quot;,,Array(1,2,3))
	AttributControl(monDlg, &quot;info&quot;,&quot;Actif&quot;,,Array(1,2,3,4))
	else
	AttributControl(monDlg, &quot;CommandButtonNav&quot;,&quot;Actif&quot;,Array(1,2,3,4),)
	AttributControl(monDlg, &quot;BoutonZorder&quot;,&quot;Actif&quot;,Array(1,2,3),)
	AttributControl(monDlg, &quot;info&quot;,&quot;Actif&quot;,Array(1,2,3,4),)
	AffectVarControl(monDlg, &quot;&quot;, &quot;info1&quot;, &quot;Label&quot;)
	AffectVarControl(monDlg, &quot;&quot;, &quot;info2&quot;, &quot;Label&quot;)
	AffectVarControl(monDlg, &quot;&quot;, &quot;info3&quot;, &quot;Label&quot;)
	AffectVarControl(monDlg, &quot;&quot;, &quot;info4&quot;, &quot;Label&quot;)	
	AffectVarControl(monDlg, &quot;&quot;, &quot;BoutonZorder3&quot;, &quot;Label&quot;)	
	End if
end sub




&apos;------------------------------------------------------------------------------
&apos; Gestion de l&apos;affichage suivant la réponse des ListBox
&apos;--------------------------------------------------------------------------------
sub ListBox1_click
Dim oSelectionListe as integer, oA as string
	oSelectionListe = RepControl(monDlg,&quot;ListBox1&quot;, &quot;ListBox&quot;)(1)
	FinNommage
	GestionNommage
if oSelectionListe = 0 or oSelectionListe = 4 then 
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(17),Array(16))
	AttributControl(monDlg,&quot;TextField&quot;,&quot;Visible&quot;,Array(2,3),)
	AttributControl(monDlg,&quot;Label&quot;,&quot;Visible&quot;,Array(4,5),)
	AttributControl(monDlg,&quot;ImageControl&quot;,&quot;Visible&quot;,Array(2,6),)
	AttributControl(monDlg,&quot;OptionButton&quot;,&quot;Visible&quot;,Array(1,2),)
end if
if oSelectionListe = 1 or oselectionListe = 5 then 
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(17),Array(16))
	AttributControl(monDlg,&quot;TextField&quot;,&quot;Visible&quot;,Array(3),Array(2))
	AttributControl(monDlg,&quot;Label&quot;,&quot;Visible&quot;,Array(5),Array(4))
	AttributControl(monDlg,&quot;ImageControl&quot;,&quot;Visible&quot;,Array(2,6),)
	AttributControl(monDlg,&quot;OptionButton&quot;,&quot;Visible&quot;,Array(1,2),)
	ListBox1a_Click
end if
if oSelectionListe = 2  then 
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,,Array(16,17))
	AttributControl(monDlg,&quot;TextField&quot;,&quot;Visible&quot;,,Array(2,3))
	AttributControl(monDlg,&quot;Label&quot;,&quot;Visible&quot;,,Array(4,5))
	AttributControl(monDlg,&quot;ImageControl&quot;,&quot;Visible&quot;,Array(2,6),)
	AttributControl(monDlg,&quot;OptionButton&quot;,&quot;Visible&quot;,,Array(1,2))
	AffectVarControl(monDlg,1 , &quot;ListBox17&quot;, &quot;ListBox&quot;)
	AffectVarControl(monDlg, &quot;5&quot;, &quot;TextField2&quot;,&quot;TextField&quot;)
	AffectVarControl(monDlg, &quot;5&quot;, &quot;TextField3&quot;,&quot;TextField&quot;)
	ListBox1a_Click
end if
if oSelectionListe = 3 then 
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,,Array(16,17))
	AttributControl(monDlg,&quot;TextField&quot;,&quot;Visible&quot;,,Array(2,3))
	AttributControl(monDlg,&quot;Label&quot;,&quot;Visible&quot;,,Array(4,5))
	AttributControl(monDlg,&quot;ImageControl&quot;,&quot;Visible&quot;,Array(2),Array(6))
	AttributControl(monDlg,&quot;OptionButton&quot;,&quot;Visible&quot;,,Array(1,2))
	AffectVarControl(monDlg,1 , &quot;ListBox17&quot;, &quot;ListBox&quot;)
	AffectVarControl(monDlg, &quot;60&quot;, &quot;TextField2&quot;,&quot;TextField&quot;)
	AffectVarControl(monDlg, &quot;5&quot;, &quot;TextField3&quot;,&quot;TextField&quot;)
	ListBox1a_Click
end if
if oSelectionListe = 4 then 
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(17),Array(16))
	AttributControl(monDlg,&quot;TextField&quot;,&quot;Visible&quot;,,Array(2,3))
	AttributControl(monDlg,&quot;Label&quot;,&quot;Visible&quot;,,Array(4,5))
	AttributControl(monDlg,&quot;ImageControl&quot;,&quot;Visible&quot;,Array(2,6),)
	AttributControl(monDlg,&quot;OptionButton&quot;,&quot;Visible&quot;,,Array(1,2))
	AffectVarControl(monDlg, &quot;a =&quot;, &quot;Label5&quot;,&quot;Label&quot;)
	AffectVarControl(monDlg, &quot;5&quot;, &quot;TextField2&quot;,&quot;TextField&quot;)
	AffectVarControl(monDlg, &quot;60&quot;, &quot;TextField3&quot;,&quot;TextField&quot;)
	ListBox1a_Click
end if
if oSelectionListe = 5 then 
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(17),Array(16))
	AttributControl(monDlg,&quot;TextField&quot;,&quot;Visible&quot;,Array(2,3),)
	AttributControl(monDlg,&quot;Label&quot;,&quot;Visible&quot;,Array(4,5),)
	AttributControl(monDlg,&quot;ImageControl&quot;,&quot;Visible&quot;,Array(2,6),)
	AttributControl(monDlg,&quot;OptionButton&quot;,&quot;Visible&quot;,Array(1,2),)
end if
if oSelectionListe = 6 then 
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(17),Array(16))
	AttributControl(monDlg,&quot;TextField&quot;,&quot;Visible&quot;,Array(3),Array(2))
	AttributControl(monDlg,&quot;Label&quot;,&quot;Visible&quot;,Array(5),Array(4))
	AttributControl(monDlg,&quot;ImageControl&quot;,&quot;Visible&quot;,Array(2,6),)
	AttributControl(monDlg,&quot;OptionButton&quot;,&quot;Visible&quot;,Array(1,2),)
	AffectVarControl(monDlg, &quot;a =&quot;, &quot;Label4&quot;,&quot;Label&quot;)
	AffectVarControl(monDlg, &quot;60&quot;, &quot;TextField2&quot;,&quot;TextField&quot;)
end if

end sub

Sub ListBox1a_Click
Dim oSel as Integer, oSelectionListeA as String, oSelectionListeB as String, oA as string
oSel = RepControl(monDlg,&quot;ListBox1&quot;, &quot;ListBox&quot;)(1)
if oSel = 1 then
	oSelectionListeA = RepControl(monDlg,&quot;ListBox16&quot;, &quot;ListBox&quot;)(0)
	oA = Mid(oSelectionListeA,2,1)
	AffectVarControl(monDlg, oA &amp; &quot;P =&quot;, &quot;Label4&quot;,&quot;Label&quot;)
End if
if oSel = 2 then
	oSelectionListeA = RepControl(monDlg,&quot;ListBox16&quot;, &quot;ListBox&quot;)(0)
	oSelectionListeB = RepControl(monDlg,&quot;ListBox17&quot;, &quot;ListBox&quot;)(0)
	AffectVarControl(monDlg, oSelectionListeA &amp; &quot;P =&quot;, &quot;Label4&quot;,&quot;Label&quot;)
	AffectVarControl(monDlg, oSelectionListeB &amp; &quot;P =&quot;, &quot;Label5&quot;,&quot;Label&quot;)
End if
if oSel = 3 then
	oSelectionListeA = RepControl(monDlg,&quot;ListBox16&quot;, &quot;ListBox&quot;)(0)
	oSelectionListeB = RepControl(monDlg,&quot;ListBox17&quot;, &quot;ListBox&quot;)(0)
	AffectVarControl(monDlg, oSelectionListeA &amp; oSelectionListeB &amp; &quot;P =&quot;, &quot;Label4&quot;,&quot;Label&quot;)
	AffectVarControl(monDlg, oSelectionListeB &amp; &quot;P =&quot;, &quot;Label5&quot;,&quot;Label&quot;)
End if
if oSel = 4 then
	oSelectionListeA = RepControl(monDlg,&quot;ListBox16&quot;, &quot;ListBox&quot;)(0)
	AffectVarControl(monDlg, oSelectionListeA &amp; &quot;P =&quot;, &quot;Label4&quot;,&quot;Label&quot;)
End if
if oSel = 6 then
	oSelectionListeA = RepControl(monDlg,&quot;ListBox16&quot;, &quot;ListBox&quot;)(0)
	AffectVarControl(monDlg, &quot;a =&quot;, &quot;Label4&quot;,&quot;Label&quot;)
End if
End sub


&apos;------------------------------------------------------------------------------
&apos; Gestion de l&apos;affichage suivant la réponse de ListBox4
&apos;--------------------------------------------------------------------------------
sub ListBox4_click
Dim oSelectionListe as integer, monObjet1 as variant, monObjet2 as variant, monObjet3 as variant, oLong as integer
oSelectionListe = RepControl(monDlg,&quot;ListBox4&quot;, &quot;ListBox&quot;)(1)
FinNommage
if oSelectionListe = 0 then 
	AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,Array(7,10),)
	AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,Array(7,8),)
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,,Array(21,41))
end if

if oSelectionListe  = 1 then 
	AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,,Array(7,10))
	AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,,Array(7,8))
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(41),Array(21))
end if
if oSelectionListe  = 2 or oSelectionListe  = 3 then 
	AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,Array(7),Array(10))
	AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,Array(7),Array(8))
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(41),Array(21))
end if
if oSelectionListe  = 4 or oSelectionListe  = 4 then 
	AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,Array(7,10),)
	AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,Array(7,8),)
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(41),Array(21))
end if
	GestionNommage
end sub


sub ListBox8_click
Dim oSelectionListe as integer

oSelectionListe = RepControl(monDlg,&quot;ListBox8&quot;, &quot;ListBox&quot;)(1)
	FinNommage
	
if oSelectionListe &lt;= 1 then
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,,Array(5,24))
	AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,Array(28),)
	AttributControl(monDlg, &quot;ImageControl&quot;,&quot;Visible&quot;,Array(4),)
	AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,Array(11),)
end if

if oSelectionListe  = 2 then
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(24),Array(5))
	AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,Array(28),)
	AttributControl(monDlg, &quot;ImageControl&quot;,&quot;Visible&quot;,Array(4),)
	AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,Array(11),)
end if

if oSelectionListe = 3 then 
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(5,24),)
	AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,,Array(28))
	AttributControl(monDlg, &quot;ImageControl&quot;,&quot;Visible&quot;,,Array(4))  &apos;chapeau de l&apos;angle
	AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,Array(11),)
	AffectVarControl(monDlg, &quot;&quot;, &quot;TextField28&quot;,&quot;TextField&quot;)
end if
if oSelectionListe = 4 then 
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(24),Array(5))
	AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,,Array(28))
	AttributControl(monDlg, &quot;ImageControl&quot;,&quot;Visible&quot;,Array(4),)
	AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,,Array(11))
	AffectVarControl(monDlg, &quot;60&quot;, &quot;TextField28&quot;,&quot;TextField&quot;)
end if
if oSelectionListe = 5 then
	AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,,Array(5,24))
	AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,Array(28),)
	AttributControl(monDlg, &quot;ImageControl&quot;,&quot;Visible&quot;,Array(4),)
	AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,Array(11),)
end if

GestionNommage
End sub

