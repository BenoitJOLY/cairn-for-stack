sub ConstSegment(oStep as integer)
Dim oNewSegment as object, oC as object
Dim oInfo as variant
Dim a as double, b as double, c as double, d as double, e as double, i as integer
Dim oA as New com.sun.star.awt.Point, oB as New com.sun.star.awt.Point, oM as New com.sun.star.awt.Point
Dim oU1 as New com.sun.star.awt.Point, oV1 as New com.sun.star.awt.Point

if oStep = 4 then 
	oReponseDlg(1) = RepControl(monDlg,&quot;ListBox4&quot;,&quot;ListBox&quot;)(1)
	
	if oReponseDlg(1) = 0 then
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox21&quot;,&quot;ListBox&quot;)(1)
		oReponseDlg(3) = RepControl(monDlg,&quot;ListBox41&quot;,&quot;ListBox&quot;)(1)
		if oReponseDlg(2) = oReponseDlg(3)  then 
		Msgbox(Trad(monDlg,MesMessages2(12)), 0+48, &quot;AHmath2D&quot;)
		Exit sub
		End if
		oA = oListePointsExistants(oReponseDlg(2))
		oB = oListePointsExistants(oReponseDlg(3))
		oNewSegment = SegmentDraw(oA.X,oA.Y,oB.X,oB.Y)
	end if
	if oReponseDlg(1) = 1 then
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox21&quot;,&quot;ListBox&quot;)(1)
		a = CDbl(RepControl(monDlg,&quot;TextField7&quot;,&quot;TextField&quot;)) * 1000  &apos;longueur
    	b = CDbl(RepControl(monDlg,&quot;TextField8&quot;,&quot;TextField&quot;)) &apos;Angle
		oM = oListePointsExistants(oReponseDlg(2))
		oNewSegment = SegmentDraw(oM.X,oM.Y,oM.X + a * cos(b*pi/180),oM.Y - a * sin(b*pi/180))
	end if
	if oReponseDlg(1) = 2 then
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox21&quot;,&quot;ListBox&quot;)(1)
    	b = CDbl(RepControl(monDlg,&quot;TextField8&quot;,&quot;TextField&quot;)) &apos;Angle
		oC = oCollectionCercles(oReponseDlg(2))
		oInfo = InfoForme(oC)
		oM = oInfo(2) &apos; point à 0°
		oA = Rotation(oInfo(3),b,oM)
		oB = Rotation(oInfo(3),180,oA)
		oNewSegment = SegmentDraw(oA.X,oA.Y,oB.X,oB.Y)
	end if
	if oReponseDlg(1) = 3 then
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox21&quot;,&quot;ListBox&quot;)(1)
    	b = CDbl(RepControl(monDlg,&quot;TextField8&quot;,&quot;TextField&quot;)) &apos;Angle
		oC = oCollectionCercles(oReponseDlg(2))
		oInfo = InfoForme(oC)
		oM = oInfo(2) &apos; point à 0°
		oA = Rotation(oInfo(3),b,oM)
		oNewSegment = SegmentDraw(oInfo(3).X,oInfo(3).Y,oA.X,oA.Y)
	end if
	if oReponseDlg(1) = 4 then
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox21&quot;,&quot;ListBox&quot;)(1)
		oC = oCollectionArcs(oReponseDlg(2))
		oInfo = InfoForme(oC)
		oA = oInfo(1)
		oB = oInfo(2)
		oNewSegment = SegmentDraw(oA.X,oA.Y,oB.X,oB.Y)
	end if

end if


if oStep = 40 then
	oReponseDlg(1) = RepControl(monDlg,&quot;ListBox40&quot;,&quot;ListBox&quot;)(1)
    a = CDbl(RepControl(monDlg,&quot;TextField12&quot;,&quot;TextField&quot;)) * 1000
    b = CDbl(RepControl(monDlg,&quot;TextField13&quot;,&quot;TextField&quot;))
    if oReponseDlg(1) = 1 then oNewSegment = SegmentDraw(10500 - a/2 * cos(b*pi/180) , 15000 + a/2 * sin(b*pi/180), 10500 + a/2 * cos(b*pi/180), 15000 - a/2 * sin(b*pi/180))
End if

  
mesFormes.add(oNewSegment)
SauvDerniereConstruction(oNewSegment)
if oStep = 6 and oReponseDlg(1) = 3 then
	mesFormes.add(oNewSegment2)
	SauvDerniereConstruction(oNewSegment2,false)
End if
end sub

</script:module>