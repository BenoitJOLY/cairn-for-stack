Public oObjetChoisi as object

&apos;-------------------------------------------------------
&apos;-------------Gestion du déplacement (l = D G H B)
&apos; l&apos;objet concerné doit être affecté à la variable public oObjetChoisi
&apos;-------------------------------------------------------
Sub DeplaceElement(l as string )
Dim nvPosition as New com.sun.star.awt.Point, a as Double, k(1) as integer
Dim oInfo as variant

oInfo = InfoForme(oObjetChoisi)

a = CDbl(RepControl(monDlg,&quot;TextField25&quot;,&quot;TextField&quot;))*1000
if l = &quot;D&quot; then k = array(1,0)
if l = &quot;G&quot; then k = array(-1,0)
if l = &quot;H&quot; then k = array(0,-1)
if l = &quot;B&quot; then k = array(0,1)

nvPosition.X = oInfo(0).X + k(0) * CInt(a)
nvPosition.Y = oInfo(0).Y+ k(1) * CInt(a)
oObjetChoisi.Position = nvPosition
End Sub

sub DeplaceDroite
DeplaceElement(&quot;D&quot;)
End sub

sub DeplaceGauche
DeplaceElement(&quot;G&quot;)
End sub

sub DeplaceHaut
DeplaceElement(&quot;H&quot;)
End sub

sub DeplaceBas
DeplaceElement(&quot;B&quot;)
End sub

&apos;-------------------------------------------------------
&apos;-------------Gestion de la taille l = A B  s = + -
&apos;-------------------------------------------------------

sub ModifieLongueur(l as string, s as string)
Dim nvPointA as New com.sun.star.awt.Point,nvPointB as New com.sun.star.awt.Point, a as integer, k(1) as integer

if oTypeSB = &quot;openoffice&quot; then
	msgbox(Trad(monDlg,MesMessages2(4)))
	Exit sub
End if

if l = &quot;A&quot; and s = &quot;+&quot; then k = array(1,0)
if l = &quot;A&quot; and s = &quot;-&quot; then k = array(-1,0)
if l = &quot;B&quot; and s = &quot;+&quot; then k = array(0,1)
if l = &quot;B&quot; and s = &quot;-&quot; then k = array(0,-1)

oInfo = InfoForme(oObjetChoisi)

a = CDbl(RepControl(monDlg,&quot;TextField26&quot;,&quot;TextField&quot;)) * 1000
nvPointA.X = oInfo(1).X - k(0) * CInt(a)*cos(oInfo(5)*pi/180)
nvPointA.Y = oInfo(1).Y + k(0) * CInt(a)*sin(oInfo(5)*pi/180)
nvPointB.X = oInfo(2).X + k(1) * CInt(a)*cos(oInfo(5)*pi/180)
nvPointB.Y = oInfo(2).Y - k(1) * CInt(a)*sin(oInfo(5)*pi/180)
oObjetChoisi.Polygon = array(nvPointA,nvPointB)
end sub


sub ModifieLongPlus
Dim oRep as integer, oInfo as variant

oInfo = InfoForme(oObjetChoisi)
if oInfo(10) = &quot;Segment&quot; then
GestionBugOpenOffice
oRep = RepControl(monDlg,&quot;ListBox19&quot;,&quot;ListBox&quot;)(1)
if oRep = 0 then ModifieLongueur(&quot;A&quot;,&quot;+&quot;)
if oRep = 1 then ModifieLongueur(&quot;B&quot;,&quot;+&quot;)
End if
if oInfo(10) = &quot;Cercle&quot;  or oInfo(10) = &quot;Arc de cercle&quot; then
Modifierrayon(&quot;+&quot;)
End if
end sub

sub ModifieLongMoins
Dim oRep as integer, oInfo as variant

oInfo = InfoForme(oObjetChoisi)
if oInfo(10) = &quot;Segment&quot; then
GestionBugOpenOffice
oRep = RepControl(monDlg,&quot;ListBox19&quot;,&quot;ListBox&quot;)(1)
if oRep = 0 then ModifieLongueur(&quot;A&quot;,&quot;-&quot;)
if oRep = 1 then ModifieLongueur(&quot;B&quot;,&quot;-&quot;)
End if
if oInfo(10) = &quot;Cercle&quot;  or oInfo(10) = &quot;Arc de cercle&quot; then
Modifierrayon(&quot;-&quot;)
End if
end sub

sub Modifierrayon(s as string)
Dim nvPosition as New com.sun.star.awt.Point, nvTaille as New com.sun.star.awt.Size, a as integer, k as integer
Dim oInfo as variant

oInfo = InfoForme(oObjetChoisi)

if oInfo(10) = &quot;Cercle&quot; or oInfo(10) = &quot;Arc de cercle&quot;  then
a = CDbl(RepControl(monDlg,&quot;TextField26&quot;,&quot;TextField&quot;)) * 1000
k = IIF(s = &quot;+&quot;,1,-1)
nvTaille.Width = (oInfo(4) + k * a) * 2
nvTaille.Height = (oInfo(4) + k * a) * 2
nvPosition.X = oInfo(0).X - k * a
nvPosition.Y = oInfo(0).Y - k * a
oObjetChoisi.Size = nvTaille
oObjetChoisi.Position = nvPosition
end if

end sub



&apos;-------------------------------------------------------
&apos;-------------Gestion de la rotation
&apos;-------------------------------------------------------

sub Pivote(l as string, s as string)
Dim a as integer, nvAngle as Long
Dim CoordCentreRot as variant, oInfo as variant
Dim oPointA as New com.sun.star.awt.Point,oPointB as New com.sun.star.awt.Point,oPointM as New com.sun.star.awt.Point

oInfo = InfoForme(oObjetChoisi)
a = CDbl(RepControl(monDlg,&quot;TextField27&quot;,&quot;TextField&quot;))
nvAngle = IIF(s = &quot;+&quot;, a, - a)

if oInfo(10) = &quot;Segment&quot; or oInfo(10) = &quot;Arc de cercle&quot; then
	oPointA = CoordPoint(oInfo(1).X, oInfo(1).Y)
	oPointB = CoordPoint(oInfo(2).X, oInfo(2).Y) 
	oPointM = CoordPoint(oInfo(3).X, oInfo(3).Y) 
	if l = &quot;A&quot; then oPointB =  Rotation(oPointA, nvAngle, oPointB)
	if l = &quot;B&quot; then oPointA =  Rotation(oPointB, nvAngle, oPointA)
	if l = &quot;M&quot; then 
		oPointA =  Rotation(oPointM, nvAngle, oPointA)
		oPointB =  Rotation(oPointM, nvAngle, oPointB)
	End if
oObjetChoisi.Polygon = array(oPointA,oPointB)
End if
if oInfo(10) = &quot;Point&quot; then
oObjetChoisi.RotateAngle = oObjetChoisi.RotateAngle + nvAngle*100
End if

end sub




sub PivotePlus
Dim oRep as integer, oInfo as variant

oInfo = InfoForme(oObjetChoisi)
oRep = RepControl(monDlg,&quot;ListBox20&quot;,&quot;ListBox&quot;)(1)
if oInfo(10) = &quot;Segment&quot; then
GestionBugOpenOffice
if oRep = 0 then Pivote(&quot;A&quot;,&quot;+&quot;)
if oRep = 1 then Pivote(&quot;M&quot;,&quot;+&quot;)
if oRep = 2 then Pivote(&quot;B&quot;,&quot;+&quot;)
End if
if oInfo(10) = &quot;Arc de cercle&quot; then
GestionBugOpenOffice
if oRep = 0 then PivoterArc2(&quot;A&quot;,&quot;+&quot;)
if oRep = 1 then PivoterArc2(&quot;M&quot;,&quot;+&quot;)
if oRep = 2 then PivoterArc2(&quot;B&quot;,&quot;+&quot;)
End if
if oInfo(10) = &quot;Point&quot; then Pivote(&quot;M&quot;,&quot;+&quot;)
end sub





sub PivoteMoins
Dim oRep as integer, oInfo as variant

oInfo = InfoForme(oObjetChoisi)
oRep = RepControl(monDlg,&quot;ListBox20&quot;,&quot;ListBox&quot;)(1)
if oInfo(10) = &quot;Segment&quot; then
GestionBugOpenOffice
if oRep = 0 then Pivote(&quot;A&quot;,&quot;-&quot;)
if oRep = 1 then Pivote(&quot;M&quot;,&quot;-&quot;)
if oRep = 2 then Pivote(&quot;B&quot;,&quot;-&quot;)
End if
if oInfo(10) = &quot;Arc de cercle&quot; then
GestionBugOpenOffice
if oRep = 0 then PivoterArc2(&quot;A&quot;,&quot;-&quot;)
if oRep = 1 then PivoterArc2(&quot;M&quot;,&quot;-&quot;)
if oRep = 2 then PivoterArc2(&quot;B&quot;,&quot;-&quot;)
End if
if oInfo(10) = &quot;Point&quot; then Pivote(&quot;M&quot;,&quot;-&quot;)
end sub

&apos;-----------------------------------------------------------------------------
&apos;--NB : lors d&apos;une rotation avec RotateAngle, les attributs CircleStartAngle et CircleEndAngle
&apos;       ne sont pas modifiés avec l&apos;angle de la rotation
&apos;       ce qui pose problème pour repérer les coordonnées des extrémités
&apos;------------------------------------------------------------------------------


sub PivoterArc2(l as string, s as string)
Dim oPointA as New com.sun.star.awt.Point, oPointC as New com.sun.star.awt.Point, nvPosition as New com.sun.star.awt.Point
Dim oPointB as New com.sun.star.awt.Point, oPointC2 as New com.sun.star.awt.Point, oPointM as New com.sun.star.awt.Point
Dim  a as Double, nvAngle as Double, oInfo as variant

oInfo = InfoForme(oObjetChoisi)
numArc = oObjetChoisi.circleKind  &apos;pour récupérer le style d&apos;arc
a = CDbl(RepControl(monDlg,&quot;TextField27&quot;,&quot;TextField&quot;))
nvAngle = IIF(s = &quot;+&quot; , a, - a)

oPointA = oInfo(1)
oPointB = oInfo(2)
oPointM = oInfo(3)
oPointC = CentreCadre(oObjetChoisi)(0)   &apos;oPointC est le centre de la rotation

if l=&quot;A&quot; then oPointC2 = Rotation(oPointA, nvAngle, oPointC)          
if l=&quot;B&quot; then oPointC2 = Rotation(oPointB, nvAngle, oPointC)
if l=&quot;M&quot; then oPointC2 = Rotation(oPointM, nvAngle, oPointC)

nvPosition = Translation(oPointC,oPointC2,oObjetChoisi.Position)
oObjetChoisi.Position = nvPosition
oObjetChoisi.RotateAngle = CLng(nvAngle*100)
AnnuleRotateAngleArc(oObjetChoisi)    &apos;remise à zéro du rotateAngle sinon pbme pour coord de A et B

End sub

&apos;-------------------------------------------------------
&apos;-------------Gestion de l&apos;affichage
&apos;-------------------------------------------------------

sub AffichageMod_Modif
Dim oTestRep as boolean, oTitre as string


	oTestRep = ValideReponseListbox(monDlg,&quot;ListBox31&quot;,)
	oReponseDlg(2) = RepControl(monDlg,&quot;ListBox31&quot;,&quot;ListBox&quot;)(1) 
	
	
	if RepControl(monDlg,&quot;OptionButton29&quot;, &quot;OptionButton&quot;)= true then
		AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(19,20),)
		AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,Array(26),Array(27))
		AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,Array(31),Array(32))
		AttributControl(monDlg, &quot;CommandButton&quot;,&quot;Visible&quot;,Array(43,44),Array(41,42))
		if oTestRep = false then 
			AttributControl(monDlg, &quot;TextField&quot;,&quot;Actif&quot;,Array(25,26,27),)
			AttributControl(monDlg, &quot;Label&quot;,&quot;Actif&quot;,Array(30,31,32),)
			AttributControl(monDlg, &quot;CommandButton&quot;,&quot;Actif&quot;,Array(20,21,22,37,41,42,43,44),)
			else
			AttributControl(monDlg, &quot;TextField&quot;,&quot;Actif&quot;,Array(26),Array(25,27))
			AttributControl(monDlg, &quot;Label&quot;,&quot;Actif&quot;,Array(31),Array(30,32))
			AttributControl(monDlg, &quot;CommandButton&quot;,&quot;Actif&quot;,Array(43,44),Array(20,21,22,37,41,42))
		End if
	End if
	
	if RepControl(monDlg,&quot;OptionButton30&quot;, &quot;OptionButton&quot;)= true then
		oTitre = Trad(monDlg,MesMessages2(8))
		AffectVarControl(monDlg, oTitre &amp; &quot; (cm)&quot;, &quot;Label31&quot;,&quot;Label&quot;)
		AffectVarControl(monDlg, &quot;0,5&quot;, &quot;TextField26&quot;,&quot;TextField&quot;)
		AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,,Array(19,20))
		AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,,Array(26,27))
		AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,,Array(31,32))
		AttributControl(monDlg, &quot;CommandButton&quot;,&quot;Visible&quot;,,Array(41,42,43,44))
		if oTestRep = false then 
			AttributControl(monDlg, &quot;ListBox&quot;,&quot;Actif&quot;,Array(19,20),)
			AttributControl(monDlg, &quot;TextField&quot;,&quot;Actif&quot;,Array(25,26,27),)
			AttributControl(monDlg, &quot;Label&quot;,&quot;Actif&quot;,Array(30,31,32),)
			AttributControl(monDlg, &quot;CommandButton&quot;,&quot;Actif&quot;,Array(20,21,22,37,41,42,43,44),)
			Else
			AttributControl(monDlg, &quot;ListBox&quot;,&quot;Actif&quot;,,Array(19,20))
			AttributControl(monDlg, &quot;TextField&quot;,&quot;Actif&quot;,,Array(25,26,27))
			AttributControl(monDlg, &quot;Label&quot;,&quot;Actif&quot;,,Array(30,31,32))
			AttributControl(monDlg, &quot;CommandButton&quot;,&quot;Actif&quot;,,Array(20,21,22,37,41,42,43,44))
		End if
	End if
	
	if RepControl(monDlg,&quot;OptionButton31&quot;, &quot;OptionButton&quot;)= true then
		oTitre = Trad(monDlg,MesMessages2(9))
		AffectVarControl(monDlg, oTitre &amp; &quot; (cm)&quot;, &quot;Label31&quot;,&quot;Label&quot;)
		AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(19,20),)
		AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,Array(27),Array(26))
		AttributControl(monDlg, &quot;CommandButton&quot;,&quot;Visible&quot;,Array(41,42),Array(43,44))
		AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,Array(32),Array(31))
		if oTestRep = false then
			AttributControl(monDlg, &quot;TextField&quot;,&quot;Actif&quot;,Array(25,26,27),)
			AttributControl(monDlg, &quot;CommandButton&quot;,&quot;Actif&quot;,Array(20,21,22,37,41,42,43,44),)
			AttributControl(monDlg, &quot;Label&quot;,&quot;Actif&quot;,Array(30,31,32),)
			Else
			AttributControl(monDlg, &quot;TextField&quot;,&quot;Actif&quot;,Array(27),Array(25,26))
			AttributControl(monDlg, &quot;CommandButton&quot;,&quot;Actif&quot;,Array(41,42),Array(20,21,22,37,43,44))
			AttributControl(monDlg, &quot;Label&quot;,&quot;Actif&quot;,Array(32),Array(30,31))
		End if
	End if
	
	if RepControl(monDlg,&quot;OptionButton32&quot;, &quot;OptionButton&quot;)= true then
		oTitre = Trad(monDlg,MesMessages2(9))
		AffectVarControl(monDlg, oTitre &amp; &quot; (cm)&quot;, &quot;Label31&quot;,&quot;Label&quot;)
		AttributControl(monDlg, &quot;ListBox&quot;,&quot;Visible&quot;,Array(19),Array(20))
		AttributControl(monDlg, &quot;TextField&quot;,&quot;Visible&quot;,,Array(26,27))
		AttributControl(monDlg, &quot;CommandButton&quot;,&quot;Visible&quot;,,Array(41,42,43,44))
		AttributControl(monDlg, &quot;Label&quot;,&quot;Visible&quot;,,Array(31,32))
		if oTestRep = false then
			AttributControl(monDlg, &quot;ListBox&quot;,&quot;Actif&quot;,Array(19,20),)
			AttributControl(monDlg, &quot;TextField&quot;,&quot;Actif&quot;,Array(25,26,27),)
			AttributControl(monDlg, &quot;CommandButton&quot;,&quot;Actif&quot;,Array(20,21,22,37,41,42,43,44),)
			AttributControl(monDlg, &quot;Label&quot;,&quot;Actif&quot;,Array(30,31,32),)
			Else
