Sub ConstDroitePart(oStep as integer)
Dim oNvDroite as object, oNvDroite2 as object, oA as New com.sun.star.awt.Point, oM as New com.sun.star.awt.Point, nomAngle as string
Dim oU1 as New com.sun.star.awt.Point, oV1 as New com.sun.star.awt.Point
Dim a as double, b as double, c as double, d as double, e as double
Dim oD1 as object, oC1 as object
Dim oInfo1 as variant, oInfo2 as variant, oPointBis as variant

if oStep = 8 then
	oReponseDlg(1) = RepControl(monDlg,&quot;ListBox8&quot;,&quot;ListBox&quot;)(1)
	oReponseDlg(2) = RepControl(monDlg,&quot;ListBox5&quot;,&quot;ListBox&quot;)(1)
	oReponseDlg(3) = RepControl(monDlg,&quot;ListBox24&quot;,&quot;ListBox&quot;)(1)

    if oReponseDlg(1) = 0 then
    	oD1 = oCollectionDroites(oReponseDlg(2))
    	oM = oListePointsExistants(oReponseDlg(3))
    	oInfo1 = InfoForme(oD1)
		a = (oInfo1(5) + 90)*pi/180 &apos; Correspond à RotateAngle de la perpendiculaire en radian
    	oNvDroite = SegmentDraw(oM.X - 2500 * cos(a),oM.Y+ 2500 * sin(a),oM.X + 2500 * cos(a),oM.Y  - 2500 * sin(a))
    End if
    if oReponseDlg(1) = 1 then
       	oD1 = oCollectionDroites(oReponseDlg(2))
    	oM = oListePointsExistants(oReponseDlg(3))
    	oInfo1 = InfoForme(oD1) 
		a = oInfo1(5)*pi/180 &apos; Correspond à RotateAngle de la parallèle en radian
    	oNvDroite = SegmentDraw(oM.X - 2500 * cos(a),oM.Y+ 2500 * sin(a),oM.X + 2500 * cos(a),oM.Y  - 2500 * sin(a))
    End if
    if oReponseDlg(1) = 2 then 
       	oD1 = oCollectionDroites(oReponseDlg(2))
    	oInfo1 = InfoForme(oD1) 
    	a = (oInfo1(5) + 90)*pi/180 &apos; Correspond à RotateAngle de da médiatrice en radian
    	oNvDroite = SegmentDraw(oInfo1(3).X - 2500 * cos(a),oInfo1(3).Y + 2500 * sin(a),oInfo1(3).X + 2500 * cos(a),oInfo1(3).Y - 2500 * sin(a))
    End if
    if oReponseDlg(1) = 3 then
     nomAngle = RepControl(monDlg,&quot;TextField28&quot;, &quot;TextField&quot;)
     oPointBis = PointsBissectrice(nomAngle)
     oNvDroite = SegmentDraw(oPointBis(0).X,oPointBis(0).Y,oPointBis(1).X,oPointBis(1).Y)
	End if					
	if oReponseDlg(1) = 4 then
		oC1 = oCollectionArcCercles(oReponseDlg(2))
		oInfo1 = InfoForme(oC1)
		b = CDbl(RepControl(monDlg,&quot;TextField28&quot;,&quot;TextField&quot;))    	
		oM.X = oInfo1(3).X + oInfo1(4) &apos; point à 0°
		oM.Y = oInfo1(3).Y
		oA = Rotation(oInfo1(3),b,oM)
		oU1 = Vecteur(oInfo1(3),oA)
		oV1 = VecteurOrtho(oU1,1)
		oB = TranslationKV(2.5,oV1,oA)
		oA = TranslationKV(-2.5,oV1,oA)
		oNvDroite = SegmentDraw(oA.X,oA.Y,oB.X,oB.Y)
	end if
	if oReponseDlg(1) = 5 then
		oC1 = oCollectionArcCercles(oReponseDlg(2))
		oInfo1 = InfoForme(oC1)
		oA = oListePointsExistants(oReponseDlg(3))
		c = DistancePtPt(oInfo1(3),oA)
		d = oInfo1(4)/1000  &apos;rayon en cm
		If c &lt; d then 
			Msgbox(Trad(monDlg,MesMessages2(13)), 0+48, &quot;AHmath2D&quot;)
			Exit sub
		End if		
		e = sqr(c*c-d*d)
		oB = CoordCdeABC(array(oInfo1(3),oA),e,d,&quot;+&quot;)
		oC = CoordCdeABC(array(oInfo1(3),oA),e,d,&quot;-&quot;)
		oNvDroite = SegmentDraw(oA.X,oA.Y,oB.X,oB.Y)
		oNvDroite2 = SegmentDraw(oA.X,oA.Y,oC.X,oC.Y)
	end if
End if

mesFormes.add(oNvDroite)
SauvDerniereConstruction(oNvDroite)
if oReponseDlg(1) = 5 then 
	mesFormes.add(oNvDroite2)
	SauvDerniereConstruction(oNvDroite2,false)	
End if

end sub


&apos;------------------------------------------------------------------------------
&apos; renvois l&apos;origine de la bissectrice et un 2ème point)
&apos;------------------------------------------------------------------------------
function PointsBissectrice(oNomAngle as string)  as New com.sun.star.awt.Point
Dim oInd(2) as Long, oNomSommets(2) as string, oPoints(2) as variant
Dim u1 as New com.sun.star.awt.Point, u2 as New com.sun.star.awt.Point, u3 as New com.sun.star.awt.Point
Dim oM as  New com.sun.star.awt.Point
oInd = IndSommetsAngle(oNomAngle)
oNomSommets = array(oTabNomPoints(oInd(0)),oTabNomPoints(oInd(1)),oTabNomPoints(oInd(2)))

oPoints(0) = oListePointsExistants((oInd(0))
oPoints(1) = oListePointsExistants((oInd(1))
oPoints(2) = oListePointsExistants((oInd(2))

u1 = Vecteur(oPoints(1), oPoints(0),1)
u2 = Vecteur(oPoints(1), oPoints(2),1)
oM = TranslationKV(1,u1,oPoints(1))
oM = TranslationKV(1,u2,oM)
u3 = Vecteur(oPoints(1), oM,1)
oM = TranslationKV(5,u3,oPoints(1))

PointsBissectrice = array(oPoints(1),oM)
end function



&apos;---------------------------------------------------
&apos;  otxt = RepControl(monDlg,&quot;TextField28&quot;, &quot;TextField&quot;)
&apos; Renvois les indices des points ZT 
&apos;-----------------------------------------------------
Function IndSommetsAngle(otxt as string) as variant
Dim oA as string, oB as string, oC as string
Dim i as integer, mesindices(2) as Long

mesIndices = array(-1,-1,-1)
if Len(otxt) = 3 then 
	oA = Mid(otxt,1,1)
	oB = Mid(otxt,2,1)
	oC = Mid(otxt,3,1)
	for i = 0 to uBound(oTabNomPoints)
	if oA = oTabNomPoints(i) then mesIndices(0) = i
	if oB = oTabNomPoints(i) then mesIndices(1) = i
	if oC = oTabNomPoints(i) then mesIndices(2) = i
	Next
End if

IndSommetsAngle = mesIndices
end Function
</script:module>