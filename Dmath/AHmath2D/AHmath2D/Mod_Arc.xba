Sub ConstArc(oStep as integer)
Dim oA as New com.sun.star.awt.Point, oB as New com.sun.star.awt.Point
Dim oI as New com.sun.star.awt.Point, oM1 as New com.sun.star.awt.Point, oM2 as New com.sun.star.awt.Point
Dim oCentre as New com.sun.star.awt.Point, oC as Object
Dim oAngleA as Double, oAngleB as Double
Dim r as Double, a as double, b as double, num as integer, denom as integer, oFractionTxt as string
Dim oNvArc as object, oInfo1 as variant


if oStep = 12 then 
	oReponseDlg(1) = RepControl(monDlg,&quot;ListBox13&quot;,&quot;ListBox&quot;)(1)
	
	if oReponseDlg(1) = 0 then  &apos; centre + A + B
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox26&quot;,&quot;ListBox&quot;)(1)
		oReponseDlg(3) = RepControl(monDlg,&quot;ListBox27&quot;,&quot;ListBox&quot;)(1)
		oReponseDlg(4) = RepControl(monDlg,&quot;ListBox28&quot;,&quot;ListBox&quot;)(1)
		
		if oReponseDlg(2) = oReponseDlg(3) or oReponseDlg(2) = oReponseDlg(4) or oReponseDlg(3) = oReponseDlg(4)  then 
		Msgbox(Trad(monDlg,MesMessages2(12)), 0+48, &quot;AHmath2D&quot;)
		Exit sub
		End if
		
		oI = oListePointsExistants(oReponseDlg(2))
		oA = oListePointsExistants(oReponseDlg(3))
		oB = oListePointsExistants(oReponseDlg(4))
		oReponseDlg(5) = RepControl(monDlg,&quot;OptionButton12&quot;,&quot;OptionButton&quot;)
		
		if oReponseDlg(5) = true then oNvArc = ArcCercleDraw2(oI,oA,oB)
		if oReponseDlg(5) = false then oNvArc = ArcCercleDraw2(oI,oB,oA)
		
		
	End if
	if oReponseDlg(1) = 1 then  &apos; centre + A + angle
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox26&quot;,&quot;ListBox&quot;)(1)
		oReponseDlg(3) = RepControl(monDlg,&quot;ListBox27&quot;,&quot;ListBox&quot;)(1)

		if oReponseDlg(2) = oReponseDlg(3) then 
		Msgbox(Trad(monDlg,MesMessages2(12)), 0+48, &quot;AHmath2D&quot;)
		Exit sub
		End if
		
		
		a = CDbl(RepControl(monDlg,&quot;TextField11&quot;,&quot;TextField&quot;))
		oI = oListePointsExistants(oReponseDlg(2))
		oA = oListePointsExistants(oReponseDlg(3))
    	oB = Rotation(oI,a,oA)
		oNvArc = ArcCercleDraw2(oI,oA,oB)
	End if
	if oReponseDlg(1) = 2 then  &apos; centre + r + angle + inclinaison
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox26&quot;,&quot;ListBox&quot;)(1)
		r = CDbl(RepControl(monDlg,&quot;TextField10&quot;,&quot;TextField&quot;))
		a = CDbl(RepControl(monDlg,&quot;TextField11&quot;,&quot;TextField&quot;))
		b = CDbl(RepControl(monDlg,&quot;TextField30&quot;,&quot;TextField&quot;))
		oI = oListePointsExistants(oReponseDlg(2))
	    oM1.X = oI.X + r*1000
	    oM1.Y = oI.Y
	    oA = Rotation(oI,b,oM1) 
	    oB = Rotation(oI,a,oA)
	    oNvArc = ArcCercleDraw2(oI,oA,oB)
	End if

	if oReponseDlg(1) = 3 then  &apos; cercle + angle + inclinaison
	oReponseDlg(2) = RepControl(monDlg,&quot;ListBox26&quot;,&quot;ListBox&quot;)(1)
	oC = oCollectionCercles(oReponseDlg(2))
	oInfo1 = InfoForme(oC)
	a = CDbl(RepControl(monDlg,&quot;TextField10&quot;,&quot;TextField&quot;))
    b = CDbl(RepControl(monDlg,&quot;TextField11&quot;,&quot;TextField&quot;))
    oM1.X = oInfo1(3).X + oInfo1(4)
    oM1.Y = oInfo1(3).Y
    oA = Rotation(oInfo1(3),b,oM1) 
    oB = Rotation(oInfo1(3),a,oA)
    oNvArc = ArcCercleDraw2(oInfo1(3),oA,oB)
    End if
    
	if oReponseDlg(1) = 4 then
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox26&quot;,&quot;ListBox&quot;)(1)
		oC = oCollectionSegments(oReponseDlg(2))
		oInfo1 = InfoForme(oC)
		oReponseDlg(3) = RepControl(monDlg,&quot;OptionButton12&quot;,&quot;OptionButton&quot;)
		if oReponseDlg(3) = true then oNvArc = ArcCercleDraw2(oInfo1(3),oInfo1(1),oInfo1(2))
		if oReponseDlg(3) = false then oNvArc = ArcCercleDraw2(oInfo1(3),oInfo1(2),oInfo1(1))
	end if
	
	if oReponseDlg(1) = 5 then
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox28&quot;,&quot;ListBox&quot;)(1)
		oC = oCollectionSegments(oReponseDlg(2))
		oInfo1 = InfoForme(oC)
		oFractionTxt = RepControl(monDlg,&quot;TextField10&quot;,&quot;TextField&quot;)
		oReponseDlg(3) = RepControl(monDlg,&quot;OptionButton12&quot;,&quot;OptionButton&quot;)
		b = Instr(1,oFractionTxt,&quot;/&quot;,1)
		num = CInt(Left (oFractionTxt,b-1))
		denom = CInt(Right(oFractionTxt,Len(oFractionTxt) - b))
		
		if num/denom &gt;=1 then
			Msgbox(Trad(monDlg,MesMessages1(9)), 0+48, &quot;AHmath2D&quot;)
			Exit sub
		End if
		
		oAngleA = IIf(oReponseDlg(3) = true, 90*(1-2*num/denom), -90*(1-2*num/denom))
		if oAngleA = 0 then oCentre = oInfo1(3)
		if oAngleA &lt;&gt; 0 then
			oM1 = Rotation(oInfo1(2),-oAngleA,oInfo1(1))
			oM2 = Rotation(oInfo1(1),oAngleA,oInfo1(2))
			oCentre = CoordIntersDroites(array(oInfo1(2),oM1),array(oInfo1(1),oM2))
		End if
	if oReponseDlg(3) = true then oNvArc = ArcCercleDraw2(oCentre,oInfo1(1),oInfo1(2))
	if oReponseDlg(3) = false then oNvArc = ArcCercleDraw2(oCentre,oInfo1(2),oInfo1(1))
	end if
	
	if oReponseDlg(1) = 6 then
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox28&quot;,&quot;ListBox&quot;)(1)
		oC = oCollectionSegments(oReponseDlg(2))
		oInfo1 = InfoForme(oC)	
		r = CDbl(RepControl(monDlg,&quot;TextField10&quot;,&quot;TextField&quot;))
		
		If oInfo1(4) &gt; r*2 then
			Msgbox(Trad(monDlg,MesMessages2(11)), 0+48, &quot;AHmath2D&quot;)
			Exit sub
		End if
		
		oReponseDlg(3) = RepControl(monDlg,&quot;OptionButton12&quot;,&quot;OptionButton&quot;)
		if oReponseDlg(3) = true then 
			oCentre = CoordCdeABC(oC,r,r,&quot;+&quot;)
			oNvArc = ArcCercleDraw2(oCentre,oInfo1(1),oInfo1(2))
			Else
			oCentre = CoordCdeABC(oC,r,r,&quot;-&quot;)
			oNvArc = ArcCercleDraw2(oCentre,oInfo1(2),oInfo1(1))
		End if
	End if

end if

mesFormes.add(oNvArc)
SauvDerniereConstruction(oNvArc)

End Sub
</script:module>