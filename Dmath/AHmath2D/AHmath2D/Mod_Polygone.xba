Sub ConstPolygone(oStep as integer)
Dim oNvCote(49) as variant, monPolygone as object, oSgt as object,oCercle as object, oInfo as variant
Dim a as double, b as double
Dim i as integer
Dim oM1 as New com.sun.star.awt.Point, oM2 as New com.sun.star.awt.Point
Dim oA as New com.sun.star.awt.Point, oB as New com.sun.star.awt.Point, oC as New com.sun.star.awt.Point
Dim oV1 as New com.sun.star.awt.Point, oV2 as New com.sun.star.awt.Point
 


if oStep = 9 then
	oReponseDlg(1) = RepControl(monDlg,&quot;ListBox9&quot;,&quot;ListBox&quot;)(1)     
	oReponseDlg(2) = RepControl(monDlg,&quot;ListBox2&quot;,&quot;ListBox&quot;)(1)
	if oReponseDlg(1) &lt;= 4 then
		oSgt = oCollectionSegments(oReponseDlg(2))
		oInfo = InfoForme(oSgt)
		Else
		oCercle = oCollectionCercles(oReponseDlg(2))
		oInfo = InfoForme(oCercle)
	End if
		
	if oReponseDlg(1) = 0 then     &apos;triangle

		if RepControl(monDlg,&quot;OptionButton3&quot;,&quot;OptionButton&quot;) = true then
			b = CDbl(RepControl(monDlg,&quot;TextField15&quot;,&quot;TextField&quot;))
			a = CDbl(RepControl(monDlg,&quot;TextField16&quot;,&quot;TextField&quot;))	
			
			if ExistenceTriangle(a,b,oInfo(4)) = false then 
				Msgbox(Trad(monDlg,MesMessages2(11)), 0+48, &quot;AHmath2D&quot;)
				Exit sub
			End if
			
			if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = true then
	   		oC = CoordCdeABC(oSgt,a,b,&quot;+&quot;)
	   		else
	   		oC = CoordCdeABC(oSgt,a,b,&quot;-&quot;)
	   		End if
	   End if
	   
	   	if RepControl(monDlg,&quot;OptionButton4&quot;,&quot;OptionButton&quot;) = true then
	   		if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = true then
	   			b = CDbl(RepControl(monDlg,&quot;TextField18&quot;,&quot;TextField&quot;)) * (-1)
				a = CDbl(RepControl(monDlg,&quot;TextField17&quot;,&quot;TextField&quot;))	
			else
				b = CDbl(RepControl(monDlg,&quot;TextField18&quot;,&quot;TextField&quot;))
				a = CDbl(RepControl(monDlg,&quot;TextField17&quot;,&quot;TextField&quot;)) * (-1)
			End if	
			
			if abs(a) + abs(b) &gt;= 180 then
				Msgbox(Trad(monDlg,MesMessages2(11)), 0+48, &quot;AHmath2D&quot;)
				Exit sub
			End if
			
	   	oM1 = Rotation(oInfo(1),a,oInfo(2))
	   	oM2 = Rotation(oInfo(2),b,oInfo(1))
	   	oC = CoordIntersDroites(array(oInfo(1),oM1),array(oInfo(2),oM2))
	   	End if
	   	
	   	if RepControl(monDlg,&quot;OptionButton5&quot;,&quot;OptionButton&quot;) = true then
	   		a = CDbl(RepControl(monDlg,&quot;TextField19&quot;,&quot;TextField&quot;))	
	   		if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = true then
	   			b = CDbl(RepControl(monDlg,&quot;TextField20&quot;,&quot;TextField&quot;))
			else
				b = CDbl(RepControl(monDlg,&quot;TextField20&quot;,&quot;TextField&quot;)) * (-1)
			End if	
	   	oM1 = Rotation(oInfo(1),b,oInfo(2))
	   	oV1 = Vecteur(oInfo(1),oM1,1)
	   	oC = TranslationKV(a,oV1,oInfo(1))
	   	
	   	End if
	   	
	   	if RepControl(monDlg,&quot;OptionButton6&quot;,&quot;OptionButton&quot;) = true then
	   	   		a = CDbl(RepControl(monDlg,&quot;TextField21&quot;,&quot;TextField&quot;))	
	   		if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = true then
	   			b = CDbl(RepControl(monDlg,&quot;TextField22&quot;,&quot;TextField&quot;)) * (-1)
			else
				b = CDbl(RepControl(monDlg,&quot;TextField22&quot;,&quot;TextField&quot;))
			End if	
	   	oM1 = Rotation(oInfo(2),b,oInfo(1))
	   	oV1 = Vecteur(oInfo(2),oM1,1)
	   	oC = TranslationKV(a,oV1,oInfo(2))
	   	End if
	End if

	if oReponseDlg(1) = 1 then    &apos;rectangle
		a = CDbl(RepControl(monDlg,&quot;TextField15&quot;,&quot;TextField&quot;))
		if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = true then a = -a
		oV1 = Vecteur(oInfo(1),oInfo(2))
		oV2 = VecteurOrtho(oV1,1)
		oM1 = TranslationKV(a,oV2,oInfo(1))
		oM2 = TranslationKV(a,oV2,oInfo(2))
    End if


	if oReponseDlg(1) = 2 then    &apos;losange

	if RepControl(monDlg,&quot;OptionButton3&quot;,&quot;OptionButton&quot;) = true then
		a = CDbl(RepControl(monDlg,&quot;TextField15&quot;,&quot;TextField&quot;))
		if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = false then a = -a
		oM1 = Rotation(oInfo(1),a,oInfo(2))
		oV1 = Vecteur(oInfo(1),oM1)
		oM2 = TranslationKV(1,oV1,oInfo(2))
	End if
	
	if RepControl(monDlg,&quot;OptionButton4&quot;,&quot;OptionButton&quot;) = true then
		a = CDbl(RepControl(monDlg,&quot;TextField17&quot;,&quot;TextField&quot;))
		if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = true then a = -a
		oM2 = Rotation(oInfo(2),a,oInfo(1))
		oV1 = Vecteur(oInfo(2),oM2)
		oM1 = TranslationKV(1,oV1,oInfo(1))
	End if
	
	if RepControl(monDlg,&quot;OptionButton5&quot;,&quot;OptionButton&quot;) = true then
			a = CDbl(RepControl(monDlg,&quot;TextField19&quot;,&quot;TextField&quot;))
			if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = true then
	   		oM2 = CoordCdeABC(oSgt,oInfo(4),a,&quot;+&quot;)
	   		else
	   		oM2 = CoordCdeABC(oSgt,oInfo(4),a,&quot;-&quot;)
	   		End if
			oM1 = Translation(oInfo(2),oInfo(1),oM2)
	   End if
	   
	if RepControl(monDlg,&quot;OptionButton6&quot;,&quot;OptionButton&quot;) = true then
			a = CDbl(RepControl(monDlg,&quot;TextField21&quot;,&quot;TextField&quot;))
			if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = true then
	   		oM1 = CoordCdeABC(oSgt,oInfo(4),a,&quot;+&quot;)
	   		else
	   		oM1 = CoordCdeABC(oSgt,oInfo(4),a,&quot;-&quot;)
	   		End if
			oM2 = Translation(oInfo(1),oInfo(2),oM1)
	 End if	
	   
	End if
	
	if oReponseDlg(1) = 3 then    &apos;parallélogramme
		if RepControl(monDlg,&quot;OptionButton3&quot;,&quot;OptionButton&quot;) = true then
		a = CDbl(RepControl(monDlg,&quot;TextField15&quot;,&quot;TextField&quot;))
		b = CDbl(RepControl(monDlg,&quot;TextField16&quot;,&quot;TextField&quot;))
		
		if ExistenceTriangle(a,b,oInfo(4)) = false then 
				Msgbox(Trad(monDlg,MesMessages2(11)), 0+48, &quot;AHmath2D&quot;)
				Exit sub
		End if
				
		if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = true then
	   	oM1 = CoordCdeABC(oSgt,b,a,&quot;+&quot;)
	   	else
	   	oM1 = CoordCdeABC(oSgt,b,a,&quot;-&quot;)
	   	End if
		oV1 = Vecteur(oInfo(1),oM1)
		oM2 = TranslationKV(1,oV1,oInfo(2))
	End if
	
	if RepControl(monDlg,&quot;OptionButton4&quot;,&quot;OptionButton&quot;) = true then
		a = CDbl(RepControl(monDlg,&quot;TextField17&quot;,&quot;TextField&quot;))
		b = CDbl(RepControl(monDlg,&quot;TextField18&quot;,&quot;TextField&quot;))
		
		if ExistenceTriangle(a,b,oInfo(4)) = false then 
				Msgbox(Trad(monDlg,MesMessages2(11)), 0+48, &quot;AHmath2D&quot;)
				Exit sub
		End if
		
		if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = true then
	   	oM2 = CoordCdeABC(oSgt,a,b,&quot;+&quot;)
	   	else
	   	oM2 = CoordCdeABC(oSgt,a,b,&quot;-&quot;)
	   	End if
		oV1 = Vecteur(oInfo(2),oInfo(1))
		oM1 = TranslationKV(1,oV1,oM2)
	End if
	
	if RepControl(monDlg,&quot;OptionButton5&quot;,&quot;OptionButton&quot;) = true then
		a = CDbl(RepControl(monDlg,&quot;TextField19&quot;,&quot;TextField&quot;))
		b = CDbl(RepControl(monDlg,&quot;TextField20&quot;,&quot;TextField&quot;))
		if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = false then b = -b
		oC = Rotation(oInfo(1),b,oInfo(2))
		oV1 = Vecteur(oInfo(1),oC,1)
		oM1 = TranslationKV(a,oV1,oInfo(1))
		oM2 = TranslationKV(a,oV1,oInfo(2))
	   End if
	   
	if RepControl(monDlg,&quot;OptionButton6&quot;,&quot;OptionButton&quot;) = true then
		a = CDbl(RepControl(monDlg,&quot;TextField21&quot;,&quot;TextField&quot;))
		b = CDbl(RepControl(monDlg,&quot;TextField22&quot;,&quot;TextField&quot;))
		if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = true then b = -b
		oC = Rotation(oInfo(2),b,oInfo(1))
		oV1 = Vecteur(oInfo(2),oC,1)
		oM2 = TranslationKV(a,oV1,oInfo(2))
		oM1 = TranslationKV(a,oV1,oInfo(1))
	   End if	
	End if
	
	if oReponseDlg(1) = 4 then    &apos;polygone régulier
		a = CInt(RepControl(monDlg,&quot;TextField15&quot;,&quot;TextField&quot;))
		if RepControl(monDlg,&quot;OptionButton7&quot;,&quot;OptionButton&quot;) = true then
			monPolygone = PolygoneRegulier(oSgt,a,&quot;+&quot;)
			Else
			monPolygone = PolygoneRegulier(oSgt,a,&quot;-&quot;)
		End if
	End if
	
&apos;-----Tracé des côtés et ajout à la collection	
	if oReponseDlg(1) = 0 then 
		oNvCote(1) = SegmentDraw(oInfo(1).X,oInfo(1).Y,oC.X,oC.Y)
	    oNvCote(2) = SegmentDraw(oInfo(2).X,oInfo(2).Y,oC.X,oC.Y)
	    mesFormes.add(oNvCote(1))
	   	mesFormes.add(oNvCote(2))
	   	SauvDerniereConstruction(oNvCote(1))
	   	SauvDerniereConstruction(oNvCote(2),false)
	end if
	if oReponseDlg(1) &gt; 0 and oReponseDlg(1) &lt; 4  then
		oNvCote(1) = SegmentDraw(oInfo(2).X,oInfo(2).Y,oM2.X,oM2.Y)
		oNvCote(2) = SegmentDraw(oM2.X,oM2.Y,oM1.X,oM1.Y)
		oNvCote(3) = SegmentDraw(oM1.X,oM1.Y,oInfo(1).X,oInfo(1).Y)	
		mesFormes.add(oNvCote(1))
	   	mesFormes.add(oNvCote(2))
	   	mesFormes.add(oNvCote(3))
	   	SauvDerniereConstruction(oNvCote(1))
	   	SauvDerniereConstruction(oNvCote(2),false)
	   	SauvDerniereConstruction(oNvCote(3),false)
	End if

	if oReponseDlg(1) = 4 then
		For i = 0 to monPolygone.Count - 1
			mesFormes.add(monPolygone(i))
			if i = 0 then SauvDerniereConstruction(monPolygone(i))
			if i &gt; 0 then SauvDerniereConstruction(monPolygone(i),false)		
		Next
	End if
	
	if oReponseDlg(1) = 5 or oReponseDlg(1) = 6 then
		a = CInt(RepControl(monDlg,&quot;TextField15&quot;,&quot;TextField&quot;))
		b = CDbl(RepControl(monDlg,&quot;TextField17&quot;,&quot;TextField&quot;))
		c = oInfo(4)/cos(pi/a) &apos; rayon du polygone circonscrit
		if oReponseDlg(1) = 5 then 	oM1 = oInfo(2) &apos;point à 0° du polygone inscrit
		if oReponseDlg(1) = 6 then  oM1 = CoordPoint(oInfo(1).X + c,oInfo(1).Y)&apos;point à 0° du polygone circonscrit
		oA = Rotation(oInfo(3),b,oM1)
		oB = Rotation(oInfo(3),360/a,oA)
		oNvCote(1) = SegmentDraw(oA.X,oA.Y,oB.X,oB.Y)
		monPolygone =  PolygoneRegulier(array(oA,oB),a,&quot;+&quot;)
		mesFormes.add(oNvCote(1))
		SauvDerniereConstruction(oNvCote(1))	
		For i = 0 to monPolygone.Count - 1
		mesFormes.add(monPolygone(i))
		SauvDerniereConstruction(monPolygone(i),false)	
		Next
	End if
End if


end sub
</script:module>