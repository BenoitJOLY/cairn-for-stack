Sub ConstCodage(oStep as integer)
Dim oInd(2) as Long, oNomSommets(2) as string, oNomAngle as string, oPoints(2) as variant, oDimCod as double
Dim oU1 as New com.sun.star.awt.Point, oU2 as New com.sun.star.awt.Point , oU3 as New com.sun.star.awt.Point
Dim oM1 as New com.sun.star.awt.Point, oM2 as New com.sun.star.awt.Point, oM3 as New com.sun.star.awt.Point
Dim nvCodage(3) as object, oCodage as object, supCodage(oNbrObjets(1)) as object
Dim i as integer, oInfo1 as variant, oInfo2 as variant

Dim monSegment as object

if oStep = 15 then   &apos; aucune selection et 1er dessin
	oReponseDlg(1) = RepControl(monDlg,&quot;ListBox29&quot;,&quot;ListBox&quot;)(1)
	oDimCod = CDBL(RepControl(monDlg,&quot;TextField5&quot;,&quot;TextField&quot;))
		
	If oReponseDlg(1) = 0 then
		oReponseDlg(2) = RepControl(monDlg,&quot;ListBox3&quot;,&quot;ListBox&quot;)(1)
		oReponseDlg(3) = RepControl(monDlg,&quot;CheckBox1&quot;,&quot;CheckBox&quot;)
		monSegment = oCollectionSegments(oReponseDlg(2))
					
		oCodage = CodageSegment2(monSegment, oDimCod)

	End if
	
	If oReponseDlg(1) = 1 then
		oNomAngle = RepControl(monDlg,&quot;TextField4&quot;,&quot;TextField&quot;)
		oInd = IndSommetsAngle(oNomAngle)
		oPoints = array(oListePointsExistants(oInd(0)),oListePointsExistants(oInd(1)),oListePointsExistants(oInd(2)))

		if RepControl(monDlg,&quot;OptionButton16&quot;,&quot;OptionButton&quot;) = true then 
			nvCodage(0) = CodageElement1(oPoints,oDimCod)
		End if
		if RepControl(monDlg,&quot;OptionButton17&quot;,&quot;OptionButton&quot;) = true then 
			nvCodage(0) = CodageElement1(oPoints,oDimCod)
			nvCodage(1) = CodageElement1(oPoints,oDimCod+0.1)
		End if
		if RepControl(monDlg,&quot;OptionButton18&quot;,&quot;OptionButton&quot;) = true then 
			nvCodage(0) = CodageElement1(oPoints,oDimCod)
			nvCodage(1) = CodageElement1(oPoints,oDimCod+0.1)
			nvCodage(2) = CodageElement1(oPoints,oDimCod+0.2)
		End if
		if RepControl(monDlg,&quot;OptionButton19&quot;,&quot;OptionButton&quot;) = true then 
			nvCodage(0) = CodageElement1(oPoints,oDimCod)
			nvCodage(1) = CodageElement2(oPoints,Array(oDimCod-0.2, oDimCod+0.05)
		End if
		if RepControl(monDlg,&quot;OptionButton22&quot;,&quot;OptionButton&quot;) = true then 
			nvCodage(0) = CodageElement1(oPoints,oDimCod)
			nvCodage(1) = CodageElement1(oPoints,oDimCod+0.1)
			nvCodage(2) = CodageElement2(oPoints,Array(oDimCod-0.2, oDimCod+0.1))
		End if
		if RepControl(monDlg,&quot;OptionButton23&quot;,&quot;OptionButton&quot;) = true then 
			nvCodage(0) = CodageElement1(oPoints,oDimCod)
			nvCodage(1) = CodageElement1(oPoints,oDimCod+0.1)
			nvCodage(2) = CodageElement1(oPoints,oDimCod+0.2)
			nvCodage(3) = CodageElement2(oPoints,Array(oDimCod-0.2, oDimCod+0.2))
		End if
		if RepControl(monDlg,&quot;OptionButton24&quot;,&quot;OptionButton&quot;) = true then 
			nvCodage(0) = CodageElement3(oPoints,oDimCod)
		End if
		
			For i = 0 to 3
			if Not IsNull(nvCodage(i)) then oCollectionCodage.add(nvCodage(i))
			Next
			oCodage = GroupFormes(oCollectionCodage)
	end if
	
	mesFormes.add(oCodage)
	SauvDerniereConstruction(oCodage)
	Vidange(oCollectionCodage)
	
	If oReponseDlg(1) = 0 and oReponseDlg(3) = 1  then
		oInfo1 = InfoForme(monSegment)
		For i = 0 to oNbrObjets(1) - 1
			if i &lt;&gt; oReponseDlg(2) then
			oInfo2 = InfoForme(oCollectionSegments(i))
				if oInfo1(4) = oInfo2(4) then 
					supCodage(i) = CodageSegment2(oCollectionSegments(i), oDimCod)
					mesFormes.add(supCodage(i))
					SauvDerniereConstruction(supCodage(i),false)
					Vidange(oCollectionCodage)
				End if
			End if
		Next
	End if
	
	
end if
end sub


function mesPoints (oNomAngle as string, oCoeff as double) as variant
Dim oInd(2) as Long, oNomSommets(2) as string, oPoints(2) as variant
Dim oU1 as New com.sun.star.awt.Point, oU2 as New com.sun.star.awt.Point , oU3 as New com.sun.star.awt.Point
Dim oM1 as New com.sun.star.awt.Point, oM2 as New com.sun.star.awt.Point, oM3 as New com.sun.star.awt.Point
Dim nvCodage as object

	oInd = IndSommetsAngle(oNomAngle)
	oNomSommets = array(oTabNomPoints(oInd(0)),oTabNomPoints(oInd(1)),oTabNomPoints(oInd(2)))
	oPoints(0) = oListePointsExistants((oInd(0))
	oPoints(1) = oListePointsExistants((oInd(1))
	oPoints(2) = oListePointsExistants((oInd(2))
	oU1 = Vecteur(oPoints(1),oPoints(0),1)
	oU2 = Vecteur(oPoints(1),oPoints(2),1)
	oM1 = TranslationKV(oCoeff,oU1,oPoints(1))
	oM2 = TranslationKV(oCoeff,oU2,oPoints(1))
	oM3 = TranslationKV(oCoeff,oU2,oM1)
	oU3 = Vecteur(oPoints(1),oM3,1)
	oM3 = TranslationKV(oCoeff,oU3,oPoints(1))
	mesPoints =  Array(oM1,oM3,oM2)
End function




Function CodageSegment2(monSgt as object, oDim as Double) as object
Dim monCodage(2) as object


		if RepControl(monDlg,&quot;OptionButton16&quot;,&quot;OptionButton&quot;) = true then 
			monCodage(0) = CodageSegment(monSgt,oDim,1)
		End if
		if RepControl(monDlg,&quot;OptionButton17&quot;,&quot;OptionButton&quot;) = true then 
			monCodage(0) = CodageSegment(monSgt,oDim,1,-0.05)
			monCodage(1) = CodageSegment(monSgt,oDim,1,0.05)
		End if
		if RepControl(monDlg,&quot;OptionButton18&quot;,&quot;OptionButton&quot;) = true then 
			monCodage(0) = CodageSegment(monSgt,oDim,1,-0.1)
			monCodage(1) = CodageSegment(monSgt,oDim,1)
			monCodage(2) = CodageSegment(monSgt,oDim,1,0.1)
		End if
		if RepControl(monDlg,&quot;OptionButton19&quot;,&quot;OptionButton&quot;) = true then 
			monCodage(0) = CodageSegment(monSgt,oDim,2)
		End if
		if RepControl(monDlg,&quot;OptionButton22&quot;,&quot;OptionButton&quot;) = true then 
			monCodage(0) = CodageSegment(monSgt,oDim,3)
		End if
		if RepControl(monDlg,&quot;OptionButton23&quot;,&quot;OptionButton&quot;) = true then 
			monCodage(0) = CodageSegment(monSgt,oDim,3,-0.05)
			monCodage(1) = CodageSegment(monSgt,oDim,3,0.05)
		End if
		if RepControl(monDlg,&quot;OptionButton24&quot;,&quot;OptionButton&quot;) = true then 
			monCodage(0) = CodageSegment(monSgt,oDim,3,-0.1)
			monCodage(1) = CodageSegment(monSgt,oDim,3)
			monCodage(2) = CodageSegment(monSgt,oDim,3,0.1)
		End if
		if RepControl(monDlg,&quot;OptionButton33&quot;,&quot;OptionButton&quot;) = true then 
			monCodage(0) = CodageSegment(monSgt,oDim,4)
		End if
		For i = 0 to 2
		if Not IsNull(monCodage(i)) then oCollectionCodage.add(monCodage(i))
		Next
		CodageSegment2 = GroupFormes(oCollectionCodage)
		
End function

</script:module>