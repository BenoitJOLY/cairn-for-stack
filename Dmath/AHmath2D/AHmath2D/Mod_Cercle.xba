Sub ConstCercle(oStep as integer)
Dim oNewCercle as object, oD1 as object, oC1 as object
Dim a as double, b as double, c as double, r as double
Dim oM1 as New com.sun.star.awt.Point, oM2 as New com.sun.star.awt.Point
Dim oInfo1 as variant

if oStep = 40 then   &apos; aucune selection et 1er dessin
	oReponseDlg(1) = RepControl(monDlg,&quot;ListBox40&quot;,&quot;ListBox&quot;)(1)
	a = CDbl(RepControl(monDlg,&quot;TextField12&quot;,&quot;TextField&quot;))*1000
    b = CDbl(RepControl(monDlg,&quot;TextField13&quot;,&quot;TextField&quot;))
    c =  CDbl(RepControl(monDlg,&quot;TextField14&quot;,&quot;TextField&quot;))
    if oReponseDlg(1) = 2 then oNewCercle = CercleDraw(10500 , 15000, a)
    if oReponseDlg(1) = 3 then oNewCercle = ArcCercleDraw(10500 , 15000, a, c, c+b )
End if



if oStep = 11 then
	oReponseDlg(1) = RepControl(monDlg,&quot;ListBox12&quot;,&quot;ListBox&quot;)(1)
	oReponseDlg(2) = RepControl(monDlg,&quot;ListBox6&quot;,&quot;ListBox&quot;)(1)
	oReponseDlg(3) = RepControl(monDlg,&quot;ListBox25&quot;,&quot;ListBox&quot;)(1)
	
	if oReponseDlg(1) = 0 then 
	oM1 = oListePointsExistants(oReponseDlg(2))
	r = CDbl(RepControl(monDlg,&quot;TextField29&quot;,&quot;TextField&quot;))*1000
	oNewCercle = CercleDraw(oM1.X , oM1.Y, r)
	end if
	if oReponseDlg(1) = 1 then 
	oM1 = oListePointsExistants(oReponseDlg(2))
	oM2 = oListePointsExistants(oReponseDlg(3))
	r = DistancePtPt(oM1,oM2) * 1000
	oNewCercle = CercleDraw(oM1.X , oM1.Y, r)
	end if
	if oReponseDlg(1) = 2 then 
	oD1 = oCollectionSegments(oReponseDlg(2))
	oInfo1 = InfoForme(oD1)
	oNewCercle = CercleDraw(oInfo1(3).X , oInfo1(3).Y, oInfo1(4)*1000/2)
	end if
	if oReponseDlg(1) = 3 then 
	oM1 = oListePointsExistants(oReponseDlg(2))
	oD1 = oCollectionDroites(oReponseDlg(3))
	r = DistancePtDte(oM1,oD1) * 1000
	oNewCercle = CercleDraw(oM1.X , oM1.Y, r)
	end if
	if oReponseDlg(1) = 4 then 
	oM1 = oListePointsExistants(oReponseDlg(2))
	oC1 = oCollectionArcCercles(oReponseDlg(3))
	oInfo1 = InfoForme(oC1)
	r = abs(DistancePtPt(oInfo1(3),oM1) * 1000 - oInfo1(4))
	oNewCercle = CercleDraw(oM1.X , oM1.Y, r)
	end if
	if oReponseDlg(1) = 5 then 
	oC1 = oCollectionArcCercles(oReponseDlg(2))
	oInfo1 = InfoForme(oC1)
	r = CDbl(RepControl(monDlg,&quot;TextField29&quot;,&quot;TextField&quot;))*1000
	oNewCercle = CercleDraw(oInfo1(3).X , oInfo1(3).Y, r)
	end if
	if oReponseDlg(1) = 6 then 
	oC1 = oCollectionArcCercles(oReponseDlg(2))
	oInfo1 = InfoForme(oC1)
	oM1 = oListePointsExistants(oReponseDlg(3))
	r = DistancePtPt(oInfo1(3),oM1) * 1000
	oNewCercle = CercleDraw(oInfo1(3).X , oInfo1(3).Y, r)
	end if
End if

mesFormes.add(oNewCercle)
SauvDerniereConstruction(oNewCercle)

end sub
</script:module>