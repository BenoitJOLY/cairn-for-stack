option explicit

&apos;------------------------------------------------------------------------------------------------------------------------
&apos;construction d&apos;un segment
&apos;x, y en millièmes de centimètre
&apos;--------------------------------------------------------------------------------------------------------------------------

Function SegmentDraw(x1 as double, y1 as double, x2 as double, y2 as double) as object
dim Doc as object, Page as object, oSegment as object, lesPoints(1) As New com.sun.star.awt.Point

Doc = oDocTemp
Page = oPageTemp
oSegment = Doc.createInstance(&quot;com.sun.star.drawing.LineShape&quot;)
oSegment.LineWidth = 30 &apos;epaisseur du trait = 0,03 cm
Page.add(oSegment)   &apos; Page.add must take place before the coordinates are set
lesPoints(0).X = x1
lesPoints(0).Y = y1
lesPoints(1).X = x2
lesPoints(1).Y = y2
oSegment.PolyPolygon = Array(lesPoints())
oSegment.lineColor=RGB(0,0,0) &apos;noir
SegmentDraw = oSegment

end Function




&apos;------------------------------------------------------------------------------------------------------------------------
&apos;construction d&apos;un cercle
&apos;x, y et rayon en millièmes de centimètre
&apos;--------------------------------------------------------------------------------------------------------------------------

function CercleDraw(Xcentre as double,Ycentre as double,rayon as double) as object
dim Doc as object, Page as object, monCercle as object, dimensionCercle as New com.sun.star.awt.Size, positionCercle As New com.sun.star.awt.Point

Doc = oDocTemp
Page = oPageTemp
positionCercle.X = Xcentre - rayon
positionCercle.Y = Ycentre - rayon
monCercle = Doc.createInstance(&quot;com.sun.star.drawing.EllipseShape&quot;)
monCercle.CircleKind = com.sun.star.drawing.CircleKind.FULL	
monCercle.LineWidth = 30
monCercle.LineColor=RGB(0,0,0)  &apos;noir
monCercle.lineStyle = 1 &apos;avec bordure
monCercle.FillStyle = 0 &apos;sans remplissage	
dimensionCercle.Width = 2*rayon
dimensionCercle.Height =2*rayon

monCercle.Size = dimensionCercle
monCercle.Position = positionCercle

Page.add(monCercle) 
CercleDraw = monCercle
end function


&apos;------------------------------------------------------------------------------------------------------------------------
&apos;construction d&apos;un arc de cercle
&apos;x, y et rayon en millièmes de centimètre       Angle en degrés  (angle max = 360°)
&apos;--------------------------------------------------------------------------------------------------------------------------


function ArcCercleDraw(Xcentre as double,Ycentre as double,rayon as double,AngleDebut as Long, AngleFin as Long) as object
dim Doc as object, Page as object, monArc as object, dimensionArc as New com.sun.star.awt.Size, positionArc As New com.sun.star.awt.Point


Doc = oDocTemp
Page = oPageTemp
positionArc.X = Xcentre - rayon
positionArc.Y = Ycentre - rayon
monArc = Doc.createInstance(&quot;com.sun.star.drawing.EllipseShape&quot;)
monArc.CircleKind = com.sun.star.drawing.CircleKind.ARC
monArc.CircleStartAngle = AngleDebut*100
monArc.CircleEndAngle = AngleFin*100
monArc.LineWidth = 30
monArc.LineColor=RGB(0,0,0)  &apos;noir
monArc.FillStyle = 0 	
dimensionArc.Width = 2*rayon
dimensionArc.Height =2*rayon
monArc.Size = dimensionArc

monArc.Position = positionArc

Page.add(monArc) 
ArcCercleDraw = monArc
end function


function ArcCercleDraw2(oCentre as variant,oA as variant ,oB as variant) as object
dim Doc as object, Page as object, monArc as object, dimensionArc as New com.sun.star.awt.Size, positionArc As New com.sun.star.awt.Point
Dim oAngleA as Double, oAngleB as Double, rA as Long, rB as Long

Doc = oDocTemp
Page = oPageTemp

oAngleA = AngleSegment(array(oCentre,oA))
oAngleB = AngleSegment(array(oCentre,oB))
rA = DistancePtPt(oCentre,oA) * 1000
rB = DistancePtPt(oCentre,oB) * 1000

if CLng((rA-rB)/10) &lt;&gt; 0 then  &apos;rayons égaux au 1/10 de mm
	msgbox(Trad(monDlg,MesMessages2(4)))
End if

monArc = Doc.createInstance(&quot;com.sun.star.drawing.EllipseShape&quot;)
monArc.CircleKind = 3
monArc.CircleStartAngle = oAngleA*100
monArc.CircleEndAngle = oAngleB*100
monArc.LineWidth = 30
monArc.LineColor=RGB(0,0,0)  &apos;noir
monArc.FillStyle = 0
dimensionArc.Width = 2*rA
dimensionArc.Height =2*rA
monArc.Size = dimensionArc

positionArc.X = oCentre.X - rA
positionArc.Y = oCentre.Y - rA
monArc.Position = positionArc



Page.add(monArc) 

&apos;monArc.CircleKind = 3

ArcCercleDraw2 = monArc
end function



&apos;------------------------------------------------------------------------------------------------------------------------
&apos;construction d&apos;un triangle
&apos;x, y en millièmes de centimètre
&apos;--------------------------------------------------------------------------------------------------------------------------

sub TriangleDraw(x1 as double, y1 as double, x2 as double, y2 as double,x3 as double, y3 as double)

SegmentDraw(x1, y1, x2, y2)
SegmentDraw(x2, y2, x3, y3)
SegmentDraw(x3, y3, x1, y1)

end sub

&apos;------------------------------------------------------------------------------------------------------------------------
&apos;construction d&apos;un quadrilatère
&apos;x, y en millièmes de centimètre
&apos;--------------------------------------------------------------------------------------------------------------------------

sub QuadriDraw(x1 as double, y1 as double, x2 as double, y2 as double,x3 as double, y3 as double, x4 as double, y4 as double)

SegmentDraw(x1, y1, x2, y2)
SegmentDraw(x2, y2, x3, y3)
SegmentDraw(x3, y3, x4, y4)
SegmentDraw(x4, y4, x1, y1)

end sub

&apos;------------------------------------------------------------------------------------------------------------------------
&apos;construction d&apos;un polygone à l&apos;aide de segments
&apos;oPoints est un tableau de points, n est le nombre de sommets
&apos;--------------------------------------------------------------------------------------------------------------------------

sub PolygoneDraw(n as integer, oPoints as variant)
Dim i as integer, oIndexDeb as integer, oIndexFin as integer
Dim oPoint1 as  New com.sun.star.awt.Point, oPoint2 as  New com.sun.star.awt.Point 

oIndexDeb = 0
oIndexFin = n-1

for i = oIndexDeb to oIndexFin-1
	oPoint1 = oPoints(i)
	oPoint2 = oPoints(i+1)
	SegmentDraw(oPoint1.X, oPoint1(i).Y,oPoint2.X,oPoint2.Y)
Next
	oPoint1 = oPoints(oIndexFin)
	oPoint2 = oPoints(oIndexDeb)
	SegmentDraw(oPoint1.X, oPoint1.Y,oPoint2.X,oPoint2.Y)
	SegmentDraw.lineColor=RGB(0,0,0)
end sub

&apos;------------------------------------------------------------------------------------------------------------------------
&apos;construction d&apos;une ligne brisée
&apos;oPoints est un tableau de points, n est le nombre de sommets
&apos;oBezier permet d&apos;obtenir une forme de bezier
&apos;--------------------------------------------------------------------------------------------------------------------------

function LigneBriseeDraw(n as integer, oPoints as variant, optional oBezier as boolean) as object
dim Doc as object, Page as object, LigneShape as object, oPointsRedim(n-1) As New com.sun.star.awt.Point, i as integer

If Ismissing(oBezier) then oBezier = false

Doc = oDocTemp
Page = oPageTemp
if oBezier = false then LigneShape = Doc.createInstance(&quot;com.sun.star.drawing.PolyLineShape&quot;)
if oBezier = true then LigneShape = Doc.createInstance(&quot;com.sun.star.drawing.PolyPolygonShape&quot;)
LigneShape.LineWidth = 30 &apos;epaisseur du trait = 0,03 cm
Page.add(LigneShape)   &apos; Page.add must take place before the coordinates are set

for i = 0 to n-1
oPointsRedim(i) = oPoints(i)
next
LigneShape.PolyPolygon = Array(oPointsRedim())
LigneShape.lineColor=RGB(0,0,0) &apos;noir
LigneBriseeDraw = LigneShape
end function

&apos;------------------------------------------------------------------
&apos;- Construction d&apos;une zone de texte pour afficher provisoirement le nom des points
&apos;- modification pour l&apos;utiliser aussi sur un doc writer
&apos;------------------------------------------------------------------
Function ZoneTexteDraw(oDoc as object, oTexte as string, oPoint as Variant, optional oOptions as variant) as object
Dim oZone as Object, oPage as object, oPosition as New com.sun.star.awt.Point
Dim oTaille as Single

if oDoc.ImplementationName = &quot;SwXTextDocument&quot; then oPage = oDoc.DrawPage
if oDoc.ImplementationName = &quot;SdXImpressDocument&quot; then oPage = oDoc.DrawPages(0)

oZone = oDoc.createInstance(&quot;com.sun.star.drawing.TextShape&quot;)
oPage.add(oZone)
oZone.String = oTexte

If IsMissing(oOptions) then oOptions = Array(8,0,50,RGB(0,0,0),0, oPolices(0))    &apos;(taille, italique,gras,couleur, cadre, police)

with oZone 
.TextAutoGrowHeight = true &apos;la hauteur de la zone s&apos;adapte au contenu du texte
.TextAutoGrowWidth = true  &apos;la largeur de la zone s&apos;adapte au contenu du texte
.LineStyle = oOptions(4) 
.CharWeight = oOptions(2)
.CharPosture = oOptions(1)
oZone.CharHeight = oOptions(0)
oZone.CharColor = oOptions(3)
oZone.CharFontName = oOptions(5)
end with

oPosition.X = oPoint.X - oZone.Size.Width/2
oPosition.Y = oPoint.Y - oZone.Size.Height
oZone.Position = oPosition

ZoneTexteDraw = oZone 
End Function

&apos;---------------------------------------------------------------------------------------
&apos; oUn = 1 pour norme = 1
&apos;--------------------------------------------------------------------------------------

Function Vecteur(oPointOrigine as New com.sun.star.awt.Point, oPointFinal as New com.sun.star.awt.Point, optional oUn as Integer) as New com.sun.star.awt.Point
Dim monVecteur as New com.sun.star.awt.Point, oNorme as double
if IsMissing(oUn) then oUn = 0
monVecteur.X = oPointFinal.X - oPointOrigine.X
monVecteur.Y = oPointFinal.Y - oPointOrigine.Y
if oUn = 1 then 
	oNorme = sqr((monVecteur.X)*(monVecteur.X) + (monVecteur.Y) * (monVecteur.Y)) 
	monVecteur.X = (monVecteur.X / oNorme) * 1000
	monVecteur.Y = (monVecteur.Y / oNorme) * 1000 
End if
Vecteur = monVecteur
End function

&apos;---------------------------------------------------------------------------------------
&apos; oUn = 1 pour norme = 1
&apos;--------------------------------------------------------------------------------------

Function VecteurOrtho(oVecteur as New com.sun.star.awt.Point, optional oUn as Integer) as New com.sun.star.awt.Point
Dim monVecteur as New com.sun.star.awt.Point, oNorme as double
if IsMissing(oUn) then oUn = 0
monVecteur.X = oVecteur.Y * (-1)
monVecteur.Y = oVecteur.X
if oUn = 1 then 
	oNorme = sqr((monVecteur.X)*(monVecteur.X) + (monVecteur.Y) * (monVecteur.Y)) 
	monVecteur.X = (monVecteur.X / oNorme) * 1000
	monVecteur.Y = (monVecteur.Y / oNorme) * 1000 
End if
VecteurOrtho = monVecteur
End function

&apos;---------------------------------------------------------------------------------------
&apos;Image d&apos;un point par une rotation
&apos;--------------------------------------------------------------------------------------

Function Rotation(oCentre as New com.sun.star.awt.Point, oAngle as double ,oPointM as New com.sun.star.awt.Point) as New com.sun.star.awt.Point
Dim oImage as New com.sun.star.awt.Point
oImage.X = (oPointM.X - oCentre.X)  * cos(-oAngle * pi/180) - (oPointM.Y - oCentre.Y) * sin(-oAngle * pi/180) + oCentre.X
oImage.Y = (oPointM.X - oCentre.X) * sin(-oAngle * pi/180) + (oPointM.Y - oCentre.Y) * cos(-oAngle * pi/180) + oCentre.Y
Rotation = oImage
End Function 

&apos;---------------------------------------------------------------------------------------
&apos;Image d&apos;un point par une Translation
&apos;--------------------------------------------------------------------------------------

Function Translation(oDepart as New com.sun.star.awt.Point, oFin as New com.sun.star.awt.Point ,oPointM as New com.sun.star.awt.Point) as New com.sun.star.awt.Point
Dim oImage as New com.sun.star.awt.Point
oImage.X = oPointM.X  + oFin.X - oDepart.X
oImage.Y = oPointM.Y  + oFin.Y - oDepart.Y
Translation = oImage
End Function 

Function TranslationKV(K as double, oVect as New com.sun.star.awt.Point ,oPointM as New com.sun.star.awt.Point) as New com.sun.star.awt.Point
Dim oImage as New com.sun.star.awt.Point
oImage.X = oPointM.X  + k * oVect.X
oImage.Y = oPointM.Y  + k * oVect.Y
TranslationKV = oImage
End Function


&apos;---------------------------------------------------------------------------------------
&apos;Image d&apos;un point par une symétrie centrale
&apos;--------------------------------------------------------------------------------------

Function SymetrieC(oCentre as New com.sun.star.awt.Point, oPointM as New com.sun.star.awt.Point) as New com.sun.star.awt.Point
Dim oImage as New com.sun.star.awt.Point
oImage.X = oPointM.X  + 2 * (oCentre.X - oPointM.X)
oImage.Y = oPointM.Y  + 2 * (oCentre.Y - oPointM.Y)
SymetrieC = oImage
End Function 


&apos;---------------------------------------------------------------------------------------
&apos;Image d&apos;un point par une symétrie axiale
&apos;--------------------------------------------------------------------------------------

Function SymetrieA(oAxe as object, oPointM as New com.sun.star.awt.Point) as New com.sun.star.awt.Point
Dim oImage as New com.sun.star.awt.Point, oA as New com.sun.star.awt.Point, oB as New com.sun.star.awt.Point
Dim oInters as New com.sun.star.awt.Point
Dim vectAB as New com.sun.star.awt.Point, VectU1 as New com.sun.star.awt.Point, VectU2 as New com.sun.star.awt.Point, oDist as double

oA = oAxe.Polygon(0)
oB = oAxe.Polygon(1)
VectAB = Vecteur(oA,oB)
VectU1 = VecteurOrtho(VectAB)
oPointN = TranslationKV(1,VectU1, oPointM)
oInters = oInters(array(oA,oB),array(oPointM,oPointN))
SymetrieA = SymetrieC(oInters,oPointM)
End Function 

&apos;-----------------------------------------------------------------------------
&apos; distance d&apos;un point à une droite en cm
&apos;------------------------------------------------------------------------------
Function DistancePtDte(oPoint as New com.sun.star.awt.Point, oDroite as object ) as double
Dim oInfo1 as variant, oDist as Double, a1 as Long, b1 as Long, c1 as Long

	oInfo1 = InfoForme(oDroite)
	a1 = oInfo1(2).Y - oInfo1(1).Y       &apos;oDroite a pour équation   a1X + b1Y + C = 0
	b1 = oInfo1(1).X - oInfo1(2).X
	c1 = -oInfo1(1).X * a1 - oInfo1(1).Y * b1

oDist = abs(a1 * oPoint.X + b1 * oPoint.Y + C1)/sqr(a1 * a1 + b1 * b1)

DistancePtDte = oDist/1000
end function


&apos;-----------------------------------------------------------------------------
&apos; distance d&apos;un point à un autre point en cm
&apos;------------------------------------------------------------------------------
Function DistancePtPt(oA as New com.sun.star.awt.Point, oB as New com.sun.star.awt.Point ) as double
Dim oDist as Double

	oDist = CLng(sqr((oB.X - oA.X)*(oB.X - oA.X) + (oB.Y - oA.Y)*(oB.Y - oA.Y)))
	DistancePtPt = oDist/1000
end function



&apos;-----------------------------------------------------------------------------
&apos; Sommet C d&apos;un triangle ABC connaissant A, B et a et b
&apos; oSegmentAB est soit un objet, soit un tableau de 2 points
&apos;------------------------------------------------------------------------------

Function CoordCdeABC(oSegmentAB as variant, aLongBC as Double, bLongAC as Double, sens as string) as New com.sun.star.awt.Point
Dim oA as New com.sun.star.awt.Point, oB as New com.sun.star.awt.Point, oC as New com.sun.star.awt.Point, oM as New com.sun.star.awt.Point
Dim cLongAB as Double, angleA as Double, cosA as Double
Dim oU1 as New com.sun.star.awt.Point

if IsArray(oSegmentAB) = false then 
	oA = oSegmentAB.Polygon(0)
	Else
	oA = oSegmentAB(0)
End if
if IsArray(oSegmentAB) = false then 
	oB = oSegmentAB.Polygon(1)
	Else
	oB = oSegmentAB(1)
End if


cLongAB = CLng(sqr((oB.X-oA.X)*(oB.X-oA.X) + (oB.Y-oA.Y)*(oB.Y-oA.Y)))/1000

			if aLongBC + bLongAC &gt; cLongAB and aLongBC + cLongAB &gt; bLongAC and bLongAC + cLongAB &gt; aLongBC then
	   		cosA = (bLongAC * bLongAC + cLongAB * cLongAB - aLongBC * aLongBC) / (2 * bLongAC * cLongAB)
	   		angleA = abs(Atn(-cosA / Sqr(-cosA * cosA + 1)) + Pi / 2) * 180 / Pi
	   		end if
	   		if aLongBC + bLongAC = cLongAB then angleA = 0 
	   		if aLongBC + cLongAB = bLongAC then angleA = 0
	   		if bLongAC + cLongAB = aLongBC then angleA = -pi
   			angleA = Iif(sens=&quot;+&quot;,angleA,-angleA)
			oM = Rotation(oA,angleA,oB)
			oU1 = Vecteur(oA,oM,1)
			oC = TranslationKV(bLongAC,oU1,oA)
			CoordCdeABC = oC
			
end function

&apos;-----------------------------------------------------------------------------
&apos; 
&apos;------------------------------------------------------------------------------

Function ExistenceTriangle(aLongBC as Double, bLongAC as Double, cLongAB as Double) as boolean

if aLongBC + bLongAC &lt; cLongAB or aLongBC + cLongAB &lt; bLongAC or bLongAC + cLongAB &lt; aLongBC then
	ExistenceTriangle = false
	Else
	ExistenceTriangle = true
End if

End Function






Function PointMilieu(oSegmentAB as variant)
Dim oA as New com.sun.star.awt.Point, oB as New com.sun.star.awt.Point, oC as New com.sun.star.awt.Point, oM as New com.sun.star.awt.Point

if IsArray(oSegmentAB) = false then 
	oA = oSegmentAB.Polygon(0)
	Else
	oA = oSegmentAB(0)
End if
if IsArray(oSegmentAB) = false then 
	oB = oSegmentAB.Polygon(1)
	Else
	oB = oSegmentAB(1)
End if
oM.X = (oA.X + oB.X)/2
oM.Y = (oA.Y + oB.Y)/2

PointMilieu = oM
End Function

&apos;----------------------------------------------------------------------------------------
&apos; oSommets12 est un côté du polygone ou un tableau de 2 points consécutifs 
&apos;---------------------------------------------------------------------------------------
Function PolygoneRegulier(oSommets12 as Variant, n as integer, sens as string) as object
Dim angCentre as Double, angBase as Double, S(n) as variant
Dim oM1 as New com.sun.star.awt.Point, oM2 as New com.sun.star.awt.Point, oCentre as New com.sun.star.awt.Point
Dim i as integer, oNvCote as object, oCollectionCotes as object


if IsArray(oSommets12) = false then 
	S(1) = oSommets12.Polygon(0)
	Else
	S(1) = oSommets12(0)
End if
if IsArray(oSommets12) = false then 
	S(2) = oSommets12.Polygon(1)
	Else
	S(2) = oSommets12(1)
End if

oCollectionCotes = createUnoService(&quot;com.sun.star.drawing.ShapeCollection&quot;)

angCentre = IIF(sens = &quot;+&quot;,360/n,-360/n)
angBase = IIF(sens = &quot;+&quot;,90*(n - 2)/n,-90*(n - 2)/n)

oM1 = Rotation(S(1), angBase, S(2))
oM2 = Rotation(S(2), -angBase, S(1))
oCentre =  CoordIntersDroites(array(S(1),oM1), array(S(2),oM2))

For i = 3 to n
S(i) = Rotation(oCentre, angCentre, S(i-1))
oNvCote = SegmentDraw(S(i-1).X,S(i-1).Y,S(i).X,S(i).Y)
oCollectionCotes.add(oNvCote)
Next
oNvCote = SegmentDraw(S(n).X,S(n).Y,S(1).X,S(1).Y)
oCollectionCotes.add(oNvCote)

PolygoneRegulier = oCollectionCotes
end function

&apos;-------------------------------------------------------------
&apos;- oOM est soit un segment tracé ou soit un tableau de 2 points 
&apos;----------------------------------------------------------------
Function AngleSegment(oOM as variant) as Double
Dim oI as New com.sun.star.awt.Point, oM as New com.sun.star.awt.Point
Dim oAngle as Double

if IsArray(oOM) = false then 
	oI = oOM.Polygon(0)
	oM = oOM.Polygon(1)
	Else
	oI = oOM(0)
	oM = oOM(1)
End if

if oM.X &lt;&gt; oI.X then
	if oM.X &gt; oI.X then oAngle = -100*atn((oM.Y - oI.Y)/(oM.X - oI.X))*180/pi
	if oM.X &lt; oI.X and oM.Y &lt; oI.Y then oAngle = -atn((oM.Y - oI.Y)/(oM.X - oI.X))*18000/pi + 18000
	if oM.X &lt; oI.X and oM.Y &gt; oI.Y then oAngle = -atn((oM.Y - oI.Y)/(oM.X - oI.X))*18000/pi - 18000
	if oM.X &lt; oI.X and oM.Y = oI.Y then oAngle = 18000
End if

if oM.X = oI.X then
	if oM.Y &lt; oI.Y then oAngle = 9000
	if oM.Y &gt; oI.Y then oAngle = -9000
End if
AngleSegment = CLng(oAngle)/100

End function


&apos;***********************************************************************
&apos;***** Elements de codage *********************************************
&apos;***** CodageElement1 donne un &quot;arc de cercle&quot; **************************
&apos;***** CodageElement2 donne une barre *****************
&apos;***** CodageElement3 donne un angle droit ***************** 
&apos;*********************************************************************

&apos;----------------------------------------------------------
&apos;oPtsAngle contient un tableau avec 3 variables points
&apos;------------------------------------------------------------

Function CodageElement1(oPtsAngle as variant, oDim as Double) as object
Dim oM1 as New com.sun.star.awt.Point, oPt1 as New com.sun.star.awt.Point, oPt2 as New com.sun.star.awt.Point, oPt3 as New com.sun.star.awt.Point
Dim oU1 as New com.sun.star.awt.Point, oU2 as New com.sun.star.awt.Point, oU3 as New com.sun.star.awt.Point 
Dim oCodage as object
Dim lesPoints(3) As New com.sun.star.awt.Point, lesInflex(3) As Long, BezCoo As New com.sun.star.drawing.PolyPolygonBezierCoords

	oU1 = Vecteur(oPtsAngle(1),oPtsAngle(0),1)
	oU2 = Vecteur(oPtsAngle(1),oPtsAngle(2),1)
	oPt1 = TranslationKV(oDim,oU1,oPtsAngle(1))
	oPt3 = TranslationKV(oDim,oU2,oPtsAngle(1))
	if oU1.X &lt;&gt; -oU2.X and oU1.Y &lt;&gt; -oU2.Y then 
		oM1 = TranslationKV(oDim,oU2,oPt1)
		Else
		oM1 = Rotation(oPtsAngle(1),90,oPt1)
	End if
	oU3 = Vecteur(oPtsAngle(1),oM1,1)
	oPt2 = TranslationKV(oDim,oU3,oPtsAngle(1))

oCodage = oDocTemp.createInstance(&quot;com.sun.star.drawing.OpenBezierShape&quot;)


lesPoints(0) = oPt1
lesInflex(0) = com.sun.star.drawing.PolygonFlags.NORMAL
lesPoints(1) = oPt2
lesPoints(2) = oPt2
lesInflex(1) = com.sun.star.drawing.PolygonFlags.CONTROL
lesInflex(2) = com.sun.star.drawing.PolygonFlags.CONTROL 
lesPoints(3) = oPt3
lesInflex(3) = com.sun.star.drawing.PolygonFlags.NORMAL 

BezCoo.Coordinates = Array(lesPoints())
BezCoo.Flags = Array(lesInflex())
oPageTemp.add(oCodage)
oCodage.LineWidth = 30
oCodage.lineColor=RGB(0,0,0)
oCodage.PolyPolygonBezier = BezCoo

CodageElement1 = oCodage

End Function


&apos;----------------------------------------------------------
&apos;oPtsAngle contient un tableau avec 3 variables points
&apos;oDist contient les distances séparant le début et la fin du trait au sommet
&apos;------------------------------------------------------------

Function CodageElement2(oPtsAngle as variant, oDist as variant) as object
Dim oM1 as New com.sun.star.awt.Point,oM0 as New com.sun.star.awt.Point
Dim oPt1 as New com.sun.star.awt.Point, oPt2 as New com.sun.star.awt.Point, oPt3 as New com.sun.star.awt.Point
Dim oU1 as New com.sun.star.awt.Point, oU2 as New com.sun.star.awt.Point, oU3 as New com.sun.star.awt.Point 
Dim oCodage as object
Dim lesPoints(2) As New com.sun.star.awt.Point, lesInflex(2) As Long, BezCoo As New com.sun.star.drawing.PolyPolygonBezierCoords


	oU1 = Vecteur(oPtsAngle(1),oPtsAngle(0),1)
	oU2 = Vecteur(oPtsAngle(1),oPtsAngle(2),1)
	oM0 = TranslationKV(1,oU1,oPtsAngle(1))
	if oU1.X &lt;&gt; -oU2.X and oU1.Y &lt;&gt; -oU2.Y then 
		oM1 = TranslationKV(1,oU2,oM0)
		Else
		oM1 = Rotation(oPtsAngle(1),90,oM0)
	End if
	
	oU3 = Vecteur(oPtsAngle(1),oM1,1)
	
	oPt1 = TranslationKV(oDist(0),oU3,oPtsAngle(1))
	oPt3 = TranslationKV(oDist(1),oU3,oPtsAngle(1))
	oPt2 = PointMilieu(Array(oPt1,oPt3))

oCodage = oDocTemp.createInstance(&quot;com.sun.star.drawing.OpenBezierShape&quot;)

lesPoints(0) = oPt1
lesInflex(0) = com.sun.star.drawing.PolygonFlags.NORMAL

lesPoints(1) = oPt2
lesInflex(1) = com.sun.star.drawing.PolygonFlags.NORMAL

lesPoints(2) = oPt3
lesInflex(2) = com.sun.star.drawing.PolygonFlags.NORMAL 


BezCoo.Coordinates = Array(lesPoints())
BezCoo.Flags = Array(lesInflex())
oPageTemp.add(oCodage)
oCodage.LineWidth = 30
oCodage.lineColor=RGB(0,0,0)
oCodage.PolyPolygonBezier = BezCoo

CodageElement2 = oCodage

End Function


&apos;----------------------------------------------------------
&apos;oPtsAngle contient un tableau avec 3 variables points
&apos;oDist contient les distances séparant le début et la fin du trait au sommet
&apos;------------------------------------------------------------

Function CodageElement3(oPtsAngle as variant, oDist as Double) as object
Dim oM1 as New com.sun.star.awt.Point, oPt1 as New com.sun.star.awt.Point, oPt2 as New com.sun.star.awt.Point, oPt3 as New com.sun.star.awt.Point
Dim oU1 as New com.sun.star.awt.Point, oU2 as New com.sun.star.awt.Point, oU3 as New com.sun.star.awt.Point 
Dim oCodage as object
Dim lesPoints(2) As New com.sun.star.awt.Point, lesInflex(2) As Long, BezCoo As New com.sun.star.drawing.PolyPolygonBezierCoords


	oU1 = Vecteur(oPtsAngle(1),oPtsAngle(0),1)
	oU2 = Vecteur(oPtsAngle(1),oPtsAngle(2),1)
	oPt1 = TranslationKV(oDist,oU1,oPtsAngle(1))
	oPt3 = TranslationKV(oDist,oU2,oPtsAngle(1))
	oPt2 = TranslationKV(oDist,oU2,oPt1)

oCodage = oDocTemp.createInstance(&quot;com.sun.star.drawing.OpenBezierShape&quot;)

lesPoints(0) = oPt1
lesInflex(0) = com.sun.star.drawing.PolygonFlags.NORMAL
lesPoints(1) = oPt2
lesInflex(1) = com.sun.star.drawing.PolygonFlags.NORMAL 
lesPoints(2) = oPt3
lesInflex(2) = com.sun.star.drawing.PolygonFlags.NORMAL 

BezCoo.Coordinates = Array(lesPoints())
BezCoo.Flags = Array(lesInflex())
oPageTemp.add(oCodage)
oCodage.LineWidth = 30
oCodage.lineColor=RGB(0,0,0)
oCodage.PolyPolygonBezier = BezCoo

CodageElement3 = oCodage

End Function


&apos;----------------------------------------------------------
&apos;oPtsAngle contient un tableau avec 3 variables points
&apos;oDist contient les distances séparant le début et la fin du trait au sommet
&apos;------------------------------------------------------------

Function CodageSegment(oSegment as variant, oDist as Double, oType as Long, optional oDeltaMilieu as Double) as object
Dim oM1 as New com.sun.star.awt.Point, oPt1 as New com.sun.star.awt.Point, oPt2 as New com.sun.star.awt.Point
Dim  oPt3 as New com.sun.star.awt.Point, oPt4 as New com.sun.star.awt.Point
Dim oU1 as New com.sun.star.awt.Point, oU2 as New com.sun.star.awt.Point, oU3 as New com.sun.star.awt.Point 
Dim oCodage as object, oInfo as variant
Dim lesPoints(3) As New com.sun.star.awt.Point, lesInflex(3) As Long, BezCoo As New com.sun.star.drawing.PolyPolygonBezierCoords

If IsMissing(oDeltaMilieu) then oDeltaMilieu = 0

oInfo = InfoForme(oSegment)
oM1 = PointMilieu(oSegment)

oU1 = Vecteur(oInfo(1),oInfo(2),1)
oU2 = VecteurOrtho(oU1,1)
oM1 = TranslationKV(oDeltaMilieu,oU1,oM1)

oCodage = oDocTemp.createInstance(&quot;com.sun.star.drawing.OpenBezierShape&quot;)


oPt1 = TranslationKV(oDist/2,oU2,oM1)
oPt2 = TranslationKV(-oDist/2,oU2,oM1)
oPt1 = Rotation(oM1,-30,oPt1)
oPt2 = Rotation(oM1,-30,oPt2)

if oType = 1 then 
oPt1 = TranslationKV(oDist/2,oU2,oM1)
oPt2 = TranslationKV(-oDist/2,oU2,oM1)
oPt1 = Rotation(oM1,-30,oPt1)
oPt2 = Rotation(oM1,-30,oPt2)
lesPoints(0) = oPt1
lesInflex(0) = com.sun.star.drawing.PolygonFlags.NORMAL
lesPoints(1) = oM1
lesInflex(1) = com.sun.star.drawing.PolygonFlags.NORMAL 
lesPoints(2) = oM1
lesInflex(2) = com.sun.star.drawing.PolygonFlags.NORMAL 
lesPoints(3) = oPt2
lesInflex(3) = com.sun.star.drawing.PolygonFlags.NORMAL
End if
if oType = 2 then 
oPt1 = TranslationKV(oDist/2,oU2,oM1)
oPt3 = TranslationKV(-oDist/2,oU2,oM1)
oPt2 = Rotation(oM1,-30,oPt1)
oPt1 = Rotation(oM1,30,oPt1)
lesPoints(0) = oPt1
lesInflex(0) = com.sun.star.drawing.PolygonFlags.NORMAL
lesPoints(1) = oPt3
lesInflex(1) = com.sun.star.drawing.PolygonFlags.NORMAL 
lesPoints(2) = oPt3
lesInflex(2) = com.sun.star.drawing.PolygonFlags.NORMAL 
lesPoints(3) = oPt2
lesInflex(3) = com.sun.star.drawing.PolygonFlags.NORMAL
End if

if oType = 3 then 
oPt1 = TranslationKV(oDist/2,oU2,oM1)
oPt2 = TranslationKV(-oDist/2,oU2,oM1)
oPt1 = Rotation(oM1,30,oPt1)
oPt2 = Rotation(oM1,-30,oPt2)
lesPoints(0) = oPt1
lesInflex(0) = com.sun.star.drawing.PolygonFlags.NORMAL
lesPoints(1) = oM1
lesInflex(1) = com.sun.star.drawing.PolygonFlags.NORMAL 
lesPoints(2) = oM1
lesInflex(2) = com.sun.star.drawing.PolygonFlags.NORMAL 
lesPoints(3) = oPt2
lesInflex(3) = com.sun.star.drawing.PolygonFlags.NORMAL
End if
if oType = 4 then 
oPt1 = TranslationKV(-oDist/2,oU2,oM1)
oPt2 = TranslationKV(oDist/2,oU2,oM1)
oPt4 = Rotation(oM1,30,oPt1)
oPt1 = Rotation(oM1,-30,oPt1)
oPt3 = Rotation(oM1,30,oPt2)
oPt2 = Rotation(oM1,-30,oPt2)
lesPoints(0) = oPt1
lesInflex(0) = com.sun.star.drawing.PolygonFlags.NORMAL
lesPoints(1) = oPt2
lesInflex(1) = com.sun.star.drawing.PolygonFlags.NORMAL 
lesPoints(2) = oPt3
lesInflex(2) = com.sun.star.drawing.PolygonFlags.NORMAL 
lesPoints(3) = oPt4
lesInflex(3) = com.sun.star.drawing.PolygonFlags.NORMAL
End if



BezCoo.Coordinates = Array(lesPoints())
BezCoo.Flags = Array(lesInflex())
oPageTemp.add(oCodage)
oCodage.LineWidth = 30
oCodage.lineColor=RGB(0,0,0)
oCodage.PolyPolygonBezier = BezCoo

CodageSegment = oCodage

End Function

&apos;Positionne l&apos;objet à l&apos;endroit voulu sur la page
&apos;oPosition est soit une variable point soit un tableau à 2 dimension

sub PositionObjet(dessin as object, optional oPosition as variant) 
Dim oP As New com.sun.star.awt.Point
Dim olargeur as double, ohauteur as double

olargeur = dessin.Size.Width
oHauteur = dessin.Size.Height

if IsMissing(oPosition) then oPosition = Array(1000,(29700 - ohauteur)/2)

if IsArray(oPosition) = false then 
	oP.X = oPosition.X
	oP.Y = oPosition.Y
	Else
	oP.X = oPosition(0)
	oP.Y = oPosition(1)
End if

dessin.Position = oP

end sub

</script:module>