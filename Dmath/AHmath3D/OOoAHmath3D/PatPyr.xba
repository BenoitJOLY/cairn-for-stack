REM  *****  BASIC  *****

option explicit


Sub PatPyrMacroPrincipale

appelerBoiteDialoguePatPyr()
if oReponseDlg(10) = true then
Deselection
DRAWversDocActif(&quot;PatPyr.ConstructionPatPyr()&quot;)
oSolide = LastForme
TailleObjetFinal(oSolide)
PosObjetFinal(oSolide)
end if
End Sub


Sub appelerBoiteDialoguePatPyr()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;PatPyrDlg&quot;)
PositionDlg(monDlg,120,150)		
&apos;------------------------initialisation de la boite de dialogue-----------------------
Initialisation_Unites(2,0)	
Initialisation(monDlg,CheminDessin(&quot;Dessins/PatPyr/PatPyr1.gif/&quot;),)
AffecterImageFixe(monDlg, &quot;ImageSecondaire1&quot; , CheminDessin(&quot;Dessins/PatPyr/PatPyr2.gif/&quot;))
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs et des infobulles ------
for i = 1 to 3
oReponseDlg(i + 10) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	

monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub

&apos;---------------------------------------------------------------------------------------
&apos;fonction coordonnées polygone régulier
&apos;----------------------------------------------------------------------------------------
function Coordpolygone(Xa as double, Ya as double,n as Double,PosPolygone as string )
Dim R as double, Angle1 as double, Lg as double,Xcentre as double, Ycentre as double, i as integer
Dim mesabscisses(n-1) as variant, mesordonnees(n-1) as variant
 
    if oReponseDlg(3) = true then
       Lg = oReponseDlg(1)*1000
       R = Lg/(2*sin(pi/n))
    end if
  
    if oReponseDlg(4) = true then
       R = oReponseDlg(1)*1000
       Lg = 2*R*sin(pi/n)
    end if
    Xcentre = Xa + Lg/2 
    if PosPolygone = &quot;haut&quot; then
          Ycentre = Ya - R*cos(pi/n)
    else
          Ycentre = Ya + R*cos(pi/n)
    end if

Angle1 = pi - Atn((Ya-Ycentre)/(Lg/2))

for i = 0 to n-1
mesabscisses(i) = Xcentre + R*cos(i*2*pi/n - Angle1)
mesordonnees(i) = Ycentre - R*Sin(i*2*pi/n - Angle1)
next
CoordPolygone = Tableau2xN(mesabscisses, mesordonnees)
end function


&apos;---------------------------------------------------------------------------------------
&apos; fonction qui renvoie les coordonnées du sommet principal dans un patron étoilé
&apos;---------------------------------------------------------------------------------------
function CoordSommetPrinc(Xa as double, Ya as double,n as Double,PosPolygone as string)
Dim R as double, h as double, Lg as double,Xcentre as double, Ycentre as double, i as integer
Dim mesabscisses(n-1) as variant, mesordonnees(n-1) as variant

    if oReponseDlg(3) = true then
       Lg = oReponseDlg(1)*1000
       R = Lg/(2*sin(pi/n))
    end if
    if oReponseDlg(4) = true then
       R = oReponseDlg(1)*1000
       Lg = 2*R*sin(pi/n)
    end if
    Xcentre = Xa + Lg/2 
    if PosPolygone = &quot;haut&quot; then
          Ycentre = Ya - R*cos(pi/n)
    else
          Ycentre = Ya + R*cos(pi/n)
    end if

    h = oReponseDlg(2)*1000


for i = 0 to n-1
mesabscisses(i) = Xcentre + (R*cos(pi/n) + sqr(PuisN(R*cos(pi/n),2)+PuisN(h,2)))*sin(i*2*pi/n )
mesordonnees(i) = Ycentre + (R*cos(pi/n) + sqr(PuisN(R*cos(pi/n),2)+PuisN(h,2)))*cos(i*2*pi/n )
next
CoordSommetPrinc = Tableau2xN(mesabscisses, mesordonnees)

end function


&apos;---------------------------------------------------------------------------------------
&apos; fonction qui renvoie les coordonnées des sommets de la base de la partie du patron
&apos; représentant les faces latérales  dans un patron compact
&apos;---------------------------------------------------------------------------------------
function CoordSommetFaceLat(Xa as double, Ya as double,n as Double,PosPolygone as string)
Dim R as double, h as double, Lg as double,Xcentre as double, Ycentre as double, i as integer, Angle1 as double, Angle2 as double
Dim Xsommetprinc as double, Ysommetprinc as double, Longal as double
Dim mesabscisses(n+1) as variant, mesordonnees(n+1) as variant

    if oReponseDlg(3) = true then
       Lg = oReponseDlg(1)*1000
       R = Lg/(2*sin(pi/n))
    end if
    if oReponseDlg(4) = true then
       R = oReponseDlg(1)*1000
       Lg = 2*R*sin(pi/n)
    end if
    Xcentre = Xa + Lg/2 
    if PosPolygone = &quot;haut&quot; then
          Ycentre = Ya - R*cos(pi/n)
    else
          Ycentre = Ya + R*cos(pi/n)
    end if

    h = oReponseDlg(2)*1000
    Angle1 = pi - Atn((Ya-Ycentre)/(Lg/2))
    Xsommetprinc = Xcentre
    Ysommetprinc = Ycentre + (R*cos(pi/n) + sqr(PuisN(R*cos(pi/n),2)+PuisN(h,2)))
    Longal = sqr(PuisN(R,2)+PuisN(h,2)) &apos; Longueur des aretes latérales
    Angle2 = Atn((Lg/2)/sqr(PuisN(R*cos(pi/n),2)+PuisN(h,2)))


for i = 0 to n
mesabscisses(i) = Xsommetprinc + Longal*cos(i*2*Angle2 - 5*Angle2+pi/2)
mesordonnees(i) = Ysommetprinc - Longal*Sin(i*2*Angle2 - 5*Angle2+pi/2)
&apos;rem : le 5* permet de décaler de 2 triangles
&apos;n sommets (de 0 à n-1),le 1er sommet, le sommet principal 
next
mesabscisses(n+1) = Xsommetprinc  &apos;abscisse du sommet principal
mesordonnees(n+1) = Ysommetprinc  &apos; ordonnée du sommet principal

CoordSommetFaceLat = Tableau2xN(mesabscisses, mesordonnees)

end function




&apos;---------------------------------------------------------------------------------------
&apos;Construction du patron suivant les réponses du dialogue
&apos;Macro qui est lancé dans DRAWversDocActif()
&apos;----------------------------------------------------------------------------------------

sub ConstructionPatPyr()
Dim h as double, n as double, i as integer
Dim Poly1 as variant, Xpoly1 as variant, Ypoly1 as variant, Poly2 as variant, Xpoly2 as variant, Ypoly2 as variant

  n = oReponseDlg(0)
  h = oReponseDlg(2)*1000
 

&apos; tracé du polygone de base
     Poly1 = CoordPolygone(10000,10000,n,&quot;haut&quot;)
     Xpoly1 = Lignex(1,Poly1)
     Ypoly1 = Lignex(2,Poly1)
     polygoneNcotesDraw(Xpoly1,Ypoly1)
     
&apos;tracé des faces latérales compactes 
    
if oReponseDlg(7) = true then  
     Poly2 = CoordSommetFaceLat(10000,10000,n,&quot;haut&quot;) 
     Xpoly2 = Lignex(1,Poly2)
     Ypoly2 = Lignex(2,Poly2)
     &apos;polygoneNcotesDraw(Xpoly2,Ypoly2) polygone obtenu en reliant le lieu des sommets
     for i = 0 to n-1
     TriangleDraw(Xpoly2(i),Ypoly2(i),Xpoly2(i+1),Ypoly2(i+1),Xpoly2(n+1),Ypoly2(n+1))
     next

  if oReponseDlg(5)= true then &apos;bandes de collage
  
  for i = 1 to n-2
  LanguetteDraw(Xpoly1(i),Ypoly1(i),Xpoly1(i+1),Ypoly1(i+1),&quot;gauche&quot;)
  next
   LanguetteDraw(Xpoly1(n-1),Ypoly1(n-1),Xpoly1(0),Ypoly1(0),&quot;gauche&quot;)
   LanguetteDraw(Xpoly2(n+1),Ypoly2(n+1),Xpoly2(0),Ypoly2(0),&quot;gauche&quot;)

  
  end if
 end if 
  
&apos; tracé des faces latérales éclatées  
  if oReponseDlg(8) = true then  

     Poly2 = CoordSommetPrinc(10000,10000,n,&quot;haut&quot;) 
     Xpoly2 = Lignex(1,Poly2)
     Ypoly2 = Lignex(2,Poly2)
     &apos;polygoneNcotesDraw(Xpoly2,Ypoly2) polygone obtenu en reliant le lieu des sommets
     for i = 0 to n-2
     TriangleDraw(Xpoly1(i),Ypoly1(i),Xpoly1(i+1),Ypoly1(i+1),Xpoly2(i),Ypoly2(i))
     next
     TriangleDraw(Xpoly1(n-1),Ypoly1(n-1),Xpoly1(0),Ypoly1(0),Xpoly2(n-1),Ypoly2(n-1))

  if oReponseDlg(5)= true then &apos;bandes de collage
  
  for i = 0 to n-1
  LanguetteDraw(Xpoly1(i),Ypoly1(i),Xpoly2(i),Ypoly2(i),&quot;gauche&quot;)
  next
  
  end if
  
end if



end sub

&apos;****************************************************Gestion de la boite de dialogue*****************************************************************

Sub GestionInfoBulle
TexteAide(monDlg,&quot;RepPatPyr1&quot;, &quot;3 &lt;= ... &lt;= 50&quot;)
TexteAide(monDlg,&quot;RepPatPyr2&quot;, &quot;0 &lt; ... &lt;= 10&quot;)
TexteAide(monDlg,&quot;RepPatPyr3&quot;, &quot;0 &lt;= ... &lt;= 20&quot;)
end sub


sub GestionBoutonOK  
Dim i as integer, test(3) as integer

&apos;-----------------------Gestion des erreurs de saisie
test(1) = ZT_Nbre(monDlg,  &quot;RepPatPyr1&quot;, 3 , 50 , 5 , oReponseDlg(11),true)
test(2) = ZT_Nbre(monDlg,  &quot;RepPatPyr2&quot;, 0.001 , 10 , 3 ,  oReponseDlg(12),) 
test(3) = ZT_Nbre(monDlg,  &quot;RepPatPyr3&quot;, 0.001 , 20 , 5 ,  oReponseDlg(13),)  &apos; 0 ou 1
     
test(0) = test(1)*test(2)*test(3)&apos;----- (test(0) contient 1 si tout est ok 0 sinon)

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
 
    for i = 1 to 3
    oReponseDlg(i - 1) = CDbl(monDlg.getControl(&quot;RepPatPyr&quot;&amp;i).Peer.Text)  
    Next
    for i = 4 to 9
    oReponseDlg(i - 1) = monDlg.getControl(&quot;RepPatPyr&quot;&amp;i).state 
    next
          
    oReponseDlg(10) = true  
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé

&apos;---------------------    oReponseDlg(10) = true quand tout est validé
    monDlg.endExecute
end if

End Sub

&apos;----------------------------------------------------------------------------
&apos;gestion des unités Cm/Inch
&apos;-------------------------------------------------------------------------

sub OptionUnite_click
OptionUnite(2,0)
end sub


</script:module>