sub IncrementerElement(k as integer)
Dim PointZorder2 as integer
    &apos;k = 1 pour suivant     k = -1 pour précédent
    &apos;K = 2 pour dernier     k = -2 pour premier

SupprimePoints_AB
SupprimeDroiteVerte
nElements = oPageTemp.count

oPageTemp (eZorder).Linewidth = sEpaisseur
oPageTemp(eZorder).LineColor = sCouleur

if oPageTemp(eZorder).Name = &quot;ah2D_point&quot; then PointZorder2 = OrdreElement2(eZorder) else PointZorder2 = -1   &apos;-1 pour aucun

if k = 1 then 
    eZorder = (eZorder + 1) MOD nElements
    if eZorder = PointZorder2 then eZorder = (eZorder + 1) MOD nElements      &apos; pour eviter la 2ème branche d&apos;un point
end if

if k = 2 then eZorder = nElements - 1

if k = -1 then
    eZorder = (eZorder + nElements - 1) MOD nElements
    if eZorder = PointZorder2 then eZorder = (eZorder + nElements - 1) MOD nElements
end if

if k = -2 then eZorder = 0



   oTypeElement = TypeForme(oPageTemp(eZorder))
   if oTypeElement = &quot;Ligne&quot; then InfoSegment(eZorder,oPageTemp)
   if oTypeElement = &quot;Cercle&quot; then InfoCercle(eZorder,oPageTemp)
   if oTypeElement &lt;&gt; &quot;Ligne&quot; and oTypeElement &lt;&gt; &quot;Cercle&quot; then
       sLong = 0
       sAngle = 0
    end if
    if oTypeElement = &quot;Ligne&quot; and oPageTemp(eZorder).Name = &quot;ah2D_point&quot; then
       sLong = 0
       sAngle = 0
    end if
        
    sEpaisseur = oPageTemp(eZorder).LineWidth
    sCouleur = oPageTemp(eZorder).LineColor
    oPageTemp(eZorder).LineWidth = sEpaisseur + 100
    oPageTemp(eZorder).LineColor = RGB(0,0,255)
    monDlg.getControl(&quot;info1&quot;).Text = sLong
    monDlg.getControl(&quot;info2&quot;).Text = sAngle
    if oTypeElement = &quot;Ligne&quot; then monDlg.getControl(&quot;Label2&quot;).Text = oReponseDlg(84)   else   monDlg.getControl(&quot;Label2&quot;).Text = oReponseDlg(85)
    AffichageApercu

end sub



sub ElementSuivant
IncrementerElement(1)
IgnorerFormeInconnue(1)
AffichageFenetreAction
GestionOption
end sub

sub ElementPrecedent
IncrementerElement(-1)
IgnorerFormeInconnue(-1)
AffichageFenetreAction
GestionOption
end sub

sub IgnorerFormeInconnue(k as integer)  &apos;lors de la navigation   k = 1 ou k = -1
Dim oTypeForme as string, nbre as integer, compteurforme as integer

if monDlg.GetControl(&quot;CheckBox1&quot;).Model.State = 1 then      &apos;Ignorer les formes inconnues dans la naigation
  nbre = oPageTemp.count
  compteurforme = 0
  oTypeForme = TypeForme (oPageTemp(eZorder))

  While oTypeForme &lt;&gt; &quot;Cercle&quot; and oTypeForme &lt;&gt; &quot;Ligne&quot; and compteurforme &lt;&gt; nbre
  IncrementerElement(k)
  oTypeForme = TypeForme (oPageTemp(eZorder))
  compteurforme = compteurforme + 1
  Wend
end if
end sub


