AffecterImageFixe(monDlg, &quot;CommandButton21&quot; , CheminDessin(&quot;Dessins/ah2D/pointB_d.png/&quot;) )
AffecterImageFixe(monDlg, &quot;CommandButton60&quot; , CheminDessin(&quot;Dessins/ah2D/paraperp25.png/&quot;) )
AffecterImageFixe(monDlg, &quot;CommandButton22&quot; , CheminDessin(&quot;Dessins/ah2D/rechercherPoint30.png/&quot;) )
AffecterImageFixe(monDlg, &quot;CommandButton23&quot; , CheminDessin(&quot;Dessins/ah2D/annulepoint30.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl14&quot; , CheminDessin(&quot;Dessins/ah2D/rectdanscercle.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl2&quot; , CheminDessin(&quot;Dessins/ah2D/sens.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl3&quot; , CheminDessin(&quot;Dessins/ah2D/angle.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl9&quot; , CheminDessin(&quot;Dessins/ah2D/angle.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl10&quot; , CheminDessin(&quot;Dessins/ah2D/angle.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl11&quot; , CheminDessin(&quot;Dessins/ah2D/angle.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl12&quot; , CheminDessin(&quot;Dessins/ah2D/angle.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl13&quot; , CheminDessin(&quot;Dessins/ah2D/choixangle.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl17&quot; , CheminDessin(&quot;Dessins/ah2D/choixangle.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl4&quot; , CheminDessin(&quot;Dessins/ah2D/senstriangle.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl5&quot; , CheminDessin(&quot;Dessins/ah2D/rectangle.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl6&quot; , CheminDessin(&quot;Dessins/ah2D/point.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl8&quot; , CheminDessin(&quot;Dessins/ah2D/polygone.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl7&quot; , CheminDessin(&quot;Dessins/ah2D/codagesegment.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl15&quot; , CheminDessin(&quot;Dessins/ah2D/codagemilieu.png/&quot;) )
AffecterImageFixe(monDlg, &quot;ImageControl16&quot; , CheminDessin(&quot;Dessins/ah2D/codagemilieu.png/&quot;) )
Initialisation(monDlg)
initialiseZoom
intersZorder(0) = -1   &apos;initialisation    -1 pour aucune selection
intersZorder(1) = -1
repererPoint


if SelectionOK = 0 then
monDlg.Model.step = 19
ah2DStep = 19
sLong = 0
sAngle = 0
InitialiseAucuneSelection(false)
msgbox(oReponseDlg(93), 0+64,&quot;AHmath3D&quot;)
end if

if SelectionOK = 1 then
numBoutonmenu = 50
AffichageFenetreAction
AffichageApercu
end if


monDlg.getControl(&quot;info1&quot;).Text = sLong
monDlg.getControl(&quot;info2&quot;).Text = sAngle

initialisation_Unites(22,11,true)


while monDlg.Model.Tag &lt;&gt; &quot;fin&quot; 

monDlg.execute


if ah2DStep = 1 or  ah2DStep = 7 then Pointah2D
if ah2DStep = 2 or ah2DStep = 8 or ah2DStep = 15 then Segmentah2D
if ah2DStep = 3 then Triangleah2D
if ah2DStep = 4 or ah2DStep = 10 then Rectangleah2D
if ah2DStep = 5 or ah2DStep = 11 then Polygoneah2D
if ah2DStep = 6 or ah2DStep = 12 or ah2DStep = 14  then Cercleah2D
if ah2DStep = 9 then SupprimerElement_click
if ah2DStep = 13 then Segmentah2D
if ah2DStep = 16 then Intersectionah2D
if ah2DStep = 18 then ParaPerpah2D
if ah2DStep = 19 then Element0ah2D
if ah2DStep = 20 then CodageSegmentah2D
if ah2DStep = 22 then CodageAngleah2D
if ah2DStep = 23 then Mediatriceah2D
if ah2DStep = 24 then Bissectriceah2D
if ah2DStep &lt; 30 then  &apos;fin de la macro &gt; ah2Dstep = 30  annuler &gt; ah2Dstep = 31
             repererPoint
             AffichageFenetreAction
end if
wend

if ah2DStep = 30 then  &apos;valide les modifs et termine

GestionPointilles

if oPageTemp.count&lt;&gt; 0 then
   SelectionFormes(0,oDocTemp)
   DispatchSimple(&quot;Copy&quot;, oDocTemp.CurrentController.Frame)
   oDocTemp.Close(true)
   wait(200)
   DispatchSimple(&quot;Delete&quot;, oDocActif.CurrentController.Frame)
   wait(200)
   DispatchSimple(&quot;Paste&quot;, oDocActif.CurrentController.Frame)
   oDocActif.CurrentSelection(0).Position = PositionSelection         REM: Repositionne le dessin sur la page active
   else
   oDocTemp.Close(true)
end if

end if

if ah2DStep = 31 then oDocTemp.Close(true) &apos;annule les modifs et termine


monDlg.dispose

end sub


sub PremierLancement
Dim ElementTrouve as boolean, message as string
message = &quot;No element found&quot; &amp; chr(13) &amp;_
          &quot;The first shape must contain a line or a circle&quot; 

nElements = oPageTemp.count
ElementTrouve = false
eZorder = 0

While ElementTrouve = false and eZorder &lt; nElements
oTypeElement = TypeForme(oPageTemp(eZorder))
if oTypeElement = &quot;Cercle&quot; or oTypeElement = &quot;Ligne&quot; then ElementTrouve = true
if oTypeElement &lt;&gt; &quot;Cercle&quot; and oTypeElement &lt;&gt; &quot;Ligne&quot; then eZorder = eZorder + 1
wend

if ElementTrouve = false then
msgbox(message, 0, &quot;AHmath3D&quot;)
oTypeElement = &quot;Aucun&quot;
end if

end sub


&apos;*********************************************************************************************************
&apos;*********************************************************************************************************
&apos;**********************************       CONSTRUCTIONS        *******************************************
&apos;*********************************************************************************************************
&apos;*********************************************************************************************************
&apos;*********************************************************************************************************

sub Pointah2D
Dim a as double, b as double, c as double, cosA as double, AngleA as double
Dim xc as double, yc as double, sxc as double, syc as double

if ah2DStep = 1 then

   if oReponseDlg(4) = 0 then
   sxc = (sx0 + sx1)/2
   syc = (sy0 + sy1)/2
   SegmentDraw(sxc - 100, syc - 100, sxc + 100 , syc + 100 , 30, &quot;plein&quot;)
   SegmentDraw(sxc - 100, syc + 100, sxc + 100 , syc - 100 , 30, &quot;plein&quot;)
   nElements = oPageTemp.Count
   oPageTemp(nElements - 1).RotateAngle = oPageTemp(nElements - 1).RotateAngle + sAngle * 100
   oPageTemp(nElements - 2).RotateAngle = oPageTemp(nElements - 2).RotateAngle + sAngle * 100
   oPageTemp(nElements - 1).Name =&quot;ah2D_point&quot;
   oPageTemp(nElements - 2).Name =&quot;ah2D_point&quot;
   nAjout = 2
   codageMilieu(eZorder, oReponseDlg(8))
   end if
   
   
   if oReponseDlg(4) = 1 then
   b = oReponseDlg(5)*1000
   sxc = sx0 + b * cos(sAngle * pi/180)
   syc = sy0 - b * sin(sAngle * pi/180)
   SegmentDraw(sxc - 100, syc - 100, sxc + 100 , syc + 100 , 30, &quot;plein&quot;)
   SegmentDraw(sxc - 100, syc + 100, sxc + 100 , syc - 100 , 30, &quot;plein&quot;)
   nElements = oPageTemp.Count
   oPageTemp(nElements - 1).RotateAngle = oPageTemp(nElements - 1).RotateAngle + sAngle * 100
   oPageTemp(nElements - 2).RotateAngle = oPageTemp(nElements - 2).RotateAngle + sAngle * 100
   nAjout = 2
   end if
   
   if oReponseDlg(4) = 2 then
   b = oReponseDlg(5)
   sxc = sx0 + b * (sx1 - sx0)
   syc = sy0 + b * (sy1 - sy0)
   SegmentDraw(sxc - 100, syc - 100, sxc + 100 , syc + 100 , 30, &quot;plein&quot;)
   SegmentDraw(sxc - 100, syc + 100, sxc + 100 , syc - 100 , 30, &quot;plein&quot;)
   nElements = oPageTemp.Count
   oPageTemp(nElements - 1).RotateAngle = oPageTemp(nElements - 1).RotateAngle + sAngle * 100
   oPageTemp(nElements - 2).RotateAngle = oPageTemp(nElements - 2).RotateAngle + sAngle * 100
   nAjout = 2
   end if

   if oReponseDlg(4) = 3 then
    b = oReponseDlg(5)*1000
    a = oReponseDlg(6)*1000
    c = sLong*1000
   
   if a + b &gt; c and a + c &gt; b and b + c &gt; a then
   cosA = (b * b + c * c - a * a) / (2 * b * c)
   angleA = Atn(-cosA / Sqr(-cosA * cosA + 1)) + Pi / 2
   end if
   if a + b = c then angleA = 0 
   if a + c = b then angleA = 0
   if b + c = a then angleA = -pi
   
   if a + b &gt;= c and a + c &gt;= b and b + c &gt;= a then
   xc =  b * Cos(angleA)
   yc =  b * Sin(angleA)
   if oReponseDlg(7) = true then
   sxc = sx0 + xc*cos(sAngle*pi/180) - yc*sin(sAngle*pi/180)
   syc = sy0 - (xc*sin(sAngle*pi/180) + yc*cos(sAngle*pi/180))
   else
   sxc = sx0 + xc*cos(-sAngle*pi/180) - yc*sin(-sAngle*pi/180)
   syc = sy0 + (xc*sin(-sAngle*pi/180) + yc*cos(-sAngle*pi/180))
   end if

   SegmentDraw(sxc - 100, syc - 100, sxc + 100 , syc + 100 , 30, &quot;plein&quot;)
   SegmentDraw(sxc - 100, syc + 100, sxc + 100 , syc - 100 , 30, &quot;plein&quot;)
   nAjout = 2
   else
   msgbox(oReponseDlg(83), 0, &quot;AHmath3D&quot;)
   end if
   end if
   
   
end if

if ah2DStep = 7 then
   if oReponseDlg(5) = 0 then
   SegmentDraw(sx0 - 100, sy0 - 100, sx0 + 100 , sy0 + 100 , 30, &quot;plein&quot;)
   SegmentDraw(sx0 - 100, sy0 + 100, sx0 + 100 , sy0 - 100 , 30, &quot;plein&quot;)
   end if
    if oReponseDlg(5) = 1 then
    sxc = sx0 + sLong/2 * 1000 * cos(oReponseDlg(6) * pi/180) 
    syc = sy0 - sLong/2 * 1000 * sin(oReponseDlg(6) * pi/180) 
   SegmentDraw(sxc - 100, syc - 100, sxc + 100 , syc + 100 , 30, &quot;plein&quot;)
   SegmentDraw(sxc - 100, syc + 100, sxc + 100 , syc - 100 , 30, &quot;plein&quot;)
   nElements = oPageTemp.count
   a = oPageTemp(nElements-2).RotateAngle
   b = oPageTemp(nElements-1).RotateAngle
   oPageTemp(nElements-2).RotateAngle = a + oReponseDlg(6) * 100  
   oPageTemp(nElements-1).RotateAngle = b + oReponseDlg(6) * 100
   end if
   nAjout = 2
end if

 if nAjout = 2 then
    nElements = oPageTemp.count
    oPageTemp(nElements-1).Name = &quot;ah2D_point&quot;
    oPageTemp(nElements-2).Name = &quot;ah2D_point&quot;
  end if

end sub

sub Triangleah2D
Dim a as double, b as double, c as double, cosA as double, AngleA as double
Dim xc as double, yc as double, sxc as double, syc as double

if oReponseDlg(10) = 1 then  &apos;choix1 
   b = oReponseDlg(7)*1000
   a = oReponseDlg(8)*1000
   c = sLong*1000
   cosA = (b * b + c * c - a * a) / (2 * b * c)
   angleA = Atn(-cosA / Sqr(-cosA * cosA + 1)) + Pi / 2
   xc =  b * Cos(angleA)
   yc =  b * Sin(angleA)
   
   if oReponseDlg(9) = true then
   sxc = sx0 + xc*cos(sAngle*pi/180) - yc*sin(sAngle*pi/180)
   syc = sy0 - (xc*sin(sAngle*pi/180) + yc*cos(sAngle*pi/180))
   else
   sxc = sx0 + xc*cos(-sAngle*pi/180) - yc*sin(-sAngle*pi/180)
   syc = sy0 + (xc*sin(-sAngle*pi/180) + yc*cos(-sAngle*pi/180))
   end if
   SegmentDraw(sx0, sy0, sxc , syc , 30, &quot;plein&quot;)
   SegmentDraw(sx1, sy1, sxc , syc , 30, &quot;plein&quot;)
end if
if oReponseDlg(10) = 2 then  &apos;choix2
   if oReponseDlg(9) = true then
   SegmentDraw(sx0, sy0, sx0 +  oReponseDlg(7)*1000*cos((sAngle+  oReponseDlg(8))*pi/180), sy0 -  oReponseDlg(7)*1000*sin((sAngle +  oReponseDlg(8))*pi/180), 30, &quot;plein&quot;)
   SegmentDraw(sx1, sy1, sx0 +  oReponseDlg(7)*1000*cos((sAngle+  oReponseDlg(8))*pi/180), sy0 -  oReponseDlg(7)*1000*sin((sAngle +  oReponseDlg(8))*pi/180), 30, &quot;plein&quot;)
   else
   SegmentDraw(sx0, sy0, sx0 +  oReponseDlg(7)*1000*cos((-sAngle+  oReponseDlg(8))*pi/180), sy0 +  oReponseDlg(7)*1000*sin((-sAngle +  oReponseDlg(8))*pi/180), 30, &quot;plein&quot;)
   SegmentDraw(sx1, sy1, sx0 +  oReponseDlg(7)*1000*cos((-sAngle+  oReponseDlg(8))*pi/180), sy0 +  oReponseDlg(7)*1000*sin((-sAngle +  oReponseDlg(8))*pi/180), 30, &quot;plein&quot;)
   end if
end if
if oReponseDlg(10) = 3 then  &apos;choix3
   if oReponseDlg(9) = true then
   SegmentDraw(sx1, sy1, sx1 -  oReponseDlg(7)*1000*cos((-sAngle+  oReponseDlg(8))*pi/180), sy1 -  oReponseDlg(7)*1000*sin((-sAngle +  oReponseDlg(8))*pi/180), 30, &quot;plein&quot;)
   SegmentDraw(sx0, sy0, sx1 -  oReponseDlg(7)*1000*cos((-sAngle+  oReponseDlg(8))*pi/180), sy1 -  oReponseDlg(7)*1000*sin((-sAngle +  oReponseDlg(8))*pi/180), 30, &quot;plein&quot;)
   else
   SegmentDraw(sx1, sy1, sx1 -  oReponseDlg(7)*1000*cos((sAngle+  oReponseDlg(8))*pi/180), sy1 +  oReponseDlg(7)*1000*sin((sAngle +  oReponseDlg(8))*pi/180), 30, &quot;plein&quot;)
   SegmentDraw(sx0, sy0, sx1 -  oReponseDlg(7)*1000*cos((sAngle+  oReponseDlg(8))*pi/180), sy1 +  oReponseDlg(7)*1000*sin((sAngle +  oReponseDlg(8))*pi/180), 30, &quot;plein&quot;)
   end if
end if
if oReponseDlg(10) = 4 then &apos;choix4
   b = sin(oReponseDlg(8)*pi/180)*sLong*1000/sin((oReponseDlg(7) + oReponseDlg(8))*pi/180)
   a = sin(oReponseDlg(7)*pi/180)*sLong*1000/sin((oReponseDlg(7) + oReponseDlg(8))*pi/180)
   c = sLong*1000
   cosA = (b * b + c * c - a * a) / (2 * b * c)
   angleA = Atn(-cosA / Sqr(-cosA * cosA + 1)) + Pi / 2
   xc =  b * Cos(angleA)
   yc =  b * Sin(angleA)
   
   if oReponseDlg(9) = true then
   sxc = sx0 + xc*cos(sAngle*pi/180) - yc*sin(sAngle*pi/180)
   syc = sy0 - (xc*sin(sAngle*pi/180) + yc*cos(sAngle*pi/180))
   else
   sxc = sx0 + xc*cos(-sAngle*pi/180) - yc*sin(-sAngle*pi/180)
   syc = sy0 + (xc*sin(-sAngle*pi/180) + yc*cos(-sAngle*pi/180))
   end if
   SegmentDraw(sx0, sy0, sxc , syc , 30, &quot;plein&quot;)
   SegmentDraw(sx1, sy1, sxc , syc , 30, &quot;plein&quot;)
end if
nAjout = 2
end sub


sub Segmentah2D
Dim sxc as double, syc as double, sxd as double, syd as double, x0 as double, ang1 as double

if ah2DStep = 2 then
  if oReponseDlg(2) = true then
    SegmentDraw(sx0, sy0, sx0 +  oReponseDlg(0)*1000*cos((sAngle+  oReponseDlg(1))*pi/180), sy0 -  oReponseDlg(0)*1000*sin((sAngle +  oReponseDlg(1))*pi/180), 30, &quot;plein&quot;)
  else
    SegmentDraw(sx1, sy1, sx1 -  oReponseDlg(0)*1000*cos((sAngle+  oReponseDlg(1))*pi/180), sy1 +  oReponseDlg(0)*1000*sin((sAngle +  oReponseDlg(1))*pi/180), 30, &quot;plein&quot;)
  end if
  nAjout = 1
end if

if ah2DStep = 8 then
  if oReponseDlg(5) = 1 then 
    sxc = sx0 + sLong/2 * 1000 * cos(oReponseDlg(6) * pi/180) 
    syc = sy0 - sLong/2 * 1000 * sin(oReponseDlg(6) * pi/180) 
    SegmentDraw(sx0, sy0, sxc , syc , 30, &quot;plein&quot;)
  end if
   if oReponseDlg(5) = 0 then 
    sxc = sx0 + sLong/2 * 1000 * cos(oReponseDlg(6) * pi/180) 
    syc = sy0 - sLong/2 * 1000 * sin(oReponseDlg(6) * pi/180) 
    sxd = sx0 + sLong/2 * 1000 * cos(oReponseDlg(6) * pi/180 + pi) 
    syd = sy0 - sLong/2 * 1000 * sin(oReponseDlg(6) * pi/180 + pi) 
    SegmentDraw(sxc, syc, sxd , syd , 30, &quot;plein&quot;)
  end if
  if oReponseDlg(5) = 2 then 
    x0 = oReponseDlg(8)/sLong
    if x0 &lt;&gt; 1 then ang1 = 2* Atn(x0 / Sqr(-x0 * x0 + 1)) else ang1 = pi
    
    if oReponseDlg(7) = 0 then
    sxc = sx0 + sLong/2 * 1000 * cos(oReponseDlg(6) *pi/180) 
    syc = sy0 - sLong/2 * 1000 * sin(oReponseDlg(6) *pi/180) 
    sxd = sx0 + sLong/2 * 1000 * cos(ang1 + oReponseDlg(6) *pi/180 ) 
    syd = sy0 - sLong/2 * 1000 * sin(ang1 + oReponseDlg(6) *pi/180) 
    else
    sxd = sx0 + sLong/2 * 1000 * cos(oReponseDlg(6) *pi/180) 
    syd = sy0 - sLong/2 * 1000 * sin(oReponseDlg(6) *pi/180) 
    sxc = sx0 + sLong/2 * 1000 * cos(oReponseDlg(6) *pi/180 - ang1 ) 
    syc = sy0 - sLong/2 * 1000 * sin(oReponseDlg(6) *pi/180 - ang1) 
    end if
    SegmentDraw(sxc, syc, sxd , syd , 30, &quot;plein&quot;)
  end if
  
    if oReponseDlg(5) = 3 then
    sxc = sx0 + sLong/2 * 1000 * cos(oReponseDlg(6) * pi/180) 
    syc = sy0 - sLong/2 * 1000 * sin(oReponseDlg(6) * pi/180) 
    SegmentDraw(sxc + 2500*sin(oReponseDlg(6) * pi/180), syc + 2500*cos(oReponseDlg(6) * pi/180), sxc - 2500*sin(oReponseDlg(6) * pi/180) , syc - 2500*cos(oReponseDlg(6) * pi/180) , 30, &quot;plein&quot;)
    end if
    
    nAjout = 1
end if

if ah2DStep = 13 then 
SegmentDraw(pxa,pya,pxb,pyb,30,&quot;plein&quot;)
nElements = oPageTemp.count
oPageTemp(nElements - 1).Zorder = nElements - 3
nAjout = 1
end if

if ah2DStep = 15 then 
SegmentDraw(pxa,pya,pxb,pyb,30,&quot;plein&quot;)
nElements = oPageTemp.count
oPageTemp(nElements - 1).Zorder = nElements - 2
nAjout = 1
end if

end sub

sub Polygoneah2D
Dim nCotes as integer, angBase as double,angCentre as double,rPoly as double, i as integer, cst as integer
Dim a as double, b as double, c as double, cosA as double, AngleA as double
Dim xc as double, yc as double, sxc as double, syc as double , x1 as double, y1 as double, x2 as double, y2 as double

nCotes = oReponseDlg(13)
angCentre = 2*pi/nCotes
angBase = pi*(nCotes - 2)/(2*nCotes)

if ah2DStep = 5 then
   b = sin(angBase)*sLong*1000/sin(2*angBase)
   a = sin(angBase)*sLong*1000/sin(2*angBase)
   c = sLong*1000
   cosA = (b * b + c * c - a * a) / (2 * b * c)
   angleA = Atn(-cosA / Sqr(-cosA * cosA + 1)) + Pi / 2
   xc =  b * Cos(angleA)  
   yc =  b * Sin(angleA)
   if oReponseDlg(14) = true then
      sxc = sx0 + xc*cos(sAngle*pi/180) - yc*sin(sAngle*pi/180)    REM coord du centre du polygone
      syc = sy0 - (xc*sin(sAngle*pi/180) + yc*cos(sAngle*pi/180))
      cst = -1
      else
      sxc = sx0 + xc*cos(-sAngle*pi/180) - yc*sin(-sAngle*pi/180)
      syc = sy0 + (xc*sin(-sAngle*pi/180) + yc*cos(-sAngle*pi/180))
      cst = 1
   end if
   x1 = sx1
   y1 = sy1
   for i = 1 to nCotes - 1
   x2 = cos(cst*angCentre) * (x1 - sxc) - sin(cst*angCentre) * (y1 - syc) + sxc
   y2 = sin(cst*angCentre) * (x1 - sxc) + cos(cst*angCentre) * (y1 - syc) + syc
   SegmentDraw(x1,y1,x2,y2,30,&quot;plein&quot;)
   x1 = x2
   y1 = y2
   next
nAjout = nCotes -1
end if

if ah2DStep = 11 then

if oReponseDlg(12) = 0 then rPoly = sLong * 1000 /2
if oReponseDlg(12) = 1 then rPoly = sLong * 1000 /(2*cos(angCentre/2))

for i = 0 to nCotes-1
x1 = sx0 + rPoly*cos(i*angCentre + oReponseDlg(14)*pi/180)
y1 = sy0 - rPoly*Sin(i*angCentre + oReponseDlg(14)*pi/180)
x2 = sx0 + rPoly*cos((i+1)*angCentre + oReponseDlg(14)*pi/180)
y2 = sy0 - rPoly*Sin((i+1)*angCentre + oReponseDlg(14)*pi/180)
SegmentDraw(x1,y1,x2,y2,30,&quot;plein&quot;)
next
nAjout = nCotes
end if

end sub



sub Cercleah2D

if  oReponseDlg(4) = 0 then CercleDraw(sx0,sy0,sLong*1000)
if  oReponseDlg(4) = 1 then CercleDraw(sx1,sy1,sLong*1000)
if  oReponseDlg(4) = 2 then CercleDraw(sx0,sy0,sLong*1000*oReponseDlg(3))
if  oReponseDlg(4) = 3 then CercleDraw(sx1,sy1,sLong*1000*oReponseDlg(3))
if  oReponseDlg(4) = 4 then CercleDraw(sx0,sy0,1000*oReponseDlg(3))
if  oReponseDlg(4) = 5 then CercleDraw(sx1,sy1,1000*oReponseDlg(3))
if  oReponseDlg(4) = 6 then CercleDraw((sx0+sx1)/2,(sy0+sy1)/2,sLong*1000/2)
if  oReponseDlg(4) = 7 then CercleDraw(sx0,sy0,oReponseDlg(15)*1000)
if  oReponseDlg(4) = 8 then CercleDraw((sx0+sx1)/2,(sy0+sy1)/2,oReponseDlg(15)*1000)
if  oReponseDlg(4) = 9 then 
    CercleDraw((sx0+sx1)/2,(sy0+sy1)/2,sqr((pxb-(sx0+sx1)/2)*(pxb - (sx0+sx1)/2) + (pyb - (sy0+sy1)/2)*(pyb - (sy0+sy1)/2)))
    nElements = oPageTemp.count
    oPageTemp(nElements - 1).Zorder = nElements - 2    rem place le cercle derrière le point vert
end if
if  oReponseDlg(4) = 10 then CercleTangent

nAjout = 1
end sub

sub Rectangleah2D
Dim xd as double, yd as double, xc as double, yc as double, x0 as double
Dim xa as double, ya as double, xb as double, yb as double
Dim ang1 as double, ang2 as double

if ah2DStep = 4 then
  if oReponseDlg(12) = true then
  xd = sx0 - oReponseDlg(11)*1000*sin(sAngle*pi/180)
  yd = sy0 - oReponseDlg(11)*1000*cos(sAngle*pi/180)
  xc = sx1 - oReponseDlg(11)*1000*sin(sAngle*pi/180)
  yc = sy1 - oReponseDlg(11)*1000*cos(sAngle*pi/180)
  else
  xd = sx0 + oReponseDlg(11)*1000*sin(sAngle*pi/180)
  yd = sy0 + oReponseDlg(11)*1000*cos(sAngle*pi/180)
  xc = sx1 + oReponseDlg(11)*1000*sin(sAngle*pi/180)
  yc = sy1 + oReponseDlg(11)*1000*cos(sAngle*pi/180)
  end if

  SegmentDraw(sx1, sy1, xc , yc , 30, &quot;plein&quot;)
  SegmentDraw(xc, yc, xd , yd , 30, &quot;plein&quot;)
  SegmentDraw(xd, yd, sx0 , sy0 , 30, &quot;plein&quot;)
nAjout = 3
end if

if ah2DStep = 10 then
x0 = oReponseDlg(5)/sLong
ang1 = 2* Atn(x0 / Sqr(-x0 * x0 + 1))
ang2 = (pi - ang1)/2

xa = sx0 + sLong/2 * 1000 * cos(pi + ang2 + oReponseDlg(6)*pi/180) 
ya = sy0 - sLong/2 * 1000 * sin(pi + ang2 + oReponseDlg(6)*pi/180) 
xb = sx0 + sLong/2 * 1000 * cos(-ang2 + oReponseDlg(6)*pi/180 ) 
yb = sy0 - sLong/2 * 1000 * sin(-ang2 + oReponseDlg(6)*pi/180) 
xc = sx0 + sLong/2 * 1000 * cos(ang2 + oReponseDlg(6)*pi/180) 
yc = sy0 - sLong/2 * 1000 * sin(ang2 + oReponseDlg(6)*pi/180)
xd = sx0 + sLong/2 * 1000 * cos(pi -ang2 + oReponseDlg(6)*pi/180 ) 
yd = sy0 - sLong/2 * 1000 * sin(pi -ang2 + oReponseDlg(6)*pi/180)  

  SegmentDraw(xa, ya, xb , yb , 30, &quot;plein&quot;)
  SegmentDraw(xb, yb, xc , yc , 30, &quot;plein&quot;)
  SegmentDraw(xc, yc, xd , yd , 30, &quot;plein&quot;)
  SegmentDraw(xd, yd, xa , ya , 30, &quot;plein&quot;)

nAjout = 4

end if

end sub


sub Intersectionah2D
Dim a0 as double, b0 as double, c0 as double, a1 as double,b1 as double,c1 as double, d as double
Dim xH as double, yH as double, distCH as double, L1 as double
Dim xP1 as double, yP1 as double,xP2 as double, yP2 as double
Dim iAngle as double, distOO2 as double, cosA as double, angleA as double, i as integer

if ah2DStep = 16 then
   
   oPageTemp(intersZorder(0)).LineColor = sCouleurInters(0)
   oPageTemp(intersZorder(0)).LineWidth = sEpaisseurInters(0)
   intersZorder(0) = -1
   oPageTemp(intersZorder(1)).LineColor = sCouleurInters(1)
   oPageTemp(intersZorder(1)).LineWidth = sEpaisseurInters(1)
   intersZorder(1) = -1
   monDlg.GetControl(&quot;Label47&quot;).Model.BackgroundColor = RGB(255,255,255)
   monDlg.GetControl(&quot;CommandButton33&quot;).Model.State = 0
   monDlg.GetControl(&quot;Label49&quot;).Model.BackgroundColor = RGB(255,255,255)
   monDlg.GetControl(&quot;CommandButton34&quot;).Model.State = 0


  if intersType(0) = &quot;Ligne&quot; then
    a0 = Point2Y(0) - Point1Y(0)
    b0 = -(Point2X(0) - Point1X(0))
    c0 = Point1X(0)*(-a0) + Point1Y(0)*(-b0)
  end if
  
  if intersType(1) = &quot;Ligne&quot; then
    a1 = Point2Y(1) - Point1Y(1)
    b1 = -(Point2X(1) - Point1X(1))
    c1 = Point1X(1)*(-a1) + Point1Y(1)*(-b1)
  end if
  
 if intersType(0) = &quot;Ligne&quot; then
    if intersType(1) = &quot;Ligne&quot; then
  
        if (a0*b1-a1*b0) = 0 then
          msgbox(&quot;les droites sont parallèles&quot;, 0, &quot;AHmath3D&quot;)
          exit sub
        end if
    if (a0*b1-a1*b0) &lt;&gt; 0 then
      xP1 = (b0*c1-b1*c0)/(a0*b1-a1*b0)
      yP1 = (a0*c1-a1*c0)/(a1*b0-a0*b1)
      if abs(xP1) &lt; 30000 and abs(yP1) &lt; 45000 then
        nAjout = 2
      else
        msgbox(oReponseDlg(99), 0, &quot;AHmath3D&quot;)
        exit sub
      end if
    end if
  end if
  
    if intersType(1) = &quot;Cercle&quot; then      
    c1 = b0*Point1X(1) - a0*Point1Y(1)
    xH = (c1*b0-a0*c0)/(a0*a0+b0*b0)
    yH = -(c0*b0+a0*c1)/(a0*a0+b0*b0)
    distCH = abs(a0*Point1X(1) + b0*Point1Y(1) + c0)/sqr(a0*a0+b0*b0)
    if distCH - sLongInters(1)*1000/2 &gt; 5 then
     msgbox (oReponseDlg(98), 0, &quot;AHmath3D&quot;) 
     exit sub
     end if     
    if abs(distCH - sLongInters(1)*1000/2) &lt;= 5 then       Rem : on considere que la droite est tangente  si elle passe à 0,005 cm du cercle
    xP1 = xH
    yP1 = yH                                          
    nAjout = 2
    end if
    if distCH - sLongInters(1) * 1000/2 &lt; -5 then
    L1 = sqr(sLongInters(1)* 1000*sLongInters(1)*1000/4 - distCH * distCH)
    xP1 = xH + L1 * cos(sAngleInters(0) * pi/180)
    yP1 = yH - L1 * sin(sAngleInters(0) * pi/180)
    xP2 = xH - L1 * cos(sAngleInters(0) * pi/180)
    yP2 = yH + L1 * sin(sAngleInters(0) * pi/180)
    nAjout = 4
    end if   
    end if
    
  end if  &apos; fin du cas l&apos;élément est une ligne
  
  if intersType(0) = &quot;Cercle&quot; then
   
  if intersType(1) = &quot;Ligne&quot; then         &apos;la selection secondaire est une droite

    d = b1*Point1X(0) - a1*Point1Y(0)
    xH = (d*b1-a1*c1)/(a1*a1+b1*b1)
    yH = -(c1*b1+a1*d)/(a1*a1+b1*b1)
    distCH = abs(a1*Point1X(0) + b1*Point1Y(0) + c1)/sqr(a1*a1+b1*b1)
    if distCH - sLongInters(0)*1000/2 &gt; 5 then
     msgbox (oReponseDlg(98), 0, &quot;AHmath3D&quot;) 
     exit sub
     end if     
    if abs(distCH - sLongInters(0)*1000/2) &lt;= 5 then       Rem : on considere que la droite est tangente  si elle passe à 0,005 cm du cercle
    xP1 = xH
    yP1 = yH                                          
    nAjout = 2
    end if
    if distCH - sLongInters(0) * 1000/2 &lt; -5 then
    L1 = sqr(sLongInters(0)* 1000*sLongInters(0)*1000/4 - distCH * distCH)
    xP1 = xH + L1 * cos(sAngleInters(1) * pi/180)
    yP1 = yH - L1 * sin(sAngleInters(1) * pi/180)
    xP2 = xH - L1 * cos(sAngleInters(1) * pi/180)
    yP2 = yH + L1 * sin(sAngleInters(1) * pi/180)
    nAjout = 4
    end if
 end if   
 if intersType(1) = &quot;Cercle&quot; then       &apos;la selection secondaire est un cercle
 
    SegmentDraw(Point1X(0), Point1Y(0), Point1X(1) , Point1Y(1) , 30, &quot;plein&quot;)
    nElements = oPageTemp.count
    distOO2 = LgSgtDraw(oPageTemp(nElements - 1)) * 1000
    iAngle = oPageTemp(nElements - 1).RotateAngle/100
    oPagetemp.Remove(oPagetemp(nElements - 1)
    
    if distOO2 &gt; sLongInters(0) * 1000/2 +  sLongInters(1) * 1000/2 + 5 or sLongInters(0) * 1000/2 &gt; distOO2 + sLongInters(1) * 1000/2 or sLongInters(1) * 1000/2 &gt; distOO2 + sLongInters(0) * 1000/2  then
     msgbox(oReponseDlg(98), 0, &quot;AHmath3D&quot;)
     Exit sub
     end if
   
    if abs(distOO2 -sLongInters(1) * 1000/2 - sLongInters(0) * 1000/2) &lt;=5 then      rem 2 cercles sont considérés tangents quand leur distance est &lt;= 0,005 cm
    xP1 = Point1X(0) + sLongInters(0) * 1000/2*cos(iAngle*pi/180)
    yP1 = Point1Y(0) - sLongInters(0) * 1000/2*sin(iAngle*pi/180)
    nAjout = 2
    end if
    
    if distOO2 &lt; sLongInters(1) * 1000/2 + sLongInters(0) * 1000/2 - 5 then
    cosA = (sLongInters(0) * 1000/2 * sLongInters(0) * 1000/2 + distOO2 * distOO2 - sLongInters(1) * 1000/2 * sLongInters(1) * 1000/2) / (2 * sLongInters(0) * 1000/2 * distOO2)
    angleA = Atn(-cosA / Sqr(-cosA * cosA + 1)) + Pi / 2
   
    a0 =  sLongInters(0) * 1000/2 * Cos(angleA)
    b0 =  sLongInters(0) * 1000/2 * Sin(angleA)
     
   xP1 = Point1X(0) + a0*cos(iAngle*pi/180) - b0*sin(iAngle*pi/180)
   yP1 = Point1Y(0) - (a0*sin(iAngle*pi/180) + b0*cos(iAngle*pi/180))
   xP2 = Point1X(0) + a0*cos(-iAngle*pi/180) - b0*sin(-iAngle*pi/180)
   yP2 = Point1Y(0) + (a0*sin(-iAngle*pi/180) + b0*cos(-iAngle*pi/180))
   nAjout = 4
   end if
 end if
    
end if
    
   SegmentDraw(xP1 - 100, yP1 - 100, xP1 + 100 , yP1 + 100 , 30, &quot;plein&quot;)
   SegmentDraw(xP1 - 100, yP1 + 100, xP1 + 100 , yP1 - 100 , 30, &quot;plein&quot;)
   if nAjout = 4 then
   SegmentDraw(xP2 - 100, yP2 - 100, xP2 + 100 , yP2 + 100 , 30, &quot;plein&quot;)
   SegmentDraw(xP2 - 100, yP2 + 100, xP2 + 100 , yP2 - 100 , 30, &quot;plein&quot;) 
   end if

    nElements = oPageTemp.count
    for i = 1 to nAjout
    oPageTemp(nElements-i).Name = &quot;ah2D_point&quot;
    next

end if


end sub



