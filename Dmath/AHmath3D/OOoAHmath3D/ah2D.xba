sub DeplaceSegment(k1 as integer,k2 as integer, optional ordreElement as integer )   
Dim i as integer
Dim posX as Long, posY as Long, posSegmentMove as New com.sun.star.awt.Point
Dim oDist as double, TestDist as integer
SupprimePoints_AB
If IsMissing(ordreElement) then  ordreElement = eZorder

TestDist = ZT_Nbre(monDlg,  &quot;TextField18&quot;, 0.001 , 5 , 0.5 , oReponseDlg(79),)

if TestDist = 1 then

oDist = CDbl(monDlg.GetControl(&quot;TextField18&quot;).Peer.Text)
PosX = oPageTemp(ordreElement).Position.X
PosY = oPageTemp(ordreElement).Position.Y
posSegmentMove.X = PosX + k1 * oDist*1000
posSegmentMove.Y = PosY + k2 * oDist*1000

if ordreElement = eZorder then
sx0 = sx0 + k1 * oDist*1000
sx1 = sx1 + k1 * oDist*1000
sy0 = sy0 + k2 * oDist*1000
sy1 = sy1 + k2 * oDist*1000
end if

oPageTemp(ordreElement).Position = posSegmentMove
end if   
end sub



sub DeplaceDroite_click
Dim k as integer
if oPageTemp(eZorder).Name = &quot;ah2D_point&quot; then
  k = OrdreElement2(eZorder)
  if k &lt;&gt; -1 then DeplaceSegment(1,0,k)
end if
DeplaceSegment(1,0)

end sub

sub DeplaceGauche_click
Dim k as integer
if oPageTemp(eZorder).Name = &quot;ah2D_point&quot; then
  k = OrdreElement2(eZorder)
  if k &lt;&gt; -1 then DeplaceSegment(-1,0,k)
end if
DeplaceSegment(-1,0)
end sub

sub DeplaceHaut_click
Dim k as integer
if oPageTemp(eZorder).Name = &quot;ah2D_point&quot; then
  k = OrdreElement2(eZorder)
  if k &lt;&gt; -1 then DeplaceSegment(0,-1,k)
end if
DeplaceSegment(0,-1)
end sub

sub DeplaceBas_click
