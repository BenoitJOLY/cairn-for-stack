sub BasculeBouton(numBouton as integer) &apos;+ affichage bouton ajouter
Dim i as integer

for i = 50 to 64
monDlg.GetControl(&quot;CommandButton&quot; &amp; i).Model.State = 0
next
monDlg.GetControl(&quot;CommandButton&quot; &amp; numBouton).Model.State = 1
if numBouton = 59 then monDlg.getControl(&quot;CommandButton2&quot;).Model.EnableVisible = false else monDlg.getControl(&quot;CommandButton2&quot;).Model.EnableVisible = true
end sub

sub InitialiseAucuneSelection(Etat as boolean)
Dim i as integer
for i = 50 to 64
monDlg.GetControl(&quot;CommandButton&quot; &amp; i).Enable = Etat
next
monDlg.GetControl(&quot;CommandButton31&quot;).Enable = Etat
monDlg.GetControl(&quot;CommandButton22&quot;).Enable = Etat
monDlg.GetControl(&quot;CommandButton23&quot;).Enable = Etat
end sub

&apos;****************************************************************************************************
&apos;****************************************************************************************************
&apos;*****************************  TEST DE L&apos;OBJET SELECTIONNE *****************************************
&apos;****************************************************************************************************
&apos;****************************************************************************************************
&apos;****************************************************************************************************

Sub ah2D_TestSelection
Dim oSelection as object, oTypeForme as string
Dim message1 as string, message2 as string
message1 = &quot;The selected shape is not recognized&quot; &amp; chr(13) &amp;_
           &quot;or this shape don&apos;t contain a line or a circle&quot;
           
message2 = &quot;Only one shape must be selected&quot;           
           
oSelection = oDocActif.CurrentSelection
oTypeForme = TypeForme(oSelection(0))

SelectionOK = 1  &apos;initialisation : forme reconnue

if oTypeForme = &quot;Aucune forme sélectionnée ou forme non reconnue&quot; then SelectionOK = AucuneSelection
if SelectionOK = -1 then
  msgbox(Message1,0,&quot;AHmath3D&quot;)
  Exit sub
end if

if IsNull(oSelection) = false then
  if oSelection.Count&gt;1 then
  msgbox(Message2,0,&quot;AHmath3D&quot;)
  SelectionOK = -1
  Exit Sub
end if
end if

    &apos;Si la selection a passé les différents tests alors  SelectionOK = 0 ou 1

end sub






function AucuneSelection as Integer   &apos;teste si la selection est vide
Dim oSelection as object, oTypeForme as string, curseurVisible as object, otext as string

oDocActif = ThisComponent
if oDocActif.ImplementationName = &quot;SwXTextDocument&quot; then oPageActive = oDocActif.DrawPage
if oDocActif.ImplementationName = &quot;SdXImpressDocument&quot; then oPageActive = oDocActif.DrawPages(0)

 AucuneSelection = -1  &apos;initialisation selection non reconnue

if oDocActif.ImplementationName = &quot;SdXImpressDocument&quot; then
 if IsNull(oDocActif.CurrentSelection) then  AucuneSelection = 0
end if

if oDocActif.ImplementationName = &quot;SwXTextDocument&quot; then
 oSelection = oDocActif.CurrentSelection
 oTypeForme = TypeForme(oSelection(0))
 
 if oTypeForme = &quot;Aucune forme sélectionnée ou forme non reconnue&quot; then
 
 if oSelection(0).ImplementationName = &quot;SwXTextRange&quot; then

 ON ERROR GOTO GestionErreur
 curseurVisible = oDocActif.CurrentController.ViewCursor
 oText = curseurVisible.getString()
 curseurVisible.goLeft(Len(oText), false)
 AucuneSelection = 0
 end if
 end if
 
 
FinErreur1:
   On Error GoTo 0 
   Exit function     

GestionErreur:
 AucuneSelection = -1
Resume FinErreur1
 
end if

end function


