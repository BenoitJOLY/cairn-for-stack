sub RecherchePoint
Dim i as integer, j as integer, nMiniSegments as integer, test as integer

test = ZT_Nbre(monDlg,  &quot;TextField29&quot;, 0.1 , 5 , 0.5 , oReponseDlg(79),)
if test = 1 then
 oReponseDlg(6) = CDbl(monDlg.getControl(&quot;TextField29&quot;).Peer.Text)
 SupprimePoints_AB
 nElements = oPageTemp.count

 j = 0
 for i = 0 to nElements -1 
  if TypeForme(oPageTemp(i)) = &quot;Ligne&quot; then
     if LgSgtDraw(oPageTemp(i)) &lt; oReponseDlg(6)*sqr(2) then 
     oPageTemp(i).Name = &quot;ah2D_point&quot;
     j = j+1
    end if
  end if
 next
 
 
if j &gt; 0 then   REM compte le nombre de points trouvés
  Dim Milieu0 as variant, Milieu1 as variant, iMS(j-1) as integer   &apos;iMS = indice &quot;ordre&quot; minisegment
  nMiniSegments = j

  j = 0
  for i = 0 to nElements -1
  if oPageTemp(i).Name = &quot;ah2D_point&quot; then
   iMS(j) = i
   j = j+1
  end if
next
j=0

for i = 0 to nMiniSegments-2
        if iMS(i) &gt; 0 then
        Milieu0 = MilSgtDraw(oPageTemp(iMS(i)))
        for j = i+1 to nMiniSegments-1
           if iMS(j) &gt; 0 then
              Milieu1 = MilSgtDraw(oPageTemp(iMS(j)))
              if abs(Milieu0(0) - Milieu1(0)) &lt; 10 and abs(Milieu0(1) - Milieu1(1)) &lt; 10 then iMS(j) = -1
           end if
        next
       end if
Next
j = 0
for i = 0 to nMiniSegments-1
  if iMS(i) &gt;= 0 then j = j + 1
next
end if

msgbox(j &amp; &quot; &quot; &amp; oReponseDlg(80), 0, &quot;AHmath3D&quot;)

repererPoint
AffichageApercu
AffichageFenetreAction
end if
end sub


function OrdreElement2(ordreElement1 as integer) as integer      &apos;renvoie l&apos;ordre du 2ème segment d&apos;un point  ou -1
Dim oElement1 as object, oElement2 as object, Milieu0 as variant, Milieu1 as variant,i as integer

OrdreElement2 = -1   &apos;restera à -1 si aucun autre élément est trouvé  

nElements = oPageTemp.count
oElement1 = oPageTemp(ordreElement1)
if oElement1.Name = &quot;ah2D_point&quot; then
   for i = 0 to nElements - 1
     oElement2 = oPageTemp(i)
     if  oElement2.Name = &quot;ah2D_point&quot; and i &lt;&gt; ordreElement1 then
     Milieu0 = MilSgtDraw(oElement1)
     Milieu1 = MilSgtDraw(oElement2)
     if abs(Milieu0(0) - Milieu1(0)) &lt; 10 and abs(Milieu0(1) - Milieu1(1)) &lt; 10 then OrdreElement2 = i
     end if
   next
end if

end function


sub AnnulePoint
Dim k as integer
if oPageTemp(eZorder).Name = &quot;ah2D_point&quot; then oPageTemp(eZorder).Name = &quot;Ligne&quot;
k = OrdreElement2(eZorder)
if k&lt;&gt;-1 then oPageTemp(k).Name = &quot;Ligne&quot;
repererPoint
end sub


