AffecterImageFixe(monDlg, &quot;CommandButton2&quot; , CheminDessin(&quot;Dessins/ah2D/valider40.png/&quot;) )
AffecterImageFixe(monDlg, &quot;CommandButton1&quot; , CheminDessin(&quot;Dessins/ah2D/pointB_g.png/&quot;) )
AffecterImageFixe(monDlg, &quot;CommandButton4&quot; , CheminDessin(&quot;Dessins/ah2D/pointB_d.png/&quot;) )
