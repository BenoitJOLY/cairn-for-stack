sub codageAngle1(dimCodage as double, zorderEl1 as integer, zorderEl2 as integer, typeAngle as string, prolonger as boolean, optional AffMessage as boolean)   Rem : si dimCodage = 0 alors prolonge uniquement les 2 demies droites jusqu&apos;a leur intersection
Dim monInters as variant
Dim vIA(1) as variant, vIB(1) as variant, v1(1) as variant
Dim vIC(1) as variant, vID(1) as variant, v2(1) as variant
Dim coordAngleDroitX(2) as variant,coordAngleDroitY(2) as variant 
Dim xA as double, yA as double, xB as double, yB as double, xC as double, yC as double, xD as double, yD as double, xI as double, yI as double
Dim lgIA as double, lgIB as double, lgIC as double, lgID as double, lgIP as double, lg1 as double, lg2 as double


xA = oPageTemp(zorderEl1).Polygon(0).X
yA = oPageTemp(zorderEl1).Polygon(0).Y
xB = oPageTemp(zorderEl1).Polygon(1).X
yB = oPageTemp(zorderEl1).Polygon(1).Y
xC = oPageTemp(zorderEl2).Polygon(0).X
yC = oPageTemp(zorderEl2).Polygon(0).Y
xD = oPageTemp(zorderEl2).Polygon(1).X
yD = oPageTemp(zorderEl2).Polygon(1).Y


monInters = CoordInters(oPageTemp(zorderEl1),oPageTemp(zorderEl2))

if monInters(0) = &quot;paralleles&quot; and AffMessage = true then msgbox(oReponseDlg(98), 0, &quot;AHmath3D&quot;)   rem : dtes parallèles
if monInters(0) &lt;&gt; &quot;paralleles&quot; then
   xI = monInters(1)
   yI = monInters(2)
   
   lgIA = sqr((xA-xI)*(xA-xI) + (yA-yI)*(yA-yI))
   lgIB = sqr((xB-xI)*(xB-xI) + (yB-yI)*(yB-yI))
   lgIC = sqr((xC-xI)*(xC-xI) + (yC-yI)*(yC-yI))
   lgID = sqr((xD-xI)*(xD-xI) + (yD-yI)*(yD-yI))
   
   vIA = CoordVect2Draw(monInters(1), monInters(2),xA,yA)
   vIB = CoordVect2Draw(monInters(1), monInters(2),xB,yB)
   vIC = CoordVect2Draw(monInters(1), monInters(2), xC,yC)
   vID = CoordVect2Draw(monInters(1), monInters(2), xD,yD)

   
    if lgIA &gt;= lgIB then 
        v1 = vIA
        lg1 = lgIA
        else
        v1 = vIB
        lg1 = lgIB
    end if
    
    if lgIC &gt;= lgID then 
        v2 = vIC
        lg2 = lgIC
        else
        v2 = vID
        lg2 = lgID
    end if
    
   lgIP = sqr((v1(0)/lg1 + v2(0)/lg2)*(v1(0)/lg1 + v2(0)/lg2) + (v1(1)/lg1 + v2(1)/lg2)*(v1(1)/lg1 + v2(1)/lg2))
      
   coordAngleDroitX(0) = dimCodage*1000*v1(0) / lg1 + xI
   coordAngleDroitY(0) = dimCodage*1000*v1(1) / lg1 + yI
   coordAngleDroitX(1) = dimCodage*1000*(v1(0) / lg1 + v2(0) / lg2) + xI
   coordAngleDroitY(1) = dimCodage*1000*(v1(1) / lg1 + v2(1) / lg2) + yI
   coordAngleDroitX(2) = dimCodage*1000*v2(0) / lg2 + xI
   coordAngleDroitY(2) = dimCodage*1000*v2(1) / lg2 + yI

   
   if typeAngle = &quot;droit&quot; then LigneBrisee(coordAngleDroitX,coordAngleDroitY)
   if typeAngle = &quot;arrondi&quot; then
   if monInters(0) = &quot;secantes&quot; then
   coordAngleDroitX(1) = dimCodage*1000* (v1(0) / lg1 + v2(0) / lg2)/lgIP + xI 
   coordAngleDroitY(1) = dimCodage*1000* (v1(1) / lg1 + v2(1) / lg2)/lgIP + yI
  &apos; else
  &apos; coordAngleDroitX(1) = -dimCodage*1000* v1(1)/lg1 + xI    rem pbme avec angle plat
 &apos;  coordAngleDroitY(1) = dimCodage*1000* v1(0)/lg1 + yI
   end if
   PolygoneBezier3(coordAngleDroitX,coordAngleDroitY)
   end if
   if typeAngle = &quot;droit&quot; or typeAngle = &quot;arrondi&quot; then nAjout = nAjout + 1
   
&apos; prolonge les droites jusqu&apos;au point d&apos;intersection  -----------------------
if prolonger = true and monInters(0) = &quot;secantes&quot; then
  if (vIA(0)*vIB(0)+vIA(1)*vIB(1)&gt;=0) then
  oPagetemp.Remove(oPagetemp(zorderEl1))&apos;oPagetemp(intersZorder(0)))
       if  vIA(0)*vIA(0)+vIA(1)*vIA(1) &gt;= vIB(0)*vIB(0)+vIB(1)*vIB(1) then
       SegmentDraw(monInters(1),monInters(2),xA,yA, 30, &quot;plein&quot;)
       else
       SegmentDraw(monInters(1),monInters(2),xB,yB, 30, &quot;plein&quot;)
       end if
       nElements = oPageTemp.Count
       oPageTemp(nElements - 1).Zorder = zorderEl1&apos;intersZorder(0)
  end if
  
  if (vIC(0)*vID(0)+vIC(1)*vID(1)&gt;=0) then
  oPagetemp.Remove(oPagetemp(zorderEl2))&apos;oPagetemp(intersZorder(1)))
       if  vIC(0)*vIC(0)+vIC(1)*vIC(1) &gt;= vID(0)*vID(0)+vID(1)*vID(1) then
       SegmentDraw(monInters(1),monInters(2),xC,yC, 30, &quot;plein&quot;)
       else
       SegmentDraw(monInters(1),monInters(2),xD,yD, 30, &quot;plein&quot;)
       end if
       nElements = oPageTemp.Count
       oPageTemp(nElements - 1).Zorder = zorderEl2&apos;intersZorder(1)
  end if
end if   
&apos;-------------------------------------------------------------------------
end if

SauvCodageAngle = array(xI,yI,coordAngleDroitX(1),coordAngleDroitY(1),v1,v2,lg1,lg2,monInters(0))  &apos;sauvegarde des données pour utilisation ultérieure

end sub

sub CodageAngleX(zorderEl1 as integer, zorderEl2 as integer, dimCodage as double, choixCodage as integer)
Dim vIP(1) as variant, lgIP as double, oAbs(2) as variant, oOrd(2) as variant, k as integer


if choixCodage = 7 then codageAngle1(dimCodage,zorderEl1,zorderEl2, &quot;droit&quot;, true)
if choixCodage &gt; 0 and choixCodage &lt; 7 then 
   codageAngle1(dimCodage,zorderEl1,zorderEl2, &quot;arrondi&quot;, true, true)
   k = 1
   if choixCodage &lt;&gt; 1 and choixCodage &lt;&gt; 4 then
      codageAngle1(dimCodage + 0.1,zorderEl1,zorderEl2 , &quot;arrondi&quot;, false)
      k = 2
   end if
   if choixCodage = 3 or choixCodage = 6 then
   codageAngle1(dimCodage + 0.2 ,zorderEl1,zorderEl2 , &quot;arrondi&quot;, false)
   k = 3
   end if
   if choixCodage &gt; 3 then
   vIP(0) = SauvcodageAngle(2) - SauvCodageAngle(0)
   vIP(1) = SauvCodageAngle(3) - SauvCodageAngle(1)
   lgIP = sqr(vIP(0)*vIP(0) + vIP(1)*vIP(1))
   oAbs(0) = SauvCodageAngle(2) + vIP(0)*50/lgIP
   oAbs(1) = SauvCodageAngle(2) - vIP(0)*100/lgIP
   oAbs(2) = SauvCodageAngle(2) - vIP(0)*(100 + 100*k)/lgIP
   oOrd(0) = SauvCodageAngle(3) + vIP(1)*50/lgIP
   oOrd(1) = SauvCodageAngle(3) - vIP(1)*100/lgIP
   oOrd(2) = SauvCodageAngle(3) - vIP(1)*(100 + 100*k)/lgIP
   LigneBrisee(oAbs,oOrd)
   nAjout = nAjout + 1
   end if
end if


end sub

sub codageMilieu(monZorder as integer, choixCodage as integer)
Dim oVAB as variant, olgAB as double, o1mmAB as variant, o1mmpAB as variant, cod1 as variant, cod2 as variant
Dim traitCodageX as variant, traitCodageY as variant
ovAB = CoordVectDraw(oPageTemp(eZorder))
olgAB = LgSgtDraw(oPageTemp(eZorder))

o1mmAB = array(ovAB(0)/(10*olgAB),ovAB(1)/(10*olgAB))   &apos;deplacement de 1mm sur AB
o1mmpAB = array(-ovAB(1)/(10*olgAB),ovAB(0)/(10*olgAB)) &apos;deplacement de 1mm perpendiculairement AB
cod1 = array(sx0 + 0.25*ovAB(0), sy0 + 0.25*ovAB(1))
cod2 = array(sx0 + 0.75*ovAB(0), sy0 + 0.75*ovAB(1))

if choixCodage &lt; 4 and choixCodage &gt; 0 then
traitCodageX = array(cod1(0) + o1mmpAB(0) , cod1(0) , cod1(0) - o1mmpAB(0))
traitCodageY = array(cod1(1) + o1mmpAB(1) , cod1(1) , cod1(1) - o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
traitCodageX = array(cod2(0) + o1mmpAB(0) , cod2(0) , cod2(0) - o1mmpAB(0))
traitCodageY = array(cod2(1) + o1mmpAB(1) , cod2(1) , cod2(1) - o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
end if
if choixCodage =2 or choixCodage = 3 then
traitCodageX = array(cod1(0) - o1mmAB(0) + o1mmpAB(0) , cod1(0) - o1mmAB(0) , cod1(0) - o1mmAB(0) - o1mmpAB(0))
traitCodageY = array(cod1(1) - o1mmAB(1) + o1mmpAB(1) , cod1(1) - o1mmAB(1) , cod1(1) - o1mmAB(1) - o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
traitCodageX = array(cod2(0) + o1mmAB(0) + o1mmpAB(0) , cod2(0) + o1mmAB(0) , cod2(0) + o1mmAB(0) - o1mmpAB(0))
traitCodageY = array(cod2(1) + o1mmAB(1) + o1mmpAB(1) , cod2(1) + o1mmAB(1) , cod2(1) + o1mmAB(1) - o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
end if
if choixCodage = 3 then
traitCodageX = array(cod1(0) + o1mmAB(0) + o1mmpAB(0) , cod1(0) + o1mmAB(0) , cod1(0) + o1mmAB(0) - o1mmpAB(0))
traitCodageY = array(cod1(1) + o1mmAB(1) + o1mmpAB(1) , cod1(1) + o1mmAB(1) , cod1(1) + o1mmAB(1) - o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
traitCodageX = array(cod2(0) - o1mmAB(0) + o1mmpAB(0) , cod2(0) - o1mmAB(0) , cod2(0) - o1mmAB(0) - o1mmpAB(0))
traitCodageY = array(cod2(1) - o1mmAB(1) + o1mmpAB(1) , cod2(1) - o1mmAB(1) , cod2(1) - o1mmAB(1) - o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
end if
if choixCodage = 4 then
traitCodageX = array(cod1(0) - o1mmAB(0) - o1mmpAB(0) , cod1(0) +  o1mmpAB(0)  , cod1(0) + o1mmAB(0) - o1mmpAB(0))
traitCodageY = array(cod1(1) - o1mmAB(1) - o1mmpAB(1) , cod1(1) +  o1mmpAB(1)  , cod1(1) + o1mmAB(1) - o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
traitCodageX = array(cod2(0) - o1mmAB(0) - o1mmpAB(0) , cod2(0) +  o1mmpAB(0)  , cod2(0) + o1mmAB(0) - o1mmpAB(0))
traitCodageY = array(cod2(1) - o1mmAB(1) - o1mmpAB(1) , cod2(1) +  o1mmpAB(1)  , cod2(1) + o1mmAB(1) - o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
end if
if choixCodage = 5 or choixCodage = 6 or choixCodage = 7 then
traitCodageX = array(cod1(0) - 0.5*o1mmAB(0) - o1mmpAB(0) , cod1(0) +  0.5*o1mmAB(0)  , cod1(0) - 0.5*o1mmAB(0) + o1mmpAB(0))
traitCodageY = array(cod1(1) - 0.5*o1mmAB(1) - o1mmpAB(1) , cod1(1) +  0.5*o1mmAB(1)  , cod1(1) - 0.5*o1mmAB(1) + o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
traitCodageX = array(cod2(0) - 0.5*o1mmAB(0) - o1mmpAB(0) , cod2(0) +  0.5*o1mmAB(0)  , cod2(0) - 0.5*o1mmAB(0) + o1mmpAB(0))
traitCodageY = array(cod2(1) - 0.5*o1mmAB(1) - o1mmpAB(1) , cod2(1) +  0.5*o1mmAB(1)  , cod2(1) - 0.5*o1mmAB(1) + o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
end if
if choixCodage = 6 or choixCodage = 7 then
traitCodageX = array(cod1(0) - 1.5*o1mmAB(0) - o1mmpAB(0) , cod1(0) - 0.5*o1mmAB(0)   , cod1(0) - 1.5*o1mmAB(0) + o1mmpAB(0))
traitCodageY = array(cod1(1) - 1.5*o1mmAB(1) - o1mmpAB(1) , cod1(1) - 0.5*o1mmAB(1)  , cod1(1) - 1.5*o1mmAB(1) + o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
traitCodageX = array(cod2(0) - 1.5*o1mmAB(0) - o1mmpAB(0) , cod2(0) - 0.5*o1mmAB(0)  , cod2(0) - 1.5*o1mmAB(0) + o1mmpAB(0))
traitCodageY = array(cod2(1) - 1.5*o1mmAB(1) - o1mmpAB(1) , cod2(1) - 0.5*o1mmAB(1)  , cod2(1) - 1.5*o1mmAB(1) + o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
end if
if choixCodage = 7 then
traitCodageX = array(cod1(0) + 0.5*o1mmAB(0) - o1mmpAB(0) , cod1(0) + 1.5*o1mmAB(0)   , cod1(0) + 0.5*o1mmAB(0) + o1mmpAB(0))
traitCodageY = array(cod1(1) + 0.5*o1mmAB(1) - o1mmpAB(1) , cod1(1) + 1.5*o1mmAB(1)  , cod1(1) + 0.5*o1mmAB(1) + o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
traitCodageX = array(cod2(0) + 0.5*o1mmAB(0) - o1mmpAB(0) , cod2(0) + 1.5*o1mmAB(0)  , cod2(0) + 0.5*o1mmAB(0) + o1mmpAB(0))
traitCodageY = array(cod2(1) + 0.5*o1mmAB(1) - o1mmpAB(1) , cod2(1) + 1.5*o1mmAB(1)  , cod2(1) + 0.5*o1mmAB(1) + o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
end if
if choixCodage = 8 then
traitCodageX = array(cod1(0) + 0.5*o1mmAB(0) + o1mmpAB(0) , cod1(0) - 0.5*o1mmAB(0) - o1mmpAB(0)   ,  cod1(0) + 0.5*o1mmAB(0) - o1mmpAB(0),cod1(0) - 0.5*o1mmAB(0) + o1mmpAB(0))
traitCodageY = array(cod1(1) + 0.5*o1mmAB(1) + o1mmpAB(1) , cod1(1) - 0.5*o1mmAB(1) - o1mmpAB(1)   ,  cod1(1) + 0.5*o1mmAB(1) - o1mmpAB(1),cod1(1) - 0.5*o1mmAB(1) + o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
traitCodageX = array(cod2(0) + 0.5*o1mmAB(0) + o1mmpAB(0) , cod2(0) - 0.5*o1mmAB(0) - o1mmpAB(0)   ,  cod2(0) + 0.5*o1mmAB(0) - o1mmpAB(0),cod2(0) - 0.5*o1mmAB(0) + o1mmpAB(0))
traitCodageY = array(cod2(1) + 0.5*o1mmAB(1) + o1mmpAB(1) , cod2(1) - 0.5*o1mmAB(1) - o1mmpAB(1)   ,  cod2(1) + 0.5*o1mmAB(1) - o1mmpAB(1),cod2(1) - 0.5*o1mmAB(1) + o1mmpAB(1))
LigneBrisee(traitCodageX,traitCodageY)
end if

if choixCodage = 1 or  choixCodage = 4 or  choixCodage = 5 or  choixCodage = 8 then nAjout =  nAjout + 2
if choixCodage = 2 or  choixCodage = 6  then nAjout =  nAjout + 4
if choixCodage = 3 or  choixCodage = 7  then nAjout =  nAjout + 6
end sub

&apos;****************************************************************************************************
&apos;****************************************************************************************************
&apos;**********************************      Affichage page      ****************************************
&apos;****************************************************************************************************
&apos;****************************************************************************************************
&apos;****************************************************************************************************
sub initialiseZoom
monDlg.getControl(&quot;TextField1&quot;).Text = oDocTemp.CurrentController.ZoomValue
end sub


sub Zoom_Modif
Dim test(1) as integer, monTexte as string

monTexte = ReponseTexte(monDlg,&quot;TextField1&quot;)
test(0) = Texte_Nbre(monTexte,true)
if test(0) = 1 then
  oReponseDlg(3) = CDbl(monDlg.getControl(&quot;TextField1&quot;).Peer.Text)
  if oReponseDlg(3)&gt;=20 and oReponseDlg(3)&lt;=600 then Zoom(oReponseDlg(3))
end if

end sub

sub DecalerPage(k1 as integer, k2 as integer)   &apos;k1 = +-1 ou 0 k2 = +-1 ou 0
Dim PosPage As New com.sun.star.awt.Point
Dim origX as Long, origY as Long
origX = oDocTemp.CurrentController.ViewOffset.X
origY = oDocTemp.CurrentController.ViewOffset.Y
PosPage.X = origX + k1*250
PosPage.Y = origY + k2*250
oDocTemp.CurrentController.ViewOffset = PosPage
end sub


sub DecalerPage_G
DecalerPage(1,0)
end sub

sub DecalerPage_D
DecalerPage(-1,0)
end sub

sub DecalerPage_H
DecalerPage(0,1)
end sub

sub DecalerPage_B
DecalerPage(0,-1)
end sub


&apos;****************************************************************************************************
&apos;****************************************************************************************************
&apos;*************************       CERCLE TANGENT         *********************************************
&apos;****************************************************************************************************
&apos;****************************************************************************************************
&apos;****************************************************************************************************
sub  CercleTangent
Dim a as double, b as double, c as double, distPtD as double

nElements = oPageTemp.count
MiniInfoSegment(0, eZorder)
pxa = (Point1X(0) + Point2X(0))/2
pya = (Point1Y(0) + Point2Y(0))/2
MiniInfoSegment(1, nElements-1)
SupprimeDroiteVerte

    a = Point2Y(1) - Point1Y(1)
    b = -(Point2X(1) - Point1X(1))
    c = Point1X(1)*(-a) + Point1Y(1)*(-b)

 intersZorder(0) = -1
 intersZorder(1) = -1
distPtD = abs(a*pxa + b * pya + c)/sqr(a*a + b*b)

CercleDraw(pxa , pya , distPtD)

end sub


sub RechercheLignes
Dim i as integer, k as integer
nElements = oPageTemp.count
k=0
Dim oTab1(nElements - 1) as variant

for i = 0 to nElements-1
 if TypeForme(oPageTemp(i)) = &quot;Ligne&quot; and oPageTemp(i).Name &lt;&gt; &quot;ah2D_point&quot; then
    oTab1(k) = CoordSgtDraw(oPageTemp(i))
    k = k+1
    end if
next

if k = 0 then oTab1(0) = array(&quot;aucune&quot;, &quot;aucune&quot;, &quot;aucune&quot;, &quot;aucune&quot;)

Dim oTab2(k) as variant
for i = 0 to k
oTab2(i) = oTab1(i)
next

oListeDroite = oTab2

end sub


sub TraceLigne(k as integer)
Dim oPtA as variant, oPtB as variant, oDroite as variant
if oListeDroite(0)(0) &lt;&gt; &quot;aucune&quot; then
nElements = oPageTemp.count
oDroite = oListeDroite(k)
oPtA = array(oDroite(0), oDroite(1))
oPtB = array(oDroite(2), oDroite(3))
segmentDraw(oPtA(0), oPtA(1), oPtB(0),oPtB(1) , 30, &quot;plein&quot;)
oPageTemp(nElements).LineColor = RGB(38,251,123)
oPageTemp(nElements).LineWidth = sEpaisseur + 100
oPageTemp(nElements).Name = &quot;DroiteVerte&quot;
end if
end sub



sub LigneSuivante_Click(k as integer)
Dim nbreDroites as integer
   if oListeDroite(0)(0) = &quot;aucune&quot; then 
 &apos;     msgbox(oReponseDlg(94),0+64,&quot;AHmath3D&quot;) 
     Exit Sub
   end if
   nElements = oPageTemp.count
   nbreDroites = Ubound(oListeDroite)
   oPageTemp.Remove(oPageTemp(nElements - 1))
   if k = 1 then indDroite = (indDroite + 1) MOD nbreDroites
   if k = -1 then indDroite = (indDroite + nbreDroites - 1) MOD nbreDroites
   TraceLigne(indDroite)

end sub

sub LigneSuivante_D
 LigneSuivante_Click(1)
end sub

sub LigneSuivante_G
 LigneSuivante_Click(-1)
end sub

sub SupprimeDroiteVerte
nElements = oPageTemp.Count
if nElements &gt; 1 then
if oPageTemp(nElements - 1).Name = &quot;DroiteVerte&quot; then oPagetemp.Remove(oPagetemp(nElements - 1))
end if
end sub
</script:module>