AffecterImageFixe(monDlg, &quot;CommandButton54&quot; , CheminDessin(&quot;Dessins/ah2D/polygone25.png/&quot;) )
AffecterImageFixe(monDlg, &quot;CommandButton55&quot; , CheminDessin(&quot;Dessins/ah2D/cercle25.png/&quot;) )
AffecterImageFixe(monDlg, &quot;CommandButton26&quot; , CheminDessin(&quot;Dessins/ah2D/PremierElement40.png/&quot;) )
AffecterImageFixe(monDlg, &quot;CommandButton27&quot; , CheminDessin(&quot;Dessins/ah2D/ElementPrecedent40.png/&quot;) )
