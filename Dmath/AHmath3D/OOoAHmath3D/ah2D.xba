end if
DeplaceSegment(0,1)
end sub




sub PivoteSegment(k as integer)
Dim oAngle as double, TestAngle as integer, TestPoint as boolean, morceauPoint as integer
Dim oCentreRot as integer, i as integer, N as integer
Dim sxc as double, syc as double, x1 as double, y1 as double, x0 as double, y0 as double

N = oPageTemp.count

TestPoint = false
oCentreRot = ReponseListe(monDlg,&quot;ListBox2&quot;)(1)

if oPageTemp(eZorder).Name = &quot;ah2D_point&quot; then
   oCentreRot = 2
   TestPoint = true
end if

if TypeForme(oPageTemp(eZorder)) &lt;&gt; &quot;Ligne&quot; and TypeForme(oPageTemp(eZorder)) &lt;&gt; &quot;Cercle&quot; then oCentreRot = 3

TestAngle = ZT_Nbre(monDlg,  &quot;TextField19&quot;,-180 , 180 , 5 , oReponseDlg(71),)

if TestAngle = 1 then
oAngle = CDbl(monDlg.GetControl(&quot;TextField19&quot;).Peer.Text)

   if oCentreRot = 0 then
   sx1 = sx0 +  sLong*1000*cos((sAngle+ k * oAngle)*pi/180)
   sy1 = sy0 -  sLong*1000*sin((sAngle + k * oAngle)*pi/180)
   end if
   if oCentreRot = 1 then
   sx0 = sx1 -  sLong*1000*cos((sAngle+ k * oAngle)*pi/180)
   sY0 = sy1 +  slong*1000*sin((sAngle + k * oAngle)*pi/180)
   end if
   if oCentreRot = 2 then
   sxc = (sx0 + sx1)/2
   syc = (sy0 + sy1)/2
   x1 = sx1
   y1 = sy1
   x0 = sx0
   y0 = sy0
   sx1 = cos(-k * oAngle * pi/180) * (x1 - sxc) - sin(-k * oAngle * pi/180) * (y1 - syc) + sxc
   sy1 = sin(-k * oAngle * pi/180) * (x1 - sxc) + cos(-k * oAngle * pi/180) * (y1 - syc) + syc
   sx0 = cos(-k * oAngle * pi/180) * (x0 - sxc) - sin(-k * oAngle * pi/180) * (y0 - syc) + sxc
   sy0 = sin(-k * oAngle * pi/180) * (x0 - sxc) + cos(-k * oAngle * pi/180) * (y0 - syc) + syc
   
   end if
if oCentreRot &lt; 3 then
   SegmentDraw(sx0, sy0, sx1, sy1, 30, &quot;plein&quot;)
   oPageTemp.Remove(oPageTemp(eZorder))
   oPageTemp(N-1).Zorder = eZorder
   oPageTemp(eZorder).LineWidth = sEpaisseur + 100
   oPageTemp(eZorder).LineColor = RGB(0,0,255)
   oPageTemp(eZorder).LineStyle = sPointille 
   if TestPoint = true then oPageTemp(eZorder).Name = &quot;ah2D_point&quot;
   sAngle = oPageTemp(eZorder).RotateAngle /100     &apos;Angle du segment avec l&apos;horizontal
   if sAngle &gt; 180 then sAngle = sAngle - 360
   if sAngle &lt; -180 then sAngle = sAngle + 360
   monDlg.getControl(&quot;info1&quot;).Text = sLong
   monDlg.getControl(&quot;info2&quot;).Text = sAngle
   AffichageApercu

if oPageTemp(eZorder).Name = &quot;ah2D_point&quot; then   &apos;pivote le 2ème segment du point
   morceauPoint = -1  &apos;initialisation
   morceauPoint = OrdreElement2(eZorder)
   if morceauPoint &gt;=0 then
   oPageTemp(morceauPoint).RotateAngle = oPageTemp(morceauPoint).RotateAngle + k * oAngle * 100
   end if
end if
end if

if oCentreRot = 3 then     &apos;cas d&apos;un objet autre que segment ou cercle
   oPageTemp(eZorder).RotateAngle = oPageTemp(eZorder).RotateAngle + k * oAngle * 100
end if

end if
end sub


sub pivotePlus_click
SupprimePoints_AB
PivoteSegment(1)
end sub

sub pivoteMoins_click
SupprimePoints_AB
PivoteSegment(-1)
end sub


sub ModifieLongueur(k as integer)
Dim oExt as integer,i as integer, N as integer
Dim oDist as double, TestDist as integer
Dim xAB as double, yAB as double
Dim x0 as double, y0 as double,x1 as double,y1 as double, sLongProv as double

xAB = (sx1 - sx0)/(sLong*1000)
yAB = (sy1 - sy0)/(sLong*1000)
N = oPageTemp.count
oExt = ReponseListe(monDlg,&quot;ListBox3&quot;)(1)

TestDist = ZT_Nbre(monDlg,  &quot;TextField20&quot;,0.001 , 5 , 0.5 , oReponseDlg(79),)

if TestDist = 1 then
oDist = CDbl(monDlg.GetControl(&quot;TextField20&quot;).Peer.Text)

if k = -1 and oDist &gt;= sLong then
  msgbox(oReponseDlg(78), 0, &quot;AHmath3D&quot;)

  else
  
  if oExt = 0 then
  sx0 = sx0 - k * oDist* 1000 * xAB
  sy0 = sy0 - k * oDist* 1000 * yAB
  else
  sx1 = sx1 + k * oDist* 1000 * xAB
  sy1 = sy1 + k * oDist* 1000 * yAB
  end if

   sLong = CInt(sqr((sx1-sx0)*(sx1 - sx0) + (sy1-sy0)*(sy1-sy0))/10)/100   &apos;longueur du segment
   SegmentDraw(sx0, sy0, sx1, sy1, 30, &quot;plein&quot;)
   oPageTemp.Remove(oPageTemp(eZorder))
   oPageTemp(N-1).Zorder = eZorder
   oPageTemp(eZorder).LineWidth = sEpaisseur + 100
   oPageTemp(eZorder).LineColor = RGB(0,0,255)
   oPageTemp(eZorder).LineStyle = sPointille
   sAngle = oPageTemp(eZorder).RotateAngle /100     &apos;Angle du segment avec l&apos;horizontal
   if sAngle &gt; 180 then sAngle = sAngle - 360
   if sAngle &lt; -180 then sAngle = sAngle + 360

monDlg.getControl(&quot;info1&quot;).Text = sLong
monDlg.getControl(&quot;info2&quot;).Text = sAngle
AffichageApercu

end if
end if
end sub


sub ModifieLongPlus_click
SupprimePoints_AB
ModifieLongueur(1)
end sub

sub ModifieLongMoins_click
SupprimePoints_AB
ModifieLongueur(-1)
end sub


