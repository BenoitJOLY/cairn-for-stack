&apos;****************************************************************************************************
&apos;****************************************************************************************************
&apos;******************************      RELIER 2 POINTS      *******************************************
&apos;****************************************************************************************************
&apos;****************************************************************************************************
&apos;****************************************************************************************************

sub repererPoint
Dim i as integer, j as integer, nPointsMultiple as integer

TabPointX = Null
TabPointY = Null

j = 0
nElements = oPageTemp.count
Dim varX(2*nElements) as variant, varY(2*nElements) as variant

for i = 0 to 2*nElements - 1   rem initialisation des variables
varX(i) = Null
varY(i) = Null
next

for i = 0 to nElements - 1

if TypeForme(oPageTemp(i)) = &quot;Ligne&quot; then
  if oPageTemp(i).Name &lt;&gt; &quot;ah2D_point&quot; then
    varX(j) = oPageTemp(i).Polygon(0).X
    varY(j) = oPageTemp(i).Polygon(0).Y
    varX(j+1) = oPageTemp(i).Polygon(1).X
    varY(j+1) = oPageTemp(i).Polygon(1).Y
    j = j+2
  end if
  if oPageTemp(i).Name = &quot;ah2D_point&quot; then
    varX(j) = (oPageTemp(i).Polygon(0).X + oPageTemp(i).Polygon(1).X)/2
    varY(j) = (oPageTemp(i).Polygon(0).Y + oPageTemp(i).Polygon(1).Y)/2
    j = j+1
  end if
end if 
next
nPointsMultiple = j   rem : nombre de points non nuls mais présents plusieurs fois

&apos;--------------------------------------- épurer les points avec une precision de 10 (1/10 mm)
for i = 0 to nPointsMultiple - 2
    if IsNull(varX(i)) = false then
    for j = i + 1 to nPointsMultiple - 1
    if IsNull(varX(j)) = false then
    if abs(varX(j) - varX(i)) &lt; 10 and abs(varY(j) - varY(i)) &lt; 10 then
    varX(j) = Null
    varY(j) = Null
    end if
    end if
    Next
    end if
Next

j = 0
for i = 0 to nPointsMultiple - 1
if IsNull(varX(i)) = false then  j = j+1
next

nPoints = j  REM nombre final de points

if nPoints &gt; 1 then

Dim var2X(nPoints-1) as variant, var2Y(nPoints-1) as variant
j = 0
for i = 0 to nPointsMultiple-1
if IsNull(varX(i)) = false then
var2X(j) = varX(i)
var2Y(j) = varY(i)
j = j+1
end if
next

TabPointX = var2X
TabPointY = var2Y

&apos;else
&apos;msgbox(oReponseDlg(91))
end if
end sub



sub AfficherPointsNavig
Dim j as integer, i as integer

repererPoint

if nPoints &lt; 2 then 
  msgbox(oReponseDlg(92), 0, &quot;AHmath3D&quot;)
  Exit Sub
end if

nElements = oPageTemp.count

j=0
if oPageTemp(eZorder).Name = &quot;ah2D_point&quot; then
  for i = 0 to nPoints - 1
  if abs(TabPointX(i) - (sx0 + sx1)/2) &lt; 10 and abs(TabPointY(i) - (sy0 + sy1)/2) &lt; 10 then j = i
  next


pxa = TabPointX(j)
pya = TabPointY(j)

if pxa &lt;&gt; TabPointX(0) and pya &lt;&gt; TabPointY(0) then
  pxb = TabPointX(0)
  pyb = TabPointY(0)
  else
  pxb = TabPointX(1)
  pyb = TabPointY(1)
end if
end if  

if oPageTemp(eZorder).Name &lt;&gt; &quot;ah2D_point&quot; then
pxa = TabPointX(0)
pya = TabPointY(0)
pxb = TabPointX(1)
pyb = TabPointY(1)

end if

CercleDraw(pxa,pya,200)
CercleDraw(pxb,pyb,200)
oPageTemp(nElements).FillStyle = com.sun.star.drawing.FillStyle.SOLID
oPageTemp(nElements + 1).FillStyle = com.sun.star.drawing.FillStyle.SOLID
oPageTemp(nElements).FillColor  = RGB(255,0,0)
oPageTemp(nElements + 1).FillColor  = RGB(38,251,123)
oPageTemp(nElements).Name = &quot;PointAB&quot;
oPageTemp(nElements+1).Name = &quot;PointAB&quot;


end sub





sub AfficherPointB
Dim j as integer, i as integer

  repererPoint
  pxb = TabPointX(0)
  pyb = TabPointY(0)

nElements = oPageTemp.count
CercleDraw(pxb,pyb,200)
oPageTemp(nElements).FillStyle = com.sun.star.drawing.FillStyle.SOLID
