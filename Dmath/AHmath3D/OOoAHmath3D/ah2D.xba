sub Bissectriceah2D
Dim v1 as variant, v2 as variant, vOM as variant,  lg1 as double, lg2 as double, lgOM as variant, zorderBis as integer
Dim ptI as variant, ptJ as variant, ptM as variant, ptO as variant
nAjout = 0

codageAngle1(0 , intersZorder(0), intersZorder(1), &quot;aucun&quot; , true )
if SauvCodageAngle(8) = &quot;parallele&quot; then Exit sub
v1 = SauvCodageAngle(4)
v2 = SauvCodageAngle(5)
ptO = array(SauvCodageAngle(0), SauvCodageAngle(1))
ptI = array(ptO(0) + 1000*v1(0)/SauvCodageAngle(6) , ptO(1) + 1000*v1(1)/SauvCodageAngle(6))
ptJ = array(ptO(0) + 1000*v2(0)/SauvCodageAngle(7) , ptO(1) + 1000*v2(1)/SauvCodageAngle(7))
ptM = array((ptI(0) + ptJ(0))/2 , (ptI(1) + ptJ(1))/2)
vOM = array(ptM(0) - ptO(0) , ptM(1) - ptO(1))
lgOM = sqr(vOM(0) * vOM(0) + vOM(1) * vOM(1))

segmentDraw(ptO(0),ptO(1),ptO(0) + 5000*vOM(0)/lgOM,ptO(1) + 5000*vOM(1)/lgOM,30, &quot;plein&quot;)
nAjout = nAjout + 1

zorderBis = oPageTemp.count - 1
CodageAngleX(intersZorder(0) , zorderBis, oReponseDlg(5), oReponseDlg(6) )
CodageAngleX(intersZorder(1) , zorderBis, oReponseDlg(5), oReponseDlg(6) )
initialisationIntersection


end sub


