end sub

sub Cercle_click
Dim oSelectionListe as integer
oSelectionListe = ReponseListe(monDlg,&quot;ListBox1&quot;)(1)

if oSelectionListe &lt; 2 or oSelectionListe = 6 then
monDlg.getControl(&quot;TextField5&quot;).Model.EnableVisible = false
monDlg.getControl(&quot;Label6&quot;).Model.EnableVisible = false
monDlg.getControl(&quot;UL3&quot;).Model.EnableVisible = false
end if
