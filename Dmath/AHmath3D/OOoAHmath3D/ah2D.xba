&apos;CERCLE TANGENT

Option Explicit

Private sLong as double, sAngle as double, sx0 as double, sy0 as double, sx1 as double, sy1 as double
Private pxa as double, pya as double, pxb as double, pyb as double
Private XCadre as double, YCadre as double, XCadreTemp as double, YCadreTemp as double
Private ah2DStep as integer,  SelectionOK as integer, repDialogue as integer
Private nElements as integer, oTypeElement as string, nAjout as integer, oElement as object
Private indexSelection as integer, sCouleur as Long, sEpaisseur as integer,sPointille as integer, eZorder as integer   Rem eZorder = ordre de l&apos;élément sélectionné
Private PositionSelection As New com.sun.star.awt.Point, numBoutonmenu as integer
Private nPoints as integer, TabPointX as variant, TabPointY as variant
Private intersZorder(1) as integer, sAngleInters(1) as double, sLongInters(1) as double, sEpaisseurInters(1) as integer, sCouleurInters(1) as Long, sPointilleInters(1) as integer
Private point1X(1) as double, Point1Y(1) as double, point2X(1) as double, Point2Y(1) as double, intersName(1) as string, intersType(1) as string
Private SauvCodageAngle as variant, oListeDroite as variant, indDroite as integer


sub MacroPrincipale
Dim i as integer

oDocActif = ThisComponent
if oDocActif.ImplementationName = &quot;SwXTextDocument&quot; then oPageActive = oDocActif.DrawPage
if oDocActif.ImplementationName = &quot;SdXImpressDocument&quot; then oPageActive = oDocActif.DrawPages(0)

ah2D_TestSelection
if SelectionOK = -1 then 
  Exit sub
end if

if SelectionOK = 1 then
&apos;-------------repositionnement de la forme dégroupée-------------------------------
indexSelection = ThisComponent.CurrentSelection(0).Zorder
XCadre = oPageActive.GetByIndex(indexSelection).Position.X      REM position du dessin sur la page active
YCadre = oPageActive.GetByIndex(indexSelection).Position.Y
PositionSelection.X = XCadre
PositionSelection.Y = YCadre
DispatchSimple(&quot;Copy&quot;, oDocActif.CurrentController.Frame)
&apos;----------------------------------------------------------------------------------
end if

   ChargerDoc(true)
   oDocTemp.Title = &quot;AH2D&quot;
   oPageTemp.Name = &quot;AH2D_Temp&quot;
   
if SelectionOK = 1 then    &apos;la selection est un objet déjà créé
   DispatchSimple(&quot;Paste&quot;, oDocTemp.CurrentController.Frame)
   GroupCleaner(4,oDocTemp,false)
   PremierLancement
   
   if oTypeElement = &quot;Aucun&quot; then
       oDocTemp.close(true)
       Exit Sub
   end if
   if oTypeElement = &quot;Ligne&quot; then InfoSegment(eZorder,oPageTemp)
   if oTypeElement = &quot;Cercle&quot; then InfoCercle(eZorder,oPageTemp)
   oPageTemp(eZorder).LineWidth = sEpaisseur + 100
   oPageTemp(eZorder).LineColor = RGB(0,0,255)
   oDocTemp.Currentcontroller.Select(Null)
end if


  
monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;ah2dDlg&quot;)
PositionDlg(monDlg,120,150)

&apos;------------------------ récupération des messages d&apos;erreurs et des infobulles ------
for i = 1 to 29
oReponseDlg(i + 70) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	
AffecterImageFixe(monDlg, &quot;CommandButton56&quot; , CheminDessin(&quot;Dessins/ah2D/relier2points25.png/&quot;) )
AffecterImageFixe(monDlg, &quot;CommandButton50&quot; , CheminDessin(&quot;Dessins/ah2D/point25.png/&quot;) )
AffecterImageFixe(monDlg, &quot;CommandButton51&quot; , CheminDessin(&quot;Dessins/ah2D/segment25.png/&quot;) )
AffecterImageFixe(monDlg, &quot;CommandButton52&quot; , CheminDessin(&quot;Dessins/ah2D/triangle25.png/&quot;) )
