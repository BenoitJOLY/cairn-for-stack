sub initialisationIntersection
   if intersZorder(0) &lt;&gt; -1 then
   oPageTemp(intersZorder(0)).LineWidth = sEpaisseurInters(0)
   oPageTemp(intersZorder(0)).LineColor = sCouleurInters(0)
   oPageTemp(intersZorder(0)).LineStyle = sPointilleInters(0)
   end if
   if intersZorder(1) &lt;&gt; -1 then
   oPageTemp(intersZorder(1)).LineWidth = sEpaisseurInters(1)
   oPageTemp(intersZorder(1)).LineColor = sCouleurInters(1)
   oPageTemp(intersZorder(1)).LineStyle = sPointilleInters(1)
   end if
   intersZorder(0) = -1
   intersZorder(1) = -1
   monDlg.GetControl(&quot;Label47&quot;).Model.BackgroundColor = RGB(255,255,255)
   monDlg.GetControl(&quot;CommandButton33&quot;).Model.State = 0
   monDlg.GetControl(&quot;Label49&quot;).Model.BackgroundColor = RGB(255,255,255)
   monDlg.GetControl(&quot;CommandButton34&quot;).Model.State = 0
end sub


