sub SupprimerElement_click
dim testElementestPoint as boolean, morceauPoint as integer

testElementestPoint = false
SupprimePoints_AB
nElements = oPageTemp.count
morceauPoint = -1

if nElements &gt; 1 then
  if oPagetemp(eZorder).Name = &quot;ah2D_point&quot; then
     testElementestPoint = true
     morceauPoint = OrdreElement2(eZorder)
     if morceauPoint &gt; eZorder then morceauPoint = morceauPoint - 1   &apos;decalage de 1 du à la supression du premier segment
  end if
  oPagetemp.Remove(oPagetemp(eZorder)) 
  if eZorder = 0 then eZorder = nElements - 2 else eZorder = eZorder - 1  
  
  if morceauPoint &gt;=0 then
    oPagetemp.Remove(oPagetemp(morceauPoint)) 
    if eZorder = nElements - 2 then eZorder = nElements - 3
  end if
  
   oTypeElement = TypeForme(oPageTemp(eZorder))
   if oTypeElement = &quot;Ligne&quot; then InfoSegment(eZorder,oPageTemp)
   if oTypeElement = &quot;Cercle&quot; then InfoCercle(eZorder,oPageTemp)
    sEpaisseur = oPageTemp(eZorder).LineWidth
    sCouleur = oPageTemp(eZorder).LineColor
    oPageTemp(eZorder).LineWidth = sEpaisseur + 100
    oPageTemp(eZorder).LineColor = RGB(0,0,255)
    monDlg.getControl(&quot;info1&quot;).Text = sLong
    monDlg.getControl(&quot;info2&quot;).Text = sAngle
    if oTypeElement = &quot;Ligne&quot; then monDlg.getControl(&quot;Label2&quot;).Text = oReponseDlg(84)   else   monDlg.getControl(&quot;Label2&quot;).Text = oReponseDlg(85)
    AffichageApercu
    nAjout = 0
    else
    msgbox(oReponseDlg(86), 0, &quot;AHmath3D&quot;)
end if

end sub


