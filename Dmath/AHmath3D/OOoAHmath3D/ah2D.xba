sub codageLong(oSegment as object, k as integer, angleCodage as integer)
Dim PointsX(2) as variant, PointsY(2) as variant, i as integer,j as integer
Dim oMilieu as variant
Dim oAngle as double

oAngle = oSegment.RotateAngle
oMilieu = MilSgtDraw(oSegment)

for j = 1 to k

PointsX(0) = oMilieu(0) + (j-k/2) * 75 * cos(oAngle * pi/18000)  + 100*cos((oAngle - angleCodage)*pi/18000)
PointsY(0) = oMilieu(1) - (j-k/2) * 75 * sin(oAngle * pi/18000) - 100*sin((oAngle - angleCodage)*pi/18000)
PointsX(1) = oMilieu(0) + (j-k/2) * 75 * cos(oAngle * pi/18000) 
PointsY(1) = oMilieu(1) - (j-k/2) * 75 * sin(oAngle * pi/18000)
PointsX(2) = oMilieu(0) + (j-k/2) * 75 * cos(oAngle * pi/18000)  + 100*cos((oAngle + angleCodage)*pi/18000)
PointsY(2) = oMilieu(1) - (j-k/2) * 75 * sin(oAngle * pi/18000) - 100*sin((oAngle + angleCodage)*pi/18000)
LigneBrisee(PointsX, PointsY, 30)
next

end sub


sub coderSegment(oSeul as Boolean, nTraits as integer, angleCodage as integer)
Dim i as integer

nAjout = 0
if oSeul = true then
 codageLong(oPageTemp(eZorder), nTraits, angleCodage)
 nAjout = 1
end if

if oSeul = false then
  nElements = oPageTemp.Count
    for i = 0 to nElements - 1
      if TypeForme(oPageTemp(i)) = &quot;Ligne&quot; then
         if LgSgtDraw(oPageTemp(i)) = sLong then         
           codageLong(oPageTemp(i), nTraits, angleCodage)
           nAjout = nAjout + nTraits
         end if
      end if
    next
end if

end sub


function CoordInters(Ligne1 as object, Ligne2 as object) as variant
Dim a0 as double, b0 as double, c0 as double, a1 as double,b1 as double,c1 as double
Dim xP1 as double, yP1 as double, var(2) as variant
Dim e as double, f as double, g as double, h as double, test as double
Dim angle1 as integer, angle2 as integer

if sAngleInters(0) &lt; 0 then angle1 = FIX((sAngleInters(0) + 180)*100) else angle1 = FIX(sAngleInters(0)*100)
if sAngleInters(1) &lt; 0 then angle2 = FIX((sAngleInters(1) + 180)*100) else angle2 = FIX(sAngleInters(1)*100)

&apos; equation cartesienne des droites
    a0 = Point2Y(0) - Point1Y(0)
    b0 = -(Point2X(0) - Point1X(0))
    c0 = Point1X(0)*(-a0) + Point1Y(0)*(-b0)
 
    a1 = Point2Y(1) - Point1Y(1)
    b1 = -(Point2X(1) - Point1X(1))
    c1 = Point1X(1)*(-a1) + Point1Y(1)*(-b1)
     
    &apos;if a0*Point1X(1) + b0*Point1Y(1) + c0 = 0 then
    if (Point2X(0) - Point1X(0))*(Point1Y(1) - Point1Y(0)) - (Point2Y(0) - Point1Y(0))*(Point1X(1) - Point1X(0)) = 0 then &apos;AB vect AC = 0
    var(0) = &quot;confondues&quot;
    
    e = sqr((Point1X(1) - Point1X(0))*(Point1X(1) - Point1X(0)) + (Point1Y(1) - Point1Y(0))*(Point1Y(1) - Point1Y(0)))
    f = sqr((Point1X(1) - Point2X(0))*(Point1X(1) - Point2X(0)) + (Point1Y(1) - Point2Y(0))*(Point1Y(1) - Point2Y(0)))
    g = sqr((Point2X(1) - Point1X(0))*(Point2X(1) - Point1X(0)) + (Point2Y(1) - Point1Y(0))*(Point2Y(1) - Point1Y(0)))
    h = sqr((Point2X(1) - Point2X(0))*(Point2X(1) - Point2X(0)) + (Point2Y(1) - Point2Y(0))*(Point2Y(1) - Point2Y(0)))
    test = MinMax(array(e,f,g,h))(0)
    if test = e then Var = array(&quot;confondues&quot;, (Point1X(1) + Point1X(0))/2, (Point1Y(1) + Point1Y(0))/2
    if test = f then Var = array(&quot;confondues&quot;, (Point1X(1) + Point2X(0))/2, (Point1Y(1) + Point2Y(0))/2
    if test = g then Var = array(&quot;confondues&quot;, (Point2X(1) + Point1X(0))/2, (Point2Y(1) + Point1Y(0))/2
    if test = h then Var = array(&quot;confondues&quot;, (Point2X(1) + Point2X(0))/2, (Point2Y(1) + Point2Y(0))/2
    end if
  
    if angle1 = angle2 and var(0) &lt;&gt; &quot;confondues&quot; then   &apos;(a0*b1-a1*b0) = 0
    var(0) = &quot;paralleles&quot;
    var(1) = 0
    var(2) = 0
    end if
    
    if angle1 &lt;&gt; angle2 then &apos;(a0*b1-a1*b0) &lt;&gt; 0
      xP1 = (b0*c1-b1*c0)/(a0*b1-a1*b0)
      yP1 = (a0*c1-a1*c0)/(a1*b0-a0*b1)
      var(0) = &quot;secantes&quot;
      var(1) = xP1
      var(2) = yP1
    end if
    CoordInters = var
end function



sub Ligne_Click(NomBouton as string, NomLabel as string, numLigneActive as integer, numLignePassive as integer)  &apos;numLigneActive = 0 ou 1
if monDlg.GetControl(NomBouton).Model.State = 1 then
   InfoInters(numLigneActive)
   ElementSuivant
   if intersZorder(numLignePassive) = eZorder then ElementSuivant

   if (intersType(numLigneActive) = &quot;Ligne&quot; and intersName(1) &lt;&gt; &quot;ah2D_point&quot;) then
       if intersZorder(numLigneActive) &lt;&gt; intersZorder(numLignePassive) then
          oPageTemp(intersZorder(numLigneActive)).LineColor = RGB(38,251,123)
          oPageTemp(intersZorder(numLigneActive)).LineWidth = sEpaisseur + 100
          monDlg.GetControl(NomLabel).Model.BackgroundColor = RGB(38,251,123)
       else
          msgbox (oReponseDlg(90), 0, &quot;AHmath3D&quot;)
          monDlg.GetControl(NomBouton).Model.State = 0
          intersZorder(numLigneActive) = -1
       end if
   else
       msgbox(oReponseDlg(95), 0, &quot;AHmath3D&quot;)
       monDlg.GetControl(NomBouton).Model.State = 0
       intersZorder(numLigneActive) = -1
   end if

Else
   oPageTemp(intersZorder(numLigneActive)).LineColor = sCouleurInters(numLigneActive)
   oPageTemp(intersZorder(numLigneActive)).LineWidth = sEpaisseurInters(numLigneActive)
   intersZorder(numLigneActive) = -1
   monDlg.GetControl(NomLabel).Model.BackgroundColor = RGB(255,255,255)
end if

end sub


