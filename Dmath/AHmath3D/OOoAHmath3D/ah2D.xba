angleY = Array(milAB(1) + oReponseDlg(5)*vAB(0)/lgAB , milAB(1) + oReponseDlg(5)*(vAB(0) + vAB(1))/lgAB , milAB(1) + oReponseDlg(5)*vAB(1)/lgAB)
LigneBrisee(angleX, angleY)
