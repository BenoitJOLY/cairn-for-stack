sub bougerPoint_click(k as integer, xp as double, yp as double,xs as double, ys as double, nomPoint as string, optional PtBseul as boolean)   
Dim i as integer, j as integer, oIndice as integer

If IsMissing(PtBseul) then PtBseul = false   &apos;pour ne bouger qu&apos;un seul point

if nPoints &gt; 1 then


for i = 0 to nPoints - 1
if xp = TabPointX(i) and yp = TabPointY(i) then j = i
Next
if k = 1 then
 if j &lt; nPoints -1 then
 xp = TabPointX(j + 1)
 yp = TabPointY(j + 1)
 oIndice = j+1
 else
 xp = TabPointX(0)
 yp = TabPointY(0)
 oIndice = 0
 end if
 if PtBseul = false then
   if xp = xs and yp = ys then
     if xp = TabPointX(nPoints - 1) and yp = TabPointY(nPoints - 1) then
     xp = TabPointX(0)
     yp = TabPointY(0)
     else
     xp = TabPointX(oIndice + 1)
     yp = TabPointY(oIndice + 1)
     end if
   end if
 end if
end if
if k = -1 then
 if j &gt; 0 then
 xp = TabPointX(j - 1)
 yp = TabPointY(j - 1)
 oIndice = j-1
 else
 xp = TabPointX(nPoints -1)
 yp = TabPointY(nPoints -1)
 oIndice = nPoints -1
 end if
if PtBseul = false then
     if xp = xs and yp = ys then
        if xp = TabPointX(0) and yp = TabPointY(0) then
        xp = TabPointX(nPoints -1)
        yp = TabPointY(nPoints -1)
        else
        xp = TabPointX(oIndice - 1)
        yp = TabPointY(oIndice - 1)
        end if
     end if
end if
end if  
  nElements = oPageTemp.count
  
  if nomPoint = &quot;A&quot; then 
  oPagetemp.Remove(oPagetemp(nElements - 2))
  CercleDraw(xp,yp,200) 
  oPageTemp(nElements-1).FillStyle = com.sun.star.drawing.FillStyle.SOLID
  oPageTemp(nElements-1).FillColor  = RGB(255,0,0)
  oPageTemp(nElements-1).Name = &quot;PointAB&quot;
  oPageTemp(nElements - 1).Zorder  = nElements -2
  
  else
  oPagetemp.Remove(oPagetemp(nElements - 1))
  CercleDraw(xp,yp,200) 
  oPageTemp(nElements-1).FillStyle = com.sun.star.drawing.FillStyle.SOLID
  oPageTemp(nElements-1).FillColor  = RGB(38,251,123)
  oPageTemp(nElements-1).Name = &quot;PointAB&quot;
  end if
end if

end sub


sub PointA_droite
bougerPoint_click(1, pxa, pya,pxb,pyb,&quot;A&quot;)
end sub

sub PointA_gauche
bougerPoint_click(-1, pxa, pya,pxb,pyb,&quot;A&quot;)
end sub

