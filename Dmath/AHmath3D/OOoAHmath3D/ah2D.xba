sub AffichageApercu
Dim ChoixApercu as integer, i as integer

if oTypeElement = &quot;Ligne&quot; and oPageTemp(eZorder).Name &lt;&gt; &quot;ah2D_point&quot; then
for i = -12 to 12
if abs(15*i - sAngle)&lt;= 7.5 then ChoixApercu = 15*i
next
AffecterImageFixe(monDlg, &quot;ImageControl1&quot; , CheminDessin(&quot;Dessins/ah2D/apercu_&quot; &amp; ChoixApercu &amp; &quot;.png/&quot;) )
end if

if oPageTemp(eZorder).Name = &quot;ah2D_point&quot; then AffecterImageFixe(monDlg, &quot;ImageControl1&quot; , CheminDessin(&quot;Dessins/ah2D/apercu_point.png/&quot;) )

if oTypeElement = &quot;Cercle&quot; then AffecterImageFixe(monDlg, &quot;ImageControl1&quot; , CheminDessin(&quot;Dessins/ah2D/apercu_cercle.png/&quot;) )

if oTypeElement &lt;&gt; &quot;Cercle&quot; and  oTypeElement &lt;&gt; &quot;Ligne&quot; then AffecterImageFixe(monDlg, &quot;ImageControl1&quot; , CheminDessin(&quot;Dessins/ah2D/nonreconnu.png/&quot;) )


end sub


sub InfoSegment(ordreElement as integer, oPage as object)              REM collecte les informations du segment
   sx0 = oPage(ordreElement).Polygon(0).X    &apos; abscisse point A
   sy0 = oPage(ordreElement).Polygon(0).Y    &apos; ordonnée point A
   sx1 = oPage(ordreElement).Polygon(1).X    &apos; abscisse point B
   sy1 = oPage(ordreElement).Polygon(1).Y    &apos; ordonnée point B
   sLong = CInt(sqr((sx1-sx0)*(sx1 - sx0) + (sy1-sy0)*(sy1-sy0))/10)/100   &apos;longueur du segment
   sAngle = oPage(ordreElement).RotateAngle /100     &apos;Angle du segment avec l&apos;horizontal
   if sAngle &gt; 180 then sAngle = sAngle - 360
   sPointille = oPage(ordreElement).LineStyle
   sEpaisseur = oPageTemp(ordreElement).LineWidth
   sCouleur = oPageTemp(ordreElement).LineColor
   
   
end sub


sub InfoCercle(ordreElement as integer, oPage as object)           REM collecte les informations du cercle
Dim  x0 as integer, y0 as integer
    
    sAngle = 0
    oPage(ordreElement).RotateAngle = sAngle   
    x0 = oPage(ordreElement).Position.X    &apos; abscisse coin haut droit du cadre
    y0 = oPage(ordreElement).Position.Y    &apos; ordonnée coin haut droit du cadre
    sLong = CInt((oPage(ordreElement).Size.Height)/10)/100   &apos;Diamètre
    sx0 = x0 + sLong*1000/2      &apos; abscisse du centre du cercle
    sy0 = y0 + sLong*1000/2      &apos; ordonnée du centre du cercle
    sPointille = oPage(ordreElement).LineStyle
    sEpaisseur = oPageTemp(ordreElement).LineWidth
    sCouleur = oPageTemp(ordreElement).LineColor
end sub


sub InfoInters(k as integer)
intersType(k) = TypeForme(oPageTemp(eZorder))
intersZorder(k) = eZorder
sAngleInters(k) = sAngle
sLongInters(k) = sLong
intersName(k) = oPageTemp(eZorder).Name
point1X(k) = sx0
Point1Y(k) = sy0
point2X(k) = sx1
Point2Y(k) = sy1
sEpaisseurInters(k) = sEpaisseur
sCouleurInters(k) = sCouleur
sPointilleInters(k) = sPointille

end sub

sub MiniInfoSegment(k as integer, oZorder as integer)
point1X(k) = oPageTemp(oZorder).Polygon(0).X
Point1Y(k) = oPageTemp(oZorder).Polygon(0).Y
point2X(k) = oPageTemp(oZorder).Polygon(1).X
Point2Y(k) = oPageTemp(oZorder).Polygon(1).Y
intersZorder(k) = oZorder
sAngleInters(k) = oPageTemp(oZorder).RotateAngle /100
   if sAngleInters(k) &gt; 180 then sAngleInters(k) = sAngleInters(k) - 360
end sub


