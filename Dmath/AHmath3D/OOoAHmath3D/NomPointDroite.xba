Option Explicit

Private ahTaille As Integer, ahPolice As String, ahGras As Boolean , ahItalique As Boolean
Private ahPositionY As Integer, ahHauteurPage As Integer, nbreLigne as integer
Private PoliceDoc as string
private monDlg2 as object, champProgres1 As Object, quotient as integer    &apos;var liés à la barre de progression
private largeurPage as integer, hauteurPage as integer

&apos;--------------------------------------------------------------------------------

sub MacroPrincipaleNomPointDroite &apos;macro principale
Dim NbreZones as integer 

Deselection
largeurPage = dimPage(false,).x
hauteurPage = dimPage(false,).y
Polices_Defaut
appelerDialogue()
if oReponseDlg(86) = true then
DRAWversDocActif(&quot;NomPointDroite.ConstructionZT()&quot;)
PosObjetFinal(LastForme,0,ahPositionY)
NbreZones = DegrouperForme(LastForme) &apos;Dégroupe toutes les zones de texte et renvoie leur nombre
TexteTravers(NbreZones)
SelectionFormes(1) &apos;selectionne la dernière zone de texte
end if
end Sub


&apos;---------------------------------------------------------------------------------------------------
&apos; ici sont les programmes secondaires lancés par la macro Principale
&apos;---------------------------------------------------------------------------------------------------

Sub appelerDialogue()
Dim NomPoint As String, i As Integer, active As Boolean, j as integer, var1 as object, coche As Object
Dim lettre As String, monMessage as string
	
monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;InserZoneDlg&quot;)
PositionDlg(monDlg,120,150)


&apos;------------------------------------------------------------------------
&apos;récupération des données du dialogue dans oReponseDlg
&apos;-------------------------------------------------------------------------

if monDlg.execute = com.sun.star.ui.dialogs.ExecutableDialogResults.OK then

    for i = 1 to 86
        coche = monDlg.getControl(&quot;lettre_&quot;&amp;i)  &apos; coche = case à cocher nommée lettre_i
        active = coche.Model.State                        &apos; active = true si la boite à cocher est cochée

       if active = true then                       &apos; si active = true alors l&apos;étiquette de la boite à cocher est stockée dans une cellule de la variable &quot;montableau&quot;
          lettre = trad(monDlg, coche.Model.Label)
          oReponseDlg( i - 1) = lettre
       else
          oReponseDlg (i - 1) = &quot;0&quot;
       end if
  Next  
&apos; ------------met fin à la macro dans le cas ou aucune lettre n&apos;est cochée -----------------------------------------
dim test as boolean
test = false
for i = 1 to  86
if oReponseDlg (i - 1) &lt;&gt; &quot;0&quot; then
test = true
end if
next
if test = false then
monMessage = monDlg.getControl(&quot;Message3&quot;).Peer.Text
msgbox(monMessage)
end
end if
&apos;----------------------------------------------------------------------------------------------------------

  ahTaille = monDlg.getControl(&quot;NumericField1&quot;).Value     &apos; récupération de la taille de la police
  ahPolice = monDlg.getControl(&quot;Police&quot;).Text     &apos; récupération de la police d&apos;écriture
  ahGras = monDlg.getControl(&quot;BoutonGras&quot;).State          &apos; récupération des options gras et italique
  ahItalique = monDlg.getControl(&quot;BoutonItalique&quot;).State

  if monDlg.getControl(&quot;BoutonHaut&quot;).State then ahPositionY = 1   &apos; récupération du positionnement sur la page
  if monDlg.getControl(&quot;BoutonMilieu&quot;).State then ahPositionY = 2
  if monDlg.getControl(&quot;BoutonBas&quot;).State then ahPositionY = 3

   oReponseDlg(86) = true &apos;renvoie true si la boite de dialogue est fermée par le bouton OK
end if
	
monDlg.dispose
End Sub


&apos;----------------------------------------------------------------------------------------------------------------------
&apos;affiche une zone de texte contenant le texte contenu dans la variable ahPoint
&apos;----------------------------------------------------------------------------------------------------------------------

Sub ZoneDeTexte(ahPoint as string)
Dim ahZone as Object, monCurseur As Object, monDocument As Object, monTexte As Object, ahEspion as object, ahChaine As Object, Page as object
Dim i As Integer, ahCurseurVisible As object


monDocument = oDocTemp
Page = oPageTemp


	ahZone = monDocument.createInstance(&quot;com.sun.star.drawing.TextShape&quot;)
	Page.add(ahZone)
    ahZone.TextAutoGrowHeight = true &apos;la hauteur de la zone s&apos;adapte au contenu du texte
    ahZone.TextAutoGrowWidth = true  &apos;la largeur de la zone s&apos;adapte au contenu du texte
  	ahZone.LineStyle = com.sun.star.drawing.LineStyle.NONE               &apos;pas de cadre
   	ahZone.String = ahPoint	
    ahZone.CharWeight = IIf(ahGras,150,100) 
    ahZone.CharPosture = IIf(ahItalique,1,0)
    ahZone.CharFontName = ahPolice                                        &apos;police d&apos;écriture
    ahZone.CharHeight = ahTaille


&apos; mets en indice les chiffres pour (d1) (d2) etc ...   
    for i = 1 to 6
      if ahPoint = &quot;(d&quot; &amp; i &amp;&quot;)&quot; then
    ahChaine = ahZone.Text
    ahEspion = ahChaine.createTextCursor
    ahEspion.gotoStart(False)
    ahEspion.goRight(2,False)
    ahEspion.goRight(1,True)
    ahEspion.CharEscapement = -20
    ahEspion.CharEscapementHeight = 70
    ahEspion.String = i
      end if
   Next

End sub



&apos;---------------------------------------------------------------------------------
sub ConstructionZT()
Dim j As Integer, ahTexte As String, decalage As Long, LargeurTotale As Long, maZoneTexte as object, posTxtLigne as integer
Dim  positionForme As New com.sun.star.awt.Point

decalage = 1000
LargeurTotale = 0
&apos;récupère le texte contenu dans mon tableau et teste si cette valeur est différente de 0
&apos;Si cette valeur est différente de zéro, elle est copiée dans la variable Point
&apos;La variable Point est récupérée par la macro ZoneDeTexte qui l&apos;affiche
if oReponseDlg(86) = true then
for j = 1 to 86
ahTexte = oReponseDlg (j - 1)
  if ahTexte &lt;&gt; &quot;0&quot; then
     &apos; --------------------------------------------gère l&apos;affichage sur plusieurs lignes
     nbreLigne = Int(LargeurTotale/largeurPage)
     posTxtLigne = LargeurTotale mod largeurPage
     positionForme.x = posTxtLigne
     positionForme.y = 1000*nbreLigne
    
     ZoneDeTexte(ahTexte)
     maZoneTexte = LastForme(oDocTemp)
     maZoneTexte.position = positionForme
     LargeurTotale = 500 + LargeurTotale + maZoneTexte.Size.Width  &apos;Largeur totale des zones de texte espacés de 5 mm
     
  end if
      
Next
end if

if ahPositionY = 1 then ahPositionY = 0
if ahPositionY = 2 then ahPositionY = CInt(hauteurPage/2)
if ahPositionY = 3 then ahPositionY = hauteurPage - (nbreLigne +1) * 1000

end sub



&apos;************************************************************************************************
&apos;********************  Gestion des polices de caractères  ***************************************
&apos;************************************************************************************************

  
  
&apos;-------------------------------------------------------------------------------------
&apos;Police selectionnée dans le document WRITER
&apos; Arial par defaut pour Draw
&apos;function inspirée d&apos;une procédure de Cmath de Christophe Devalland 
&apos;-------------------------------------------------------------------------------------
function PoliceActive as string
dim oViewCursor as object, oTextCursor as object, sPolice as string

oDocActif = ThisComponent

if oDocActif.ImplementationName = &quot;SwXTextDocument&quot; then
  oPageActive = oDocActif.DrawPage
  oViewCursor = oDocActif.getCurrentController().getViewCursor()
  oTextCursor=oViewCursor.Text.createTextCursorByRange(oViewCursor)
  sPolice=oTextCursor.CharFontName
else
  sPolice = &quot;Arial&quot;
end if	
  PoliceActive = sPolice
end function  


&apos;-------------------------------------------------------------------------------------
&apos;Defini la variable ahPolicesBasiques au demarrage de la macro principale
&apos;-------------------------------------------------------------------------------------
  
sub Polices_Defaut
Dim i as integer, policeTrouvee as boolean
Dim oPolicesBasiques() as string

PoliceDoc = PoliceActive
policeTrouvee = false
oPolicesBasiques = Array(&quot;Arial&quot;,&quot;Atalante&quot;,&quot;Book Antiqua&quot;,&quot;Calibri&quot;,&quot;Century&quot;,&quot;Comic Sans MS&quot;,_
&quot;Courrier&quot;,&quot;DejaVu Serif&quot;,&quot;Franklin&quot;,&quot;Garamond&quot;,&quot;Georgia&quot;,&quot;Liberation Serif&quot;,&quot;Tahoma Helvetica&quot;,&quot;Times New Roman&quot;,&quot;Verdana&quot;)

if IsEmpty(ah3DTest) = false then
  exit sub   &apos;ah3Dmespolices est déjà défini
end if


&apos;ajoute la police active (curseur) a la liste si elle n&apos;est pas présente
for i = 0 to 14
if oPolicesBasiques(i) = PoliceDoc then policeTrouvee = true
next
if policeTrouvee &lt;&gt; true then
 ah3Dmespolices = Array(PoliceDoc,&quot;Arial&quot;,&quot;Atalante&quot;,&quot;Book Antiqua&quot;,&quot;Calibri&quot;,&quot;Century&quot;,&quot;Comic Sans MS&quot;,_
&quot;Courrier&quot;,&quot;DejaVu Serif&quot;,&quot;Franklin&quot;,&quot;Garamond&quot;,&quot;Georgia&quot;,&quot;Liberation Serif&quot;,&quot;Tahoma Helvetica&quot;,&quot;Times New Roman&quot;,&quot;Verdana&quot;)
else
ah3Dmespolices = oPolicesBasiques()
end if

end sub

&apos;---------------------------------------------------------------------------------------
&apos;chargement de toutes les polices
&apos;---------------------------------------------------------------------------------------


sub ChargerPolices_Click
Dim monMessage as string

 if Not IsLO5Win64 then
  monDlg2 = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;BarreProgDlg&quot;)
  monDlg2.execute
  ah3DTest = &quot;programme déjà effectué&quot;
  monDlg2.Dispose
  gestioncasePolice
  else
  monMessage = monDlg.getControl(&quot;Message5&quot;).Peer.Text
  msgbox(monMessage)
 end if
end sub



&apos;-------------------------------------------------------------------------------
&apos;sub inspirée sur Cmath de Christophe Devalland 
&apos;Modif : ajout d&apos;une barre de progression BarreProgDlg
&apos;-------------------------------------------------------------------------------

sub  GestionBarreProgression

  Dim oWindow          &apos;Container window AWT XDevice interface.
  Dim oFonts()         &apos;Array of awt FontDescriptor structures.
  Dim oFinalFonts()    &apos;Font descriptors to return.
  Dim nIndex() As Long &apos;Indirect sorted index into.
  Dim sName$           &apos;Font name.
  Dim i&amp;               &apos;General index variable.
  Dim j&amp;               &apos;General index variable.
  Dim n&amp;               &apos;General utility variable.
  Dim k&amp;               &apos;General utility variable.
  Dim bChanged As Boolean 
  Dim oFontsName()     &apos;Array of string.
  Dim val As Double    &apos;*****ajout à la fonction originale : Val = valeur des barres de progressions


  ChargerDoc (false, &quot;writer&quot;)
  oWindow  = oDocTemp.getCurrentController().getFrame().getContainerWindow()
  oFonts() = oWindow.getFontDescriptors()
  oDocTemp.close(True)
  
  
  ReDim nIndex(UBound(oFonts()))
  n = UBound(oFonts())

 &apos;*****ajout à la fonction originale ****************************************** 
   quotient = int(10000/n)
   champProgres1 = monDlg2.getControl(&quot;ProgressBar1&quot;)
   champProgres1.value = 10000 - n * quotient
   monDlg2.getcontrol(&quot;Label1&quot;).Text = monDlg2.getControl(&quot;Message1&quot;).Peer.Text
 &apos;*****************************************************************************

  For i = 0 to n
    nIndex(i) = i
  Next

  REM Sort the data!
  For i = 0 To n-1
  &apos;*****ajout à la fonction originale ****************************************** 
  val = champProgres1.Value 
  champProgres1.value = ValeurProgressBar(val, 10000, 10000, n ) 
  &apos;*****************************************************************************
    bChanged = False
    For j = 1 To n-i
      If oFonts(nIndex(j-1)).Name &gt; oFonts(nIndex(j)).Name Then
        k = nIndex(j-1)
        nIndex(j-1) = nIndex(j)
        nIndex(j) = k
        bChanged = True
      End If
    Next
    If NOT bChanged Then 
    champProgres1.value = 10000 &apos;*****ajout à la fonction originale 
    Exit For
    end if
  Next

 &apos;*****ajout à la fonction originale ****************************************** 
  champProgres1.value = 10000 - n * quotient + quotient
  monDlg2.getcontrol(&quot;Label1&quot;).Text = monDlg2.getControl(&quot;Message2&quot;).Peer.Text
  &apos;*****************************************************************************
  REM Copy the font descriptor.
  sName = &quot;&quot;
  oFinalFonts() = DimArray(n)
  j = -1
  
  For i = 0 To n
  &apos;*****ajout à la fonction originale ****************************************** 
  val = champProgres1.Value&apos;*****ajout à la fonction originale
  champProgres1.value = ValeurProgressBar(val, 10000, 10000, n ) 
  &apos;*****************************************************************************

    If (sName &lt;&gt; oFonts(nIndex(i)).Name) Then
      j = j + 1
      oFinalFonts(j) = oFonts(nIndex(i))
      sName = oFinalFonts(j).Name
    End If
    
  Next
  ReDim Preserve oFinalFonts(j)
  ReDim oFontsName(j)
  
  for i = 0 to j 
  oFontsName(i) = oFinalFonts(i).Name
  Next
  ah3Dmespolices = oFontsName
  monDlg2.EndExecute

end sub




&apos;-------------------------------------------------------------------------------
&apos;il faut que partage &lt; ecart
&apos;mettre la valeur max de la pabrre de progression à 10000
&apos;-------------------------------------------------------------------------------

function ValeurProgressBar(Val0 as integer, val1 as integer, Ecart as integer, partage as integer) as double
Dim k as integer, var1 as integer

if Val0 + quotient &lt;= Val1 then
ValeurProgressBar = Val0 + quotient
else
ValeurProgressBar = Val1
end if

end function


&apos;------------------------------------------------------------------------------
&apos;affecte la liste des polices à la combobox &quot;police&quot;
&apos;permet de selectionner la police du doc par défaut sur writer
&apos;------------------------------------------------------------------------------


sub gestioncasePolice
Dim k1 as object
k1 = monDlg.getControl(&quot;Police&quot;)

k1.Model.StringItemList = ah3Dmespolices
&apos;end if
k1.Model.Text = PoliceDoc
end sub
</script:module>