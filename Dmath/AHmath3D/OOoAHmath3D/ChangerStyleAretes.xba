Private nElements as integer
private oMouseClickHandler as object
private nbreClick as integer


Sub ChangeStyleArete
dim var as integer, oforme as object, oTypeForme as string, oSelection as object
dim i as integer, clickDouble as boolean
dim defAncre as integer

oDocActif = thisComponent
if oDocActif.ImplementationName = &quot;SwXTextDocument&quot; then oPageActive = oDocActif.DrawPage
if oDocActif.ImplementationName = &quot;SdXImpressDocument&quot; then oPageActive = oDocActif.DrawPages(0)


monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;aoDlg&quot;)
AffecterImageFixe(monDlg, &quot;ImageControl1&quot; , CheminDessin(&quot;Dessins/StyleAretes/Style1.png/&quot;))
AffecterImageFixe(monDlg, &quot;ImageControl2&quot; , CheminDessin(&quot;Dessins/StyleAretes/Style2.png/&quot;))
AffecterImageFixe(monDlg, &quot;ImageControl3&quot; , CheminDessin(&quot;Dessins/StyleAretes/Style3.png/&quot;))

for i = 1 to 7
oReponseDlg(i + 1) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
AffectTextLabel2(monDlg, oReponseDlg(5), &quot;Label1&quot;)
AffectTextLabel2(monDlg, oReponseDlg(6), &quot;Label2&quot;)
monDlg.Model.Title =  oReponseDlg(7)

oSolide = oDocActif.CurrentSelection
oTypeForme = TypeForme(oSolide(0))

if IsNull(oSolide) then
msgbox(oReponseDlg(2),0,&quot;AHmath3D&quot;)
monDlg.Dispose
Exit sub
end if

if oSolide.Count&gt;1 then
 msgbox(oReponseDlg(3),0,&quot;AHmath3D&quot;)
 monDlg.Dispose
 Exit Sub
end if


if oTypeForme = &quot;Aucune forme sélectionnée ou forme non reconnue&quot; then
msgbox(oReponseDlg(2),0,&quot;AHmath3D&quot;)
monDlg.Dispose
Exit sub
end if

On Error GoTo ErreurDegroupage

if oTypeForme &lt;&gt; &quot;Aucune forme sélectionnée ou forme non reconnue&quot; then
if oDocActif.ImplementationName = &quot;SwXTextDocument&quot; then defAncre = oSolide(0).AnchorType
GroupCleaner(3, oDocActif , false)
oSolide = oDocActif.CurrentSelection
end if

nElements = oSolide.count   REM nombre d&apos;éléments de la forme
nFormes = oPageActive.count REM nombre d&apos;éléments de la page

for i = 0 to nElements - 1               REM Place tous les elements de la forme au premier plan
oSolide(i).Zorder = nFormes -1
next

on error GoTo 0

oDocActif.CurrentController.Select(oSolide(0))


monDlg.Execute
monDlg.Model.Step = 2
monDlg.Model.Title =  oReponseDlg(8)
monDlg.SetVisible(true)


RegisterMouseClickAH3D

clickDouble = false                   rem initialisation de la variable
On Error GoTo GestionErreur
While clickDouble = false  

while nbreClick = 0
wait 500
wend

oSelection = ThisComponent.CurrentSelection(0)   rem selection apres clic

if IsNull(oSelection)=false then
if  oSelection.supportsService(&quot;com.sun.star.drawing.LineProperties&quot;) = true then 
    if oSelection.Zorder &gt; nFormes -1 - nElements then
       if oSelection.LineStyle = com.sun.star.drawing.LineStyle.SOLID then
           oSelection.LineStyle = com.sun.star.drawing.LineStyle.DASH
           oSelection.LineDash = oReponseDlg(1)
       else
           oSelection.LineStyle = com.sun.star.drawing.LineStyle.SOLID
     end if
     end if
end if
end if

if nbreClick &gt; 1 then clickDouble = true
nbreClick = 0
wend




FinErreur1:
   On Error GoTo 0 
UnregisterMouseClickAH3D
monDlg.Dispose
SelectionFormes(nElements)
oSolide = LastForme
if oDocActif.ImplementationName = &quot;SwXTextDocument&quot; then oSolide.AnchorType = defAncre

Exit sub

FinErreurDegroupage:
  on Error GoTo 0
  Exit sub


ErreurDegroupage:
msgbox(oReponseDlg(4),0,&quot;AHmath3D&quot;)
Resume FinErreurDegroupage

GestionErreur:
&apos;message = &quot;Aucune forme sélectionnée ou forme non reconnue&quot;
msgbox(oReponseDlg(4),0,&quot;AHmath3D&quot;)
Resume FinErreur1


End Sub

&apos;****************************************************************
&apos;*******************fonctions du listener
&apos;***************************************************************

Sub RegisterMouseClickAH3D
  oDocView = oDocActif.currentController
  oMouseClickHandler = createUnoListener(&quot;SelectArete_&quot;, &quot;com.sun.star.awt.XMouseClickHandler&quot;)
  oDocView.addMouseClickHandler(oMouseClickHandler)
End Sub

Sub UnregisterMouseClickAH3D
 on error resume next
  oDocView.removeMouseClickHandler(oMouseClickHandler)
 on error goto 0
End Sub

Sub SelectArete_disposing(oEvt)
End Sub

Function SelectArete_mousePressed(oEvt) As Boolean
    SelectArete_mousePressed = false
End Function

Function SelectArete_mouseReleased(oEvt) As Boolean
  if oEvt.ClickCount &gt; 0 then nbreClick = oEvt.ClickCount
  SelectArete_mouseReleased = false
End Function


&apos;*******************************************************************************************
sub boutonFin

if monDlg.Model.Step = 1 then
  
  DefTirets
  if monDlg.getControl(&quot;OptionButton1&quot;).State = true then oReponseDlg(1) = IIf (oDocActif.ImplementationName = &quot;SwXTextDocument&quot;, oTiret3D_w , oTiret3D)
  if monDlg.getControl(&quot;OptionButton2&quot;).State = true then oReponseDlg(1) = IIf (oDocActif.ImplementationName = &quot;SwXTextDocument&quot;, oTiret3D_bw , oTiret3D_b)
  if monDlg.getControl(&quot;OptionButton3&quot;).State = true then oReponseDlg(1) = IIf (oDocActif.ImplementationName = &quot;SwXTextDocument&quot;, oTiret3D_cw , oTiret3D_c)

monDlg.EndExecute
end if

end sub

</script:module>