REM  *****  BASIC  *****

Option Explicit

sub PyrRectPcMacroPrincipale &apos;macro principale

appelerBoiteDialoguePyrRectPc()

if oReponseDlg(30) = true then
Deselection   
DRAWversDocActif(&quot;PyrRectPc.ConstructionPyrRectPc()&quot;)
oSolide = LastForme
TailleObjetFinal(oSolide)
PosObjetFinal(oSolide)
end if

end Sub
&apos;------------------------------------------------------------------------------------------------------
Sub appelerBoiteDialoguePyrRectPc()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;PyrRectPcDlg&quot;)
PositionDlg(monDlg,120,150)			
&apos;------------------------ initialisation de la boite de dialogue----------------------
Initialisation_Unites(3,1)		
Initialisation(monDlg,CheminDessin(&quot;Dessins/PyrRect/PyrCarreePC1.gif/&quot;),9)
AffecterImageFixe(monDlg, &quot;ImageSecondaire1&quot; , CheminDessin(&quot;Dessins/PyrRect/PyrCarrePCAngle1.gif/&quot;))
GestionInfoBulle
AfficherPoints
&apos;------------------------ récupération des messages d&apos;erreurs et des infobulles ------
for i = 1 to 4
oReponseDlg(i + 25) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	
monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub

Function CoordSommet(x0 as double,y0 as double) as variant
dim i as integer, AngFuite as double, Longueur as double, Profondeur as double, Hauteur as double, Angle as double
dim Xsommet as double, Ysommet as double, Xbase1 as double, Ybase1 as double, Xbase2 as double, Ybase2 as double, Xbase3 as double, Ybase3 as double, Xbase4 as double, Ybase4 as double
dim mesabscisses as variant, mesordonnees as variant
Angle = oReponseDlg(3)
Longueur = oReponseDlg(0)
Profondeur = oReponseDlg(1)
Hauteur = oReponseDlg(2)
AngFuite = Angle * pi/180

Xbase1 = x0 + Profondeur*cos(AngFuite)*1000
Ybase1 = y0 - Profondeur*sin(AngFuite)*1000
Xbase2 = x0
Ybase2 = y0
Xbase3 = x0+Longueur*1000
Ybase3 = y0
Xbase4 = x0 + Longueur*1000 + Profondeur*cos(AngFuite)*1000 
Ybase4 = y0 - Profondeur*sin(AngFuite)*1000

Xsommet = x0 + (Longueur + Profondeur*cos(AngFuite))*1000/2
Ysommet = y0 - Profondeur * sin(AngFuite) * 1000/2 - Hauteur * 1000

mesabscisses = array(Xsommet,Xbase1,Xbase2,Xbase3,Xbase4)
mesordonnees = array(Ysommet,Ybase1,Ybase2,Ybase3,Ybase4)
CoordSommet = Tableau2xN(mesabscisses,mesordonnees)

end function

sub ConstructionPyrRectPc()
PyramideFinalePC(5000,10000)
end sub


sub StyleAretesPyr(x0 as double, y0 as double,A2 as string, A3 as string, A4 as string,A5 as string, A6 as string, A7 as string, A8 as string )
Dim AngFuite as double, Xsommet as double, Ysommet as double,mescoord as variant

mescoord = CoordSommet(x0,y0)

&apos;tracé de la base
SegmentDraw(mescoord(2)(0),mescoord(2)(1),mescoord(3)(0),mescoord(3)(1) ,30, &quot;plein&quot;)
SegmentDraw(mescoord(3)(0),mescoord(3)(1), mescoord(4)(0),mescoord(4)(1) ,30, A2)
SegmentDraw(mescoord(4)(0),mescoord(4)(1) , mescoord(1)(0),mescoord(1)(1) ,30, A3)
SegmentDraw(mescoord(1)(0),mescoord(1)(1), mescoord(2)(0),mescoord(2)(1) ,30, A4)

&apos;tracé des aretes latérales
SegmentDraw(mescoord(2)(0),mescoord(2)(1), mescoord(0)(0),mescoord(0)(1),30, A5)
SegmentDraw(mescoord(3)(0),mescoord(3)(1) , mescoord(0)(0),mescoord(0)(1) ,30, A6)
SegmentDraw(mescoord(4)(0),mescoord(4)(1) , mescoord(0)(0),mescoord(0)(1),30, A7)
SegmentDraw(mescoord(1)(0),mescoord(1)(1) , mescoord(0)(0),mescoord(0)(1),30, A8)
end sub

sub PyramideFinalePC(x0 as double,y0 as double)
Dim mescoord as variant
dim Angle as double, Angle1 as double, Angle2 as double,Angle3 as double, Angle4 as double
Dim Xcentre as double, Ycentre as double,Style1 as string, Style2 as string, StyleTrait as string

mescoord=CoordSommet(x0,y0)
Angle = oReponseDlg(3)

Xcentre = mescoord(0)(0)
Ycentre = (mescoord(2)(1)+mescoord(4)(1))/2

if mescoord(0)(1)&lt;=MinMax(Lignex(2,mescoord))(0) then
  
   Angle1 = atn((mescoord(1)(0) - mescoord(0)(0))/(mescoord(1)(1) - mescoord(0)(1))
   Angle2 = atn((mescoord(2)(0) - mescoord(0)(0))/(mescoord(2)(1) - mescoord(0)(1))
   Angle3 = atn((mescoord(3)(0) - mescoord(0)(0))/(mescoord(3)(1) - mescoord(0)(1))
   Angle4 = atn((mescoord(4)(0) - mescoord(0)(0))/(mescoord(4)(1) - mescoord(0)(1))

   Style1 = IIf(Angle1&gt;Angle2,&quot;pointillé&quot;,&quot;plein&quot;)
   Style2 = IIf(Angle4&lt;Angle3,&quot;pointillé&quot;,&quot;plein&quot;)

   if Angle&lt;=180 then StyleAretesPyr(x0,y0,Style2,&quot;pointillé&quot;,Style1,&quot;plein&quot;,&quot;plein&quot;,Style2,Style1)
   if Angle&gt;180 and Angle&lt;360 then StyleAretesPyr(x0,y0,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,Style2,Style1)

else
   if Angle &lt;= 180 then StyleAretesPyr(x0,y0,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;)
   if Angle&gt;180 then StyleAretesPyr(x0,y0,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;pointillé&quot;,&quot;pointillé&quot;,&quot;pointillé&quot;)
end if

&apos;-------------------------------------tracé du centre de la base
if oReponseDlg(4) = 1 then PointDraw(Xcentre, YcentreAngle*pi/180 , 30,&quot;plein&quot;)

&apos;-----------------------------------tracé de la hauteur et de l&apos;angle droit ---------------------------------------------------------------------
if oReponseDlg(5) = 1 then
  SegmentDraw(Xcentre, Ycentre ,  mescoord(0)(0) , mescoord(0)(1) , 30,oReponseDlg(15))
  if oReponseDlg(6) = 1  then QuadrilatereDraw(Xcentre, Ycentre ,  Xcentre  , Ycentre - 250 ,Xcentre + 250 , Ycentre - 250 , Xcentre + 250 , Ycentre,)
end if
&apos;------------------------------relier le centre à un sommet ---------------------------------

&apos; le sommet change suivant le dessin affiché
if Angle &lt;= 180 then
    if oReponseDlg(8) = 1 then SegmentDraw(Xcentre, Ycentre ,   mescoord(2)(0) , mescoord(2)(1) , 30, oReponseDlg(17))
    if oReponseDlg(9) = 1 then SegmentDraw(Xcentre, Ycentre , mescoord(3)(0) , mescoord(3)(1) , 30, oReponseDlg(18))
    if oReponseDlg(10) = 1 then SegmentDraw(Xcentre, Ycentre ,  mescoord(4)(0) , mescoord(4)(1) , 30, oReponseDlg(19))
    if oReponseDlg(7) = 1 then  SegmentDraw(Xcentre, Ycentre , mescoord(1)(0) , mescoord(1)(1) , 30, oReponseDlg(16))
    if oReponseDlg(12) = 1 then SegmentDraw(Xcentre, Ycentre ,   (mescoord(2)(0)+ mescoord(3)(0))/2  , (mescoord(2)(1)+ mescoord(3)(1))/2 , 30, oReponseDlg(21))
    if oReponseDlg(13) = 1 then SegmentDraw(Xcentre, Ycentre ,  (mescoord(3)(0)+ mescoord(4)(0))/2  , (mescoord(3)(1)+ mescoord(4)(1))/2 , 30, oReponseDlg(22))
    if oReponseDlg(14) = 1 then SegmentDraw(Xcentre, Ycentre ,  (mescoord(4)(0)+ mescoord(1)(0))/2  , (mescoord(4)(1)+ mescoord(1)(1))/2 , 30, oReponseDlg(23))
    if oReponseDlg(11) = 1 then SegmentDraw(Xcentre, Ycentre ,  (mescoord(1)(0)+ mescoord(2)(0))/2  , (mescoord(1)(1)+ mescoord(2)(1))/2 , 30, oReponseDlg(20))
end if
if Angle &gt; 180 then
    if oReponseDlg(8) = 1 then SegmentDraw(Xcentre, Ycentre ,  mescoord(1)(0) , mescoord(1)(1) , 30, oReponseDlg(17))   
    if oReponseDlg(9) = 1 then SegmentDraw(Xcentre, Ycentre ,   mescoord(4)(0) , mescoord(4)(1) , 30, oReponseDlg(18))
    if oReponseDlg(10) = 1 then SegmentDraw(Xcentre, Ycentre ,   mescoord(3)(0) , mescoord(3)(1) , 30, oReponseDlg(19))
    if oReponseDlg(7) = 1 then  SegmentDraw(Xcentre, Ycentre ,   mescoord(2)(0) , mescoord(2)(1) , 30, oReponseDlg(16))
    if oReponseDlg(12) = 1 then SegmentDraw(Xcentre, Ycentre ,  (mescoord(4)(0)+ mescoord(1)(0))/2  , (mescoord(4)(1)+ mescoord(1)(1))/2 , 30, oReponseDlg(21))
    if oReponseDlg(13) = 1 then SegmentDraw(Xcentre, Ycentre ,  (mescoord(3)(0)+ mescoord(4)(0))/2  , (mescoord(3)(1)+ mescoord(4)(1))/2 , 30, oReponseDlg(22))
    if oReponseDlg(14) = 1 then SegmentDraw(Xcentre, Ycentre ,  (mescoord(2)(0)+ mescoord(3)(0))/2  , (mescoord(2)(1)+ mescoord(3)(1))/2   , 30, oReponseDlg(23))
    if oReponseDlg(11) = 1 then SegmentDraw(Xcentre, Ycentre ,  (mescoord(1)(0)+ mescoord(2)(0))/2  , (mescoord(1)(1)+ mescoord(2)(1))/2 , 30, oReponseDlg(20))
end if
end sub

&apos;****************************************************Gestion de la boite de dialogue*****************************************************************
sub AfficherPoints
Dim i as integer
for i = 8 to 11
Etiquette_Checkbox_modif(monDlg, &quot;PyrRectPc&quot;&amp;i, chr(i+57))
next
for i = 12 to 15
Etiquette_Checkbox_modif(monDlg, &quot;PyrRectPc&quot;&amp;i, chr(i+61))
next
end sub

sub GestionCases
dim i as integer, j as integer
Aspect2BoutonsRadio(monDlg, &quot;PyrRectPc6&quot;, &quot;StyleA1&quot;,&quot;StyleB1&quot;)
AspectCheckbox(monDlg, &quot;PyrRectPc6&quot;, &quot;PyrRectPc7&quot;)
for i=2 to 9
j=6+i
Aspect2BoutonsRadio(monDlg, &quot;PyrRectPc&quot;&amp;j, &quot;StyleA&quot;&amp;i,&quot;StyleB&quot;&amp;i)
next
end sub

Sub GestionInfoBulle
TexteAide(monDlg,&quot;PyrRectPc1&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;PyrRectPc2&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;PyrRectPc3&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;PyrRectPc4&quot;, &quot;0&lt;= ... &lt; 360&quot;)
end sub

sub GestionImage
ChangerImagePrincipalex4(monDlg , &quot;PyrRectPc4&quot; , CheminDessin(&quot;Dessins/PyrRect/PyrCarreePC1.gif/&quot;), CheminDessin(&quot;Dessins/PyrRect/PyrCarreePC2.gif/&quot;),CheminDessin(&quot;Dessins/PyrRect/PyrCarreePC3.gif/&quot;), CheminDessin(&quot;Dessins/PyrRect/PyrCarreePC4.gif/&quot;), CheminDessin(&quot;Dessins/erreur.gif/&quot;))
end sub

sub GestionBoutonOK  
Dim choix as Object, valeur as string,i as integer, test(4) as integer

&apos;-----------------------Gestion des erreurs de saisie

test(1) = ZT_Nbre(monDlg,  &quot;PyrRectPc1&quot;, 0.001 , 20 , 5 , oReponseDlg(26),) 
test(2) = ZT_Nbre(monDlg,  &quot;PyrRectPc2&quot;, 0.001 , 20 , 5 , oReponseDlg(27),) 
test(3) = ZT_Nbre(monDlg,  &quot;PyrRectPc3&quot;, 0.001 , 20 , 5 , oReponseDlg(28),)        &apos; 0 ou 1
test(4) = ZT_Nbre(monDlg,  &quot;PyrRectPc4&quot;, 0 , 360 , 45 , oReponseDlg(29),) 
test(0) = test(1)*test(2)*test(3)*test(4)  &apos;test(0) contient 1 si tout est ok 0 sinon

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
    for i = 1 to 4
    oReponseDlg(i - 1) = CDbl(monDlg.getControl(&quot;PyrRectPc&quot;&amp;i).Peer.Text)
    Next
    for i = 5 to 15
    oReponseDlg(i - 1) = monDlg.getControl(&quot;PyrRectPc&quot;&amp;i).state  
    Next
    for i = 1 to 9
    oReponseDlg(14 + i) = monDlg.getControl(&quot;StyleA&quot;&amp;i).Model.state
    next    
    
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    oReponseDlg(30) = true   &apos;true quand tout est validé
    monDlg.endExecute
end if

End Sub


&apos;----------------------------------------------------------------------------
&apos;gestion des unités Cm/Inch
&apos;-------------------------------------------------------------------------

sub OptionUnite_click
OptionUnite(3,1)
end sub


