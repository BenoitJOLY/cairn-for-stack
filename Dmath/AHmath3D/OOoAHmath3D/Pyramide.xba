REM  *****  BASIC  *****


Option Explicit


sub PyramideMacroPrincipale() &apos;macro principale

appelerBoiteDialoguePyramide()

if oReponseDlg(20) = true then
Deselection 
DRAWversDocActif(&quot;Pyramide.ConstructionPyramide()&quot;)
TailleObjetFinal(LastForme)
PosObjetFinal(LastForme)
end if

end Sub
&apos;------------------------------------------------------------------------------------------------------
Sub appelerBoiteDialoguePyramide()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;PyramideDlg&quot;)
PositionDlg(monDlg,120,150)		
&apos;-------------------------initialisation de la boite de dialogue----------------------
Initialisation_Unites(2,2)		
Initialisation(monDlg,CheminDessin(&quot;Dessins/Pyramide/pyramide1.gif/&quot;),2)
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs-------------------------
for i = 1 to 5
oReponseDlg(i + 12) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	
monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub

&apos;----------------------------------------------------------------------------------------------------

sub ConstructionPyramide()
TracerPyramide(10000, 10000 , oReponseDlg(1)*1000 ,oReponseDlg(2), oReponseDlg(0), oReponseDlg(3), oReponseDlg(4))
end sub

&apos;------------------------------------------------------------------------------------------------------
sub TracerPyramide(Xcentre as Double, Ycentre as Double , Rayon as Double ,DegRot as Double, n as integer, Hauteur as Double, AngIncl as Double)

Dim monDocument As Object, maPage As Object
Dim XSommet as Double, YSommet as  Double, AbsPtA as Double, OrdPtA as Double, AbsPtB as Double, OrdPtB as Double, AngA as Double, AngB as Double
Dim mesAbscisses as variant, mesOrdonnees as variant, mesPoints as variant
Dim varAngles as variant, varTab3xN as variant, varPoint4xN as variant
Dim k as integer, RadAngIncl as Double, h as double
Dim BasePyr as variant 
Dim AngleMini as Double, AngleMaxi as Double
Dim meineTabelle, meineTabelle1, meineTabelle2 as variant

RadAngIncl = pi* AngIncl/180

if oReponseDlg(5) = true then              &apos;hauteur réelle sélectionnée
  h = Hauteur*cos(RadAngIncl) 
  else
  h = Hauteur                             &apos; hauteur sur le dessin selectionnée
end if  


BasePyr = BasePyramide(Xcentre , Ycentre , Rayon ,DegRot ,n, AngIncl)
mesAbscisses = Lignex(1,BasePyr) &apos; = (Xcentre, Xa, Xb, ...., Xn, Xa)
mesOrdonnees = Lignex(2,BasePyr) &apos; = (Ycentre, Ya, Yb, ...., Yn, Ya)
Ycentre = Ycentre * sin(RadAngIncl)
XSommet = mesAbscisses(0)
YSommet = mesOrdonnees(0)-h*1000

varAngles = TabAngles(mesAbscisses,mesOrdonnees,XSommet,YSommet)
varTab3xN = Tableau3xN(mesAbscisses,mesOrdonnees,varAngles)
varPoint4xN = SommetVisible(varTab3xN,YSommet,AngIncl)


meineTabelle = MinMax(varAngles)
AngleMini = meineTabelle(0)
AngleMaxi = meineTabelle(1)
&apos; AngleMini = MinMax(varAngles)(0)
&apos; AngleMaxi = MinMax(varAngles)(1)

&apos;------------------------------------------------------ Tracé de la pyramide --------------------------------
for k = 1 to n


meineTabelle1 =  varPoint4xN(k)
AbsPtA = meineTabelle1(0)
OrdPtA = meineTabelle1(1)
AngA = meineTabelle1(2)

&apos;AbsPtA = varPoint4xN(k)(0)
&apos;OrdPtA = varPoint4xN(k)(1)
&apos;AngA = varPoint4xN(k)(2)

meineTabelle2 =  varPoint4xN(k+1)
AbsPtB = meineTabelle2(0)
OrdPtB = meineTabelle2(1)
AngB = meineTabelle2(2)

&apos;AbsPtB = varPoint4xN(k+1)(0)
&apos;OrdPtB = varPoint4xN(k+1)(1)
&apos;AngB = varPoint4xN(k+1)(2)


if AngIncl &gt;= 0 then


&apos;Tracé des aretes laterales

if MeineTabelle1(3) = &quot;caché&quot; then
&apos;if varPoint4xN(k)(3) = &quot;caché&quot; then
   SegmentDraw(Xsommet, Ysommet, AbsPtA,  OrdPtA,30,&quot;pointillé&quot;)
   else
   SegmentDraw(Xsommet, Ysommet,  AbsPtA,  OrdPtA,30,&quot;plein&quot;)
end if   


&apos;Tracé de la base

if MeineTabelle1(3) = &quot;caché&quot; or MeineTabelle2(3) = &quot;caché&quot; then
&apos;if varPoint4xN(k)(3) = &quot;caché&quot; or varPoint4xN(k+1)(3) = &quot;caché&quot; then
   SegmentDraw( AbsPtA, OrdPtA,  AbsPtB, OrdPtB,30,&quot;pointillé&quot;)
end if

if MeineTabelle1(3) = &quot;visible&quot; and MeineTabelle2(3) = &quot;visible&quot; then
&apos;if varPoint4xN(k)(3) = &quot;visible&quot; and varPoint4xN(k+1)(3) = &quot;visible&quot; then
  if (abs(AngA - AngleMini)&lt;0.02  or abs(AngA - AngleMaxi)&lt;0.02) and (abs(AngB - AngleMini)&lt;0.02  or abs(AngB - AngleMaxi)&lt;0.02) then 
   if YSommet &gt; OrdPtA + (XSommet - AbsPtA)*(OrdPtA - OrdPtB)/(AbsPtA - AbsPtB) then
      SegmentDraw(AbsPtA, OrdPtA,  AbsPtB, OrdPtB,30,&quot;plein&quot;)
      else
      SegmentDraw(AbsPtA, OrdPtA,  AbsPtB, OrdPtB,30,&quot;pointillé&quot;)
    end if
   else
   SegmentDraw(AbsPtA, OrdPtA,  AbsPtB, OrdPtB,30,&quot;plein&quot;)  
      
end if
end if

end if
&apos;-------------------------------------------------------------------------------------------------
if AngIncl &lt; 0 then
&apos;tracé de la base

SegmentDraw( AbsPtA, OrdPtA,  AbsPtB, OrdPtB,30,&quot;plein&quot;)

&apos;tracé des arètes latérales

      if MeineTabelle1(3)= &quot;caché&quot; then 
&apos;      if varPoint4xN(k)(3)= &quot;caché&quot; then 
      SegmentDraw( AbsPtA, OrdPtA,  XSommet, YSommet,30,&quot;pointillé&quot;)
      else
      SegmentDraw( AbsPtA, OrdPtA,  XSommet, YSommet,30,&quot;plein&quot;)
      end if
  
end if

Next
&apos;------------------------------------tracé du centre de la base------------------------------------------------------------

if oReponseDlg(7) = 1 then PointDraw(Xcentre, Ycentre, RadAngIncl ,30,&quot;plein&quot;)

&apos;------------------------------------tracé centre &lt;&gt; sommet ------------------------------------------------------------
if oReponseDlg(8) = 1 then SegmentDraw(Xcentre, Ycentre ,  mesAbscisses(n) , mesOrdonnees(n) , 30,oReponseDlg(11))

&apos;-----------------------------------tracé de la hauteur et de l&apos;angle droit ---------------------------------------------------------------------
if oReponseDlg(9) = 1 then
  SegmentDraw(Xcentre, Ycentre ,  XSommet , YSommet , 30,oReponseDlg(12))  &apos;hauteur

  if oReponseDlg(10) = 1 then 
     if  oReponseDlg(8) = 0  then   &apos;angle droit
     QuadrilatereDraw(Xcentre, Ycentre ,Xcentre + 250 , Ycentre,Xcentre + 250, Ycentre - 250* cos(RadAngIncl), Xcentre  , Ycentre - 250* cos(RadAngIncl) , 30,&quot;plein&quot;)
     else
     QuadrilatereDraw(Xcentre, Ycentre ,Xcentre + 250* cos(pi*DegRot/180) , Ycentre - 250* sin(pi*DegRot/180)*Sin(RadAngIncl),Xcentre + 250* cos(pi*DegRot/180), Ycentre - 250* cos(RadAngIncl)- 250* sin(pi*DegRot/180)*Sin(RadAngIncl), Xcentre  , Ycentre - 250* cos(RadAngIncl) , 30,&quot;plein&quot;)
   end if
  end if


end if

end sub


&apos;---------------------------------------------------------------------------------------------------------------------
&apos;tableau regroupant tous les angles entre le sommet et les points de la base
function TabAngles(TouslesAbs as variant, TouslesOrd as variant, AbsSommet as Double, OrdSommet as Double) as variant
Dim IndexMax as variant
Dim j as integer
Dim meineTabelle as variant

IndexMax = UBound(TouslesAbs)
Dim varAngles(IndexMax) as variant
varAngles(0) = &quot;non défini&quot;

For j = 1 to IndexMax
varAngles(j) = AnglePtbaseSomCentre(TouslesAbs(j),TouslesOrd(j),AbsSommet,OrdSommet)
Next

TabAngles = varAngles

end function
&apos;---------------------------------------------------------------------------------------------------------------------------

function SommetVisible(monTableau3xN as variant, Yh as Double, AngIncl as double ) as variant
Dim Index as integer, k as integer, AngleMin as Double, AngleMax as Double, n as integer
Dim XangMin as Double, YangMin as Double, XangMax as Double, YangMax as Double
Dim Ysommet as Double, XSommet as double
Dim AbsPtA as double,OrdPtA as double,AbsPtB as double,OrdPtB as double,OrdHaut1 as double,OrdHaut2 as double,OrdBas1 as double, AbsHaut1 as double, AbsHaut2 as double
Dim mesOrdonneesProvisoires as variant
Dim meineTabelle as variant

Index = UBound(monTableau3xN)  &apos; Index = nombre de sommets de la base + 2&apos;
Dim varTableau(Index) as variant &apos;vartableau et 1 ligne de n+1 case conyenent &quot;visible&quot; ou &quot;caché&quot;

meineTabelle =  MinMax((Lignex(3,monTableau3xN)))
AngleMin = meineTabelle(0)
AngleMax = meineTabelle(1)
&apos;AngleMin = MinMax((Lignex(3,monTableau3xN)))(0)
&apos;AngleMax = MinMax((Lignex(3,monTableau3xN)))(1)
Ysommet = Yh

meineTabelle =  monTableau3xN(0)
XSommet = meineTabelle(0) &apos;--- XSommet = Xcentre
&apos;XSommet = monTableau3xN(0)(0) &apos;--- XSommet = Xcentre


&apos;----------teste si le sommet se trouve visuellement &quot;à l&apos;intérieur&quot; du polygone de base------------
&apos; récupère les 2 sommets les plus hauts et regarde la posItion du sommet de la pyramide par rapport à la droite

n = Index - 1

meineTabelle =  MinMax((Lignex(2,monTableau3xN)))
OrdHaut1 =  meineTabelle(0) &apos; renvoie la plus petite ordonnée
OrdBas1 =  meineTabelle(1)  &apos; renvoie la plus grande ordonnée
&apos;OrdHaut1 =  MinMax((Lignex(2,monTableau3xN)))(0) &apos; renvoie la plus petite ordonnée
&apos;OrdBas1 =  MinMax((Lignex(2,monTableau3xN)))(1)  &apos; renvoie la plus grande ordonnée

mesOrdonneesProvisoires = Lignex(2,monTableau3xN)
mesOrdonneesProvisoires(n + 1) = OrdBas1 &apos;pour que la valeur de la case n+1 ne soit pas utilisée étant donné que c&apos;est la même que la case 1

for k = 1 to n

meineTabelle =  monTableau3xN(k)
AbsPtA = meineTabelle(0)
OrdPtA = meineTabelle(1)
&apos;AbsPtA = monTableau3xN(k)(0)
&apos;OrdPtA = monTableau3xN(k)(1)

if OrdPtA = OrdHaut1 then
  AbsHaut1 = AbsPtA
  mesOrdonneesProvisoires = (Lignex(2,monTableau3xN))
  mesOrdonneesProvisoires(k) = OrdBas1
end if
Next

meineTabelle =  MinMax(mesOrdonneesProvisoires)
OrdHaut2 =  meineTabelle(0)
&apos;OrdHaut2 =  MinMax(mesOrdonneesProvisoires)(0)

for k = 1 to n
meineTabelle =  monTableau3xN(k)
AbsPtB = meineTabelle(0)
&apos;AbsPtB = monTableau3xN(k)(0)

OrdPtB = mesOrdonneesProvisoires(k)
if OrdPtB = OrdHaut2 then
  AbsHaut2 = AbsPtB
end if
Next

&apos;----------------------------------------------------------------------------------------------------------

for k = 1 to Index

meineTabelle =  monTableau3xN(k)

   if meineTabelle(2) = AngleMin then
   XangMin = meineTabelle(0)
   YangMin = meineTabelle(1)
&apos;   if monTableau3xN(k)(2) = AngleMin then
&apos;   XangMin = monTableau3xN(k)(0)
&apos;   YangMin = monTableau3xN(k)(1)
   end if
   
   if meineTabelle(2) = AngleMax then
   XangMax = meineTabelle(0)
   YangMax = meineTabelle(1)
&apos;   if monTableau3xN(k)(2) = AngleMax then
&apos;   XangMax = monTableau3xN(k)(0)
&apos;   YangMax = monTableau3xN(k)(1)
   end if
Next

varTableau(0) = &quot;non défini&quot;

if AngIncl &lt; 0 then
if YSommet  &lt;= OrdHaut1 + (XSommet - AbsHaut1)*(OrdHaut1 - OrdHaut2)/(AbsHaut1 - AbsHaut2) then
for k = 1 to Index

meineTabelle =  monTableau3xN(k)

   if  (meineTabelle(2)&lt;0) and (meineTabelle(1)&gt; YangMin) then
&apos;   if  (monTableau3xN(k)(2)&lt;0) and (monTableau3xN(k)(1)&gt; YangMin) then
   varTableau(k) = &quot;caché&quot;
   end if
   if (meineTabelle(2)&gt;=0) and (meineTabelle(1)&gt; YangMax) then
&apos;   if (monTableau3xN(k)(2)&gt;=0) and (monTableau3xN(k)(1)&gt; YangMax) then
   varTableau(k) = &quot;caché&quot;
   end if
   if (meineTabelle(2)&lt;0) and (meineTabelle(1)&lt;= YangMin) then
&apos;   if (monTableau3xN(k)(2)&lt;0) and (monTableau3xN(k)(1)&lt;= YangMin) then
   varTableau(k) = &quot;visible&quot;
   end if 
   if (meineTabelle(2)&gt;=0) and (meineTabelle(1)&lt;= YangMax) then
&apos;   if (monTableau3xN(k)(2)&gt;=0) and (monTableau3xN(k)(1)&lt;= YangMax) then
   varTableau(k) = &quot;visible&quot;
   end if
Next
else
for k = 1 to Index
varTableau(k) = &quot;caché&quot;
Next
end if
end if
if AngIncl&gt;=0 then
if YSommet  &lt;= OrdHaut1 + (XSommet - AbsHaut1)*(OrdHaut1 - OrdHaut2)/(AbsHaut1 - AbsHaut2) then
for k = 1 to Index

meineTabelle =  monTableau3xN(k)

   if  (meineTabelle(2)&lt;0) and (meineTabelle(1)&gt;= YangMin) then
&apos;   if  (monTableau3xN(k)(2)&lt;0) and (monTableau3xN(k)(1)&gt;= YangMin) then
   varTableau(k) = &quot;visible&quot;
   end if
   if (meineTabelle(2)&gt;=0) and (meineTabelle(1)&gt;= YangMax) then
&apos;   if (monTableau3xN(k)(2)&gt;=0) and (monTableau3xN(k)(1)&gt;= YangMax) then
   varTableau(k) = &quot;visible&quot;
   end if
   if (meineTabelle(2)&lt;0) and (meineTabelle(1)&lt; YangMin) then
&apos;   if (monTableau3xN(k)(2)&lt;0) and (monTableau3xN(k)(1)&lt; YangMin) then
   varTableau(k) = &quot;caché&quot;
   end if 
   if (meineTabelle(2)&gt;=0) and (meineTabelle(1)&lt; YangMax) then
&apos;   if (monTableau3xN(k)(2)&gt;=0) and (monTableau3xN(k)(1)&lt; YangMax) then
   varTableau(k) = &quot;caché&quot;
   end if
Next
else
for k = 1 to Index
varTableau(k) = &quot;visible&quot;
Next
end if
end if
SommetVisible = Tableau4xN((Lignex(1,monTableau3xN)),(Lignex(2,monTableau3xN)),(Lignex(3,monTableau3xN)),varTableau)
end function

&apos;-----------------------------------------------------------------------------------------------------------------------------
Function BasePyramide(Xcentre as Double, Ycentre as Double , Rayon as Double ,DegRot as Double, n as Double, AngIncl as Double) as variant
Dim Point(1) as variant
Dim CoordSom(n + 1) as variant
Dim NombreFormes As Integer, k As Integer, R as Integer, RadRot as Double, RadAngIncl as Double


RadRot = pi*DegRot/180
RadAngIncl = pi* AngIncl/180
Point = Array(Xcentre,Ycentre * Sin(RadAngIncl)) &apos;coord du centre de la base
CoordSom(0) = Point

for k = 1 to n+1 &apos;coord des sommets avec le 1er qui reapparait en dernier
Point = Array(Xcentre + Rayon*cos(k*2*pi/n + RadRot),(Ycentre - Rayon*Sin(k*2*pi/n + RadRot))* Sin(RadAngIncl))
CoordSom(k) = Point
next

BasePyramide = CoordSom

end Function


&apos;****************************************************Gestion de la boite de dialogue*****************************************************************

sub GestionCase1
AspectCheckbox(monDlg,&quot;RepPyr10&quot;,&quot;RepPyr11&quot;)
Aspect2BoutonsRadio(monDlg,&quot;RepPyr10&quot;,&quot;StyleA2&quot;,&quot;StyleB2&quot;)
end sub
sub GestionCase2
Aspect2BoutonsRadio(monDlg,&quot;RepPyr9&quot;,&quot;StyleA1&quot;,&quot;StyleB1&quot;)
end sub

Sub GestionInfoBulle
TexteAide(monDlg,&quot;RepPyr1&quot;, &quot;3 &lt;= ... &lt;= 50&quot;)
TexteAide(monDlg,&quot;RepPyr2&quot;, &quot;0 &lt; ... &lt;= 10&quot;)
TexteAide(monDlg,&quot;RepPyr3&quot;, &quot;0 &lt;= ... &lt;= 180&quot;)
TexteAide(monDlg,&quot;RepPyr4&quot;, &quot;0 &lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;RepPyr5&quot;, &quot;-90 &lt;= ... &lt;= 90&quot;)
end sub

sub GestionImage
ChangerImagePrincipalex2(monDlg , &quot;RepPyr5&quot;, CheminDessin(&quot;Dessins/Pyramide/pyramide1.gif/&quot;),CheminDessin(&quot;Dessins/Pyramide/pyramide2.gif/&quot;), CheminDessin(&quot;Dessins/erreur.gif/&quot;))
end sub

sub GestionBoutonOK  
Dim i as integer, test(6) as integer

&apos;-----------------------Gestion des erreurs de saisie
test(1) = ZT_Nbre(monDlg,  &quot;RepPyr1&quot;, 3 , 50 , 6 , oReponseDlg(13),true)
test(2) = ZT_Nbre(monDlg,  &quot;RepPyr2&quot;, 0.001 , 10 , 3 ,  oReponseDlg(14),) 
test(3) = ZT_Nbre(monDlg,  &quot;RepPyr3&quot;, 0 , 180 , 0 ,  oReponseDlg(15),)
test(4) = ZT_Nbre(monDlg,  &quot;RepPyr4&quot;, 0 , 20 , 5 ,  oReponseDlg(16),) 
test(5) = ZT_Nbre(monDlg,  &quot;RepPyr5&quot;, -90 , 90 , 20 , oReponseDlg(17),)   &apos; 0 ou 1

     
test(0) = test(1)*test(2)*test(3)*test(4)*test(5)   
&apos;---------------------- (test(0) contient 1 si tout est ok 0 sinon)

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
 
    for i = 1 to 5
    oReponseDlg(i - 1) = CDbl(monDlg.getControl(&quot;RepPyr&quot;&amp;i).Peer.Text)  
    Next
    for i = 6 to 7
    oReponseDlg(i - 1) = monDlg.getControl(&quot;RepPyr&quot;&amp;i).state 
    next
    for i = 8 to 11
    oReponseDlg(i - 1) = monDlg.getControl(&quot;RepPyr&quot;&amp;i).state  
    Next 
    for i = 1 to 2
    oReponseDlg(10 + i) = monDlg.getControl(&quot;StyleA&quot;&amp;i).Model.state 
    next
       
    oReponseDlg(20) = true  &apos;oReponseDlg(20) = true quand tout est validé
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé

    monDlg.endExecute
end if

End Sub

&apos;----------------------------------------------------------------------------
&apos;gestion des unités Cm/Inch
&apos;-------------------------------------------------------------------------

sub OptionUnite_click
OptionUnite(2,2)
end sub

