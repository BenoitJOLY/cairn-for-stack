function  TestTriangle as integer
Dim oTestTriangle as integer
oTestTriangle = 1   &apos; 1 = true
if monDlg.getControl(&quot;OptionButton6&quot;).State = true then
if  (oReponseDlg(1)+ oReponseDlg(2)&lt;=  oReponseDlg(3)) or (oReponseDlg(3)+ oReponseDlg(2)&lt;=  oReponseDlg(1)) or (oReponseDlg(1)+ oReponseDlg(3)&lt;=  oReponseDlg(2))  then
   oTestTriangle = 0
end if
end if 
if monDlg.getControl(&quot;OptionButton11&quot;).State = true then
if  (oReponseDlg(1)+ oReponseDlg(2)&gt;= 180) then
   oTestTriangle = 0
end if
end if 
TestTriangle = oTestTriangle
end function



