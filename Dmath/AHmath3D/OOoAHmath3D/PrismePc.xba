REM  *****  BASIC  *****

Option Explicit

Private infoSelection as string, oBase1 as variant
Private ahStep as Integer
Private ahSommetX(15) as long
Private ahSommetY(15) as long

sub PrismePcMacroPrincipale 
oDocActif = ThisComponent
oReponseDlg(1) = 3 &apos;initialisation du nombre de sommets

appelerBoiteDialoguePrismePc()

if oReponseDlg(0) = true then
Deselection 
  if ahStep = 1 then  main1
  if ahStep = 2 then  main2
  if ahStep = 3 then  main3
  if ahStep = 4 then  main4
  if ahStep = 5 then  main5
  if ahStep = 6 then  main6
  if ahStep = 7 then  main7
   oSolide = LastForme
   TailleObjetFinal(oSolide)
   PosObjetFinal(oSolide)
 if ahStep&lt;&gt;7 then ChangeStyleArete
end if
end Sub



&apos;----------------------------- création et affichage de la boite de dialogue
Sub appelerBoiteDialoguePrismePc()
Dim i As Integer
	
monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;PrismePcDlg&quot;)
PositionDlg(monDlg,120,150)	
&apos;--------------------------initialissation de la boite de dialogue---------------------
initialisation_Unites(10,3)
initialisationCoord
Initialisation(monDlg,CheminDessin(&quot;Dessins/PrismePC/repere.png/&quot;))
AffecterImageFixe(monDlg, &quot;ImageControl3&quot; ,CheminDessin(&quot;Dessins/PrismePC/trap4.png/&quot;))
AffecterImageFixe(monDlg, &quot;ImageControl6&quot; ,CheminDessin(&quot;Dessins/PrismePC/tr1.png/&quot;))
AffecterImageFixe(monDlg, &quot;ImageControl1&quot; ,CheminDessin(&quot;Dessins/PrismePC/trap3.png/&quot;))
AffecterImageFixe(monDlg, &quot;ImageControl10&quot; ,CheminDessin(&quot;Dessins/PrismePC/Pave.png/&quot;))
AffecterImageFixe(monDlg, &quot;ImageControl11&quot; ,CheminDessin(&quot;Dessins/PrismePC/cyl.png/&quot;))
AffecterImageFixe(monDlg, &quot;ImageControl12&quot; ,CheminDessin(&quot;Dessins/PrismePC/ligneb.png/&quot;))
AffecterImageFixe(monDlg, &quot;ImageControl13&quot; ,CheminDessin(&quot;Dessins/PrismePC/polyg.png/&quot;))

GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs -----------------------
for i = 1 to 22
oReponseDlg(i + 70) = monDlg.getControl(&quot;message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------
monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub


&apos;---------------------------------- gestion affichage du dialogue step = 1

sub initialisationCoord
Dim i as integer

for i = 1 to 15
AffectTextLabel2(monDlg,chr(i+64)&amp;&quot; (&quot;, &quot;Label&quot;&amp;i+1)
AffectTextLabel2(monDlg, &quot;;&quot;, &quot;Label&quot;&amp;16+i)
AffectTextLabel2(monDlg,&quot;)&quot;, &quot;Label&quot;&amp;31+i)
next

end sub



&apos;****************************************************Gestion de la boite de dialogue*****************************************************************
Sub GestionInfoBulle
TexteAide(monDlg,&quot;Hauteur&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;Angle&quot;, &quot;0&lt; ... &lt; 180&quot;)
TexteAide(monDlg,&quot;NbreSommets&quot;, &quot;3&lt;= ... &lt;= 15&quot;)
TexteAide(monDlg,&quot;tr_a&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;tr_b&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;tr_c&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;LongRect&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;LargRect&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;TextField38&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;TextField39&quot;, &quot;0&lt; ... &lt; 180&quot;)
TexteAide(monDlg,&quot;TextField40&quot;, &quot;0&lt; ... &lt; 180&quot;)
TexteAide(monDlg,&quot;TextField41&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;NbreCotes&quot;, &quot;3&lt;= ... &lt;= 50&quot;)
TexteAide(monDlg,&quot;LongCote&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;Cercle_1&quot;, &quot;0&lt; ... &lt;= 20&quot;)
end sub

sub NSommets_Modif
Dim i as integer, test(1) as integer, NbreSom as integer, monTexte as string

monTexte = ReponseTexte(monDlg,&quot;NbreSommets&quot;)
test(0) = Texte_Nbre(monTexte,true)

if test(0) = 1 then
oReponseDlg(1) = CDbl(monDlg.getControl(&quot;NbreSommets&quot;).Peer.Text)
if oReponseDlg(1)&gt;2 and oReponseDlg(1)&lt;16 then
for i = 1 to oReponseDlg(1)
monDlg.getControl(&quot;Label&quot;&amp;i+1).Model.enableVisible = true
monDlg.getControl(&quot;Label&quot;&amp;i+16).Model.enableVisible = true
monDlg.getControl(&quot;Label&quot;&amp;i+31).Model.enableVisible = true
monDlg.getControl(&quot;TextField&quot;&amp;2*i).Model.enableVisible = true
monDlg.getControl(&quot;TextField&quot;&amp;2*i+1).Model.enableVisible = true
next
if oReponseDlg(1)&lt;&gt;15 then
for i = oReponseDlg(1) + 1 to 15
monDlg.getControl(&quot;Label&quot;&amp;i+1).Model.enableVisible = false
monDlg.getControl(&quot;Label&quot;&amp;i+16).Model.enableVisible = false
monDlg.getControl(&quot;Label&quot;&amp;i+31).Model.enableVisible = false
monDlg.getControl(&quot;TextField&quot;&amp;2*i).Model.enableVisible = false
monDlg.getControl(&quot;TextField&quot;&amp;2*i+1).Model.enableVisible = false
next
end if
end if
end if
end sub

sub NSommets_PerteFocus
Dim test(1) as integer, monTexte as string

test(1) = ZT_Nbre(monDlg,  &quot;NbreSommets&quot;, 3 , 15 , 3 , oReponseDlg(73),true)

if test(1) = 1 then oReponseDlg(1) = CDbl(ReponseTexte(monDlg,  &quot;NbreSommets&quot;))

end sub





sub GestionBoutonOK  
Dim i as integer, test(32) as integer

test(1) = ZT_Nbre(monDlg,  &quot;Angle&quot;, 0.001 , 179.99 , 30 , oReponseDlg(72),) 
test(2) = ZT_Nbre(monDlg,  &quot;Hauteur&quot;, 0.001, 20 , 5 , oReponseDlg(71),)
test(0) = test(1)*test(2)
if test(0) = 1 then 
    oReponseDlg(100) = CDbl(monDlg.getControl(&quot;Hauteur&quot;).Peer.Text)    REM valable pour step =  1 à 7
    oReponseDlg(99) = CDbl(monDlg.getControl(&quot;Angle&quot;).Peer.Text)      REM valable pour step =  1 à 7
end if


if test(0) = 1 then

if monDlg.Model.Step = 1 then    REM  prisme à bases quelconques

for i = 1 to oReponseDlg(1)   
test(2*i-1) = ZT_Nbre(monDlg,  &quot;TextField&quot;&amp;2*i, 0 , 20 , 5 , oReponseDlg(74)&amp; chr(64+i) &amp; oReponseDlg(76),) 
test(2*i) = ZT_Nbre(monDlg,  &quot;TextField&quot;&amp;2*i+1, 0 , 30 , 5 , oReponseDlg(75)&amp; chr(64+i) &amp; oReponseDlg(77),)
next 
for i = 1 to 2*oReponseDlg(1)
test(0) = test(0)*test(i)
next                              REM test(0) contient 1 si tout est ok 0 sinon

if test(0) = 1 then
 for i = 1 to oReponseDlg(1)
    oReponseDlg(2*i) = CDbl(monDlg.getControl(&quot;TextField&quot;&amp;2*i).Peer.Text)
    oReponseDlg(2*i+1) = CDbl(monDlg.getControl(&quot;TextField&quot;&amp;2*i+1).Peer.Text)
 Next
    oReponseDlg(2*oReponseDlg(1)+2) = CDbl(monDlg.getControl(&quot;TextField2&quot;).Peer.Text)
    oReponseDlg(2*oReponseDlg(1)+3) = CDbl(monDlg.getControl(&quot;TextField3&quot;).Peer.Text)  &apos;coord du sommet A&apos; pour fermer le polygone

    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    oReponseDlg(0) = true   &apos;true quand tout est validé
    ahStep = 1
    monDlg.endExecute
end if

end if

if monDlg.Model.Step = 2 then    REM  prisme à bases ligne brisée sélectionnée

infoSelection = TypeForme(oDocActif.CurrentSelection(0))

if infoSelection = &quot;Ligne brisée&quot; or infoSelection = &quot;Ligne brisée fermée&quot; then
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    oReponseDlg(0) = true   &apos;true quand tout est validé
    ahStep = 2
    oBase1 = CoordLigneBrisee &apos;récupère les coordonnées de la ligne brisée
    DispatchSimple(&quot;Delete&quot;, oDocActif.CurrentController.Frame) &apos;efface la forme sélectionnée
    monDlg.endExecute
else msgbox(oReponseDlg(92))
end if
end if

if monDlg.Model.Step = 3 then     REM  prisme à bases triangulaires

if monDlg.getControl(&quot;OptionButton6&quot;).State = true then
test(1) = ZT_Nbre(monDlg,  &quot;tr_a&quot;, 0.001 , 20 , 5 , oReponseDlg(78),)
Else
test(1) = ZT_Nbre(monDlg,  &quot;tr_a&quot;, 0.001 , 179.99 , 45 , oReponseDlg(90),)
end if 
if monDlg.getControl(&quot;OptionButton11&quot;).State = true then
test(2) = ZT_Nbre(monDlg,  &quot;tr_b&quot;, 0.001 , 179.99 , 45 , oReponseDlg(87),)
Else
test(2) = ZT_Nbre(monDlg,  &quot;tr_b&quot;, 0.001, 20 , 5 , oReponseDlg(79),)
end if
test(3) = ZT_Nbre(monDlg,  &quot;tr_c&quot;, 0.001, 20 , 5 , oReponseDlg(80),)

test(0) = test(1)*test(2)*test(3)

if test(0) = 1 then
    oReponseDlg(1) = CDbl(monDlg.getControl(&quot;tr_a&quot;).Peer.Text)
    oReponseDlg(2) = CDbl(monDlg.getControl(&quot;tr_b&quot;).Peer.Text) 
    oReponseDlg(3) = CDbl(monDlg.getControl(&quot;tr_c&quot;).Peer.Text)
    test(0) = TestTriangle
    if test(0) = 0 then msgbox(oReponseDlg(91))
end if


if test(0) = 1 then 
    oReponseDlg(1) = CDbl(monDlg.getControl(&quot;tr_a&quot;).Peer.Text)
    oReponseDlg(2) = CDbl(monDlg.getControl(&quot;tr_b&quot;).Peer.Text) 
    oReponseDlg(3) = CDbl(monDlg.getControl(&quot;tr_c&quot;).Peer.Text)
    oReponseDlg(4) = CDbl(monDlg.getControl(&quot;OptionButton6&quot;).State)
    oReponseDlg(5) = CDbl(monDlg.getControl(&quot;OptionButton7&quot;).State)
    oReponseDlg(6) = CDbl(monDlg.getControl(&quot;OptionButton8&quot;).State)
    oReponseDlg(7) = CDbl(monDlg.getControl(&quot;OptionButton9&quot;).State)
    oReponseDlg(8) = CDbl(monDlg.getControl(&quot;OptionButton10&quot;).State)
    oReponseDlg(9) = CDbl(monDlg.getControl(&quot;OptionButton11&quot;).State)

    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    oReponseDlg(0) = true   
    ahStep = 3
    monDlg.endExecute
end if
end if


  
if monDlg.Model.Step = 4 then     REM  prisme à bases rectangulaires

test(1) = ZT_Nbre(monDlg,  &quot;LongRect&quot;, 0.001 , 20 , 5 , oReponseDlg(78),) 
test(2) = ZT_Nbre(monDlg,  &quot;LargRect&quot;, 0.001, 20 , 5 , oReponseDlg(79),)
test(0) = test(1)*test(2)
if test(0) = 1 then
    oReponseDlg(1) = CDbl(monDlg.getControl(&quot;LongRect&quot;).Peer.Text)
    oReponseDlg(2) = CDbl(monDlg.getControl(&quot;LargRect&quot;).Peer.Text)

    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    oReponseDlg(0) = true   &apos;true quand tout est validé
    ahStep = 4
    monDlg.endExecute
end if
end if



if monDlg.Model.Step = 5 then    REM  prisme à bases trapèzes

test(1) = ZT_Nbre(monDlg,  &quot;TextField38&quot;, 0.001 , 20 , 5 , oReponseDlg(78),) 
test(2) = ZT_Nbre(monDlg,  &quot;TextField39&quot;, 0.001 , 179.99 , 45 , oReponseDlg(87),)
if monDlg.getControl(&quot;CheckBox1&quot;).State = 1 then
test(3) = ZT_Nbre(monDlg,  &quot;TextField40&quot;, 0.001 , 179.99, 45 , oReponseDlg(88),) 
else
test(3) = ZT_Nbre(monDlg,  &quot;TextField40&quot;, 0.001 , 20 , 5 , oReponseDlg(80),) 
end if
test(4) = ZT_Nbre(monDlg,  &quot;TextField41&quot;, 0.001, 20 , 5 , oReponseDlg(89),)
test(0) = test(1)*test(2)*test(3)*test(4)

if test(0) = 1 then
    oReponseDlg(1) = CDbl(monDlg.getControl(&quot;TextField38&quot;).Peer.Text)
    oReponseDlg(2) = CDbl(monDlg.getControl(&quot;TextField39&quot;).Peer.Text)
    oReponseDlg(3) = CDbl(monDlg.getControl(&quot;TextField40&quot;).Peer.Text)
    oReponseDlg(4) = CDbl(monDlg.getControl(&quot;TextField41&quot;).Peer.Text)
    oReponseDlg(5) = CDbl(monDlg.getControl(&quot;CheckBox1&quot;).State)
    oReponseDlg(6) = CDbl(monDlg.getControl(&quot;OptionButton1&quot;).State)
    oReponseDlg(7) = CDbl(monDlg.getControl(&quot;OptionButton2&quot;).State)
    oReponseDlg(8) = CDbl(monDlg.getControl(&quot;OptionButton3&quot;).State)
    oReponseDlg(9) = CDbl(monDlg.getControl(&quot;OptionButton4&quot;).State)
    oReponseDlg(10) = CDbl(monDlg.getControl(&quot;OptionButton5&quot;).State)

    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    oReponseDlg(0) = true   &apos;true quand tout est validé
    ahStep = 5
    monDlg.endExecute
end if    
end if


if monDlg.Model.Step = 6 then    REM  prisme à bases polygones réguliers

test(1) = ZT_Nbre(monDlg,  &quot;NbreCotes&quot;,3 , 50 , 3 , oReponseDlg(85),true)
test(2) = ZT_Nbre(monDlg,  &quot;LongCote&quot;, 0.001 , 20 , 5 , oReponseDlg(81),)
test(0) = test(1)*test(2)

if test(0) = 1 then
    oReponseDlg(1) = CDbl(monDlg.getControl(&quot;NbreCotes&quot;).Peer.Text)
    oReponseDlg(2) = CDbl(monDlg.getControl(&quot;LongCote&quot;).Peer.Text)

    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    oReponseDlg(0) = true   &apos;true quand tout est validé
    ahStep = 6
    monDlg.endExecute
end if
end if


if monDlg.Model.Step = 7 then    REM  cylindre de révolution

test(0) = ZT_Nbre(monDlg,  &quot;Cercle_1&quot;, 0.001 , 20 , 5 , oReponseDlg(86),)

if test(0)=1 then
    oReponseDlg(1) = CDbl(monDlg.getControl(&quot;Cercle_1&quot;).Peer.Text)
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    oReponseDlg(0) = true   &apos;true quand tout est validé
    ahStep = 7
    monDlg.endExecute
end if
end if
end if
End Sub     REM fin de l&apos;action du bouton OK

&apos;*********************************************************************************************************
sub main1
DRAWversDocActif(&quot;PrismePc.ConstructionPrismePc()&quot;)
end sub


sub ConstructionPrismePc()
Dim AngFuite as double, x1 as double, y1 as double,x2 as double, y2 as double, i as integer

AngFuite = oReponseDlg(99)*pi/180
for i=1 to oReponseDlg(1)
x1 = oReponseDlg(2*i)*1000
y1 = oReponseDlg(2*i+1)*-1000
x2 = oReponseDlg(2*i+2)*1000
y2 = oReponseDlg(2*i+3)*-1000

SegmentDraw(x1,y1, x2, y2, 30,&quot;plein&quot;) &apos;[AB] ...
SegmentDraw(x1,y1, x1 + oReponseDlg(100)*1000*cos(AngFuite), y1 - oReponseDlg(100)*1000*sin(AngFuite), 30, &quot;plein&quot; ) &apos;[AA&apos;]...
SegmentDraw(x1 + oReponseDlg(100)*1000*cos(AngFuite),y1  - oReponseDlg(100)*1000*sin(AngFuite),x2  + oReponseDlg(100)*1000*cos(AngFuite), y2  - oReponseDlg(100)*1000*sin(AngFuite), 30, &quot;plein&quot; ) &apos;[A&apos;B&apos;] ...
next
end sub


&apos;***************************************************************************************
sub main2
DRAWversDocActif(&quot;PrismePc.ConstructionPrisme2()&quot;)
end sub
   
sub ConstructionPrisme2()
Dim  i as integer, taille as integer, h as double, angle as double
h = oReponseDlg(100)
angle = oReponseDlg(99)
taille = Ubound(oBase1)
Dim oBase2X(taille) as double, oBase2Y(taille) as double, oBase1X(taille) as double ,oBase1Y(taille) as double
for i = 0 to taille 
oBase1X(i) = oBase1(i)(0)
oBase2X(i) = oBase1X(i) + h*1000*cos(angle*pi/180)
oBase1Y(i) = oBase1(i)(1)
oBase2Y(i) = oBase1Y(i) - h*1000*sin(angle*pi/180)
next

for i = 0 to taille- 1
  SegmentDraw(oBase1X(i), oBase1Y(i) , oBase1X(i+1) , oBase1Y(i+1) , 30 , &quot;plein&quot;)
  SegmentDraw(oBase2X(i), oBase2Y(i),oBase2X(i+1), oBase2Y(i+1),30,&quot;plein&quot;)
  SegmentDraw(oBase1X(i), oBase1Y(i),oBase2X(i), oBase2Y(i),30,&quot;plein&quot;)
next
SegmentDraw(oBase1X(0), oBase1Y(0),oBase1X(taille), oBase1Y(taille),30,&quot;plein&quot;)
SegmentDraw(oBase2X(0), oBase2Y(0),oBase2X(taille), oBase2Y(taille),30,&quot;plein&quot;)
SegmentDraw(oBase1X(taille), oBase1Y(taille),oBase2X(taille), oBase2Y(taille),30,&quot;plein&quot;)
end sub




&apos;********************************************************************************************************

sub ConstructionPrisme3()
Dim  h as double, angle as double , i as integer, L1 as double, L2 as double, L3 as double
Dim Triangle1 as variant, XTriangle1 as variant, YTriangle1 as variant,  Triangle2 as variant, XTriangle2 as variant, YTriangle2 as variant
h = oReponseDlg(100)
angle = oReponseDlg(99)

if oReponseDlg(4)= true then 
  L1 = oReponseDlg(1)
  L2 = oReponseDlg(2)
  L3 = oReponseDlg(3)
ElseIf oReponseDlg(5)= true then 
  L2 = oReponseDlg(2)
  L3 = oReponseDlg(3)
  L1 = sqr(L2*L2 + L3*L3 - 2*L2*L3*cos(oReponseDlg(1)*pi/180))
ElseIf oReponseDlg(6)= true then 
  L3 = oReponseDlg(3)
  L2 = oReponseDlg(2)/sin(oReponseDlg(1)*pi/180)
  L1 = sqr(L2*L2 + L3*L3 - 2*L2*L3*cos(oReponseDlg(1)*pi/180))  
ElseIf oReponseDlg(7)= true then 
  L3 = oReponseDlg(3)
  L1 = oReponseDlg(2)/sin(oReponseDlg(1)*pi/180)
  L2 = sqr(L1*L1 + L3*L3 - 2*L1*L3*cos(oReponseDlg(1)*pi/180))
ElseIf oReponseDlg(8)= true then 
  L3 = oReponseDlg(3)
  L1 = oReponseDlg(2)
  L2 = sqr(L1*L1 + L3*L3 - 2*L1*L3*cos(oReponseDlg(1)*pi/180))
ElseIf oReponseDlg(9)= true then 
  L3 = oReponseDlg(3)
  L2 = L3*sin(oReponseDlg(1)*pi/180)/sin((180-oReponseDlg(1)-oReponseDlg(2))*pi/180)
  L1 = sqr(L2*L2 + L3*L3 - 2*L2*L3*cos(oReponseDlg(2)*pi/180))  
end if


Triangle1 = CoordTriangleMain(7000, 7000, &quot;haut&quot;,L1,L2,L3)
Triangle2 = CoordTriangleMain(7000 + h*1000*cos(angle*pi/180), 7000 - h*1000*sin(angle*pi/180), &quot;haut&quot;, L1,L2,L3)
Xtriangle1 = Lignex(1,Triangle1)
YTriangle1 = Lignex(2,Triangle1)
Xtriangle2 = Lignex(1,Triangle2)
YTriangle2 = Lignex(2,Triangle2)
for i = 0 to 2
SegmentDraw(Xtriangle1(i),YTriangle1(i),Xtriangle1(i+1),YTriangle1(i+1),30,&quot;plein&quot;) 
SegmentDraw(Xtriangle2(i),YTriangle2(i),Xtriangle2(i+1),YTriangle2(i+1),30,&quot;plein&quot;) 
SegmentDraw(Xtriangle1(i),YTriangle1(i),Xtriangle2(i),YTriangle2(i),30,&quot;plein&quot;) 
next

end sub

sub main3
DRAWversDocActif(&quot;PrismePc.ConstructionPrisme3()&quot;)
end sub


&apos;********************************************************************************************************
sub ConstructionPrisme4()
Dim  h as double, angle as double
h = oReponseDlg(100)
angle = oReponseDlg(99)

PaveStyleArete(7000, 7000, oReponseDlg(1), oReponseDlg(2), h, angle*pi/180, &quot;plein&quot;, &quot;plein&quot;, &quot;plein&quot;, &quot;plein&quot;, &quot;plein&quot;,&quot;plein&quot;, &quot;plein&quot;, &quot;plein&quot;, &quot;plein&quot;)

end sub

sub main4
DRAWversDocActif(&quot;PrismePc.ConstructionPrisme4()&quot;)
end sub

&apos;*******************************************************************************************************

sub ConstructionPrisme5
Dim xa as double,  ya as double,xb as double,  yb as double,xc as double,  yc as double,xd as double,  yd as double
Dim xa2 as double,  ya2 as double,xb2 as double,  yb2 as double,xc2 as double,  yc2 as double,xd2 as double,  yd2 as double
Dim h as double, angle as double
h = oReponseDlg(100)
angle = oReponseDlg(99)
   xa = 0
   ya = 0
   yb = 0
   xb = oReponseDlg(1)*1000
   
if  oReponseDlg(5) = 1 then
   if  oReponseDlg(6) = true then
   xc = xb - oReponseDlg(4)*1000*cos(oReponseDlg(3)*pi/180)
   yc = - oReponseDlg(4)*1000*sin(oReponseDlg(3)*pi/180)
   xd = -yc/tan(oReponseDlg(2)*pi/180)
   yd = yc
   end if
   
   if  oReponseDlg(7) = true then
   xd = oReponseDlg(4)*1000*cos(oReponseDlg(2)*pi/180)
   yd = - oReponseDlg(4)*1000*sin(oReponseDlg(2)*pi/180)
   yc = yd
   xc = xb + yd/tan(oReponseDlg(3)*pi/180)
   end if
   
   
   if  oReponseDlg(8) = true then
   xd = oReponseDlg(4)*1000/tan(oReponseDlg(2)*pi/180)
   yd = - oReponseDlg(4)*1000
   yc = yd
   xc = xb + yd/tan(oReponseDlg(3)*pi/180)
   end if
   
   else
   if oReponseDlg(9) = true then
   xd = oReponseDlg(3)*1000*cos(oReponseDlg(2)*pi/180)
   yd = - oReponseDlg(3)*1000*sin(oReponseDlg(2)*pi/180)
   yc = yd
   xc = xd + oReponseDlg(4)*1000
   end if
   
   if oReponseDlg(10) = true then
   xc = xb - oReponseDlg(3)*1000*cos(oReponseDlg(2)*pi/180)
   yc = - oReponseDlg(3)*1000*sin(oReponseDlg(2)*pi/180)
   yd = yc
   xd = xc - oReponseDlg(4)*1000
   end if
end if
SegmentDraw(xa,ya,xb,yb,30,&quot;plein&quot;) 
SegmentDraw(xb,yb,xc,yc,30,&quot;plein&quot;)
SegmentDraw(xc,yc,xd,yd,30,&quot;plein&quot;)
SegmentDraw(xa,ya,xd,yd,30,&quot;plein&quot;)

xa2 = xa + h*1000*cos(angle*pi/180)
ya2 = ya - h*1000*sin(angle*pi/180)
xb2 = xb + h*1000*cos(angle*pi/180)
yb2 = yb - h*1000*sin(angle*pi/180)
xc2 = xc + h*1000*cos(angle*pi/180)
yc2 = yc - h*1000*sin(angle*pi/180)
xd2 = xd + h*1000*cos(angle*pi/180)
yd2 = yd - h*1000*sin(angle*pi/180)


SegmentDraw(xa,ya,xa2,ya2,30,&quot;plein&quot;) 
SegmentDraw(xb,yb,xb2,yb2,30,&quot;plein&quot;)
SegmentDraw(xc,yc,xc2,yc2,30,&quot;plein&quot;)
SegmentDraw(xd,yd,xd2,yd2,30,&quot;plein&quot;)

SegmentDraw(xa2,ya2,xb2,yb2,30,&quot;plein&quot;) 
SegmentDraw(xb2,yb2,xc2,yc2,30,&quot;plein&quot;)
SegmentDraw(xc2,yc2,xd2,yd2,30,&quot;plein&quot;)
SegmentDraw(xa2,ya2,xd2,yd2,30,&quot;plein&quot;)


end sub

sub main5
DRAWversDocActif(&quot;PrismePc.ConstructionPrisme5()&quot;)
end sub

&apos;******************************************************************************************************
sub ConstructionPrisme6()
Dim  h as double, angle as double, n as integer
Dim  Poly1 as variant, Xpoly1 as variant, Ypoly1 as variant, i as integer
Dim  Poly2 as variant, Xpoly2 as variant, Ypoly2 as variant
h = oReponseDlg(100)
angle = oReponseDlg(99)
n = oReponseDlg(1)
Poly1 = CoordpolygoneMain(10000,10000,n,&quot;haut&quot;, oReponseDlg(2),true)
Poly2 = CoordpolygoneMain(10000 + h*1000*cos(angle*pi/180),10000 - + h*1000*sin(angle*pi/180),n,&quot;haut&quot;, oReponseDlg(2),true)
Xpoly1 = Lignex(1,Poly1)
Ypoly1 = Lignex(2,Poly1)
Xpoly2 = Lignex(1,Poly2)
Ypoly2 = Lignex(2,Poly2)


for i = 0 to n-2
SegmentDraw(Xpoly1(i),Ypoly1(i),Xpoly1(i+1),Ypoly1(i+1),30,&quot;plein&quot;) 
SegmentDraw(Xpoly2(i),Ypoly2(i),Xpoly2(i+1),Ypoly2(i+1),30,&quot;plein&quot;) 
SegmentDraw(Xpoly1(i),Ypoly1(i),Xpoly2(i),Ypoly2(i),30,&quot;plein&quot;) 
next
SegmentDraw(Xpoly1(0),Ypoly1(0),Xpoly1(n-1),Ypoly1(n-1),30,&quot;plein&quot;) 
SegmentDraw(Xpoly2(0),Ypoly2(0),Xpoly2(n-1),Ypoly2(n-1),30,&quot;plein&quot;) 
SegmentDraw(Xpoly1(n-1),Ypoly1(n-1),Xpoly2(n-1),Ypoly2(n-1),30,&quot;plein&quot;) 
end sub


sub main6
DRAWversDocActif(&quot;PrismePc.ConstructionPrisme6()&quot;)
end sub


&apos;*******************************************************************************************************
sub ConstructionCylindre()
Dim  h as double, angle as double, r as double, xTan as double, Ytan as double
Dim Style as string

h = oReponseDlg(100)
angle = oReponseDlg(99)
r = oReponseDlg(1)

xTan = r * cos((90 - angle)*pi/180)
yTan = r * sin((90 - angle)*pi/180)

ArcEllipseDraw(-r*1000, -r*1000, 2*r*1000,2*r*1000, &quot;plein&quot;, -90+angle, 90+angle)
ArcEllipseDraw(-r*1000, -r*1000, 2*r*1000,2*r*1000, &quot;plein&quot;, 90+angle, -90+angle)

ArcEllipseDraw(-r*1000 + h*1000*cos(angle*pi/180), -r*1000-h*1000*sin(angle*pi/180), 2*r*1000,2*r*1000, &quot;plein&quot;, -90+angle, 90+angle)
ArcEllipseDraw(-r*1000 + h*1000*cos(angle*pi/180), -r*1000-h*1000*sin(angle*pi/180), 2*r*1000,2*r*1000, &quot;pointillé&quot;, 90+angle, -90+angle)

SegmentDraw(xTan*1000,yTan*1000,xTan*1000 + h*1000*cos(angle*pi/180),yTan * 1000-h*1000*sin(angle*pi/180),30,&quot;plein&quot;) 
SegmentDraw(-Xtan*1000,-yTan*1000,-xTan*1000 + h*1000*cos(angle*pi/180),-yTan*1000-h*1000*sin(angle*pi/180),30,&quot;plein&quot;) 

end sub


sub main7
DRAWversDocActif(&quot;PrismePc.ConstructionCylindre()&quot;)
end sub

