REM  *****  BASIC  *****

Option Explicit



sub CalotteMP &apos;macro principale

Dim i As Integer, test As String, decalage As Long, NombreElements as variant
Dim NomSolide As String, nbre1 as variant, nbre2 as variant, nbre3 as variant, nbre4 as variant

appelDlgCalotte()

if oReponseDlg(20) = true then
Deselection 
DRAWversDocActif(&quot;Calotte.ConstructionCalotte()&quot;)
TailleObjetFinal(LastForme)
PosObjetFinal(LastForme)

end if

end Sub

&apos;------------------------------------------------------------------------------------------------------
Sub appelDlgCalotte()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;CalotteDlg&quot;)
PositionDlg(monDlg,120,150)
&apos;------------------------initialisation de la boite de dialogue-----------------------
Initialisation_Unites(2,1)		
Initialisation(monDlg,CheminDessin(&quot;Dessins/Calotte/calotte1.png/&quot;),4)
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs-------------------------
for i = 1 to 4
oReponseDlg(i + 50) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	
monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
    
End Sub



sub ConstructionCalotte()
Dim oAngInclRad as Double, oAngSectRad as double, oAngSectDeg as double, oAngDebRad as double, oAngDebDeg as double, oAngDebRad2 as double, oAngDebDeg2 as double
Dim Abscentre as Double, Ordcentre as  Double
Dim a as double, b as double
Dim Rayon as double, oRayonSect as double
Dim oLong as double, oStyle as string


Rayon = oReponseDlg(0)*1000
oAngInclRad =abs(oReponseDlg(2) * pi / 180)  &apos;abs car il me faut un angle positif à cause du signe des sin

if oReponseDlg(4) = 1 then oReponseDlg(1) = oReponseDlg(1)/cos(oAngInclRad)          &apos;hauteur sur le dessin sélectionnée

AbsCentre = Rayon
OrdCentre = 10000 + Rayon
oRayonSect = sqr(oReponseDlg(0)*oReponseDlg(0)-oReponseDlg(1)*oReponseDlg(1))
oAngSectRad = Atn(oReponseDlg(1)/oRayonSect)
oAngSectDeg = oAngSectRad*180/pi
a = oRayonSect*1000  &apos;gde 1/2 diagonale de l&apos;ellipse
b = oRayonSect*1000 * sin(oAngInclRad) &apos;pte 1/2 diagonale de l&apos;ellipse
oLong = oReponseDlg(1)/cos(oAngInclRad)

if oReponseDlg(2)&gt;= 0 then oStyle = &quot;plein&quot; else oStyle = &quot;pointillé&quot;

if  abs(oLong) &lt;  oReponseDlg(0) then &apos;ellipse tangente au cercle
oAngDebRad = Atn(oLong/sqr(oReponseDlg(0)*oReponseDlg(0)-oLong*oLong))  
oAngDebDeg = oAngDebRad*180/pi  &apos;angle  centre sphère - pt de tangence

oAngDebRad2 = Atn(sqr(oRayonSect*oRayonSect-oReponseDlg(0)*oReponseDlg(0)*cos(oAngDebRad)*cos(oAngDebRad))/(oReponseDlg(0)*cos(oAngDebRad))) 
oAngDebDeg2 = Sgn(oReponseDlg(1))*oAngDebRad2*180/pi  &apos;angle  centre section - pt de tangence

ArcEllipseDraw(0, 10000 ,2*Rayon,2*Rayon,&quot;plein&quot;,-180-oAngDebDeg,oAngDebDeg)
ArcEllipseDraw(Rayon - a, 10000 + Rayon - oReponseDlg(1)*cos(oAngInclRad)*1000 -b,2*a,2*b,&quot;plein&quot;,oAngDebDeg2,180-oAngDebDeg2)
ArcEllipseDraw(Rayon - a, 10000 + Rayon - oReponseDlg(1)*cos(oAngInclRad)*1000 -b,2*a,2*b,oStyle,180-oAngDebDeg2,oAngDebDeg2)

else 
if oReponseDlg(1)&gt;= 0 then ArcEllipseDraw(0, 10000 ,2*Rayon,2*Rayon,&quot;plein&quot;,-179.99,179.99) 
ArcEllipseDraw(Rayon - a, 10000 + Rayon - oReponseDlg(1)*cos(oAngInclRad)*1000 -b,2*a,2*b,oStyle,-179.99,180)
end if

&apos;centre de la sphère
if oReponseDlg(7) = 1 then PointDraw(AbsCentre, OrdCentre, oAngInclRad , 30,&quot;plein&quot;)

&apos;centre de la section
if oReponseDlg(8) = 1 then PointDraw(AbsCentre, OrdCentre - oReponseDlg(1)*cos(oAngInclRad)*1000 ,oAngInclRad , 30,&quot;plein&quot;)

&apos;centre de la section &lt;&gt; centre de la sphère
if oReponseDlg(9) = 1 then SegmentDraw(AbsCentre, OrdCentre - oReponseDlg(1)*cos(oAngInclRad)*1000 ,  AbsCentre , OrdCentre , 30,oReponseDlg(14))

&apos;centre de la sphère &lt;&gt; section
if oReponseDlg(10) = 1 then SegmentDraw(AbsCentre + a, OrdCentre - oReponseDlg(1)*cos(oAngInclRad)*1000 ,  AbsCentre , OrdCentre , 30,oReponseDlg(15))

&apos;rayon de la sphère
if oReponseDlg(11) = 1 then SegmentDraw(AbsCentre, OrdCentre ,  AbsCentre + Rayon , OrdCentre , 30,oReponseDlg(16))

&apos;rayon de la section
if oReponseDlg(12) = 1 then SegmentDraw(AbsCentre, OrdCentre - oReponseDlg(1)*cos(oAngInclRad)*1000 ,  AbsCentre + a , OrdCentre - oReponseDlg(1)*cos(oAngInclRad)*1000 , 30,oReponseDlg(17))

&apos;grand cercle
if oReponseDlg(13) = 1 then
  if oReponseDlg(1)&gt;=0 then
     if oReponseDlg(2)&gt;=0 then
     ArcEllipseDraw(0, Ordcentre -Rayon*sin(oAngInclRad)  ,2*Rayon,2*Rayon*sin(oAngInclRad),&quot;pointillé&quot;,0,180) 
     ArcEllipseDraw(0, Ordcentre -Rayon*sin(oAngInclRad)  ,2*Rayon,2*Rayon*sin(oAngInclRad),&quot;plein&quot;,180,0)
     else
     ArcEllipseDraw(0, Ordcentre -Rayon*sin(oAngInclRad)  ,2*Rayon,2*Rayon*sin(oAngInclRad),&quot;plein&quot;,0,180) 
     ArcEllipseDraw(0, Ordcentre -Rayon*sin(oAngInclRad)  ,2*Rayon,2*Rayon*sin(oAngInclRad),&quot;pointillé&quot;,180,0)
     end if     
  end if
  if oReponseDlg(1)&lt; 0 then
    ArcEllipseDraw(0, Ordcentre -Rayon*sin(oAngInclRad)  ,2*Rayon,2*Rayon*sin(oAngInclRad),&quot;plein&quot;,180,0)
    ArcEllipseDraw(0, Ordcentre -Rayon*sin(oAngInclRad)  ,2*Rayon,2*Rayon*sin(oAngInclRad),&quot;plein&quot;,0,180)
  end if
end if
end sub


&apos;-------------------------------------------------------------------------------------------------------
&apos;gestion des boutons de la boite de dialogue

Sub GestionInfoBulle
TexteAide(monDlg,&quot;TextField1&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;TextField2&quot;, &quot;-R &lt;= ... &lt;= R&quot;)
TexteAide(monDlg,&quot;TextField3&quot;, &quot;-90&lt;= ... &lt;= 90&quot;)
end sub


sub GestionImage
Dim oDistOI as double
if IsNumeric(monDlg.getcontrol(&quot;TextField2&quot;).Peer.text) then
   oDistOI = CDbl(monDlg.getcontrol(&quot;TextField2&quot;).Peer.text)
   if oDistOI &gt;= 0 then
   ChangerImagePrincipalex2(monDlg , &quot;TextField3&quot;, CheminDessin(&quot;Dessins/Calotte/calotte1.png/&quot;),CheminDessin(&quot;Dessins/Calotte/calotte2.png/&quot;), CheminDessin(&quot;Dessins/erreur.gif/&quot;))
   else
   ChangerImagePrincipalex2(monDlg , &quot;TextField3&quot;, CheminDessin(&quot;Dessins/Calotte/calotte5.png/&quot;),CheminDessin(&quot;Dessins/Calotte/calotte6.png/&quot;), CheminDessin(&quot;Dessins/erreur.gif/&quot;))
   end if
end if
end sub

sub GestionImage2
Dim oAngleProv as double
if IsNumeric(monDlg.getcontrol(&quot;TextField3&quot;).Peer.text) then
   oAngleProv = CDbl(monDlg.getcontrol(&quot;TextField3&quot;).Peer.text)
   if oAngleProv &gt;=0 then
   ChangerImagePrincipalex2(monDlg , &quot;TextField2&quot;, CheminDessin(&quot;Dessins/Calotte/calotte1.png/&quot;),CheminDessin(&quot;Dessins/Calotte/calotte5.png/&quot;), CheminDessin(&quot;Dessins/erreur.gif/&quot;))
   else
   ChangerImagePrincipalex2(monDlg , &quot;TextField2&quot;, CheminDessin(&quot;Dessins/Calotte/calotte2.png/&quot;),CheminDessin(&quot;Dessins/Calotte/calotte6.png/&quot;), CheminDessin(&quot;Dessins/erreur.gif/&quot;))
   end if
end if   
end sub



sub GestionBoutonOK  
Dim i as integer, test(6) as integer

&apos;-----------------------Gestion des erreurs de saisie
test(1) = ZT_Nbre(monDlg,  &quot;TextField1&quot;, 0.001 , 10 , 3 , oReponseDlg(51),)
test(2) = ZT_Nbre(monDlg,  &quot;TextField2&quot;, -10 , 10 , 1 , oReponseDlg(52),)
test(3) = ZT_Nbre(monDlg,  &quot;TextField3&quot;, -90 , 90 , 10 , oReponseDlg(53),) 
     
test(0) = test(1)*test(2)*test(3)&apos;*test(4) &apos;test(0) contient 1 si tout est ok 0 sinon

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
    for i = 1 to 3
    oReponseDlg(i - 1) = CDbl(monDlg.getControl(&quot;TextField&quot;&amp;i).Peer.Text)
    Next
    for i = 1 to 2
    oReponseDlg(2+i) = monDlg.getControl(&quot;OptionButton&quot;&amp;i).Model.state  
    Next 
    for i = 1 to 7
    oReponseDlg(6+i) = monDlg.getControl(&quot;CheckBox&quot;&amp;i).Model.state  
    Next 
    for i = 1 to 4
    oReponseDlg(13+i) = monDlg.getControl(&quot;StyleA&quot;&amp;i).Model.state
    Next
&apos;    ---------------------compare R et OI---------------------------------
    if oReponseDlg(3) = 1 then
       if oReponseDlg(1) &gt; oReponseDlg(0) then
        msgbox(oReponseDlg(54), 0+48,&quot;AHmath3D&quot;)
        test(0) = 0
        end if
    end if
     if oReponseDlg(3) = 0 then
       if oReponseDlg(1)/cos(oReponseDlg(2)*pi/180) &gt; oReponseDlg(0) then
        msgbox(oReponseDlg(54), 0+48,&quot;AHmath3D&quot;)
        test(0) = 0
        end if
    end if
end if  
 
if test(0) = 1 then
        
    oReponseDlg(20) = true  &apos;renvoie true si la boite de dialogue est fermée par le bouton OK
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    monDlg.endExecute
end if

End Sub


&apos;----------------------------------------------------------------------------
&apos;gestion des unités Cm/Inch
&apos;-------------------------------------------------------------------------

sub OptionUnite_click
OptionUnite(2,1)
end sub


</script:module>