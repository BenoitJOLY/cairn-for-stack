REM  *****  BASIC  *****

option explicit


Sub appelerBoiteDialoguePatCyl()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;PatCylDlg&quot;)
PositionDlg(monDlg,120,150)
&apos;------------------------initialisation de la boite de dialogue-----------------------
Initialisation_Unites(2,0)	
Initialisation(monDlg,CheminDessin(&quot;Dessins/PatCyl/PatCyl1.gif/&quot;),)
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs et des infobulles ------
for i = 1 to 2
oReponseDlg(i + 4) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	

monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub

sub PatCylMacroPrincipale()

appelerBoiteDialoguePatCyl()

if oReponseDlg(4) = true then
	Deselection
   DRAWversDocActif(&quot;PatCyl.ConstructionPatCyl()&quot;)
   oSolide = LastForme
   TailleObjetFinal(oSolide)
   PosObjetFinal(oSolide)
end if

end sub


sub ConstructionPatCyl()
Dim R as double, h as double, L as double
R = oReponseDlg(0)*1000
h = oReponseDlg(1)*1000
L = 2*pi*R


CercleDraw(5000-R,5000+L/4,R,0)
QuadrilatereDraw(5000, 5000, 5000+h,5000,5000+h,5000+L,5000,5000+L,0)
CercleDraw(5000+h+R,5000+3*L/4,R,0)

if oReponseDlg(2) = true then
LanguetteDraw(5000,5000,5000+h,5000,&quot;droite&quot;,0,0.1)
LanguetteDraw(5000,5000+L,5000,5000+98*L/100,&quot;droite&quot;,0,1)
LanguetteDraw(5000,5000+76*L/100,5000,5000+74*L/100,&quot;droite&quot;,0,1)
LanguetteDraw(5000,5000+51*L/100,5000,5000+49*L/100,&quot;droite&quot;,0,1)
LanguetteDraw(5000+h,5000+L,5000+h,5000+98*L/100,&quot;gauche&quot;,0,1)
LanguetteDraw(5000+h,5000+26*L/100,5000+h,5000+24*L/100,&quot;gauche&quot;,0,1)
LanguetteDraw(5000+h,5000+51*L/100,5000+h,5000+49*L/100,&quot;gauche&quot;,0,1)


end if

end sub

&apos;****************************************************Gestion de la boite de dialogue*****************************************************************


Sub GestionInfoBulle
TexteAide(monDlg,&quot;PatCylDlg1&quot;, &quot;0 &lt; ... &lt;= 10&quot;)
TexteAide(monDlg,&quot;PatCylDlg2&quot;, &quot;0 &lt; ... &lt;= 20&quot;)
end sub


sub GestionBoutonOK  
Dim i as integer, test(2) as integer

&apos;-----------------------Gestion des erreurs de saisie
test(1) = ZT_Nbre(monDlg,  &quot;PatCylDlg1&quot;, 0.001 , 10 , 3 ,oReponseDlg(5),)
test(2) = ZT_Nbre(monDlg,  &quot;PatCylDlg2&quot;, 0.001 , 20 , 5 , oReponseDlg(6),) 


     
test(0) = test(1)*test(2)

&apos;---------------------- (test(0) contient 1 si tout est ok 0 sinon)

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
 
    for i = 1 to 2
    oReponseDlg(i - 1) = CDbl(monDlg.getControl(&quot;PatCylDlg&quot;&amp;i).Peer.Text)  
    Next
    for i = 3 to 4
    oReponseDlg(i - 1) = monDlg.getControl(&quot;PatCylDlg&quot;&amp;i).state 
    next
          
    oReponseDlg(4) = true  
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé

&apos;---------------------    oReponseDlg(4) = true quand tout est validé
    monDlg.endExecute
end if

End Sub

&apos;----------------------------------------------------------------------------
&apos;gestion des unités Cm/Inch
&apos;-------------------------------------------------------------------------

sub OptionUnite_click
OptionUnite(2,0)
end sub


</script:module>