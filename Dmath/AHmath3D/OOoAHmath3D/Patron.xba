REM  *****  BASIC  *****

option explicit

Private oChoixBouton as integer

sub MacroPrincipale

oChoixBouton = 0

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;PatronDlg&quot;)
AffecterImageFixe(monDlg, &quot;CommandButton1&quot;,CheminDessin(&quot;icons/image25_26.png/&quot;))
AffecterImageFixe(monDlg, &quot;CommandButton2&quot;,CheminDessin(&quot;icons/image26_26.png/&quot;))
AffecterImageFixe(monDlg, &quot;CommandButton3&quot;,CheminDessin(&quot;icons/image27_26.png/&quot;))
AffecterImageFixe(monDlg, &quot;CommandButton4&quot;,CheminDessin(&quot;icons/image28_26.png/&quot;))
AffecterImageFixe(monDlg, &quot;CommandButton5&quot;,CheminDessin(&quot;icons/image30_26.png/&quot;))

monDlg.execute
monDlg.dispose

if oChoixBouton = 1 then PatPrismeMacroPrincipale
if oChoixBouton = 2 then PatCylMacroPrincipale
if oChoixBouton = 3 then PatPyrMacroPrincipale
if oChoixBouton = 4 then PatConeMacroPrincipale
if oChoixBouton = 5 then PatCubeMacroPrincipale

end sub



sub CommandButton1_Click
oChoixBouton = 1
monDlg.EndExecute
end sub


sub CommandButton2_Click
oChoixBouton = 2
monDlg.EndExecute
end sub


sub CommandButton3_Click
oChoixBouton = 3
monDlg.EndExecute
end sub


sub CommandButton4_Click
oChoixBouton = 4
monDlg.EndExecute
end sub


sub CommandButton5_Click
oChoixBouton = 5
monDlg.EndExecute
end sub
</script:module>