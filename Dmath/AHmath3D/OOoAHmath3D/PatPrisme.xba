REM  *****  BASIC  *****

option explicit

Sub appelerBoiteDialoguePatPrisme()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;PatPrismeDlg&quot;)
PositionDlg(monDlg,120,150)		
&apos;------------------------initialisation de la boite de dialogue-----------------------
Initialisation_Unites(2,0)	
Initialisation(monDlg,CheminDessin(&quot;Dessins/PatPrisme/PatPrisme1.gif/&quot;),)
AffecterImageFixe(monDlg, &quot;ImageSecondaire1&quot; , CheminDessin(&quot;Dessins/PatPrisme/PatPrisme2.gif/&quot;))
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs et des infobulles ------
for i = 1 to 4
oReponseDlg(i + 17) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	

monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub



sub PatPrismeMacroPrincipale()

appelerBoiteDialoguePatPrisme()

if oReponseDlg(17) = true then
	Deselection
   DRAWversDocActif(&quot;PatPrisme.ConstructionPatPrisme()&quot;)
   oSolide = LastForme
   TailleObjetFinal(oSolide)
   PosObjetFinal(oSolide)
end if
end sub
&apos;---------------------------------------------------------------------------------------
&apos;fonction coordonnées polygone régulier
&apos;----------------------------------------------------------------------------------------
function Coordpolygone(Xa as double, Ya as double,n as Double,PosPolygone as string)
Dim R as double, Angle1 as double, Lg as double,Xcentre as double, Ycentre as double, i as integer
Dim mesabscisses(n-1) as variant, mesordonnees(n-1) as variant


    if oReponseDlg(8) = true then
       Lg =  oReponseDlg(7)*1000
       R = Lg/(2*sin(pi/n))
    else
       R = oReponseDlg(7)*1000
       Lg = 2*R*sin(pi/n)
    end if
    Xcentre = Xa + Lg/2 
    if PosPolygone = &quot;haut&quot; then
          Ycentre = Ya - R*cos(pi/n)
    else
          Ycentre = Ya + R*cos(pi/n)
    end if

Angle1 = pi - Atn((Ya-Ycentre)/(Lg/2))

for i = 0 to n-1
mesabscisses(i) = Xcentre + R*cos(i*2*pi/n - Angle1)
mesordonnees(i) = Ycentre - R*Sin(i*2*pi/n - Angle1)
next
CoordPolygone = Tableau2xN(mesabscisses, mesordonnees)
end function

&apos;---------------------------------------------------------------------------------------
&apos;fonction coordonnées triangle
&apos;----------------------------------------------------------------------------------------
function CoordTriangle(xa as double, ya as double, Sens as string) as variant
Dim a as double, b as Double, c as double
Dim cosA as double, angleA as Double, xb as double, yb as double, xc as double, yc as double

  a = oReponseDlg(1)*1000
  b = oReponseDlg(2)*1000
  c = oReponseDlg(3)*1000
   
   &apos;inégalité triangulaire
   If a + b &lt;= c Or a + c &lt;= b Or b + c &lt;= a Then
   MsgBox(&quot;Ce triangle n&apos;est pas constructible ou est aplati&quot;)
   End
   End If
  &apos; fin de l&apos;inégalité triangulaire
  
   cosA = (b * b + c * c - a * a) / (2 * b * c)
   angleA = Atn(-cosA / Sqr(-cosA * cosA + 1)) + Pi / 2
   
   &apos;coordonnées des sommets du triangle
   if sens = &quot;bas&quot; then
   xb = xa + c
   yb = ya
   xc = xa + b * Cos(angleA)
   yc = ya + b * Sin(angleA)
   else
   xb = xa + c
   yb = ya
   xc = xa + b * Cos(angleA)
   yc = ya - b * Sin(angleA)
   end if
   
   CoordTriangle = Array(xa,ya,xb,yb,xc,yc)
   
end function

&apos;---------------------------------------------------------------------------------------
&apos;fonction coordonnées rectangles
&apos;----------------------------------------------------------------------------------------

function CoordRectangle(x1 as double, y1 as double, x2 as double, y2 as double, h as double, Sens as string) as variant
dim largeur as double

largeur = sqr(PuisN(x2-x1,2)+PuisN(y2-y1,2))
x3 = x2-(y2-y1)*h/largeur
y3 = y2+(x2-x1)*h/largeur
x4 = x1-(y2-y1)*h/largeur
y4=y1+(x2-x1)*h/largeur

CoordRectangle = Array(x1,y1,x2,y2,x3,y3,x4,y4)
end function

&apos;---------------------------------------------------------------------------------------
&apos;Construction du patron suivant les réponses du dialogue
&apos;Macro qui est lancé dans DRAWversDocActif()
&apos;----------------------------------------------------------------------------------------

sub ConstructionPatPrisme()
Dim a as double, b as Double, c as double, h as double, n as double, Lg as double, R as double, i as integer
Dim Tr1 as variant, Tr2 as variant, x3 as double, y3 as double
Dim Poly1 as variant, Xpoly1 as variant, Ypoly1 as variant, Poly2 as variant, Xpoly2 as variant, Ypoly2 as variant

  n = oReponseDlg(6)
  h = oReponseDlg(0)*1000
  
if oReponseDlg(13) = true then  
  
&apos;tracé du prisme à bases triangulaires  
if oReponseDlg(10) = true then  
  a = oReponseDlg(1)*1000
  b = oReponseDlg(2)*1000
  c = oReponseDlg(3)*1000
  Tr1=CoordTriangle(5000,5000,&quot;haut&quot;)
  Tr2=CoordTriangle(5000,5000+h,&quot;bas&quot;)

  TriangleDraw(Tr1(0),Tr1(1),Tr1(2),Tr1(3),Tr1(4),Tr1(5))
  QuadrilatereDraw(5000 ,5000,5000+c,5000,5000+c,5000 + h,5000,5000+h)
  QuadrilatereDraw(5000-b,5000,5000,5000,5000,5000+h,5000-b,5000+h)
  QuadrilatereDraw(5000+c,5000,5000+c+a,5000,5000+c+a,5000+h,5000+c,5000+h)
  TriangleDraw(Tr2(0),Tr2(1),Tr2(2),Tr2(3),Tr2(4),Tr2(5))


  if oReponseDlg(15)= true then
  LanguetteDraw(Tr1(2),Tr1(3),Tr1(4),Tr1(5),&quot;gauche&quot;)
  LanguetteDraw(Tr1(4),Tr1(5),Tr1(0),Tr1(1),&quot;gauche&quot;)
  LanguetteDraw(Tr2(2),Tr2(3),Tr2(4),Tr2(5),&quot;droite&quot;)
  LanguetteDraw(Tr2(4),Tr2(5),Tr2(0),Tr2(1),&quot;droite&quot;)
  
  LanguetteDraw(5000-b,5000,5000-b,5000+h,&quot;gauche&quot;)
  end if
end if

&apos; tracé du prisme à bases rectangulaires

if oReponseDlg(11) = true then  
  a = oReponseDlg(4)*1000
  b = oReponseDlg(5)*1000
  
  QuadrilatereDraw(5000+b ,5000,5000+b+a,5000,5000+b+a,5000 - b,5000+b,5000-b) 
  QuadrilatereDraw(5000 ,5000,5000+b,5000,5000+b,5000 + h,5000,5000+h) 
  QuadrilatereDraw(5000+b ,5000,5000+b+a,5000,5000+b+a,5000 + h,5000+b,5000+h)
  QuadrilatereDraw(5000+b+a,5000,5000+b+a+b,5000,5000+b+a+b,5000+h,5000+b+a,5000+h)
  QuadrilatereDraw(5000+b+a+b,5000,5000+b+a+b+a,5000,5000+b+a+b+a,5000+h,5000+b+a+b,5000+h)
  QuadrilatereDraw(5000+b ,5000+h,5000+b+a,5000+h,5000+b+a,5000+h+b,5000+b,5000+h+b) 


  if oReponseDlg(15)= true then
  LanguetteDraw(5000+b+a,5000,5000+b+a,5000 - b,&quot;gauche&quot;)
  LanguetteDraw(5000+b+a,5000 - b,5000+b,5000-b,&quot;gauche&quot;)
  LanguetteDraw(5000+b ,5000,5000+b,5000-b,&quot;droite&quot;)
  LanguetteDraw(5000+b+a,5000+h,5000+b+a,5000+h+b,&quot;droite&quot;)
  LanguetteDraw(5000+b+a,5000+h+b,5000+b,5000+h+b,&quot;droite&quot;)
  LanguetteDraw(5000+b ,5000+h,5000+b,5000+h+b,&quot;gauche&quot;)
  LanguetteDraw(5000 ,5000,5000,5000+h,&quot;gauche&quot;)
  end if
end if

&apos; tracé du prisme à bases polygonales

if oReponseDlg(12) = true then  

     Poly1 = CoordPolygone(10000,10000,n,&quot;haut&quot;,)
     Poly2 = CoordPolygone(10000,10000+h,n,&quot;bas&quot;)
     Xpoly1 = Lignex(1,Poly1)
     Ypoly1 = Lignex(2,Poly1)
     Xpoly2 = Lignex(1,Poly2)
     Ypoly2 = Lignex(2,Poly2)
     Lg = Xpoly1(1) - Xpoly1(0)
     for i = 0 to n-1
     QuadrilatereDraw(10000+(i-1)*Lg,10000,10000+i*Lg,10000,10000+i*Lg,10000+h,10000+(i-1)*Lg,10000+h)
     next
     polygoneNcotesDraw(Xpoly1,Ypoly1)
     polygoneNcotesDraw(Xpoly2,Ypoly2)


  if oReponseDlg(15)= true then
  
  for i = 1 to n-2
  LanguetteDraw(Xpoly1(i),Ypoly1(i),Xpoly1(i+1),Ypoly1(i+1),&quot;gauche&quot;)
  LanguetteDraw(Xpoly2(i),Ypoly2(i),Xpoly2(i+1),Ypoly2(i+1),&quot;gauche&quot;)  
  next
  LanguetteDraw(Xpoly1(n-1),Ypoly1(n-1),Xpoly1(0),Ypoly1(0),&quot;gauche&quot;)
  LanguetteDraw(Xpoly2(0),Ypoly2(0),Xpoly2(1),Ypoly2(1),&quot;gauche&quot;)
  LanguetteDraw(10000-Lg,10000,10000-Lg,10000+h,&quot;gauche&quot;)
  
  end if
end if
end if
&apos;----tracé des patrons étoilés------------------------------------------

if oReponseDlg(14)= true then

&apos;tracé du prisme à bases triangulaires  
if oReponseDlg(10) = true then  
  a = oReponseDlg(1)*1000
  b = oReponseDlg(2)*1000
  c = oReponseDlg(3)*1000
  Tr1=CoordTriangle(5000,5000,&quot;haut&quot;)
  Tr2=CoordTriangle(5000,5000+h,&quot;bas&quot;)

  TriangleDraw(Tr1(0),Tr1(1),Tr1(2),Tr1(3),Tr1(4),Tr1(5))
  QuadrilatereDraw(5000 ,5000,5000+c,5000,5000+c,5000 + h,5000,5000+h)
  TriangleDraw(Tr2(0),Tr2(1),Tr2(2),Tr2(3),Tr2(4),Tr2(5))
  RectangleDraw(Tr2(4),Tr2(5),Tr2(2),Tr2(3),h)
  RectangleDraw(Tr2(0),Tr2(1),Tr2(4),Tr2(5),h)


  if oReponseDlg(15)= true then
  LanguetteDraw(Tr1(2),Tr1(3),Tr1(4),Tr1(5),&quot;gauche&quot;)
  LanguetteDraw(Tr1(4),Tr1(5),Tr1(0),Tr1(1),&quot;gauche&quot;)
  
  x3 = Tr2(2)+(Tr2(5)-Tr2(3))*h/a
  y3 = Tr2(3)-(Tr2(4)-Tr2(2))*h/a 
  LanguetteDraw(Tr2(2),Tr2(3),x3,y3,&quot;droite&quot;)
 
  x3 = Tr2(4)+(Tr2(1)-Tr2(5))*h/b
  y3 = Tr2(5)-(Tr2(0)-Tr2(4))*h/b 
  LanguetteDraw(Tr2(4),Tr2(5),x3,y3,&quot;droite&quot;)
  
  LanguetteDraw(5000,5000,5000,5000+h,&quot;gauche&quot;)
  end if
end if


&apos; tracé du prisme à bases rectangulaires

if oReponseDlg(11) = true then  
  a = oReponseDlg(4)*1000
  b = oReponseDlg(5)*1000
  

 
  QuadrilatereDraw(5000 ,5000,5000+b,5000,5000+b,5000 - a,5000,5000-a)  &apos;base haut
  QuadrilatereDraw(5000 ,5000,5000+b,5000,5000+b,5000 + h,5000,5000+h)
  QuadrilatereDraw(5000,5000+h,5000+b,5000+h,5000+b,5000+a+h,5000,5000+a+h)&apos;base bas
  RectangleDraw(5000+b,5000+a+h,5000+b,5000+h,h)
  RectangleDraw(5000,5000+a+h,5000+b,5000+a+h,h)
  RectangleDraw(5000,5000+h,5000,5000+a+h,h)



  if oReponseDlg(15)= true then
  LanguetteDraw(5000+b,5000,5000+b,5000 - a,&quot;gauche&quot;)
  LanguetteDraw(5000+b,5000 - a,5000,5000-a,&quot;gauche&quot;)
  LanguetteDraw(5000 ,5000,5000,5000-a,&quot;droite&quot;)
  LanguetteDraw(5000,5000,5000,5000+h,&quot;gauche&quot;)
  LanguetteDraw(5000,5000+h+a,5000-h,5000+h+a,&quot;droite&quot;)
  LanguetteDraw(5000+b ,5000+h+a,5000+b,5000+2*h+a,&quot;droite&quot;)
  LanguetteDraw(5000+b ,5000+h,5000+b+h,5000+h,&quot;droite&quot;)
  end if
end if

&apos; tracé du prisme à bases polygonales

if oReponseDlg(12) = true then  

     Poly1 = CoordPolygone(10000,10000,n,&quot;haut&quot;)
     Poly2 = CoordPolygone(10000,10000+h,n,&quot;bas&quot;)
     Xpoly1 = Lignex(1,Poly1)
     Ypoly1 = Lignex(2,Poly1)
     Xpoly2 = Lignex(1,Poly2)
     Ypoly2 = Lignex(2,Poly2)
     Lg = Xpoly1(1) - Xpoly1(0)
     
     QuadrilatereDraw(10000,10000,10000+Lg,10000,10000+Lg,10000+h,10000,10000+h)
     polygoneNcotesDraw(Xpoly1,Ypoly1)
     polygoneNcotesDraw(Xpoly2,Ypoly2)
     for i=0 to n-2
     RectangleDraw(Xpoly2(i),Ypoly2(i),Xpoly2(i+1),Ypoly2(i+1),h)
     next


  if oReponseDlg(15)= true then
  
  for i = 1 to n-2
  LanguetteDraw(Xpoly1(i),Ypoly1(i),Xpoly1(i+1),Ypoly1(i+1),&quot;gauche&quot;)
  next
  LanguetteDraw(Xpoly1(n-1),Ypoly1(n-1),Xpoly1(0),Ypoly1(0),&quot;gauche&quot;)
   for i = 0 to n-2
  x3 = Xpoly2(i+1)-(Ypoly2(i+1)-Ypoly2(i))*h/sqr(PuisN(Xpoly2(i+1)-Xpoly2(i),2)+PuisN(Ypoly2(i+1)-Ypoly2(i),2))
  y3 = Ypoly2(i+1)+(Xpoly2(i+1)-Xpoly2(i))*h/sqr(PuisN(Xpoly2(i+1)-Xpoly2(i),2)+PuisN(Ypoly2(i+1)-Ypoly2(i),2)) 
  LanguetteDraw(Xpoly2(i+1),Ypoly2(i+1),x3,y3,&quot;droite&quot;)
  next
  x3 = Xpoly2(0)
  y3 = Ypoly2(0)- h 
  LanguetteDraw(Xpoly2(0),Ypoly2(0),x3,y3,&quot;droite&quot;)
  
  end if
end if
end if
end sub


&apos;****************************************************Gestion de la boite de dialogue*****************************************************************


Sub GestionInfoBulle
TexteAide(monDlg,&quot;PatPrismeDlg1&quot;, &quot;0 &lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;PatPrismeDlg2&quot;, &quot;0 &lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;PatPrismeDlg3&quot;, &quot;0 &lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;PatPrismeDlg4&quot;, &quot;0 &lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;PatPrismeDlg5&quot;, &quot;0 &lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;PatPrismeDlg6&quot;, &quot;0 &lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;PatPrismeDlg7&quot;, &quot;3 &lt;= ... &lt;= 50&quot;)
TexteAide(monDlg,&quot;PatPrismeDlg8&quot;, &quot;0 &lt; ... &lt;= 10&quot;)

end sub


sub GestionBoutonOK  
Dim i as integer, test(8) as integer

&apos;-----------------------Gestion des erreurs de saisie
test(1) = ZT_Nbre(monDlg,  &quot;PatPrismeDlg1&quot;, 0.001 , 20 , 5 , oReponseDlg(18),)
test(2) = ZT_Nbre(monDlg,  &quot;PatPrismeDlg2&quot;, 0.001 , 20 , 5 , oReponseDlg(21),) 
test(3) = ZT_Nbre(monDlg,  &quot;PatPrismeDlg3&quot;, 0.001 , 20 , 5 , oReponseDlg(21),)  
test(4) = ZT_Nbre(monDlg,  &quot;PatPrismeDlg4&quot;, 0.001 , 20 , 5 , oReponseDlg(21),) 
test(5) = ZT_Nbre(monDlg,  &quot;PatPrismeDlg5&quot;, 0.001 , 20 , 5 , oReponseDlg(21),)
test(6) = ZT_Nbre(monDlg,  &quot;PatPrismeDlg6&quot;, 0.001 , 20 , 5 , oReponseDlg(21),) 
test(7) = ZT_Nbre(monDlg,  &quot;PatPrismeDlg7&quot;, 3 , 50 , 5 , oReponseDlg(19),true) 
test(8) = ZT_Nbre(monDlg,  &quot;PatPrismeDlg8&quot;, 0.001 , 10 , 3 , oReponseDlg(20),)  &apos;0 ou 1

     
test(0) = test(1)*test(2)*test(3)*test(4)*test(5)*test(6)*test(7)*test(8)

&apos;---------------------- (test(0) contient 1 si tout est ok 0 sinon)

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
 
    for i = 1 to 8
    oReponseDlg(i - 1) = CDbl(monDlg.getControl(&quot;PatPrismeDlg&quot;&amp;i).Peer.Text)  
    Next
    for i = 9 to 17
    oReponseDlg(i - 1) = monDlg.getControl(&quot;PatPrismeDlg&quot;&amp;i).state 
    next
          
    oReponseDlg(17) = true  
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé

&apos;---------------------    oReponseDlg(17) = true quand tout est validé
    monDlg.endExecute
end if

End Sub

&apos;----------------------------------------------------------------------------
&apos;gestion des unités Cm/Inch
&apos;-------------------------------------------------------------------------

sub OptionUnite_click
OptionUnite(7,0)
end sub


