&apos;--------------------------------------------------------------------------------
&apos;renvoie le min et le max d&apos;un tableau à 1 ligne et n colonnes
&apos;--------------------------------------------------------------------------------
function MinMax(tableauNx1 as variant) as variant
Dim IndexMin as Integer, IndexMax as Integer, Min as Double, Max as Double
Dim k as Integer

&apos;IndexMin = LBound(tableauNx1)
IndexMax = UBound(tableauNx1)

Min = tableauNx1(0)
Max = tableauNx1(0)

for k = 1 to IndexMax
if tableauNx1(k) &lt; Min then
   Min = tableauNx1(k)
end if
if tableauNx1(k) &gt; Max then
   Max = tableauNx1(k)
end if
Next

MinMax = Array(Min, Max)

end function


&apos;--------------------------------------------------------------------------------
&apos;renvoie la xième ligne d&apos;un tableau a m lignes et n colonnes
&apos;--------------------------------------------------------------------------------

function Lignex(x as integer, monTableau as variant) as variant
Dim k as integer, IndexMax as Double
Dim meineTabelle as variant

IndexMax = Ubound(monTableau)     &apos;n = IndexMax    m = Ubound(montableau(0))

Dim var1(IndexMax) as variant

for k = 0 to IndexMax

meineTabelle = monTableau(k)
var1(k) = meineTabelle(x - 1)
&apos;var1(k) = monTableau(k)(x - 1)
next
Lignex = var1
end function


&apos;--------------------------------------------------------------------------------
&apos;--- supprime la j ème valeur d&apos;un tableau à 1 ligne et n colonnes - commence à zéro
&apos;--- et renvoie le tableau avec les colonnes décalées vers la gauche et vide la dernière
&apos;--------------------------------------------------------------------------------

function SupjTab1xN(monTableau as variant, j as integer) as variant
Dim IndexMax as Double , k as integer
IndexMax = Ubound(monTableau)

Dim TabProvisoire(IndexMax) as variant
for k = 0 to IndexMax
if k&lt;j then
TabProvisoire(k)=monTableau(k)
end if
if k&gt;j then
TabProvisoire(k-1)=monTableau(k)
end if
TabProvisoire(IndexMax)= &quot;&quot;
next
SupjTab1xN = TabProvisoire
end function


&apos;--------------------------------------------------------------------------------
&apos;crée un tableau 2 lignes n colonnes a partir de 2 lignes de n cases
&apos;--------------------------------------------------------------------------------
function Tableau2xN(Ligne1 as  variant, Ligne2 as variant) as variant

Dim Index as integer, Point(1) as variant, k as integer

Index = UBound(Ligne1)

Dim varTab1(Index) as variant

for k = 0 to Index
Point = array(Ligne1(k),Ligne2(k))
varTab1(k) = Point
Next

Tableau2xN = varTab1

end function

&apos;--------------------------------------------------------------------------------
&apos;crée un tableau 3 lignes n colonnes a partir de 3 lignes de n cases
&apos;--------------------------------------------------------------------------------
function Tableau3xN(Ligne1 as  variant, Ligne2 as variant, Ligne3 as variant) as variant

Dim Index as integer, Point(2) as variant, k as integer

Index = UBound(Ligne1)

Dim varTab1(Index) as variant

for k = 0 to Index
Point = array(Ligne1(k),Ligne2(k),Ligne3(k))
varTab1(k) = Point
Next

Tableau3xN = varTab1

end function

&apos;--------------------------------------------------------------------------------
&apos;crée un tableau 4 lignes n colonnes a partir de 4 lignes de n cases
&apos;--------------------------------------------------------------------------------
function Tableau4xN(Ligne1 as  variant, Ligne2 as variant, Ligne3 as variant ,  Ligne4 as variant) as variant

Dim Index as integer, Point(3) as variant, k as integer

Index = UBound(Ligne1)

Dim varTab1(Index) as variant

for k = 0 to Index
Point = array(Ligne1(k),Ligne2(k),Ligne3(k),Ligne4(k))
varTab1(k) = Point
Next

Tableau4xN = varTab1

end function

&apos;--------------------------------------------------------------------------------
&apos;supprime tous les dessins d&apos;une page writer
&apos;--------------------------------------------------------------------------------
sub SupprimeDessins(oDoc as object)
Dim maPage As Object, NombreFormes as Double, maForme as object
Dim k as integer


if oDoc.ImplementationName = &quot;SwXTextDocument&quot; then maPage = oDoc.DrawPage
if oDoc.ImplementationName = &quot;SdXImpressDocument&quot; then maPage = oDoc.DrawPages(0)

NombreFormes = maPage.Count
msgbox(NombreFormes)
for k = 1 to NombreFormes
maForme = maPage(NombreFormes - k)
maPage.remove(maForme)
Next

end sub


&apos;--------------------------------------------------------------------------------
&apos;renvoie la puissance N d&apos;un nombre avec N&gt;= 1
&apos;--------------------------------------------------------------------------------
function PuisN(Nombre as double, N as integer)
Dim J as integer, Reponse as double

Reponse = 1
for j = 1 to N
Reponse = Reponse * Nombre
Next
PuisN = Reponse
end function

&apos;--------------------------------------------------------------------------------
&apos;renvoie true si la chaine d&apos;une zone de texte est un nombre et qu&apos;elle est
&apos; comprise entre borne1 et borne2 incluses
&apos;option entier teste aussi si le nombre est un entier
&apos;--------------------------------------------------------------------------------
function estunnombreentrebornes(variable as variant,borne1 as double, borne2 as double,optional entier as boolean) as boolean
dim var1 as boolean, nombre1 as double, nombre2 as double

if isMissing(entier) then
entier = false
end if
  var1=IsNumeric(variable)
  if var1 = true then
  nombre1 = CDbl(variable)
     if entier = true then
          nombre2 = Fix(nombre1)
          else
          nombre2 = nombre1
     end if
     
     if nombre1&lt;borne1 or nombre1&gt;borne2 or nombre2&lt;&gt;nombre1 then
       var1 = false
     end if
    
  estunnombreentrebornes = var1
  end if
end function




&apos;---------------------------------------------------------------------------------------------------
&apos;function traduction qui récupère du texte quand le multilanguage est activé 
&apos;d&apos;après le livre de Bernard Marcelly et Laurent Godard : Macros OOoBASIC et API
&apos;----------------------------------------------------------------------------------------------------
Function trad(dlg As Object, libelle As String) As String
Dim rr As Object
rr = dlg.Model.ResourceResolver
trad = rr.resolveString(Mid(libelle, 2))
End Function
&apos;------------------------------------------------------------------------------------------------
&apos;selectionne les n dernières formes d&apos;un document writer ou Draw et les groupes
&apos;si n=0 alors selectionne toutes les formes
&apos;------------------------------------------------------------------------------------------------
sub SelectionFormes(n as integer, optional oDoc as object)
Dim oPage as object, oSelection as object, m as integer, oGroupe as object, oElementGroupe as object

if Ismissing(oDoc) then oDoc = thisComponent
if oDoc.ImplementationName = &quot;SwXTextDocument&quot; then oPage = oDoc.DrawPage
if oDoc.ImplementationName = &quot;SdXImpressDocument&quot; then oPage = oDoc.DrawPages(0)

m = oPage.Count
oSelection = createUnoService(&quot;com.sun.star.drawing.ShapeCollection&quot;)
if n = 0 then n = m
if n &gt; 1 then 
 for i = 1 to n
  oElementGroupe = oPage.getByIndex(m-i)
  oSelection.add(oElementGroupe)
 Next
 oGroupe = oPage.group(oSelection)
end if

m = oPage.Count
oGroupe = oPage.getByIndex(m-1)

if oDoc.ImplementationName = &quot;SwXTextDocument&quot; then
 oGroupe.Surround = com.sun.star.text.WrapTextMode.THROUGHT  &apos;text au travers
 oGroupe.AnchorType = com.sun.star.text.TextContentAnchorType.AT_PAGE
 &apos;oGroupe.SurroundAnchorOnly = true
end if

oDoc.CurrentController.select(oGroupe)

end sub


&apos;---------------------------------------------------------------------------------------------------
&apos;renvoi la derniere forme d&apos;une page, celle au dessus des autres
&apos;---------------------------------------------------------------------------------------------------



function LastForme(optional oDoc as object) as object
Dim n as integer, oForme as object

if Ismissing(oDoc) then oDoc = thisComponent
if oDoc.ImplementationName = &quot;SwXTextDocument&quot; then oPage = oDoc.DrawPage
if oDoc.ImplementationName = &quot;SdXImpressDocument&quot; then oPage = oDoc.DrawPages(0)

n = oPage.count
oForme = oPage.GetByIndex(n-1)
LastForme = oForme
end function


&apos;---------------------------------------------------------------------------------------------------
&apos;positionne la forme &quot;dessin&quot; sur la page writer
&apos;---------------------------------------------------------------------------------------------------

sub PosObjetFinal(dessin as object, optional posX as integer,optional posY as integer) &apos;macro principale
Dim positionForme As New com.sun.star.awt.Point
Dim olargeur as double, ohauteur as double

olargeur = dessin.Size.Width
oHauteur = dessin.Size.Height
if IsMissing(posX) then posX = (21000 - olargeur)/2
if IsMissing(posY) then posY = (29700 - ohauteur)/2
positionForme.x = posX
positionForme.y = posY
&apos;if ThisComponent.ImplementationName = &quot;SwXTextDocument&quot; then dessin.AnchorType = 2  &apos;défini l&apos;ancrage par rapport à la page
dessin.Position = positionForme

end sub


&apos;---------------------------------------------------------------------------------------------------
&apos;Taille finale suivant unite cm ou inch de la forme &quot;dessin&quot; sur la page
&apos;---------------------------------------------------------------------------------------------------

sub TailleObjetFinal(dessin as object) &apos;macro principale
Dim tailleForme As New com.sun.star.awt.Size
Dim olargeur as long, oHauteur as long, ahconst as double

olargeur = dessin.Size.width
oHauteur = dessin.Size.Height
tailleForme.Width = oLargeur*oChoixUnite 
tailleForme.Height = oHauteur*oChoixUnite 
dessin.size = tailleForme
end sub



&apos;--------------------------------------------------------------------------------
&apos;fonction qui renvoie l&apos;angle par rapport à la hauteur
&apos;angle positif pour les points à droites de la hauteur et négatif à gauche
&apos;macro prisme et macro pyramide
&apos;--------------------------------------------------------------------------------
Function AnglePtbaseSomCentre(Xa as Double, Ya as Double, Xs as Double, Ys as Double) as variant
Dim  varAngle as Double


if Ya &lt;&gt; Ys then
  if Xa &gt;= Xs then
  varAngle =  Atn((Xs - Xa)/(Ys - Ya))
     if varAngle &lt;0 then
     varAngle = pi + varAngle
     end if
  AnglePtbaseSomCentre = varAngle
  end if
  
  if Xa &lt; Xs then
  varAngle = Atn((Xs - Xa)/(Ys - Ya))
    if varAngle &gt; 0 then 
    varAngle = varAngle - pi
    end if
  AnglePtbaseSomCentre = varAngle
  end if
end if
if Ya = Ys then
  if Xa &gt;= Xs then
  AnglePtbaseSomCentre = pi/2
  else
  AnglePtbaseSomCentre = -1 * pi/2
  end if
end if
end function

     

&apos;--------------------------------------------------------------------------------
&apos;Dégroupe une forme et renvoie le nombre d&apos;éléments qui la constitue
&apos;--------------------------------------------------------------------------------
function DegrouperForme(oForme as Object, optional oDoc as object) as Double
Dim oPage As Object, nFormes as variant, x As Long, nElements as variant


if Ismissing(oDoc) then oDoc = thisComponent
if oDoc.ImplementationName = &quot;SwXTextDocument&quot; then oPage = oDoc.DrawPage
if oDoc.ImplementationName = &quot;SdXImpressDocument&quot; then oPage = oDoc.DrawPages(0)

nFormes = oPage.Count
nElements = 0
&apos;oForme = oPage(nFormes - 1)

if oForme.ShapeType = &quot;com.sun.star.drawing.GroupShape&quot; then
   nElements = oForme.Count
   oPage.ungroup(oForme)
end if
DegrouperForme = nElements
End function

&apos;----------------------------------------------------------------------------------
&apos;propriété &quot;texte au travers&quot; sur les n dernières formes d&apos;une page writer
&apos;----------------------------------------------------------------------------------

sub TexteTravers (n as variant)
Dim maPage As Object, NombreFormes as Double,GroupElements as object, ahForme as object

oDocActif = ThisComponent

if oDocActif.ImplementationName = &quot;SwXTextDocument&quot; then 
   maPage = oDocActif.DrawPage
   NombreFormes = maPage.Count
   GroupElements = createUnoService(&quot;com.sun.star.drawing.ShapeCollection&quot;)
   for i = 1 to n
   ahForme = maPage(NombreFormes - i)
   ahForme.Surround = com.sun.star.text.WrapTextMode.THROUGHT
   Next
end if
end sub


&apos;----------------------------------------------------------------------------------
&apos;renvoie les coordonnées d&apos;un polygone à n côtés connaissant la longueur du coté ou du rayon
&apos;----------------------------------------------------------------------------------

&apos;----------------------------------------------------------------------------------------
function CoordpolygoneMain(Xa as double, Ya as double,n as Double,PosPolygone as string, Longueur as double, Cote_Rayon as boolean)
Dim R as double, Angle1 as double, Lg as double,Xcentre as double, Ycentre as double, i as integer
Dim mesabscisses(n-1) as variant, mesordonnees(n-1) as variant


    if Cote_Rayon = true then
       Lg = Longueur*1000
       R = Lg/(2*sin(pi/n))
    else
       R = Longueur*1000
       Lg = 2*R*sin(pi/n)
    end if
    Xcentre = Xa + Lg/2 
    if PosPolygone = &quot;haut&quot; then
          Ycentre = Ya - R*cos(pi/n)
    else
          Ycentre = Ya + R*cos(pi/n)
    end if

Angle1 = pi - Atn((Ya-Ycentre)/(Lg/2))

for i = 0 to n-1
mesabscisses(i) = Xcentre + R*cos(i*2*pi/n - Angle1)
mesordonnees(i) = Ycentre - R*Sin(i*2*pi/n - Angle1)
next
CoordPolygoneMain = Tableau2xN(mesabscisses, mesordonnees)
end function

&apos;---------------------------------------------------------------------------------------
&apos;fonction coordonnées triangle
&apos;----------------------------------------------------------------------------------------
function CoordTriangleMain(xa as double, ya as double, Sens as string, RepA as double, RepB as double, RepC as double) as variant
Dim a as double, b as Double, c as double
Dim cosA as double, angleA as Double, xb as double, yb as double, xc as double, yc as double
Dim mesabscisses(3) as variant, mesordonnees(3) as variant

  a = RepA*1000
  b = RepB*1000
  c = RepC*1000
   
   &apos;inégalité triangulaire
   If a + b &lt;= c Or a + c &lt;= b Or b + c &lt;= a Then
   MsgBox(&quot;Ce triangle n&apos;est pas constructible ou est aplati&quot;)
   End
   End If
  &apos; fin de l&apos;inégalité triangulaire
  
   cosA = (b * b + c * c - a * a) / (2 * b * c)
   angleA = Atn(-cosA / Sqr(-cosA * cosA + 1)) + Pi / 2
   
   &apos;coordonnées des sommets du triangle
   if sens = &quot;bas&quot; then
   xb = xa + c
   yb = ya
   xc = xa + b * Cos(angleA)
   yc = ya + b * Sin(angleA)
   else
   xb = xa + c
   yb = ya
   xc = xa + b * Cos(angleA)
   yc = ya - b * Sin(angleA)
   end if
   
   mesabscisses = Array(xa,xb,xc,xa)
   mesordonnees = Array(ya,yb,yc,ya)
   
   
   CoordTriangleMain = Tableau2xN(mesabscisses, mesordonnees)
   
end function

&apos;----------------------------------------------------------------------------------------------------
&apos; fonction qui renvoie le type de forme sélectionnée et la place au premier plan
&apos;une seule forme peut être sélectionnée

function TypeForme (maForme as object) as string
Dim monType as string, message as string, N as integer
Dim A as string, B as string, C as string, D as string, E as string, F as string, G as string

  
On Error GoTo GestionErreur

   monType = maForme.getShapeType

   A = &quot;com.sun.star.drawing.LineShape&quot;
   B = &quot;com.sun.star.drawing.RectangleShape&quot;
   C = &quot;com.sun.star.drawing.PolyLineShape&quot; 
   D = &quot;com.sun.star.drawing.PolyPolygonShape&quot; 
   E = &quot;com.sun.star.drawing.EllipseShape&quot;
   F = &quot;com.sun.star.drawing.CustomShape&quot;
   G = &quot;com.sun.star.drawing.GroupShape&quot;

   
   if monType = A then message = &quot;Ligne&quot;
   if monType = B then message = &quot;Rectangle&quot;
   if monType = C then message = &quot;Ligne brisée&quot;
   if monType = D then message = &quot;Ligne brisée fermée&quot;
   if monType = E then message = &quot;Ellipse&quot;
   if monType = E and abs(maForme.Size.Height - maForme.Size.Width) &lt; 15 then message = &quot;Cercle&quot;    REM 
   if monType = F then message = &quot;forme particulière&quot;    
   if monType = G then message = &quot;forme groupée&quot;      
   if monType &lt;&gt; A and monType &lt;&gt; B and monType &lt;&gt; C and monType &lt;&gt; D and monType &lt;&gt; E and monType &lt;&gt; F and monType &lt;&gt; G  then    message = &quot;Aucune forme sélectionnée ou forme non reconnue&quot;
   
   TypeForme = message
   
FinErreur1:
   On Error GoTo 0 
   TypeForme = message
   Exit function     

GestionErreur:
message = &quot;Aucune forme sélectionnée ou forme non reconnue&quot;
Resume FinErreur1
   
end function


&apos;-------------------------------------------------------------------------------------------------------------------------------------------
&apos; fonction qui renvoie les coordonnée dans DRAW d&apos;une ligne brisée sélectionnée

function CoordLigneBrisee (MessageErreur as string) as variant     REM MessageErreur = &quot;il faut sélectionner une ligne ou une ligne brisée&quot;
Dim oForme as object, i as integer, oTaille as integer
Dim oType as string, N as integer


if oDocActif.CurrentSelection.supportsService( &quot;com.sun.star.drawing.ShapeCollection&quot;) then     
    oForme = oDocActif.CurrentSelection(0)
    oType = oForme.getShapeType

   if oType = &quot;com.sun.star.drawing.PolyLineShape&quot;  or oType = &quot;com.sun.star.drawing.PolyPolygonShape&quot;  then
   oTaille = Ubound(oForme.Polygon)
   ChargerDoc(false)
   DispatchSimple(&quot;Copy&quot;, oDocActif.CurrentController.Frame)
   DispatchSimple(&quot;Paste&quot;, oDocTemp.CurrentController.Frame)
   oForme = LastForme(oDocTemp)
   Dim ahSommet(otaille) as variant
   for i = 0 to oTaille
   ahSommet(i) = array(oForme.Polygon(i).X,oForme.Polygon(i).Y) 
   next
   CoordLigneBrisee = ahSommet
   oDocTemp.close(True)
   else
   msgbox(MessageErreur)    
   CoordLigneBrisee = &quot;vide&quot;
   end if

else
    msgbox(MessageErreur)
   CoordLigneBrisee = &quot;vide&quot;
end if

end function


&apos;-------------------------------------------------------------------------------------------------------------------------------------------
&apos; fonction qui renvoie les coordonnée dans le docactif d&apos;une ligne 

function CoordLigne (MessageErreur as string) as variant     REM MessageErreur = &quot;il faut sélectionner une ligne&quot;
Dim oForme as object, i as integer, oTaille as integer
Dim oType as string, N as integer


if oDocActif.CurrentSelection.supportsService( &quot;com.sun.star.drawing.ShapeCollection&quot;) then     
    oForme = oDocActif.CurrentSelection(0)
    oType = oForme.getShapeType

   if oType = &quot;com.sun.star.drawing.LineShape&quot;  then
   &apos;oTaille = Ubound(oForme.Polygon)
   &apos;ChargerDoc(false)
   &apos;DispatchSimple(&quot;Copy&quot;, oDocActif.CurrentController.Frame)
   &apos;DispatchSimple(&quot;Paste&quot;, oDocTemp.CurrentController.Frame)
  &apos; oForme = LastForme(oDocTemp)
   Dim  ahSommet(1) as variant &apos;ahSommet(otaille) as variant
   for i = 0 to 1
   ahSommet(i) = array(oForme.Polygon(i).X,oForme.Polygon(i).Y) 
   next
   CoordLigne = ahSommet
   &apos;oDocTemp.close(True)
   else
   msgbox(&quot;MessageErreur&quot;)    
   CoordLigne = &quot;vide&quot;
   end if

else
    msgbox(&quot;MessageErreur&quot;)
   CoordLigne = &quot;vide&quot;
end if

end function


&apos;********************* fonction Degroupage total ******************************************************
&apos;pour palier au problème de certaines formes GDmaths qui ont besoins de plusieurs dégroupage

Function GroupCleaner(Npasse as integer,optional oDoc as object, optional regrouperForme as boolean) as integer
Dim Nbre0 as integer, Nbre1 as integer, i as integer
Dim oFormeDeg as object
Dim oDispatcher1 as object

If IsMissing(regrouperForme) then regrouperForme = true
if Ismissing(oDoc) then oDoc = thisComponent

Nbre0 = oDoc.CurrentSelection.count
Nbre1 = 0

oDispatcher1 = createUnoService( &quot;com.sun.star.frame.DispatchHelper&quot; )

if Npasse &lt;&gt; 0 then
   While Nbre0 &lt;&gt; Nbre1
   Nbre0 = Nbre1

   for i = 1 to Npasse
   oDispatcher1.executeDispatch( oDoc.CurrentController.Frame, &quot;.uno:FormatUngroup&quot;, &quot;&quot;, 0, Array() )    Rem : utiliser Degrouper3D plante la procédure
   Next

   Nbre1 = oDoc.CurrentSelection.count
wend
end if

if regrouperForme = true then Grouper3D(oDoc)

GroupCleaner = Nbre0

end function


&apos;-------------------------------------------------------------------------------------------------
&apos;test si un objet ou un dessin est selectionné 
&apos;-------------------------------------------------------------------------------------------------

Sub TestSelection as boolean
dim var as integer, oforme as object, oTypeForme as string, oSelection as object
dim i as integer, oTest as boolean

oTest = false

oDocActif = thisComponent
if oDocActif.ImplementationName = &quot;SwXTextDocument&quot; then oPageActive = oDocActif.DrawPage
if oDocActif.ImplementationName = &quot;SdXImpressDocument&quot; then oPageActive = oDocActif.DrawPages(0)

oSolide = oDocActif.CurrentSelection

if IsNull(oSolide) = false then
   if oSolide.supportsService(&quot;com.sun.star.drawing.ShapeCollection&quot;) then oTest = true
   if oSolide.supportsService(&quot;com.sun.star.text.BaseFrame&quot;) then oTest = true
end if

TestSelection = oTest
msgbox(oTest)

end sub

&apos;---------------------------------------------------------------------------------------------------------
&apos;---------------- renvoie (option : et définit) la valeur du zoom de la page
&apos;---------------------------------------------------------------------------------------------------------
function Zoom(optional z as integer, optional oDoc as object) as integer

if Ismissing(oDoc) then oDoc = thisComponent
if IsMissing(z) then
	if oDoc.ImplementationName = &quot;SwXTextDocument&quot; then z =	oDoc.CurrentController.ViewSettings.ZoomValue  
	if oDoc.ImplementationName = &quot;SdXImpressDocument&quot; then z = oDoc.CurrentController.ZoomValue
end if

if Not IsMissing(z) then
 if oDoc.ImplementationName = &quot;SwXTextDocument&quot; then 
    if z &lt;&gt; 1 and z &lt;&gt; 2 then
    oDoc.CurrentController.ViewSettings.ZoomType = 3
    if z &lt; 20 then z = 20
    if z &gt; 600 then z = 600
	oDoc.CurrentController.ViewSettings.ZoomValue = z
	end if
	if z = 1 then oDoc.CurrentController.ViewSettings.ZoomType = 1  &apos;&quot;largeur page&quot;
	if z = 2 then oDoc.CurrentController.ViewSettings.ZoomType = 2  &apos;&quot;hauteur page&quot;
    wait(200)
	z = oDoc.CurrentController.ViewSettings.ZoomValue
 end if
 if oDoc.ImplementationName = &quot;SdXImpressDocument&quot; then
    if z&gt;= 20 then
	oDoc.CurrentController.ZoomType = 3
	oDoc.CurrentController.ZoomValue = z
	end if
	if z = 1 then oDoc.CurrentController.ZoomType = 1  &apos;&quot;largeur page&quot;
	if z = 2 then oDoc.CurrentController.ZoomType = 2  &apos;&quot;hauteur page&quot;
    wait(200)
	z = oDoc.CurrentController.ZoomValue
 end if	
end if

Zoom = z

end function

&apos;---------------------------------------------------------------------------------------------------
&apos;fonction qui renvoie la position de la forme &quot;dessin&quot; sur la page active / coin haut droit
&apos;---------------------------------------------------------------------------------------------------

function PosObjetPage(optional dessin as object) As New com.sun.star.awt.Point
Dim positionForme As New com.sun.star.awt.Point
Dim posx as integer, posy as integer
Dim oDoc as Object
Dim TypeAncre as string, numTypeAncre as integer

If IsMissing(dessin) then dessin = ThisComponent.CurrentSelection(0)
oDoc = thisComponent

if oDoc.ImplementationName = &quot;SwXTextDocument&quot; then
numTypeAncre = dessin.AnchorType  REM monDessin.AnchorType = 0 - &quot;Paragraphe&quot; / 1 - &quot;Caractère&quot; / 2 - &quot;Page&quot; / 3 - &quot;Cadre&quot; / 4 - &quot;Caractère curseur&quot;
if dessin.AnchorType &lt;&gt; 2 then dessin.AnchorType = 2
posx = dessin.Position.x
posy = dessin.Position.y
dessin.AnchorType = numTypeAncre
end if

if oDoc.ImplementationName = &quot;SdXImpressDocument&quot; then
posx = dessin.Position.x
posy = dessin.Position.y
end if

positionForme.x = posx
positionForme.y = posy

PosObjetPage = positionForme

end function
</script:module>