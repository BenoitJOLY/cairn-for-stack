REM  *****  BASIC  *****

Option Explicit



sub ConeTroncMP &apos;macro principale

Dim i As Integer, test As String, decalage As Long, NombreElements as variant
Dim NomSolide As String, nbre1 as variant, nbre2 as variant, nbre3 as variant, nbre4 as variant

appelDlgConeTronc()

if oReponseDlg(20) = true then
Deselection 
DRAWversDocActif(&quot;ConeTronc.ConstructionConeTronc()&quot;)
&apos;TailleObjetFinal(LastForme)
&apos;PosObjetFinal(LastForme)
end if

end Sub

&apos;------------------------------------------------------------------------------------------------------
Sub appelDlgConeTronc()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;ConeTroncDlg&quot;)
PositionDlg(monDlg,120,150)
&apos;------------------------initialisation de la boite de dialogue-----------------------
Initialisation_Unites(3,1)		
Initialisation(monDlg,CheminDessin(&quot;Dessins/ConeTronc/conetronc1.png/&quot;),5)
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs-------------------------
for i = 1 to 6
oReponseDlg(i + 50) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	
monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
    
End Sub



sub ConstructionConeTronc()
Dim oAngInclRad as Double, oAngSectRad as double, oAngSectDeg as double, oAngDebRad as double, oAngDebDeg as double, oAngDebRad2 as double, oAngDebDeg2 as double
Dim Abscentre as Double, Ordcentre1 as  Double, Ordcentre2 as  Double
Dim a as double, b as double, c as double, d as double, k as double,kh as double, oYi as double, oXi1 as double, oXi2 as double, oYsom as double
Dim Rayon1 as double,Rayon2 as double, oRayonSect as double, oHauteurTC as double
Dim oLong as double, oStyle as string, oAngle1 as double, oAngle2 as double
Dim oXt1 as double, oYt1 as double, oXt2 as double, oYt2 as double
Dim oPosBases as string

Rayon1 = oReponseDlg(0)*1000
Rayon2 = oReponseDlg(1)*1000
oAngInclRad =abs(oReponseDlg(2) * pi / 180)  &apos;abs car il me faut un angle positif à cause du signe des sin
if oReponseDlg(18) = 1 then oReponseDlg(3) = oReponseDlg(3)/cos(oAngInclRad)          &apos;hauteur sur le dessin sélectionnée
oHauteurTC = oReponseDlg(3)*1000*cos(oAngInclRad)


AbsCentre = Rayon1
OrdCentre1 = 10000
OrdCentre2 = 10000 - oHauteurTC

a = Rayon1  &apos;gde 1/2 diagonale de l&apos;ellipse 1
b = Rayon1 * sin(oAngInclRad) &apos;pte 1/2 diagonale de l&apos;ellipse 1
c = Rayon2  &apos;gde 1/2 diagonale de l&apos;ellipse 2
d = Rayon2 * sin(oAngInclRad) &apos;pte 1/2 diagonale de l&apos;ellipse 2
k = a/b   rem k = c/d
kh = a/c   rem kh = rapport d&apos;homothétie


&apos;--------- coord des points d&apos;intersections des ellipses
&apos;oYi = (a*a-c*c+k*k*oHauteurTC*oHauteurTC)/(2*k*k*oHauteurTC)
&apos;if 1-(oYi/b)*(oYi/b) &gt; 0 then    rem les ellipses se croisent
&apos;oXi1 = a*sqr(1-(oYi/b)*(oYi/b))
&apos;oXi2 = -1*a*sqr(1-(oYi/b)*(oYi/b))
&apos;endif
&apos;-----------------------------------------------------------

oYsom = oHauteurTC*kh/(kh-1)
oPosBases = IIf(oYsom*oYsom-b*b &gt;=0, &quot;non incluses&quot;, &quot;incluses&quot;)  &apos;oPosBases= incluses qd les 2 ellipses sont l&apos;une dans l&apos;autre

if oPosBases = &quot;non incluses&quot; then
  oXt1 = a*sqr(oYsom*oYsom-b*b)/oYsom
  oYt1 = b*b/oYsom
  oXt2 = oXt1/kh
  oYt2 = (oYt1-oYsom)/kh + oYsom

  oAngle1 = Atn(sqr(a*a-oXt1*oXt1)/oXt1) * 180/pi
  oAngle2 = Atn(sqr(c*c-oXt2*oXt2)/oXt2) * 180/pi

  if oReponseDlg(2)&gt;=0 then
  ArcEllipseDraw(10000-a, 10000 - b ,2*a,2*b,&quot;pointillé&quot;,oAngle1,180-oAngle1)
  ArcEllipseDraw(10000-a, 10000 - b ,2*a,2*b,&quot;plein&quot;,180-oAngle1,oAngle1)
  ArcEllipseDraw(10000-c, 10000 - oHauteurTC - d ,2*c,2*d,&quot;plein&quot;,oAngle2,180-oAngle2)
  ArcEllipseDraw(10000-c, 10000 - oHauteurTC - d ,2*c,2*d,&quot;plein&quot;,180-oAngle2,oAngle2)
  else
  ArcEllipseDraw(10000-a, 10000 - b ,2*a,2*b,&quot;plein&quot;,oAngle1,180-oAngle1)
  ArcEllipseDraw(10000-a, 10000 - b ,2*a,2*b,&quot;plein&quot;,180-oAngle1,oAngle1)
  ArcEllipseDraw(10000-c, 10000 - oHauteurTC - d ,2*c,2*d,&quot;plein&quot;,oAngle2,180-oAngle2)
  ArcEllipseDraw(10000-c, 10000 - oHauteurTC - d ,2*c,2*d,&quot;pointillé&quot;,180-oAngle2,oAngle2)
  end if

  SegmentDraw(10000 + oXt1, 10000-oYt1 ,  10000 + oXt2 , 10000 - oYt2 , 30,&quot;plein&quot;)
  SegmentDraw(10000 - oXt1, 10000-oYt1 ,  10000 -oXt2 , 10000 - oYt2  , 30,&quot;plein&quot;)

end if


if oPosBases = &quot;incluses&quot; then
    if oReponseDlg(2)&gt;=0 and a&lt;c then
    ArcEllipseDraw(10000-a, 10000 - b ,2*a,2*b,&quot;pointillé&quot;,-179.99, 180)
    else
    ArcEllipseDraw(10000-a, 10000 - b ,2*a,2*b,&quot;plein&quot;,-179.99, 180)
    end if
    if oReponseDlg(2)&lt;0 and a&gt;=c then
    ArcEllipseDraw(10000-c, 10000 - oHauteurTC - d ,2*c,2*d,&quot;pointillé&quot;,-179.99, 180)
    else
    ArcEllipseDraw(10000-c, 10000 - oHauteurTC - d ,2*c,2*d,&quot;plein&quot;,-179.99, 180)
    end if
end if


if abs(oYsom) &lt;= 25000 then
 if oReponseDlg(5) = 1 then  PointDraw(10000 , 10000-oYsom , oAngInclRad , 30,&quot;plein&quot;)   &apos;sommet
 if oReponseDlg(10) = 1 then SegmentDraw(10000 , 10000-oYsom ,  10000 , 10000 , 30,oReponseDlg(15))    &apos;hauteur du cone
 if oReponseDlg(6) = 1 then    &apos;cône
  SegmentDraw(10000 - oXt1, 10000-oYt1 ,  10000 , 10000 - oYsom , 30,oReponseDlg(13))
  SegmentDraw(10000 + oXt1, 10000-oYt1 ,  10000 , 10000 - oYsom  , 30,oReponseDlg(13))
 end if
 else  
 if oReponseDlg(5) = 1 or  oReponseDlg(10) = 1 or  oReponseDlg(6) = 1 then
 msgbox(oReponseDlg(56), 0+48,&quot;AHmath3D&quot;)
 end if 
end if

if oReponseDlg(7) = 1 then PointDraw(10000 , 10000-oHauteurTC,oAngInclRad , 30,&quot;plein&quot;)    &apos;centre dessus
if oReponseDlg(8) = 1 then PointDraw(10000 , 10000 , oAngInclRad , 30,&quot;plein&quot;)     &apos;centre dessous
if oReponseDlg(9) = 1 then SegmentDraw(10000 , 10000-oHauteurTC ,  10000 , 10000 , 30,oReponseDlg(14))   &apos;hauteur du tronc
if oReponseDlg(11) = 1 then SegmentDraw(10000 , 10000-oHauteurTC  ,  10000 + oXt2, 10000-oYt2  , 30,oReponseDlg(16))    &apos;rayon dessus
if oReponseDlg(12) = 1 then SegmentDraw(10000 , 10000,  10000 + oXt1, 10000-oYt1  , 30,oReponseDlg(17))    &apos;rayon dessous

end sub


&apos;-------------------------------------------------------------------------------------------------------
&apos;gestion des boutons de la boite de dialogue

Sub GestionInfoBulle
TexteAide(monDlg,&quot;TextField1&quot;, &quot;0&lt; ... &lt;= 10&quot;)
TexteAide(monDlg,&quot;TextField2&quot;, &quot;0 &lt;= ... &lt;= 10&quot;)
TexteAide(monDlg,&quot;TextField3&quot;, &quot;-90&lt;= ... &lt;= 90&quot;)
TexteAide(monDlg,&quot;TextField4&quot;, &quot;0&lt;= ... &lt;= 20&quot;)
end sub


sub GestionImage
Dim R1 as double, R2 as double,A1 as double
if IsNumeric(monDlg.getcontrol(&quot;TextField1&quot;).Peer.text) and IsNumeric(monDlg.getcontrol(&quot;TextField2&quot;).Peer.text) and IsNumeric(monDlg.getcontrol(&quot;TextField3&quot;).Peer.text)  then
   R1 = CDbl(monDlg.getcontrol(&quot;TextField1&quot;).Peer.text)
   R2 = CDbl(monDlg.getcontrol(&quot;TextField2&quot;).Peer.text)
   A1 = CDbl(monDlg.getcontrol(&quot;TextField3&quot;).Peer.text)
   if A1&gt;=0 then
     if R1 &gt;= R2 then
     AffecterImageFixe(monDlg, &quot;ImagePrincipale&quot; , CheminDessin(&quot;Dessins/ConeTronc/conetronc1.png/&quot;))
     else
     AffecterImageFixe(monDlg, &quot;ImagePrincipale&quot; , CheminDessin(&quot;Dessins/ConeTronc/conetronc3.png/&quot;))
     end if
   else
   if R1 &gt;= R2 then
     AffecterImageFixe(monDlg, &quot;ImagePrincipale&quot; , CheminDessin(&quot;Dessins/ConeTronc/conetronc2.png/&quot;))
     else
     AffecterImageFixe(monDlg, &quot;ImagePrincipale&quot; , CheminDessin(&quot;Dessins/ConeTronc/conetronc4.png/&quot;))
     end if
    end if
end if
end sub



sub GestionBoutonOK  
Dim i as integer, test(6) as integer

&apos;-----------------------Gestion des erreurs de saisie
test(1) = ZT_Nbre(monDlg,  &quot;TextField1&quot;, 0.001 , 10 , 5 , oReponseDlg(51),)
test(2) = ZT_Nbre(monDlg,  &quot;TextField2&quot;, 0.001 , 10 , 3 , oReponseDlg(52),)
test(3) = ZT_Nbre(monDlg,  &quot;TextField3&quot;, -90 , 90 , 10 , oReponseDlg(54),) 
test(4) = ZT_Nbre(monDlg,  &quot;TextField4&quot;, 0.001, 20 , 5 , oReponseDlg(53),) 
     
test(0) = test(1)*test(2)*test(3)*test(4) &apos;test(0) contient 1 si tout est ok 0 sinon

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
    for i = 1 to 4
    oReponseDlg(i - 1) = CDbl(monDlg.getControl(&quot;TextField&quot;&amp;i).Peer.Text)
    Next
    for i = 1 to 8
    oReponseDlg(4+i) = monDlg.getControl(&quot;CheckBox&quot;&amp;i).Model.state  
    Next 
    for i = 1 to 5
    oReponseDlg(12+i) = monDlg.getControl(&quot;StyleA&quot;&amp;i).Model.state  
    Next
    oReponseDlg(18) =  monDlg.getControl(&quot;OptionButton2&quot;).Model.state

    If oReponseDlg(0) = oReponseDlg(1) then   &apos;r1 = r2 &gt; cylindre
    msgbox(oReponseDlg(55), 0+48,&quot;AHmath3D&quot;)
    test(0) = 0
    end if
end if  
 
if test(0) = 1 then
        
    oReponseDlg(20) = true  &apos;renvoie true si la boite de dialogue est fermée par le bouton OK
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    monDlg.endExecute
end if

End Sub


&apos;----------------------------------------------------------------------------
&apos;gestion des unités Cm/Inch
&apos;-------------------------------------------------------------------------

sub OptionUnite_click
OptionUnite(2,1)
end sub

</script:module>