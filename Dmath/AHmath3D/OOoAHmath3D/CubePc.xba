REM  *****  BASIC  *****

Option Explicit

sub CubePcMacroPrincipale &apos;macro principale

appelerBoiteDialogueCubePc()

if oReponseDlg(8) = true then
	Deselection  
   DRAWversDocActif(&quot;CubePc.ConstructionCubePc()&quot;)
   oSolide = LastForme
   TailleObjetFinal(oSolide)
   PosObjetFinal(oSolide)
  
end if

end Sub
&apos;------------------------------------------------------------------------------------------------------
Sub appelerBoiteDialogueCubePc()
Dim i As Integer
	
monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;CubePcDlg&quot;)
PositionDlg(monDlg,120,150)	
&apos;--------------------------initialissation de la boite de dialogue---------------------
Initialisation_Unites(3,1)
Initialisation(monDlg,CheminDessin(&quot;Dessins/PavePC/Pave1.gif/&quot;))
AffecterImageFixe(monDlg, &quot;ImageControl2&quot; ,CheminDessin(&quot;Dessins/PavePC/PaveAngle.gif/&quot;))
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs -----------------------
for i = 1 to 4
oReponseDlg(i + 3) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------

monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub


sub PaveStyleArete(x0 as double, y0 as double, Longueur as double, Hauteur as double, Profondeur as double, AngleFuite as double, Aface as string, A5 as string, A6 as string, A7 as string, A8 as string,A9 as string, A10 as string, A11 as string, A12 as string)

&apos;tracé de la vue de face
SegmentDraw(x0, y0 , x0 + Longueur*1000 ,y0 ,30, Aface)
SegmentDraw(x0 , y0 ,x0, y0 - Hauteur*1000 ,30, Aface)
SegmentDraw( X0 + Longueur *1000 ,y0, X0 + Longueur *1000, y0 - Hauteur*1000 ,30,Aface)
SegmentDraw( X0 ,y0 - Hauteur*1000, X0 + Longueur *1000, y0 - Hauteur*1000 ,30,Aface)


&apos;Tracé de la vue de dessus
SegmentDraw(x0, y0 - Hauteur * 1000 , x0 + Profondeur * cos(AngleFuite)*1000 ,y0 - Hauteur *1000 - Profondeur * sin(AngleFuite)*1000 ,30,A5)
SegmentDraw(x0  + Longueur * 1000, y0  - Hauteur*1000 , x0 + Longueur *1000 + Profondeur * cos(AngleFuite)*1000,y0 - Hauteur*1000-Profondeur*sin(AngleFuite)*1000 ,30,A6)
SegmentDraw( x0 + Profondeur * cos(AngleFuite)*1000 ,y0 -Hauteur * 1000 - Profondeur * sin(AngleFuite)*1000 ,  x0 + Longueur *1000 + Profondeur * cos(AngleFuite)*1000  ,y0 - Hauteur*1000-Profondeur*sin(AngleFuite)*1000 ,30,A7)

&apos;Tracé de la vue de dessous
SegmentDraw(x0, y0  , x0 + Profondeur * cos(AngleFuite)*1000 ,y0  - Profondeur * sin(AngleFuite)*1000 ,30,A8)
SegmentDraw(x0  + Longueur * 1000, y0   , x0 + Longueur *1000 + Profondeur * cos(AngleFuite)*1000,y0 - Profondeur*sin(AngleFuite)*1000 ,30,A9)
SegmentDraw(x0 + Profondeur * cos(AngleFuite)*1000 ,y0 - Profondeur * sin(AngleFuite)*1000 ,  x0 + Longueur *1000 + Profondeur * cos(AngleFuite)*1000  ,y0 -Profondeur*sin(AngleFuite)*1000 ,30,A10)

&apos;Tracé des 2 hauteurs de la face de derrière
SegmentDraw(x0 + Profondeur * cos(AngleFuite)*1000, y0 - Profondeur*sin(AngleFuite)*1000  , x0 + Profondeur * cos(AngleFuite)*1000 ,y0 - Hauteur * 1000- Profondeur*sin(AngleFuite)*1000 ,30,A11)
SegmentDraw(x0 + LOngueur * 1000 + Profondeur * cos(AngleFuite)*1000, y0 - Profondeur*sin(AngleFuite)*1000  , x0 + Longueur * 1000 + Profondeur * cos(AngleFuite)*1000 ,y0 - Hauteur * 1000- Profondeur*sin(AngleFuite)*1000 ,30,A12)

end sub



sub ConstructionCubePc()
Dim AngFuite as double, Xpos as double, Ypos as double

AngFuite =  oReponseDlg(3) * pi / 180
Xpos = 5000
Ypos = 10000

if AngFuite&gt;=0 and AngFuite&lt;= pi/2 then
PaveStyleArete(Xpos, Ypos, oReponseDlg(0), oReponseDlg(1), oReponseDlg(2), AngFuite, &quot;plein&quot;, &quot;plein&quot;, &quot;plein&quot;, &quot;plein&quot;, &quot;pointillé&quot;,&quot;plein&quot;, &quot;pointillé&quot;, &quot;pointillé&quot;, &quot;plein&quot;)
end if

if AngFuite&gt;pi/2 and AngFuite&lt;= pi then
PaveStyleArete(Xpos, Ypos, oReponseDlg(0), oReponseDlg(1), oReponseDlg(2), AngFuite, &quot;plein&quot;, &quot;plein&quot;, &quot;plein&quot;, &quot;plein&quot;, &quot;plein&quot;,&quot;pointillé&quot;, &quot;pointillé&quot;, &quot;plein&quot;, &quot;pointillé&quot;)
end if

if AngFuite&gt;pi and AngFuite&lt;= 3*pi/2 then
PaveStyleArete(Xpos, Ypos, oReponseDlg(0), oReponseDlg(1), oReponseDlg(2), AngFuite, &quot;plein&quot;, &quot;plein&quot;, &quot;pointillé&quot;, &quot;pointillé&quot;, &quot;plein&quot;,&quot;plein&quot;, &quot;plein&quot;, &quot;plein&quot;, &quot;pointillé&quot;)
end if

if AngFuite&gt;3*pi/2 and AngFuite&lt;= 2*pi then
PaveStyleArete(Xpos, Ypos, oReponseDlg(0), oReponseDlg(1), oReponseDlg(2), AngFuite, &quot;plein&quot;, &quot;pointillé&quot;, &quot;plein&quot;, &quot;pointillé&quot;, &quot;plein&quot;,&quot;plein&quot;, &quot;plein&quot;, &quot;pointillé&quot;, &quot;plein&quot;)
end if
end sub

&apos;****************************************************Gestion de la boite de dialogue*****************************************************************

sub GestionImage
ChangerImagePrincipalex4(monDlg , &quot;RepCubePc4&quot; , CheminDessin(&quot;Dessins/PavePC/Pave1.gif/&quot;), CheminDessin(&quot;Dessins/PavePC/Pave2.gif/&quot;),CheminDessin(&quot;Dessins/PavePC/Pave3.gif/&quot;), CheminDessin(&quot;Dessins/PavePC/Pave4.gif/&quot;), CheminDessin(&quot;Dessins/erreur.gif/&quot;))
end sub

Sub GestionInfoBulle
TexteAide(monDlg,&quot;RepCubePc1&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;RepCubePc2&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;RepCubePc3&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;RepCubePc4&quot;, &quot;0&lt;= ... &lt;= 360&quot;)
end sub


sub GestionBoutonOK  
Dim choix as Object, valeur as string,i as integer, test(4) as integer

&apos;-----------------------Gestion des erreurs de saisie
for i = 1 to 3
test(i) = ZT_Nbre(monDlg,  &quot;RepCubePc&quot;&amp;i, 0.001 , 20 , 5 , oReponseDlg(i + 3),) 
next 
test(4) = ZT_Nbre(monDlg,  &quot;RepCubePc4&quot;, 0 , 360 , 45 , oReponseDlg(7),)        &apos; 0 ou 1
test(0) = test(1)*test(2)*test(3)*test(4)   
&apos;---------------------- (test(0) contient 1 si tout est ok 0 sinon)

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
    for i = 1 to 4
    oReponseDlg(i - 1) = CDbl(monDlg.getControl(&quot;RepCubePc&quot;&amp;i).Peer.Text)
    Next
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    oReponseDlg(8) = true   &apos;true quand tout est validé
&apos;---------------------    oReponseDlg(8) = true quand tout est validé
    monDlg.endExecute
end if

End Sub


&apos;----------------------------------------------------------------------------
&apos;gestion des unités Cm/Inch
&apos;-------------------------------------------------------------------------

sub OptionUnite_click
OptionUnite(3,1)
end sub


</script:module>