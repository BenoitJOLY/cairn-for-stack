REM  *****  BASIC  *****

Option Explicit


sub CylindreMacroPrincipale &apos;macro principale

appelerBoiteDialogueCylindre()

if oReponseDlg(32) = true then
	Deselection
   DRAWversDocActif(&quot;Cylindre.ConstructionCylindre()&quot;)
   oSolide = LastForme
   TailleObjetFinal(oSolide)
   PosObjetFinal(oSolide) 
end if

end Sub


&apos;------------------------------------------------------------------------------------------------------
Sub appelerBoiteDialogueCylindre()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;CylindreDlg&quot;)
PositionDlg(monDlg,120,150)
&apos;-------------------------initialisation de la boite de dialogue--------------------
Initialisation_Unites(2,5)	
Initialisation(monDlg,CheminDessin(&quot;Dessins/Cylindre/cylindre1.gif/&quot;))
GestionInfoBulle
&apos;------------------------ récupération des messages d&apos;erreurs -----------------------
for i = 1 to 5
oReponseDlg(i + 26) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	

monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub

sub ConstructionCylindre()
TracerCylindre(10000,10000, oReponseDlg(0)*1000,oReponseDlg(1)*1000,oReponseDlg(2))
end sub

&apos;------------------------------------------------------------------------------------------------------
sub TracerCylindre(Xcentre as Double, Ycentre as Double , Rayon as Double , h as Double, AngIncl as Double)
Dim RadAngIncl as Double
Dim Abscentre1 as Double, Ordcentre1 as  Double, Abscentre2 as Double, Ordcentre2 as Double
Dim AngleRayon1 as double, AngleDiam1 as double, AngleRayon2 as double, AngleDiam2 as double
Dim a as double, b as double, h1 as double, k as integer


RadAngIncl =abs(AngIncl * pi / 180)  &apos;abs car il me faut un angle positif à cause du signe des sin

if oReponseDlg(24) = 1 then              &apos;hauteur sur le dessin sélectionnée
   h1 = h                               
   else                              
   h1 = h * cos(RadAngIncl)              
end if                                    

AbsCentre1 = Xcentre
OrdCentre1 = Ycentre
AbsCentre2 = Xcentre
OrdCentre2 = Ycentre - h1

AngleDiam1 = oReponseDlg(21)* pi/180
AngleDiam2 = oReponseDlg(22)* pi/180
AngleRayon1 = oReponseDlg(19)* pi/180
AngleRayon2 = oReponseDlg(20)* pi/180

a = Rayon
b = Rayon * sin(RadAngIncl)


&apos;le 3ème argument de ArcEllipse est la largeur de l&apos;ellipse entière
&apos;le 4ème argument de ArcEllipse est la hauteur de l&apos;ellipse entière
if AngIncl &gt; 0 then
ArcEllipseDraw(Abscentre1 - a, Ordcentre1 - b ,2*a,2*b,&quot;pointillé&quot;,0,180)
ArcEllipseDraw(Abscentre1 - a, Ordcentre1 - b ,2*a,2*b,&quot;plein&quot;,180,0)
ArcEllipseDraw(Abscentre1 - a, Ordcentre1 - b -h1 ,2*a,2*b,&quot;plein&quot;,0,180)
ArcEllipseDraw(Abscentre1 - a, Ordcentre1 - b - h1 ,2*a,2*b,&quot;plein&quot;,180,0)
SegmentDraw(Abscentre1 - a, Ordcentre1,  Abscentre1 - a, Ordcentre1 -h1,30,&quot;plein&quot;)
SegmentDraw(Abscentre1 + a, Ordcentre1,  Abscentre1 + a, Ordcentre1 -h1,30,&quot;plein&quot;)
end if
if AngIncl &lt; 0 then
ArcEllipseDraw(Abscentre1 - a, Ordcentre1 - b ,2*a,2*b,&quot;plein&quot;,0,180)
ArcEllipseDraw(Abscentre1 - a, Ordcentre1 - b ,2*a,2*b,&quot;plein&quot;,180,0)
ArcEllipseDraw(Abscentre1 - a, Ordcentre1 - b -h1 ,2*a,2*b,&quot;plein&quot;,0,180)
ArcEllipseDraw(Abscentre1 - a, Ordcentre1 - b - h1 ,2*a,2*b,&quot;pointillé&quot;,180,0)
SegmentDraw(Abscentre1 - a, Ordcentre1,  Abscentre1 - a, Ordcentre1 -h1,30,&quot;plein&quot;)
SegmentDraw(Abscentre1 + a, Ordcentre1,  Abscentre1 + a, Ordcentre1 -h1,30,&quot;plein&quot;)
end if
if AngIncl = 0 then
SegmentDraw(Abscentre1 - a, Ordcentre1-h1,  Abscentre1 + a, Ordcentre1 -h1,30,&quot;plein&quot;)
SegmentDraw(Abscentre1 + a, Ordcentre1,  Abscentre1 + a, Ordcentre1 -h1,30,&quot;plein&quot;)
SegmentDraw(Abscentre1 - a, Ordcentre1,  Abscentre1 - a, Ordcentre1 -h1,30,&quot;plein&quot;)
SegmentDraw(Abscentre1 - a, Ordcentre1,  Abscentre1 + a, Ordcentre1,30,&quot;plein&quot;)
end if
&apos;----------------------tracer les centres des bases
if oReponseDlg(3) = 1 then
PointDraw(AbsCentre1, OrdCentre1 , RadAngIncl , 30,&quot;plein&quot;)
PointDraw(AbsCentre2, OrdCentre2 , RadAngIncl , 30,&quot;plein&quot;)
end if
&apos;-----------------------tracer hauteur
if oReponseDlg(16) = 1 then  SegmentDraw(AbsCentre1, OrdCentre1 ,  AbsCentre2 , OrdCentre2 , 30,oReponseDlg(17))

&apos;---------------------tracer des rayons
if oReponseDlg(4) = 1 then SegmentDraw(AbsCentre1, OrdCentre1 ,  AbsCentre1 + a* cos(AngleRayon1) , OrdCentre1 - a * sin(AngleRayon1)*sin(RadAngIncl) , 30,oReponseDlg(5))
if oReponseDlg(7) = 1 then SegmentDraw(AbsCentre2, OrdCentre2 ,  AbsCentre2 + a*cos(AngleRayon2) , OrdCentre2 - a *sin(AngleRayon2)*sin(RadAngIncl) , 30,oReponseDlg(8))

&apos;--------------------tracer des diamètres
if oReponseDlg(10) = 1 then SegmentDraw(AbsCentre1 - a* cos(AngleDiam1), OrdCentre1+ a * sin(AngleDiam1)*sin(RadAngIncl) ,  AbsCentre1 + a* cos(AngleDiam1) , OrdCentre1- a* sin(AngleDiam1)*sin(RadAngIncl) , 30,oReponseDlg(11))
if oReponseDlg(13) = 1 then SegmentDraw(AbsCentre2 - a*cos(AngleDiam2), OrdCentre2+ a * sin(AngleDiam2)*sin(RadAngIncl) ,  AbsCentre2 + a*cos(AngleDiam2)  , OrdCentre2-a*sin(AngleDiam2)*sin(RadAngIncl) , 30,oReponseDlg(14))

&apos;----------------------tracer des angles droits
if oReponseDlg(25)=1 then   &apos;angle droit face du haut
if oReponseDlg(7) = 1 then
    QuadrilatereDraw(AbsCentre2, OrdCentre2 ,  AbsCentre2  + cos(AngleRayon2) * 250 ,OrdCentre2 - sin(AngleRayon2)*sin(RadAngIncl) * 250  ,AbsCentre2  + cos(AngleRayon2)  * 250 ,OrdCentre2 - sin(AngleRayon2)*sin(RadAngIncl) * 250 + 250,AbsCentre2, OrdCentre2 + 250 , 30)
    ElseIf oReponseDlg(13)=1 then
    QuadrilatereDraw(AbsCentre2, OrdCentre2 ,  AbsCentre2  + cos(AngleDiam2) * 250 ,OrdCentre2 - sin(AngleDiam2)*sin(RadAngIncl) * 250  ,AbsCentre2  + cos(AngleDiam2)  * 250 ,OrdCentre2 - sin(AngleDiam2)*sin(RadAngIncl) * 250 + 250,AbsCentre2, OrdCentre2 + 250 , 30)
    Else
    QuadrilatereDraw(AbsCentre2, OrdCentre2 ,  AbsCentre2 + 250 ,OrdCentre2 ,AbsCentre2  + 250 ,OrdCentre2 + 250,AbsCentre2, OrdCentre2 + 250 , 30)
end if


end if
  

if oReponseDlg(26)=1 then   &apos;angle droit face du bas
if oReponseDlg(4) = 1 then
    QuadrilatereDraw(AbsCentre1, OrdCentre1 ,  AbsCentre1  + cos(AngleRayon1) * 250 ,OrdCentre1 - sin(AngleRayon1)*sin(RadAngIncl) * 250  ,AbsCentre1  + cos(AngleRayon1)  * 250 ,OrdCentre1 - sin(AngleRayon1)*sin(RadAngIncl) * 250 - 250,AbsCentre1, OrdCentre1 - 250 , 30)
    ElseIf oReponseDlg(10) = 1 then
    QuadrilatereDraw(AbsCentre1, OrdCentre1 ,  AbsCentre1  + cos(AngleDiam1) * 250 ,OrdCentre1 - sin(AngleDiam1)*sin(RadAngIncl) * 250  ,AbsCentre1  + cos(AngleDiam1)  * 250 ,OrdCentre1 - sin(AngleDiam1)*sin(RadAngIncl) * 250 - 250,AbsCentre1, OrdCentre1 - 250 , 30)
    Else
    QuadrilatereDraw(AbsCentre1, OrdCentre1 ,  AbsCentre1  + 250 ,OrdCentre1 ,AbsCentre1  + 250 ,OrdCentre1 - 250,AbsCentre1, OrdCentre1 - 250 , 30)
end if
end if

end sub
&apos;-------------------------------------------------------------------------------------------------------
&apos;gestion des boutons de la boite de dialogue
sub GestionCase1
Aspect2BoutonsRadio(monDlg,&quot;RepCyl17&quot;,&quot;RepCyl18&quot;,&quot;RepCyl19&quot;)
AspectLabel(monDlg,&quot;RepCyl17&quot;,&quot;RepCyl26&quot;)
AspectLabel(monDlg,&quot;RepCyl17&quot;,&quot;RepCyl27&quot;)
end sub
sub GestionCase2
Aspect2BoutonsRadio(monDlg,&quot;RepCyl5&quot;,&quot;RepCyl6&quot;,&quot;RepCyl7&quot;)
AspectLabel(monDlg,&quot;RepCyl5&quot;,&quot;UA3&quot;)
AspectLabel(monDlg,&quot;RepCyl5&quot;,&quot;RepCyl20&quot;)
end sub
sub GestionCase3
Aspect2BoutonsRadio(monDlg,&quot;RepCyl8&quot;,&quot;RepCyl9&quot;,&quot;RepCyl10&quot;)
AspectLabel(monDlg,&quot;RepCyl8&quot;,&quot;UA2&quot;)
AspectLabel(monDlg,&quot;RepCyl8&quot;,&quot;RepCyl21&quot;)
end sub
sub GestionCase4
Aspect2BoutonsRadio(monDlg,&quot;RepCyl11&quot;,&quot;RepCyl12&quot;,&quot;RepCyl13&quot;)
AspectLabel(monDlg,&quot;RepCyl11&quot;,&quot;UA4&quot;)
AspectLabel(monDlg,&quot;RepCyl11&quot;,&quot;RepCyl22&quot;)
end sub
sub GestionCase5
Aspect2BoutonsRadio(monDlg,&quot;RepCyl14&quot;,&quot;RepCyl15&quot;,&quot;RepCyl16&quot;)
AspectLabel(monDlg,&quot;RepCyl14&quot;,&quot;UA5&quot;)
AspectLabel(monDlg,&quot;RepCyl14&quot;,&quot;RepCyl23&quot;)
end sub


&apos;****************************************************Gestion de la boite de dialogue*****************************************************************

Sub GestionInfoBulle
TexteAide(monDlg,&quot;RepCyl1&quot;, &quot;0&lt; ... &lt;= 10&quot;)
TexteAide(monDlg,&quot;RepCyl2&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;RepCyl3&quot;, &quot;-90&lt;= ... &lt;= 90&quot;)
TexteAide(monDlg,&quot;RepCyl20&quot;, &quot;0&lt;= ... &lt;= 360&quot;)
TexteAide(monDlg,&quot;RepCyl21&quot;, &quot;0&lt;= ... &lt;= 360&quot;)
TexteAide(monDlg,&quot;RepCyl22&quot;, &quot;0&lt;= ... &lt;= 180&quot;)
TexteAide(monDlg,&quot;RepCyl23&quot;, &quot;0&lt;= ... &lt;= 180&quot;)
end sub


sub GestionImage
ChangerImagePrincipalex2(monDlg , &quot;RepCyl3&quot;, CheminDessin(&quot;Dessins/Cylindre/cylindre1.gif/&quot;),CheminDessin(&quot;Dessins/Cylindre/cylindre2.gif/&quot;), CheminDessin(&quot;Dessins/erreur.gif/&quot;))
end sub



sub GestionBoutonOK  
Dim i as integer, test(7) as integer

&apos;-----------------------Gestion des erreurs de saisie
test(1) = ZT_Nbre(monDlg,  &quot;RepCyl1&quot;, 0.001 , 10 , 3 , oReponseDlg(27),)
test(2) = ZT_Nbre(monDlg,  &quot;RepCyl2&quot;, 0.001 , 20 , 5 , oReponseDlg(28),) 
test(3) = ZT_Nbre(monDlg,  &quot;RepCyl3&quot;, -90 , 90 , 10 , oReponseDlg(29),)
test(4) = ZT_Nbre(monDlg,  &quot;RepCyl20&quot;, 0 , 360 , 0 , oReponseDlg(30),) 
test(5) = ZT_Nbre(monDlg,  &quot;RepCyl21&quot;, 0 , 360 , 0 , oReponseDlg(30),)   &apos; 0 ou 1
test(6) = ZT_Nbre(monDlg,  &quot;RepCyl22&quot;, 0 , 180 , 0 , oReponseDlg(31),)
test(7) = ZT_Nbre(monDlg,  &quot;RepCyl23&quot;, 0 , 180 , 0 , oReponseDlg(31),)  

     
test(0) = test(1)*test(2)*test(3)*test(4)*test(5)*test(6)*test(7)   
&apos;---------------------- (test(0) contient 1 si tout est ok 0 sinon)

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
    for i = 1 to 3
    oReponseDlg(i - 1) = CDbl(monDlg.getControl(&quot;RepCyl&quot;&amp;i).Peer.Text)  
    Next
    for i = 4 to 19
    oReponseDlg(i - 1) = monDlg.getControl(&quot;RepCyl&quot;&amp;i).Model.state  
    Next 
    for i = 20 to 23
    oReponseDlg(i - 1) = CDbl(monDlg.getControl(&quot;RepCyl&quot;&amp;i).Peer.Text)  
    Next
    oReponseDlg(23) = monDlg.getControl(&quot;RepCyl24&quot;).Model.state 
    oReponseDlg(24) = monDlg.getControl(&quot;RepCyl25&quot;).Model.state 
    oReponseDlg(25) = monDlg.getControl(&quot;RepCyl26&quot;).Model.state 
    oReponseDlg(26) = monDlg.getControl(&quot;RepCyl27&quot;).Model.state    

    oReponseDlg(32) = true  &apos;renvoie true si la boite de dialogue est fermée par le bouton OK
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé

&apos;---------------------    oReponseDlg(32) = true quand tout est validé
    monDlg.endExecute
end if

End Sub


&apos;----------------------------------------------------------------------------
&apos;gestion des unités Cm/Inch
&apos;-------------------------------------------------------------------------

sub OptionUnite_click
OptionUnite(2,5)
end sub

