sub GestionZoneInfo
Dim test(5) as integer

&apos;-----------------------Gestion des erreurs de saisie

test(1) = ZT_Nbre(monDlg,  &quot;RepTroncPyrPc1&quot;, 0.001 , 20 , 5 , oReponseDlg(45),) 
test(2) = ZT_Nbre(monDlg,  &quot;RepTroncPyrPc2&quot;, 0.001 , 20 , 5 , oReponseDlg(46),) 
test(3) = ZT_Nbre(monDlg,  &quot;RepTroncPyrPc3&quot;, 0.1 , 99.9 , 50 , oReponseDlg(47),)        &apos; 0 ou 1
test(4) = ZT_Nbre(monDlg,  &quot;RepTroncPyrPc4&quot;, 0.001 , 20 , 5 , oReponseDlg(48),) 
test(5) = ZT_Nbre(monDlg,  &quot;RepTroncPyrPc5&quot;, 0 , 360 , 45 , oReponseDlg(49),) 

AffectTextLabel(monDlg,&quot;RepTroncPyrPc1&quot; , &quot;Info1&quot;, CDbl(monDlg.getcontrol(&quot;RepTroncPyrPc3&quot;).Peer.text)/100)
AffectTextLabel(monDlg,&quot;RepTroncPyrPc2&quot; , &quot;Info2&quot;, CDbl(monDlg.getcontrol(&quot;RepTroncPyrPc3&quot;).Peer.text)/100)
AffectTextLabel(monDlg,&quot;RepTroncPyrPc4&quot; , &quot;Info3&quot;, 100/(100 - CDbl(monDlg.getcontrol(&quot;RepTroncPyrPc3&quot;).Peer.text)))

end sub

Sub GestionInfoBulle
TexteAide(monDlg,&quot;RepTroncPyrPc1&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;RepTroncPyrPc2&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;RepTroncPyrPc3&quot;, &quot;0,1&lt;= ... &lt;= 99,9&quot;)
TexteAide(monDlg,&quot;RepTroncPyrPc4&quot;, &quot;0&lt; ... &lt;= 20&quot;)
TexteAide(monDlg,&quot;RepTroncPyrPc5&quot;, &quot;0&lt;= ... &lt; 360&quot;)
end sub


sub GestionImage
ChangerImagePrincipalex4(monDlg , &quot;RepTroncPyrPc5&quot; , CheminDessin(&quot;Dessins/Tronc/SommetTroncA1.gif/&quot;), CheminDessin(&quot;Dessins/Tronc/SommetTroncA2.gif/&quot;),CheminDessin(&quot;Dessins/Tronc/SommetTroncA3.gif/&quot;), CheminDessin(&quot;Dessins/Tronc/SommetTroncA4.gif/&quot;), CheminDessin(&quot;Dessins/erreur.gif/&quot;))
end sub

sub GestionBoutonOK  
Dim choix as Object, valeur as string,i as integer, test(5) as integer

&apos;-----------------------Gestion des erreurs de saisie

test(1) = ZT_Nbre(monDlg,  &quot;RepTroncPyrPc1&quot;, 0.001 , 20 , 5 , oReponseDlg(45),) 
test(2) = ZT_Nbre(monDlg,  &quot;RepTroncPyrPc2&quot;, 0.001 , 20 , 5 , oReponseDlg(46),) 
test(3) = ZT_Nbre(monDlg,  &quot;RepTroncPyrPc3&quot;, 0.1 , 99.9 , 50 , oReponseDlg(47),)        &apos; 0 ou 1
test(4) = ZT_Nbre(monDlg,  &quot;RepTroncPyrPc4&quot;, 0.001 , 20 , 5 , oReponseDlg(48),) 
test(5) = ZT_Nbre(monDlg,  &quot;RepTroncPyrPc5&quot;, 0 , 360 , 45 , oReponseDlg(49),)  
test(0) = test(1)*test(2)*test(3)*test(4)*test(5)   
&apos;---------------------- (test(0) contient 1 si tout est ok 0 sinon)

if test(0) = 1 then
&apos;---------------------- recupere toute les données saisie dans une variable globale
    for i = 1 to 5
    oReponseDlg(i - 1) = CDbl(monDlg.getControl(&quot;RepTroncPyrPc&quot;&amp;i).Peer.Text)
    Next
    for i = 6 to 12
    oReponseDlg(i - 1) = monDlg.getControl(&quot;RepTroncPyrPc&quot;&amp;i).state  
    Next
    for i = 19 to 34
    oReponseDlg(i - 7) = monDlg.getControl(&quot;RepTroncPyrPc&quot;&amp;i).state  &apos; sommets et milieux
    Next
    for i = 1 to 17
    oReponseDlg(27 + i) =  monDlg.getControl(&quot;StyleA&quot;&amp;i).Model.state
    next
    
    &apos;affecte les dimensions à la zone info
    AffectTextLabel(monDlg,&quot;RepTroncPyrPc1&quot; , &quot;Info1&quot;, CDbl(monDlg.getcontrol(&quot;RepTroncPyrPc3&quot;).Peer.text)/100)
    AffectTextLabel(monDlg,&quot;RepTroncPyrPc2&quot; , &quot;Info2&quot;, CDbl(monDlg.getcontrol(&quot;RepTroncPyrPc3&quot;).Peer.text)/100)
    AffectTextLabel(monDlg,&quot;RepTroncPyrPc4&quot; , &quot;Info3&quot;, 100/(100 - CDbl(monDlg.getcontrol(&quot;RepTroncPyrPc3&quot;).Peer.text)))
    
    &apos;met en mémoire la valeur de la hauteur de la pyramide entière
    oReponseDlg(51) = CDbl(monDlg.getControl(&quot;Info3&quot;).Peer.Text)       &apos;43--51
   &apos;met en mémoire les dimensions de la base du dessus
    oReponseDlg(52) = oReponseDlg(0)*oReponseDlg(2)/100      &apos;44 -- 52
    oReponseDlg(53) = oReponseDlg(1)*oReponseDlg(2)/100      &apos;45 -- 53
    
    monDlg.Model.Tag= &quot;OK&quot;   &apos;met OK au tag du dialogue quand tout est validé
    oReponseDlg(50) = true   &apos;true quand tout est validé
    monDlg.endExecute
end if

End Sub


