REM  *****  BASIC  *****

Option Explicit


sub TroncPyrPcMacroPrincipale &apos;macro principale

appelerBoiteDialogueTroncPyrPc()

if oReponseDlg(50) = true then
Deselection   
DRAWversDocActif(&quot;TroncPyrPc.ConstructionTroncPyrPc()&quot;)
oSolide = LastForme
TailleObjetFinal(oSolide)
PosObjetFinal(oSolide)
end if

end Sub
&apos;------------------------------------------------------------------------------------------------------
Sub appelerBoiteDialogueTroncPyrPc()
Dim i As Integer

monDlg = CreerDialogue(&quot;OOoAHmath3D&quot;, &quot;TroncPyrPcDlg&quot;)
PositionDlg(monDlg,120,150)			
&apos;------------------------initialisation de la boite de dialogue-----------------------
Initialisation_Unites(6,1)		
Initialisation(monDlg,CheminDessin(&quot;Dessins/Tronc/SommetTroncA1.gif/&quot;),17)
AffecterImageFixe(monDlg, &quot;ImageSecondaire1&quot; , CheminDessin(&quot;Dessins/Tronc/TroncAngle.gif/&quot;))
AffecterImageFixe(monDlg, &quot;BoutonActualiser&quot; , CheminDessin(&quot;Dessins/Tronc/TroncActualiser.png/&quot;) )
GestionInfoBulle
AfficherPoints
&apos;------------------------ récupération des messages d&apos;erreurs et des infobulles ------
for i = 1 to 5
oReponseDlg(i + 44) = monDlg.getControl(&quot;Message&quot;&amp;i).Peer.Text
Next
&apos;--------------------------------------------------------------------------------------	

monDlg.execute
if monDlg.Model.Tag= &quot;OK&quot; then
monDlg.dispose
end if
End Sub

sub ConstructionTroncPyrPc()
TracerTronc(5000,10000)
end sub


sub TracerBase1(x0 as double, y0 as double,A2 as string, A3 as string, A4 as string)
Dim AngFuite as double, Longueur as double, Profondeur as double, Hauteur as double, Angle as double
Angle = oReponseDlg(4)
Longueur = oReponseDlg(0)
Profondeur = oReponseDlg(1)
Hauteur = oReponseDlg(3)
AngFuite = Angle * pi/180

SegmentDraw(x0, y0 , x0 + Longueur*1000 ,y0 ,30, &quot;plein&quot;)
SegmentDraw(x0 + Longueur*1000, y0 , x0 + Longueur*1000 + Profondeur*cos(AngFuite)*1000 ,y0 - Profondeur*sin(AngFuite)*1000 ,30, A2)
SegmentDraw( x0 + Longueur*1000 + Profondeur*cos(AngFuite)*1000 ,y0 - Profondeur*sin(AngFuite)*1000 , x0 + Profondeur*cos(AngFuite)*1000 ,y0 - Profondeur*sin(AngFuite)*1000 ,30, A3)
SegmentDraw(x0, y0 , x0 + Profondeur*cos(AngFuite)*1000 ,y0 - Profondeur*sin(AngFuite)*1000 ,30, A4)
end sub

sub TracerBase2(x0 as double, y0 as double, A2 as string, A3 as string, A4 as string)
Dim Longueur as double, Profondeur as double, Hauteur as double, Angle as double
Dim AngFuite as double, decalage as double, Ycentre2 as double, Pf as double
Angle = oReponseDlg(4)
Longueur = oReponseDlg(52)
Profondeur = oReponseDlg(53)
Hauteur = oReponseDlg(3)
AngFuite = Angle * pi/180
Pf = oReponseDlg(1)&apos;profondeur de la face du dessous
Ycentre2 = y0 - Pf*sin(AngFuite)*1000/2 - Hauteur*1000
decalage = (oReponseDlg(0)+ oReponseDlg(1)*cos(AngFuite) - (oReponseDlg(52)+ oReponseDlg(53)*cos(AngFuite)))*1000/2

SegmentDraw(x0 + decalage, Ycentre2 + Profondeur*sin(AngFuite)*1000/2 , x0 + decalage + Longueur*1000 ,Ycentre2+ Profondeur*sin(AngFuite)*1000/2,30, &quot;plein&quot;)
SegmentDraw(x0 + decalage + Longueur*1000, Ycentre2+ Profondeur*sin(AngFuite)*1000/2 , x0 + decalage + Longueur*1000 + Profondeur*cos(AngFuite)*1000 ,Ycentre2 - Profondeur*sin(AngFuite)*1000/2 ,30, A2)
SegmentDraw( x0 + decalage + Longueur*1000 + Profondeur*cos(AngFuite)*1000 ,Ycentre2 - Profondeur*sin(AngFuite)*1000/2 , x0 + decalage + Profondeur*cos(AngFuite)*1000 ,Ycentre2 -	 Profondeur*sin(AngFuite)*1000/2 ,30, A3)
SegmentDraw(x0 + decalage, Ycentre2 + Profondeur*sin(AngFuite)*1000/2, x0 + decalage + Profondeur*cos(AngFuite)*1000 ,Ycentre2 - Profondeur*sin(AngFuite)*1000/2 ,30, A4)
end sub

sub TracerAretes(x0 as double, y0 as double,A1 as string,A2 as string, A3 as string, A4 as string)
Dim  Long1 as double, Prof1 as double,Long2 as double, Prof2 as double, Hauteur as double, Angle as double
Dim AngFuite as double, decalage as double, Ycentre2 as double
Angle = oReponseDlg(4)
AngFuite = Angle * pi/180
Long1 = oReponseDlg(0)
Prof1 = oReponseDlg(1)
Long2 = oReponseDlg(52)
Prof2 = oReponseDlg(53)
Hauteur = oReponseDlg(3)
decalage = (oReponseDlg(0)+ oReponseDlg(1)*cos(AngFuite) - (oReponseDlg(52)+ oReponseDlg(53)*cos(AngFuite)))*1000/2
Ycentre2 = y0 - Prof1*sin(AngFuite)*1000/2 - Hauteur*1000

SegmentDraw(x0 + decalage, Ycentre2 + Prof2*sin(AngFuite)*1000/2 ,x0, y0 ,30,A1)
SegmentDraw(x0 + decalage + Long2*1000 ,Ycentre2 + Prof2*sin(AngFuite)*1000/2 ,x0 + Long1*1000 ,y0  ,30,A2)
SegmentDraw( x0 + decalage + Long2*1000 + Prof2*cos(AngFuite)*1000 ,Ycentre2- Prof2*sin(AngFuite)*1000/2  ,x0 + Long1*1000 + Prof1*cos(AngFuite)*1000 ,y0 - Prof1*sin(AngFuite)*1000,30,A3)
SegmentDraw( x0 + decalage + Prof2*cos(AngFuite)*1000 ,Ycentre2- Prof2*sin(AngFuite)*1000/2, x0 + Prof1*cos(AngFuite)*1000 ,y0 - Prof1*sin(AngFuite)*1000,30,A4)
end sub

sub TracerRestePyr(x0 as double, y0 as double,xs as double, ys as double,A1 as string,A2 as string, A3 as string, A4 as string)
Dim AngFuite as double, decalage as double, Ycentre2 as double, Angle as double, Hauteur as double
Dim  Long1 as double, Prof1 as double, Long2 as double, Prof2 as double
Angle = oReponseDlg(4)
AngFuite = Angle * pi/180
Long1 = oReponseDlg(0)
Prof1 = oReponseDlg(1)
Long2 = oReponseDlg(52)
Prof2 = oReponseDlg(53)
Hauteur = oReponseDlg(3)
decalage = (Long1+ Prof1*cos(AngFuite) - (Long2+ Prof2*cos(AngFuite)))*1000/2
Ycentre2 = y0 - Prof1*sin(AngFuite)*1000/2 - Hauteur*1000

SegmentDraw(x0 + decalage, Ycentre2 + Prof2*sin(AngFuite)*1000/2 ,xs, ys ,30,A1)
SegmentDraw(x0 + decalage + Long2*1000 ,Ycentre2 + Prof2*sin(AngFuite)*1000/2 ,xs ,ys  ,30,A2)
SegmentDraw( x0 + decalage + Long2*1000 + Prof2*cos(AngFuite)*1000 ,Ycentre2- Prof2*sin(AngFuite)*1000/2  ,xs ,ys ,30,A3)
SegmentDraw( x0 + decalage + Prof2*cos(AngFuite)*1000 ,Ycentre2- Prof2*sin(AngFuite)*1000/2, xs  ,ys ,30,A4)
end sub



sub TracerTronc(x1 as double, y1 as double)
Dim Ysommet as double,Lg as double, Lg2 as double,Pf as double,Pf2 as double, Ht as double,HtTronc as double, Ang as double
Dim Xcentre as double, Ycentre1 as double,Ycentre2 as double, AngArete1 as double, AngArete2 as double, decalage as double,StyleTraitA as string,StyleTraitB as string
Dim i as integer

Lg = CDbl(oReponseDlg(0))
Lg2 = CDbl(oReponseDlg(52))		
Pf = CDbl(oReponseDlg(1))
Pf2 = CDbl(oReponseDlg(53))
HtTronc = CDbl(oReponseDlg(3))
Ht = CDbl(oReponseDlg(51))
Ang = CDbl(oReponseDlg(4))
decalage = (oReponseDlg(0)+ oReponseDlg(1)*cos(Ang*pi/180) - (oReponseDlg(52)+ oReponseDlg(53)*cos(Ang*pi/180)))*1000/2
Ysommet = y1 - (Pf * sin(Ang*pi/180)/2 + Ht) * 1000
Xcentre = x1 + (Lg + Pf*cos(Ang*pi/180))*1000/2
Ycentre1 = y1 - Pf*sin(Ang*pi/180)*1000/2
Ycentre2 = y1 - Pf*sin(Ang*pi/180)*1000/2 - HtTronc*1000
if Ang &lt;&gt; 180 then
AngArete1 = 180 - abs(Atn((Ysommet-y1)/(Xcentre - x1-Lg*1000))*180/pi)
AngArete2 = abs(Atn((Ysommet-y1)/(Xcentre - x1))*180/pi)
end if

if Ysommet &gt;= y1 - Pf * sin(Ang*pi/180)*1000 and Ang &lt;= 180 then  
TracerBase1(5000, 10000,&quot;plein&quot;, &quot;plein&quot;,&quot;plein&quot;)
TracerBase2(5000, 10000,&quot;plein&quot;, &quot;plein&quot;,&quot;plein&quot;)
TracerAretes(5000, 10000,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;)
end if
if Ysommet &lt; y1 - Pf * sin(Ang*pi/180)*1000 and Ysommet &gt; y1 and Ang &gt; 180 then  
TracerBase1(5000, 10000,&quot;plein&quot;, &quot;plein&quot;,&quot;plein&quot;)
TracerBase2(5000, 10000, &quot;pointillé&quot;, &quot;pointillé&quot;,&quot;pointillé&quot;)
TracerAretes(5000, 10000, &quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;pointillé&quot;)
end if

if Ysommet &lt; y1 - Pf * sin(Ang*pi/180)*1000 and Ysommet &lt;=y1 then  
   if Ang = 180 then
   TracerBase1(5000, 10000,&quot;plein&quot;, &quot;pointillé&quot;,&quot;plein&quot;)
   TracerBase2(5000, 10000,&quot;plein&quot;, &quot;pointillé&quot;,&quot;plein&quot;)
   TracerAretes(5000, 10000,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;plein&quot;)
   end if
   if Ang &lt;=90 and  AngArete2&gt;= Ang then
   TracerBase1(5000, 10000,&quot;plein&quot;, &quot;pointillé&quot;,&quot;pointillé&quot;)
   TracerBase2(5000, 10000,&quot;plein&quot;, &quot;plein&quot;,&quot;plein&quot;)
   TracerAretes(5000, 10000,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;)
   end if
   if Ang &lt;=90 and AngArete2&lt;Ang then
   TracerBase1(5000, 10000,&quot;plein&quot;, &quot;pointillé&quot;,&quot;plein&quot;)
   TracerBase2(5000, 10000,&quot;plein&quot;, &quot;plein&quot;,&quot;plein&quot;)
   TracerAretes(5000, 10000,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;)
   end if
   if Ang &lt; 180 and Ang&gt;90 and AngArete1&gt;= Ang then
   TracerBase1(5000, 10000,&quot;pointillé&quot;, &quot;pointillé&quot;,&quot;plein&quot;)
   TracerBase2(5000, 10000,&quot;plein&quot;, &quot;plein&quot;,&quot;plein&quot;)
   TracerAretes(5000, 10000,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;plein&quot;)
   end if
   if Ang &lt; 180 and Ang&gt;90 and AngArete1&lt; Ang then
   TracerBase1(5000, 10000,&quot;pointillé&quot;, &quot;pointillé&quot;,&quot;plein&quot;)
   TracerBase2(5000, 10000,&quot;plein&quot;, &quot;plein&quot;,&quot;plein&quot;)
   TracerAretes(5000, 10000,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;plein&quot;)
   end if
   if Ang &gt; 180 and Ang &lt;270 and Ang - 180&lt; AngArete2 then
   TracerBase1(5000, 10000,&quot;plein&quot;, &quot;plein&quot;,&quot;plein&quot;)
   TracerBase2(5000, 10000, &quot;pointillé&quot;, &quot;pointillé&quot;,&quot;plein&quot;)
   TracerAretes(5000, 10000,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;plein&quot;)
   end if
    if Ang &gt; 180 and Ang &lt;270 and Ang - 180 &gt;= AngArete2 then
   TracerBase1(5000, 10000,&quot;plein&quot;, &quot;plein&quot;,&quot;plein&quot;)
   TracerBase2(5000, 10000,&quot;pointillé&quot;, &quot;pointillé&quot;,&quot;pointillé&quot;)
   TracerAretes(5000, 10000,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;pointillé&quot;)
   end if
   if Ang &lt;= 360 and Ang &gt;=270 and Ang - 180 &lt; AngArete1 then
   TracerBase1(5000, 10000, &quot;plein&quot;, &quot;plein&quot;,&quot;plein&quot;)
   TracerBase2(5000, 10000,&quot;pointillé&quot;, &quot;pointillé&quot;,&quot;pointillé&quot;)
   TracerAretes(5000, 10000,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;pointillé&quot;)
   end if
    if Ang &lt;= 360 and Ang &gt;=270 and Ang - 180 &gt;=AngArete1 then
   TracerBase1(5000, 10000, &quot;plein&quot;, &quot;plein&quot;,&quot;plein&quot;)
   TracerBase2(5000, 10000,&quot;plein&quot;, &quot;pointillé&quot;,&quot;pointillé&quot;)
   TracerAretes(5000, 10000,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;)
   end if
end if

&apos;-------------------------------------tracé du centre des  bases
if oReponseDlg(5) = 1 then PointDraw(Xcentre, Ycentre1Ang*pi/180 , 30,&quot;plein&quot;)
if oReponseDlg(6) = 1 then PointDraw(Xcentre, Ycentre2, Ang*pi/180 , 30,&quot;plein&quot;)

&apos;-----------------------------------tracé de la hauteur et des angles droits ---------------------------------------------------------------------
if oReponseDlg(7) = 1 then 
  SegmentDraw(Xcentre, Ycentre1 ,  Xcentre , Ycentre2 , 30,oReponseDlg(44)) &apos;hauteur

  if oReponseDlg(9) = 1  then QuadrilatereDraw(Xcentre, Ycentre1 ,  Xcentre  , Ycentre1 - 250 ,Xcentre + 250 , Ycentre1 - 250,  Xcentre + 250 , Ycentre1 , 30,&quot;plein&quot;)
  if oReponseDlg(8) = 1  then QuadrilatereDraw(Xcentre, Ycentre2 ,  Xcentre  , Ycentre2 + 250 ,Xcentre + 250 , Ycentre2 + 250,  Xcentre + 250 , Ycentre2 , 30,&quot;plein&quot;)
  
end if

&apos;-----------------------------------tracé de la pyramide ---------------------------------------------------------------------
if oReponseDlg(10) = 1 then

  if oReponseDlg(11) = false then
  SegmentDraw(Xcentre, Ysommet , x1 + decalage , Ycentre2 + Pf2*sin(Ang*pi/180)*1000/2 , 30,&quot;pointillé&quot;)
  SegmentDraw(Xcentre, Ysommet , x1 + decalage + Lg2*1000 , Ycentre2 + Pf2*sin(Ang*pi/180)*1000/2 , 30,&quot;pointillé&quot;)
  SegmentDraw(Xcentre, Ysommet , x1 + decalage + Lg2*1000 + Pf2*cos(Ang*pi/180)*1000 , Ycentre2 - Pf2*sin(Ang*pi/180)*1000/2 , 30,&quot;pointillé&quot;)
  SegmentDraw(Xcentre, Ysommet , x1 + decalage + Pf2*cos(Ang*pi/180)*1000 , Ycentre2 - Pf2*sin(Ang*pi/180)*1000/2 , 30,&quot;pointillé&quot;)
  end if
   
  if oReponseDlg(11) = True then
   if Ysommet &gt;= y1 - Pf * sin(Ang*pi/180)*1000 and Ang &lt;= 180 then  
   TracerRestePyr(5000, 10000, Xcentre,Ysommet,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;)
   end if
   if Ysommet &lt; y1 - Pf * sin(Ang*pi/180)*1000 and Ysommet &gt; y1 and Ang &gt; 180 then  
   TracerRestePyr(5000, 10000, Xcentre,Ysommet,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;pointillé&quot;)
   end if
   if Ysommet &lt; y1 - Pf * sin(Ang*pi/180)*1000 and Ysommet &lt;=y1 then  
    if Ang = 180 then
    TracerRestePyr(5000, 10000,Xcentre,Ysommet,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;plein&quot;)
    end if
    if Ang &lt;=90 and  AngArete2&gt;= Ang then
    TracerRestePyr(5000, 10000, Xcentre,Ysommet,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;)
    end if
    if Ang &lt;=90 and AngArete2&lt;Ang then
    TracerRestePyr(5000, 10000, Xcentre,Ysommet,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;)
    end if
    if Ang &lt; 180 and Ang&gt;90 and AngArete1&gt;= Ang then
    TracerRestePyr(5000, 10000, Xcentre,Ysommet,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;plein&quot;)
    end if
    if Ang &lt; 180 and Ang&gt;90 and AngArete1&lt; Ang then
    TracerRestePyr(5000, 10000, Xcentre,Ysommet,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;plein&quot;)
    end if
    if Ang &gt; 180 and Ang &lt;270 and Ang - 180&lt; AngArete2 then
    TracerRestePyr(5000, 10000, Xcentre,Ysommet,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;plein&quot;)
    end if
    if Ang &gt; 180 and Ang &lt;270 and Ang - 180 &gt;= AngArete2 then
    TracerRestePyr(5000, 10000, Xcentre,Ysommet,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;pointillé&quot;)
    end if
    if Ang &lt;= 360 and Ang &gt;=270 and Ang - 180 &lt; AngArete1 then
    TracerRestePyr(5000, 10000, Xcentre,Ysommet,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;,&quot;pointillé&quot;)
    end if
    if Ang &lt;= 360 and Ang &gt;=270 and Ang - 180 &gt;=AngArete1 then
    TracerRestePyr(5000, 10000, Xcentre,Ysommet,&quot;plein&quot;,&quot;plein&quot;,&quot;plein&quot;,&quot;pointillé&quot;)
    end if
   end if
  end if

end if
&apos;--------------------------rejoindre le centre des bases aux sommets ou aux milieux


     &apos;--------------base du haut : centre &gt; sommets
    if Ang &lt;= 180 then    
       if oReponseDlg(12) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  x1 + decalage  , Ycentre2 + Pf2*sin(Ang*pi/180)*1000/2  , 30, oReponseDlg(28))&apos;A
       if oReponseDlg(13) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  x1 + decalage + Lg2 * 1000  , Ycentre2 + Pf2*sin(Ang*pi/180)*1000/2   , 30, oReponseDlg(29))&apos;B
       if oReponseDlg(14) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  x1 + decalage + Lg2 * 1000 + Pf2 * cos(Ang*pi/180)*1000 , Ycentre2  - Pf2 * sin(Ang*pi/180)*1000/2 , 30, oReponseDlg(30)) &apos;C
       if oReponseDlg(15) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  x1 + decalage +  Pf2 * cos(Ang*pi/180)*1000  , Ycentre2  - Pf2 * sin(Ang*pi/180)*1000/2 , 30, oReponseDlg(31)) &apos;D
       if oReponseDlg(20) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  Xcentre +  Pf2 * cos(Ang*pi/180)*1000/2  , Ycentre2 - Pf2 * sin(Ang*pi/180)*1000/2  , 30,  oReponseDlg(36)) &apos;I 
       if oReponseDlg(21) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  Xcentre - Lg2*1000/2 , Ycentre2 , 30,  oReponseDlg(37)) &apos;J
       if oReponseDlg(22) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  Xcentre  -  Pf2 * cos(Ang*pi/180)*1000/2  , Ycentre2 + Pf2 * sin(Ang*pi/180)*1000/2  , 30,  oReponseDlg(38)) &apos; K
       if oReponseDlg(23) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  Xcentre  +  Lg2*1000/2  , Ycentre2 , 30,  oReponseDlg(39))  &apos; L
    end if
    if Ang &gt; 180 then    
       if oReponseDlg(12) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  x1 + decalage +  Pf2 * cos(Ang*pi/180)*1000  , Ycentre2  - Pf2 * sin(Ang*pi/180)*1000/2 , 30, oReponseDlg(28)) &apos;A
       if oReponseDlg(13) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  x1 + decalage + Lg2 * 1000 + Pf2 * cos(Ang*pi/180)*1000 , Ycentre2  - Pf2 * sin(Ang*pi/180)*1000/2 , 30, oReponseDlg(29)) &apos;B
       if oReponseDlg(14) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  x1 + decalage + Lg2 * 1000  , Ycentre2 + Pf2*sin(Ang*pi/180)*1000/2   , 30, oReponseDlg(30)) &apos;C
       if oReponseDlg(15) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  x1 + decalage  , Ycentre2 + Pf2*sin(Ang*pi/180)*1000/2  , 30, oReponseDlg(31))&apos;D
       if oReponseDlg(20) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  Xcentre -  Pf2 * cos(Ang*pi/180)*1000/2  , Ycentre2 + Pf2 * sin(Ang*pi/180)*1000/2  , 30, oReponseDlg(36)) &apos;I
       if oReponseDlg(21) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  Xcentre - Lg2*1000/2 , Ycentre2 , 30, oReponseDlg(37)) &apos;J
       if oReponseDlg(22) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  Xcentre  +  Pf2 * cos(Ang*pi/180)*1000/2  , Ycentre2 - Pf2 * sin(Ang*pi/180)*1000/2  , 30, oReponseDlg(38)) &apos;K
       if oReponseDlg(23) = 1 then SegmentDraw(Xcentre, Ycentre2 ,  Xcentre  +  Lg2*1000/2  , Ycentre2 , 30, oReponseDlg(39)) &apos;L
    end if
    &apos;--------------base du bas : centre &gt; sommets
    if Ang &lt;= 180 then    
       if oReponseDlg(16) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  x1  , y1 , 30, oReponseDlg(32)) &apos;E
       if oReponseDlg(17) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  x1 + Lg * 1000  , y1  , 30, oReponseDlg(33)) &apos;F
       if oReponseDlg(18) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  x1 + Lg * 1000 + Pf * cos(Ang*pi/180)*1000 , y1 - Pf * sin(Ang*pi/180)*1000 , 30, oReponseDlg(34)) &apos;G
       if oReponseDlg(19) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  x1 +  Pf * cos(Ang*pi/180)*1000  , y1 - Pf * sin(Ang*pi/180)*1000 , 30, oReponseDlg(35))&apos;H
       if oReponseDlg(24) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  Xcentre +  Pf * cos(Ang*pi/180)*1000/2  , Ycentre1 - Pf * sin(Ang*pi/180)*1000/2  , 30, oReponseDlg(40))       &apos;M
       if oReponseDlg(25) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  Xcentre - Lg*1000/2 , Ycentre1 , 30, oReponseDlg(41))&apos;N
       if oReponseDlg(26) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  Xcentre  -  Pf * cos(Ang*pi/180)*1000/2  , Ycentre1 + Pf * sin(Ang*pi/180)*1000/2  , 30, oReponseDlg(42)) &apos;O
       if oReponseDlg(27) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  Xcentre  +  Lg*1000/2  , Ycentre1 , 30, oReponseDlg(43)) &apos;P
    end if
    if Ang &gt; 180 then    
       if oReponseDlg(16) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  x1 +  Pf * cos(Ang*pi/180)*1000  , y1 - Pf * sin(Ang*pi/180)*1000 , 30, oReponseDlg(32))&apos;E
       if oReponseDlg(17) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  x1 + Lg * 1000 + Pf * cos(Ang*pi/180)*1000 , y1 - Pf * sin(Ang*pi/180)*1000 , 30, oReponseDlg(33)) &apos;F
       if oReponseDlg(18) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  x1 + Lg * 1000  , y1  , 30, oReponseDlg(34)) &apos;G
       if oReponseDlg(19) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  x1  , y1 , 30, oReponseDlg(35)) &apos;H
       if oReponseDlg(24) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  Xcentre -  Pf * cos(Ang*pi/180)*1000/2  , Ycentre1+Pf * sin(Ang*pi/180)*1000/2  , 30, oReponseDlg(40))        &apos;M
       if oReponseDlg(25) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  Xcentre - Lg*1000/2 , Ycentre1 , 30, oReponseDlg(41))        &apos;N
       if oReponseDlg(26) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  Xcentre  +  Pf * cos(Ang*pi/180)*1000/2  , Ycentre1 - Pf * sin(Ang*pi/180)*1000/2  , 30, oReponseDlg(42))        &apos;O
       if oReponseDlg(27) = 1 then SegmentDraw(Xcentre, Ycentre1 ,  Xcentre  +  Lg*1000/2  , Ycentre1 , 30, oReponseDlg(43)) &apos;P
    end if
   
end sub


