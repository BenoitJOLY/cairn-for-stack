    <questionvariables>
      <text><![CDATA[stack_include_contrib("prooflib.mac");

/* 1. Définition de tous les blocs (bons et distracteurs) */
proof_steps: [
    ["L1", "def calculer_moyenne(notes):"],
    ["L2", "    if len(notes) == 0:"],
    ["L3", "        return 0"],
    ["L4", "    somme = sum(notes)"],
    ["L5", "    moyenne = somme / len(notes)"],
    ["L6", "    return moyenne"],
    ["D1", "    somme = 0"],
    ["D2", "    return somme / len(notes)"]
];

/* 2. Définition de la structure de la bonne réponse 
   Même pour une séquence simple, il faut utiliser proof() */
ta: proof("L1", "L2", "L3", "L4", "L5", "L6");

/* 3. Mélange aléatoire des blocs pour l'affichage élève */
proof_steps: random_permutation(proof_steps);

/* 4. Génération des alternatives (utile si on utilisait proof_iff) */
tal: proof_alternatives(ta);

/* 5. Création d'un ensemble contenant les preuves aplaties pour l'évaluation */
tas: setify(map(proof_flatten, tal));]]></text>
