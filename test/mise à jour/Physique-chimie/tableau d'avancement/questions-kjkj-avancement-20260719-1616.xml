    <questionvariables>
      <text>n0_val : rand(4) + 2;
nH_i : 100; /* On fixe H+ initiale à 100 pour simuler l'excès */

/* Etat initial */
ni_h2o2 : n0_val;
ni_mno4 : 0;
ni_h : nH_i;
ni_o2 : 0;
ni_mn2 : 0;

/* Etat en cours (litteral avec x) */
nc_h2o2 : n0_val - 5*x;
nc_mno4 : 2*x;
nc_h : nH_i - 6*x;
nc_o2 : 5*x;
nc_mn2 : 2*x;

/* Avancement maximal */
val_xmax : float(n0_val / 5);

/* Etat final */
nf_h2o2 : ev(nc_h2o2, x = val_xmax);
nf_mno4 : ev(nc_mno4, x = val_xmax);
nf_h : ev(nc_h, x = val_xmax);
nf_o2 : ev(nc_o2, x = val_xmax);
nf_mn2 : ev(nc_mn2, x = val_xmax);</text>
    </questionvariables>
