longueur_apres1: slength(sremove("<",local_raw1));
is_equi1: is(longueur_avant1 > longueur_apres1);
is_tot1: false;
if (not is_equi1) then (
    if slength(local_raw1) > slength(sremove(">",local_raw1)) then is_tot1: true
);
ans_arrow_det1: "absente";
if is_equi1 then ans_arrow_det1: "<=>" else if is_tot1 then ans_arrow_det1: "->";
is_arrow_ok1: is(ans_arrow_det1 = tans_arrow1);
arrow_s_label1: if is_equi1 then "la fleche d equilibre (<=>)" else if is_tot1 then "la fleche totale (->)" else "aucune fleche";
arrow_t_label1: if is(tans_arrow1="->") then "la fleche totale (->)" else "la fleche d equilibre (<=)";
L_reac1: if listp(ans_reacharge1) then ans_reacharge1 else [];
L_reac_n1: if listp(ans_reacoef1) then ans_reacoef1 else [];
L_prod1: if listp(ans_procharge1) then ans_procharge1 else [];
L_prod_n1: if listp(ans_procoef1) then ans_procoef1 else [];
is_atoms_ok1: sequal(ans_atombalance1,"true");
charge_rea_s1: if length(L_reac1)>0 and length(L_reac1)=length(L_reac_n1) then sum(L_reac1[i]*L_reac_n1[i],i,1,length(L_reac1)) else 0;
charge_pro_s1: if length(L_prod1)>0 and length(L_prod1)=length(L_prod_n1) then sum(L_prod1[i]*L_prod_n1[i],i,1,length(L_prod1)) else 0;
charges_conserved1: is(charge_rea_s1=charge_pro_s1);
nb_rea_s1: if listp(ans_reaformul1) then length(ans_reaformul1) else 0;
nb_pro_s1: if listp(ans_proformul1) then length(ans_proformul1) else 0;
nb_rea_t1: length(tans_reaformul1); nb_pro_t1: length(tans_proformul1);
rea_ok1: is(sort(if listp(ans_reaformul1) then ans_reaformul1 else [])=sort(tans_reaformul1));
pro_ok1: is(sort(if listp(ans_proformul1) then ans_proformul1 else [])=sort(tans_proformul1));
formulas_ok1: rea_ok1 and pro_ok1;
fct_pro_ok1: sequal(ans_fct_pro1,tans_fct_pro1);
list_rea_s1: if listp(ans_reaformul1) and listp(ans_reacoef1) then map(lambda([f,c],[f,c]),ans_reaformul1,ans_reacoef1) else [];
list_pro_s1: if listp(ans_proformul1) and listp(ans_procoef1) then map(lambda([f,c],[f,c]),ans_proformul1,ans_procoef1) else [];
full_ans_map1: append(list_rea_s1,list_pro_s1);
list_rea_t1: map(lambda([f,c],[f,c]),tans_reaformul1,tans_reacoef1);
list_pro_t1: map(lambda([f,c],[f,c]),tans_proformul1,tans_procoef1);
full_tans_map1: append(list_rea_t1,list_pro_t1);
_common1: sublist(full_ans_map1,lambda([pp],not is(assoc(pp[1],full_tans_map1,"nf")="nf")));
k_ratio1: if length(_common1)>0 then _common1[1][2]/assoc(_common1[1][1],full_tans_map1,1) else 1;
