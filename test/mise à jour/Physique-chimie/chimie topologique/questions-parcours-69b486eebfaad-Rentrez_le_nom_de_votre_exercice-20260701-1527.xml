      <text><![CDATA[<div style="background:#B5464D;border-left:5px solid #8f2b33;border-radius:0 8px 8px 0;padding:10px 16px;margin-bottom:12px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;"><strong style="font-weight:800;color:#fff;font-size:.95rem;">Q1 — Chimie Topologique</strong> <span style="background:#8f2b33;color:#fff;padding:2px 9px;border-radius:20px;font-size:.78rem;font-weight:bold;">/ 2 pt</span></div>
