    <name>
      <text>conversion d'unités autogénérées</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Convertit {@val_depart@}  en {@y@}</p>
<p>[[input:ans1]] [[validation:ans1]]</p>]]></text>
