    <questionvariables>
      <text><![CDATA[val: float(rand(990)/10);

multiple: [["f",1E-15],["p",1E-12],["n",1E-9],["µ",1E-6],["m",1E-3],["c",1E-2],["d",1E-1],[" ",1],["da",1E1],["h",1E2],["k",1E3],["M",1E6],["G",1E9],["T",1E12]];
/* Choisir une sous-liste au hasard dans la liste multiple */
choix_liste1: rand(multiple);
choix_liste2: rand(multiple);

while choix_liste1 = choix_liste2 do
 choix_liste2: rand(multiple);
end;

/* Extraire le préfixe (premier élément de la sous-liste) */
choix1: choix_liste1[1];
choix2: choix_liste2[1];
/* Extraire le facteur (deuxième élément de la sous-liste) */
choix_a: choix_liste1[2];
choix_b: choix_liste2[2];

unités: ["W", "Pa", "J", "cd", "K", "g", "N", "V", "A", "s", "m"];
unité_choisie: rand(unités);
liste_combine1: [choix1, unité_choisie];
liste_combine2: [choix2, unité_choisie];

/* On utilise 'sconcat' pour créer les unités sous forme de chaînes de caractères */
x: sconcat(choix1, unité_choisie);
y: sconcat(choix2, unité_choisie);

/* On définit la variable de départ */
val_depart: val * x;

/* Création de la variable 'ta1' */
ta1: val *choix_a /choix_b;
z: choix_a /choix_b;
ta5:?;]]></text>
