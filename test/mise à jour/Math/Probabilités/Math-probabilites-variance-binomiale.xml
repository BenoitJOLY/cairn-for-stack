      <text>/* Fonction utilitaire CORRECTE pour Maxima */
/* rand(n) dans Maxima renvoie un entier entre 1 et n */
ri(a,b) := a + rand(b - a + 1) - 1;

/* Génération des paramètres */
n: ri(10, 50);
p_pool: [1/2, 1/3, 2/3, 1/4, 3/4, 1/5, 2/5, 3/5, 4/5];
p: p_pool[rand(length(p_pool))];
q: 1 - p;

/* Réponse attendue */
ans_correct: n * p * q;

/* Erreurs classiques */
err_ex: n * p;
err_p_q: p * q;
err_np2: n * p * p;
err_nq: n * q;</text>
