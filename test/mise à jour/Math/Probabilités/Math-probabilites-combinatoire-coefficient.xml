    <questionvariables>
      <text><![CDATA[/* Fonction utilitaire */
ri(a,b) := a + floor(rand((b-a+1)));

/* Génération des paramètres */
n: ri(6, 10);
k: ri(2, n-2);
nmk: n - k;

/* Réponse attendue */
ans_correct: binomial(n, k);

/* Pour l'affichage dans la correction */
num_simp: apply("*", makelist(i, i, nmk+1, n));
den_simp: k!;

/* Erreurs classiques */
/* Erreur 1 : A calculé un arrangement A(n,k) = n!/(n-k)! (a oublié le k! au dénominateur) */
err_arrang: n! / nmk!;
/* Erreur 2 : A oublié le (n-k)! au dénominateur */
err_no_nmk: n! / k!;
/* Erreur 3 : A inversé la fraction */
err_inv: (k! * nmk!) / n!;]]></text>
    </questionvariables>
