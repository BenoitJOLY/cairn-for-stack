    <questionvariables>
      <text>/* Fonction utilitaire */
ri(a,b) := a + rand(b - a + 1);

/* Génération des paramètres */
n: ri(10, 50);
p_pool: [1/2, 1/3, 2/3, 1/4, 3/4, 1/5, 2/5, 3/5, 4/5];
p: p_pool[1 + ri(1, length(p_pool))];

/* Réponse attendue */
ans_correct: n * p;

/* Erreurs classiques */
err_add: n + p;
err_sous: n - p;
err_var: n * p * (1 - p);
err_only_p: p;</text>
