    <questionvariables>
      <text>/* Fonction utilitaire CORRECTE pour Maxima */
ri(a,b) := a + rand(b - a + 1) - 1;

/* Génération sécurisée par pool de triplets valides */
/* Format : [P(A), P(B), P(A inter B)] */
triplets: [
    [1/2, 1/2, 1/5],
    [2/3, 1/2, 1/4],
    [3/4, 1/3, 1/6],
    [4/5, 3/5, 2/5],
    [1/2, 2/3, 1/3],
    [3/5, 1/2, 1/10],
    [5/6, 1/2, 1/3],
    [3/4, 3/4, 1/2],
    [2/5, 3/4, 1/5],
    [1/3, 4/5, 1/10]
];

chosen: triplets[rand(length(triplets))];
pA: chosen[1];
pB: chosen[2];
p_inter: chosen[3];

/* Réponse attendue */
ans_correct: pA + pB - p_inter;

/* Erreurs classiques */
/* Erreur 1 : A fait une addition simple P(A) + P(B) */
err_add: pA + pB;
/* Erreur 2 : Confusion avec l'indépendance P(A) * P(B) */
err_prod: pA * pB;
/* Erreur 3 : A donné l'intersection au lieu de l'union */
err_inter: p_inter;
/* Erreur 4 : A fait une soustraction P(A) - P(B) */
err_sous: pA - pB;</text>
