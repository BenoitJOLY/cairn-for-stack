    <questionvariables>
      <text>/* Fonction utilitaire */
ri(a,b) := a + floor(rand((b-a+1)));

/* Génération des paramètres */
n: ri(5, 8);
/* On évite k=0 ou k=n pour que les erreurs de puissances soient bien distinctes */
k: 1 + floor(rand((n-1)));
nmk: n - k;

/* On choisit une probabilité p sous forme de fraction simple */
p_pool: [1/2, 1/3, 2/3, 1/4, 3/4, 1/5, 2/5, 3/5, 4/5];
p: p_pool[1 + floor(rand(length(p_pool)))];
q: 1 - p;

/* Valeurs pour la correction */
ck_val: binomial(n, k);
num_p: p^k;
den_p: 1;
num_q: q^nmk;
den_q: 1;

/* Réponse attendue */
ans_correct: (ck_val * p^k * q^nmk);

/* Erreurs classiques */
/* Erreur 1 : A oublié le coefficient binomial C(n,k) */
err_no_ck: p^k * q^nmk;
/* Erreur 2 : A inversé les puissances (p^(n-k) et q^k) */
err_pow_swap: ck_val * p^nmk * q^k;
/* Erreur 3 : A oublié le terme (1-p)^(n-k) */
err_no_1mp: ck_val * p^k;
/* Erreur 4 : A juste écrit le coefficient binomial */
err_only_ck: ck_val;</text>
