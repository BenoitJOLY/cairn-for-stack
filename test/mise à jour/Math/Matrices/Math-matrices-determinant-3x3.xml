    <questionvariables>
      <text><![CDATA[/* Fonction utilitaire : entier aléatoire entre a et b */
ri(a,b) := a + rand(b - a + 1)$ 

/* Génération des 9 coefficients */
a11: ri(-3,3); a12: ri(-3,3); a13: ri(-3,3);
a21: ri(-3,3); a22: ri(-3,3); a23: ri(-3,3);
a31: ri(-3,3); a32: ri(-3,3); a33: ri(-3,3);

/* Construction de la matrice */
M: matrix([a11,a12,a13],[a21,a22,a23],[a31,a32,a33]);

/* Produits de Sarrus — diagonales descendantes (+) */
p1: a11*a22*a33;
p2: a12*a23*a31;
p3: a13*a21*a32;

/* Produits de Sarrus — diagonales montantes (−) */
n1: a13*a22*a31;
n2: a11*a23*a32;
n3: a12*a21*a33;

/* Sommes intermédiaires */
S1: p1 + p2 + p3;
S2: n1 + n2 + n3;

/* Déterminant correct */
det_correct: S1 - S2;

/* Erreurs classiques */
err_trace: a11 + a22 + a33;
err_sarrus_plus: S1 + S2;
err_sarrus_inv: S2 - S1;
err_diag_seule: p1;]]></text>
    </questionvariables>
