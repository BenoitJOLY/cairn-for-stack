    <questionvariables>
      <text><![CDATA[/* Fonction utilitaire : entier aléatoire entre a et b */
ri(a,b) := a + rand(b - a + 1)$ 

/* Génération des coefficients */
a11: ri(-3,3); a12: ri(-3,3); a21: ri(-3,3); a22: ri(-3,3);
b11: ri(-3,3); b12: ri(-3,3); b21: ri(-3,3); b22: ri(-3,3);

/* Construction des matrices */
A: matrix([a11, a12], [a21, a22]);
B: matrix([b11, b12], [b21, b22]);

/* Produit correct */
C: A.B;

/* Coefficients du résultat (pour le feedback détaillé via extraction) */
c11: C[1,1]; c12: C[1,2]; c21: C[2,1]; c22: C[2,2];

/* Erreurs classiques */
err_BA: B.A;
err_add: A + B;
err_had: matrix([a11*b11, a12*b12], [a21*b21, a22*b22]);]]></text>
