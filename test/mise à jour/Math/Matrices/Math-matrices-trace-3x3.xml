    <questionvariables>
      <text>/* Fonction utilitaire : entier aléatoire entre a et b */
ri(a,b) := a + rand(b - a + 1)$ 
/* Génération des 9 coefficients */
a11: ri(-5,5); a12: ri(-5,5); a13: ri(-5,5);
a21: ri(-5,5); a22: ri(-5,5); a23: ri(-5,5);
a31: ri(-5,5); a32: ri(-5,5); a33: ri(-5,5);

/* Construction de la matrice */
M: matrix([a11,a12,a13],[a21,a22,a23],[a31,a32,a33]);

/* Trace correcte */
trace_correct: a11 + a22 + a33;

/* Erreurs classiques */
err_det: determinant(M);
err_somme_tot: a11+a12+a13+a21+a22+a23+a31+a32+a33;
err_prod_diag: a11*a22*a33;
err_diag_sec: a13 + a22 + a31;</text>
    </questionvariables>
