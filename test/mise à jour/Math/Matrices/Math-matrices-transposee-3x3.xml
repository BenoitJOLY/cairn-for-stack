      <text><![CDATA[/* Fonction utilitaire : entier aléatoire entre a et b */
ri(a,b) := a + rand(b - a + 1)$ 

/* Génération des 9 coefficients */
a11: ri(-3,3)$ a12: ri(-3,3)$ a13: ri(-3,3)$ a21: ri(-3,3)$ a22: ri(-3,3)$ a23: ri(-3,3)$ a31: ri(-3,3)$ a32: ri(-3,3)$ a33: ri(-3,3)$ 
/* Construction de la matrice */
M: matrix([a11,a12,a13],[a21,a22,a23],[a31,a32,a33])$ 
/* Transposée correcte */
M_t: transpose(M)$ 
/* Erreurs classiques de symétrie */
