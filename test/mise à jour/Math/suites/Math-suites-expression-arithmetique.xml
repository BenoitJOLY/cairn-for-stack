    <questionvariables>
      <text>/* Fonction utilitaire */
ri(a,b) := a + floor(rand((b-a+1)));

/* Génération des paramètres */
U0: ri(-5,5);
k: ri(2,5);
r: ri(-5,5);

/* Sécurité : on s'assure que la raison n'est pas nulle */
while r = 0 do (
    r: ri(-5,5)
);

/* Calcul des valeurs */
Uk: U0 + k*r;
Uk_m_U0: Uk - U0;

/* Réponses attendues et erreurs classiques */
ans_correct: U0 + n*r;
/* Erreur 1 : A inversé la différence lors du calcul de r (U0 - Uk au lieu de Uk - U0) */
err_inv: U0 - n*r;
/* Erreur 2 : A écrit la constante Uk au lieu de l'expression en fonction de n */
err_const: Uk;
/* Erreur 3 : A inversé le premier terme et la raison dans la formule */
err_swap: r + n*U0;
/* Erreur 4 : A oublié de multiplier la raison par n */
err_nok: U0 + r;</text>
