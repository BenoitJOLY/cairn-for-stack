    <questionvariables>
      <text>/* Fonction utilitaire */
ri(a,b) := a + rand(b - a + 1);
/* Génération des coordonnées */
xa: ri(-5,5);
 ya: ri(-5,5);
 xb: ri(-5,5);
 yb: ri(-5,5); 
/* On s'assure que A et B ne sont pas confondus */
while xa=xb and ya=yb do (
    xb: ri(-5,5),
    yb: ri(-5,5)
)$ 
/* Calculs pour la correction */
somme_x: xa + xb;
 somme_y: ya + yb;
 x_mid: somme_x / 2;
 y_mid: somme_y / 2;
 M_mid: matrix([x_mid], [y_mid]); 
/* Erreurs classiques */
/* Erreur 1 : Inversion des coordonnées x et y */
err_swap: matrix([y_mid], [x_mid]);
 /* Erreur 2 : A fait une différence au lieu d'une somme */
err_diff: matrix([(xa - xb)/2], [(ya - yb)/2]);
 /* Erreur 3 : A oublié de diviser la deuxième coordonnée par 2 */
err_no_div_y: matrix([x_mid], [somme_y]);</text>
    </questionvariables>
