    <questionvariables>
      <text><![CDATA[/* Fonction utilitaire */
ri(a,b) := a + rand(b - a + 1)$ 
/* Génération des coordonnées du vecteur */
x: ri(-5,5)$ y: ri(-5,5)$ 
/* On s'assure que le vecteur n'est pas nul */
while x=0 and y=0 do (
    x: ri(-5,5),
    y: ri(-5,5)
)$ 
/* Calculs intermédiaires */
x2: x^2$ y2: y^2$ somme_carres: x2 + y2$ 
/* Norme exacte et arrondie à 10^-2 */
norm_exact: sqrt(somme_carres)$ norm_arr: 1.00*(round(float(norm_exact)*100)/100)$ 
/* Erreurs classiques */
err_no_sqrt: somme_carres$ err_manhattan: abs(x) + abs(y)$ err_soustraction: sqrt(abs(x2 - y2))$]]></text>
    </questionvariables>
