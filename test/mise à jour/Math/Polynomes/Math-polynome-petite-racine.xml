    <questionvariables>
      <text><![CDATA[/* Fonction utilitaire */
ri(a,b) := a + rand(b - a + 1) - 1;

/* Génération secrète de deux racines entières distinctes */
r1: ri(-4, 4);
r2: ri(-4, 4);
while r2 = r1 do r2: ri(-4, 4);

/* Détermination explicite de la plus petite et de la plus grande */
r_min: min(r1, r2);
r_max: max(r1, r2);

/* Génération du coefficient a (non nul) */
r_a: rand(6);
if r_a = 1 then a: -3
else if r_a = 2 then a: -2
else if r_a = 3 then a: -1
else if r_a = 4 then a: 1
else if r_a = 5 then a: 2
else a: 3;

/* Fabrication du polynôme à l'envers : a(x - r1)(x - r2) */
b: -a * (r1 + r2);
c: a * r1 * r2;
poly: a*x^2 + b*x + c;

/* Calcul du discriminant */
delta: b^2 - 4*a*c;

/* Réponse attendue */
ans_correct: r_min;

/* Erreurs classiques */
/* Erreur 1 : A donné la plus grande racine au lieu de la plus petite */
err_max: r_max;
/* Erreur 2 : A oublié le "a" au dénominateur */
err_no_a: min((-b - sqrt(delta))/2, (-b + sqrt(delta))/2);
/* Erreur 3 : A oublié le signe "-" devant b */
err_no_minus: min((b - sqrt(delta))/(2*a), (b + sqrt(delta))/(2*a));
/* Erreur 4 : A donné l'abscisse du sommet */
err_sommet: -b/(2*a);]]></text>
    </questionvariables>
