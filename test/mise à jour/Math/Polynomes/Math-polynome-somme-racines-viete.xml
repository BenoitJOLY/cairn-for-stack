    <questionvariables>
      <text>/* Fonction utilitaire */
ri(a,b) := a + rand(b - a + 1) - 1;

/* Génération secrète de deux racines entières distinctes */
r1: ri(-4, 4);
r2: ri(-4, 4);
while r2 = r1 do r2: ri(-4, 4);

/* Génération du coefficient a (non nul) */
r_a: rand(6);
if r_a = 1 then a: -3
else if r_a = 2 then a: -2
else if r_a = 3 then a: -1
else if r_a = 4 then a: 1
else if r_a = 5 then a: 2
else a: 3;

/* Fabrication du polynôme à l'envers : a(x - r1)(x - r2) */
b: -a * (r1 + r2);
c: a * r1 * r2;
poly: a*x^2 + b*x + c;

/* Réponse attendue */
ans_correct: r1 + r2;

/* Erreurs classiques */
/* Erreur 1 : A oublié le signe moins (a calculé b/a) */
err_sign: b / a;
/* Erreur 2 : A calculé le produit des racines (c/a) */
err_prod: c / a;
/* Erreur 3 : A calculé -(c/a) */
err_minus_prod: -c / a;
/* Erreur 4 : A fait b + a */
err_add_ba: b + a;</text>
    </questionvariables>
