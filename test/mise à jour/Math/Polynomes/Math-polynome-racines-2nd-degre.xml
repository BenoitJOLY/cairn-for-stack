    <questionvariables>
      <text><![CDATA[/* Fonction utilitaire */
ri(a,b) := a + rand(b - a + 1) - 1;

/* Génération secrète de deux racines entières distinctes */
r1: ri(-4, 4);
r2: ri(-4, 4);
while r2 = r1 do r2: ri(-4, 4);

/* Ordonner les racines pour un affichage propre dans la correction */
if r1 > r2 then (
    temp: r1,
    r1: r2,
    r2: temp
);

/* Génération du coefficient a (non nul) */
r_a: rand(6);
if r_a = 1 then a: -3
else if r_a = 2 then a: -2
else if r_a = 3 then a: -1
else if r_a = 4 then a: 1
else if r_a = 5 then a: 2
else a: 3;

/* Fabrication du polynôme à l'envers : a(x - r1)(x - r2) */
b: -a * (r1 + r2);
c: a * r1 * r2;
poly: a*x^2 + b*x + c;

/* Calcul du discriminant pour la correction */
delta: b^2 - 4*a*c;

/* Ensemble de réponses pour les tests logiques */
ans_correct_set: {r1, r2};

/* Erreurs classiques (mises sous forme d'ensembles pour le test AlgEquiv) */
/* Erreur 1 : A oublié le "a" au dénominateur */
err_no_a_set: {(-b - sqrt(delta))/2, (-b + sqrt(delta))/2};
/* Erreur 2 : A oublié le signe "-" devant b */
err_no_minus_set: {(b - sqrt(delta))/(2*a), (b + sqrt(delta))/(2*a)};]]></text>
    </questionvariables>
