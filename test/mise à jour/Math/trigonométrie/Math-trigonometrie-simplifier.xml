    <questionvariables>
      <text>/* Fonction utilitaire */
ri(a,b) := a + rand(b - a + 1) - 1;

/* Choix aléatoire du modèle d'expression (sans utiliser de liste) */
r_tpl: rand(4);

/* Choix aléatoire de l'angle constant a (parmi les valeurs classiques) */
r_a: rand(3);
if r_a = 1 then a_val: pi/6
else if r_a = 2 then a_val: pi/4
else a_val: pi/3;

/* Génération de l'expression et de la réponse en fonction du modèle */
if r_tpl = 1 then (
    expr: cos(a_val + x) + cos(a_val - x),
    ans_correct: 2*cos(a_val)*cos(x),
    err_wrong_op: -2*sin(a_val)*sin(x)
) else if r_tpl = 2 then (
    expr: cos(a_val + x) - cos(a_val - x),
    ans_correct: -2*sin(a_val)*sin(x),
    err_wrong_op: 2*cos(a_val)*cos(x)
) else if r_tpl = 3 then (
    expr: sin(a_val + x) + sin(a_val - x),
    ans_correct: 2*sin(a_val)*cos(x),
    err_wrong_op: 2*cos(a_val)*sin(x)
) else (
    expr: sin(a_val + x) - sin(a_val - x),
    ans_correct: 2*cos(a_val)*sin(x),
    err_wrong_op: 2*sin(a_val)*cos(x)
);

/* Erreurs classiques */
/* Erreur 1 : A oublié le facteur 2 */
err_no_2: ans_correct / 2;

/* Erreur 2 : Confusion des fonctions dans le résultat (sin au lieu de cos) */
if r_tpl = 1 then err_swap: 2*cos(a_val)*sin(x)
else if r_tpl = 2 then err_swap: -2*cos(a_val)*cos(x)
else if r_tpl = 3 then err_swap: 2*cos(a_val)*cos(x)
else err_swap: 2*sin(a_val)*cos(x);

/* Erreur 3 : A inversé le signe de tout */
err_sign: -ans_correct;</text>
