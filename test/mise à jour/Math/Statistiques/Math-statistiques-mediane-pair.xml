    <questionvariables>
      <text><![CDATA[/* 1. Génération de 6 nombres distincts triés par ordre croissant */
L: sort([rand(9)+1, rand(8)+10, rand(9)+20, rand(9)+30, rand(8)+40, rand(9)+50])$ 
/* 2. Affichage de la liste */
str_L: simplode(L, " ; ")$ 
/* 3. Calcul de la vraie médiane (Maxima gère les effectifs pairs tout seul) */
ta_med: float(median(L))$ 
/* 4. Les erreurs classiques pour le PRT */
ta_mean: float(mean(L))$ ta_sum_mid: L[3] + L[4]$ ta_one_mid: L[3]$]]></text>
