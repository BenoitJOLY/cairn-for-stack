        <truenextnode>-1</truenextnode>
        <trueanswernote>PRT-ERR-SANS_DIV</trueanswernote>
        <truefeedback format="html">
          <text><![CDATA[<div style="border-left: 4px solid #dc2626; padding: 10px 14px; background: #fff0f0; border-radius: 4px;">❌ <strong>Presque !</strong> Vous avez bien multiplié chaque moyenne par son effectif et fait la somme. Mais la formule de la moyenne exige de diviser ce résultat par l'effectif total ({@N_total@}).</div>]]></text>
        </truefeedback>
        <falsescoremode>=</falsescoremode>
        <falsescore>0</falsescore>
